#!/usr/bin/env bash
# Set the executable bit on the scripts that need it, in the index, before the
# commit exists.
#
# The development of this repository is on /mnt/c. There, git sets
# core.fileMode=false, and ignores the executable bit of the filesystem. Thus a
# new script runs here, but gets committed as mode 100644. On Linux, nothing can
# execute it. `git add` cannot carry the bit, and `chmod` cannot either. On this
# checkout, the mode is ONLY in the index. Only `git update-index --chmod=+x`
# writes it there.
#
# tests/repo.bats already fails a build for this, and CI goes red. Both happen
# after the commit. That is too late for a reminder. It cost one red release,
# and ten commits of a tests/mocks/ssh that silently did not execute. Thus this
# fixes it at the last moment that still allows action.
#
# It fixes, and does not refuse, because there is nothing to decide. Each path
# in tests/executable-paths.sh is there because something executes it. A hook
# that blocks is only the same reminder that people forget, one step earlier.
#
# Enable it once for each clone, with:  git config core.hooksPath .githooks
set -euo pipefail

root=$(git rev-parse --show-toplevel) || exit 0
list="$root/tests/executable-paths.sh"

# A clone older than the list, or a rebase at an old revision, must not break a
# commit. Correctness does not depend on this file (it depends on repo.bats).
# Thus each failure path is "do nothing, quietly".
[ -x "$list" ] || exit 0

fixed=()
while IFS= read -r path; do
    [ -f "$path" ] || continue

    # The mode AND the repo-relative name both come from the answer of git.
    # This does not remove $root from the front of the name. That looks
    # obvious, but is wrong on Git Bash. There, rev-parse says C:/Code/Draugr,
    # and the path list says /c/Code/Draugr. It is the same directory with a
    # different spelling, and the prefix never matches.
    #
    # ls-files -s prints "<mode> <sha> <stage>\t<path>".
    entry=$(git ls-files -s --full-name -- "$path" 2>/dev/null) || continue

    # Only files already in the index. A listed script that is not added is not
    # part of this commit. A stage here silently commits something that the
    # author did not ask for.
    [ -n "$entry" ] || continue

    mode=${entry%% *}
    [ "$mode" != 100755 ] || continue

    rel=${entry#*$'\t'}
    git update-index --chmod=+x -- "$rel" && fixed+=("$rel")
done < <("$list")

[ ${#fixed[@]} -gt 0 ] || exit 0

# Said aloud, not done silently. The new commit now has a mode change that
# nobody typed. A surprise in a diff is worse than a noisy hook.
printf 'pre-commit: made executable in the index (mode 100644 -> 100755):\n' >&2
printf '  %s\n' "${fixed[@]}" >&2
