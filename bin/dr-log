#!/usr/bin/env bash
# dr-log: the work of the agent that you did not see yet.
#
# It is `git log` for HEAD..draugr/<branch>, so each git log option works:
# `dr-log -p`, `dr-log --author=…`, `dr-log -3`. The default is --stat. The
# first question about the work of an agent is usually about the changed files.
#
#   dr-log             one line and a file summary for each commit
#   dr-log -p          with the full patch
#   dr-log --oneline   only the subjects
set -euo pipefail

DR_PROG=dr-log
# readlink -f comes first. install.sh links this file into ~/.local/bin, and
# through a link BASH_SOURCE is the LINK. Without it, ../lib is ~/.local/lib.
_dr_bin=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$_dr_bin/../lib/common.sh"

case "${1:-}" in
    -h|--help) dr_help "$0"; exit 0 ;;
esac

dr_context
dr_require_tracking_ref
tracking=$(dr_tracking_ref)

# If the caller asked for no format, add --stat. Thus `dr-log --oneline`
# does not fight a default that nobody asked for.
if [ $# -eq 0 ]; then
    set -- --stat
fi

# "$@" comes last, so that the options of the caller win over all above.
exec git -C "$DR_REPO" log "HEAD..$tracking" "$@"
