#!/usr/bin/env bash
# dr-ls: each mound on this machine, not only the mound of this repo.
#
# Sandboxes live longer than the shell that started them, and people easily
# forget a stopped one. Thus this lists all of them, also those that sbx created
# directly. The arrow marks the mound of the current repo.
#
#   dr-ls           table
#   dr-ls --json    the raw sbx output, for scripts
#   dr-ls --names   one name per line
set -euo pipefail

DR_PROG=dr-ls
# readlink -f comes first. install.sh links this file into ~/.local/bin, and
# through a link BASH_SOURCE is the LINK. Without it, ../lib is ~/.local/lib.
_dr_bin=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$_dr_bin/../lib/common.sh"

# --json passes the output of sbx without change. Thus a script that needs more
# than dr-ls continues to work, and does not wait for a new field from us.
format=table
while [ $# -gt 0 ]; do
    case "$1" in
        --json)    format=json ;;
        --names|-q) format=names ;;
        -h|--help) dr_help "$0"; exit 0 ;;
        *) dr_die "unknown option: $1" "Try: dr-ls --help" ;;
    esac
    shift
done

json=$(dr_sbx ls --json) || dr_die "could not list sandboxes" "Is sbx working?  dr-doctor"

if [ "$format" = json ]; then
    printf '%s\n' "$json"
    exit 0
fi

if [ "$format" = names ]; then
    printf '%s' "$json" | jq -r '(.sandboxes // [])[].name'
    exit 0
fi

# Which one is ours? That has a meaning only inside a repo. This command often
# runs outside a repo, so a failure here is not an error. The subshell keeps the
# `exit 1` of dr_repo_root from a stop of dr-ls.
mine=
if repo=$(git rev-parse --show-toplevel 2>/dev/null); then
    mine=$(dr_sandbox_name "$repo")
fi

# jq builds the rows, and the shell adds the marks.
#
# join("\t"), not the more usual @tsv, because @tsv escapes backslashes. Each
# workspace here is a Windows path, and C:\Code becomes C:\\Code. These four
# fields cannot hold a tab, so a plain join is safe.
rows=$(printf '%s' "$json" | jq -r \
    '(.sandboxes // [])[]
     | [(.name // "-"), (.agent // "-"), (.status // "-"),
        ((.workspaces // []) | join(" "))]
     | join("\t")')

if [ -z "$rows" ]; then
    dr_info "no sandboxes on this machine"
    printf '  %sCreate one with:  dr-up%s\n' "$_DR_DIM" "$_DR_OFF" >&2
    exit 0
fi

# Three spaces, because each row below starts with a mark of two characters and
# a separator. Otherwise the whole table moves one column.
printf '%s   %-24s %-8s %-9s %s%s\n' "$_DR_BOLD" SANDBOX AGENT STATUS WORKSPACE "$_DR_OFF"

# IFS=$'\t' splits only on tabs, so a workspace path with spaces stays whole.
while IFS=$'\t' read -r name agent status workspace; do
    [ -n "$name" ] || continue

    # The color shows the state, so that you see a running mound without
    # reading.
    case "$status" in
        running) colour=$_DR_GREEN ;;
        stopped) colour=$_DR_DIM ;;
        *)       colour=$_DR_YELLOW ;;
    esac

    marker='  '
    [ "$name" = "$mine" ] && marker="${_DR_BLUE}->${_DR_OFF}"

    printf '%b %-24s %-8s %b%-9s%b %s\n' \
        "$marker" "$name" "$agent" "$colour" "$status" "$_DR_OFF" "$workspace"
done <<< "$rows"
