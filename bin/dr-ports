#!/usr/bin/env bash
# dr-ports: publish a port from the running mound, without a rebuild.
#
# sbx applies the ports of the kit at the creation of the sandbox, and a change
# of the kit recreates the container. That cost is too high for "I only want to
# look at the dev server for a minute". This command is for that case.
#
# Published ports go on the WINDOWS loopback, not on the loopback of WSL. Thus
# connect to them from a Windows browser at 127.0.0.1:<port>. Inside WSL, that
# address is the loopback of the WSL VM, and does not connect. The same NAT
# boundary applies here that makes dr-sync use ssh.
#
#   dr-ports                 what is published now
#   dr-ports 5173            publish 5173 to a temporary host port
#   dr-ports 8080:80         publish container 80 as host 8080
#   dr-ports --close 8080:80 unpublish it
set -euo pipefail

DR_PROG=dr-ports
# readlink -f comes first. install.sh links this file into ~/.local/bin, and
# through a link BASH_SOURCE is the LINK. Without it, ../lib is ~/.local/lib.
_dr_bin=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$_dr_bin/../lib/common.sh"

# An argument without a dash is a port to open. --close takes a port to close.
close=()
open=()
while [ $# -gt 0 ]; do
    case "$1" in
        --close|-c) shift; [ -n "${1:-}" ] || dr_die "--close needs a port"; close+=("$1") ;;
        -h|--help)  dr_help "$0"; exit 0 ;;
        -*) dr_die "unknown option: $1" "Try: dr-ports --help" ;;
        *)  open+=("$1") ;;
    esac
    shift
done

dr_context

dr_sandbox_exists "$DRAUGR_SANDBOX" || dr_die \
    "$DRAUGR_SANDBOX does not exist" "Create it with:  dr-up"

# No arguments is a query. That is the usual case, and it must change nothing.
if [ ${#open[@]} -eq 0 ] && [ ${#close[@]} -eq 0 ]; then
    dr_sbx ports "$DRAUGR_SANDBOX"
    printf '\n  %sThese are on the WINDOWS loopback. Open them in a Windows browser,%s\n' \
        "$_DR_DIM" "$_DR_OFF" >&2
    printf '  %snot with curl from WSL.%s\n' "$_DR_DIM" "$_DR_OFF" >&2
    exit 0
fi

# sbx accepts --publish and --unpublish many times. Thus both lists go in one
# call, and the whole change applies together.
args=(ports "$DRAUGR_SANDBOX")
for p in "${open[@]+"${open[@]}"}";  do args+=(--publish "$p"); done
for p in "${close[@]+"${close[@]}"}"; do args+=(--unpublish "$p"); done

dr_sbx "${args[@]}" || dr_die \
    "could not change published ports" \
    "Format:  [[HOST_IP:]HOST_PORT:]SANDBOX_PORT[/PROTOCOL]" \
    "See the published ports with:  dr-ports"

dr_ok "ports updated"
printf '  %sConnect to them from Windows at 127.0.0.1:<host port>%s\n' "$_DR_DIM" "$_DR_OFF" >&2
