#!/usr/bin/env bash
# dr-init: set up this project for Draugr.
#
# It writes .draugr.conf (commit it) and a starter sbx kit at .draugr/kit/
# (commit that too). It adds the layer for each user to .gitignore, and trusts
# the configuration that it wrote.
#
#   dr-init                  set up the current repository
#   dr-init --agent codex    select the agent now
#   dr-init --force          overwrite files that already exist
set -euo pipefail

DR_PROG=dr-init
# readlink -f comes first. install.sh links this file into ~/.local/bin, and
# through a link BASH_SOURCE is the LINK. Without it, ../lib is ~/.local/lib.
_dr_bin=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$_dr_bin/../lib/common.sh"

# If --agent has no value, ${2:?msg} stops with that message.
force=
agent=
while [ $# -gt 0 ]; do
    case "$1" in
        --force|-f) force=1 ;;
        --agent)    agent=${2:?--agent needs a value}; shift ;;
        -h|--help)  dr_help "$0"; exit 0 ;;
        *) dr_die "unknown option: $1" "Try: dr-init --help" ;;
    esac
    shift
done

# dr-init and dr-up are the only two commands that can create a repository.
# This one is the more natural place, because you came here to set up a project.
# It obeys DRAUGR_ON_MISSING_REPO. If that is "fail" (the default), it refuses,
# as before.
dr_context_create
repo=$DR_REPO
[ -n "$agent" ] && DRAUGR_AGENT=$agent
name=$(dr_sandbox_name "$repo")
name=${name#draugr-}

wrote=0

# --- .draugr.conf ----------------------------------------------------------
conf="$repo/.draugr.conf"
if [ -f "$conf" ] && [ -z "$force" ]; then
    # In the create modes, "kept existing" is false. dr_repo_create wrote its
    # own .draugr.conf a moment earlier. If the output calls that your file, it
    # is a small lie, and such lies make people stop reading the output.
    if [ -n "${DR_REPO_CREATED:-}" ]; then
        dr_info "using the .draugr.conf that was just written for this directory"
    else
        dr_info "kept existing .draugr.conf"
    fi
else
    {
        cat "$DRAUGR_SHARE/project.example"
        if [ -n "$agent" ]; then
            printf '\nDRAUGR_AGENT=%s\n' "$agent"
        fi
    } > "$conf"
    dr_ok "wrote .draugr.conf"
    wrote=$((wrote + 1))
fi

# --- the kit ---------------------------------------------------------------
# DRAUGR_KIT is a list, and dr-init writes the OWN kit of the project, the first
# entry. With the whole value, it creates a directory named ".draugr/kit lua" as
# soon as somebody adds a library kit to the list.
read -ra _kit_entries <<< "${DRAUGR_KIT:-.draugr/kit}"
kitentry=${_kit_entries[0]:-.draugr/kit}
kitdir="$repo/$kitentry"
case "$kitentry" in /*) kitdir=$kitentry ;; esac

if [ -f "$kitdir/spec.yaml" ] && [ -z "$force" ]; then
    dr_info "kept existing kit at ${kitdir#"$repo"/}"
else
    mkdir -p "$kitdir"
    # Two substitutions from one project name. @SLUG@ is for the `name:` field.
    # sbx requires lowercase letters, digits, and hyphens there. @NAME@ is for
    # the free-text fields, with your spelling.
    #
    # The agent is NOT in the kit. sbx cannot compose a kit that pins an agent
    # with a different agent. If the current choice is in a committed file, a
    # different agent needs an edit, not a configuration change.
    sed -e "s|@SLUG@|$(dr_kit_slug "$name")|g" \
        -e "s|@NAME@|$name|g" \
        "$DRAUGR_SHARE/kit.example/spec.yaml" > "$kitdir/spec.yaml"
    dr_ok "wrote ${kitdir#"$repo"/}/spec.yaml"
    wrote=$((wrote + 1))
fi

# --- gitignore the files of this checkout, not of the project ---------------
#
# You commit .draugr/kit/, because it holds the sandbox rules of the project.
# You do not commit the four below. Without this step, each shows as an
# untracked file. With DRAUGR_REQUIRE_CLEAN=true, that is not only untidy. It
# blocks dr-go.
ignore="$repo/.gitignore"
ignore_entries=(
    '.draugr.local.conf'     # configuration for one user, never shared
    '.draugr/kit.applied'    # the kit of the mound of this checkout
    '.draugr/create.applied' # its configuration at creation: ports, mounts, memory
    '.draugr/tmp/'           # staging for sbx cp, removed after each transfer
)

# Test one entry at a time, not all together. Thus a repo from an older Draugr
# gets the entries that did not exist then. In data-only mode, there is nothing
# to add. That .gitignore is one "*", which already covers these and all other
# files. More lines below it only make people ask what they are for.
missing=()
if [ "${DR_REPO_CREATED:-}" != create-data-only ]; then
    for entry in "${ignore_entries[@]}"; do
        grep -qxF "$entry" "$ignore" 2>/dev/null || missing+=("$entry")
    done
fi

if [ ${#missing[@]} -gt 0 ]; then
    # BEFORE the append, find out whether the file ends in the middle of a line.
    # A read and a write of the same file in one pipeline cause problems. $(...)
    # removes the final newlines, so a non-empty result means that there is no
    # final \n.
    terminator=
    if [ -s "$ignore" ] && [ -n "$(tail -c1 "$ignore")" ]; then
        terminator=$'\n'
    fi
    {
        printf '%s\n# Draugr: files of this checkout, not of the project.\n' "$terminator"
        printf '%s\n' "${missing[@]}"
    } >> "$ignore"
    dr_ok "gitignored ${missing[*]}"
    wrote=$((wrote + 1))
fi

# --- trust what we just wrote ----------------------------------------------
# Draugr wrote this file, so the user has nothing to review yet. The question
# exists to stop a *cloned* configuration that nobody read. Here, it is only a
# show, and a show teaches people to click through real warnings.
dr_trust_add "$conf"

# If this repository did not exist at the start of dr-init, all the changes
# above are uncommitted. A commit here makes "dr-init leaves a clean tree" true
# in the modes that create a repo. It does nothing in the usual case, where the
# repo was always yours.
dr_repo_commit_setup "$repo"

# Tell clearly whether something changed. You can run dr-init again with no
# damage, and you must see the difference without a diff of your repo.
printf '\n'
if [ "$wrote" -eq 0 ]; then
    dr_info "nothing to do. This project was already set up."
else
    dr_ok "$name is ready"
fi

cat >&2 <<EOF

  ${_DR_BOLD}Next${_DR_OFF}
    1. Edit ${_DR_BOLD}${kitdir#"$repo"/}/spec.yaml${_DR_OFF}. List the domains that your build needs
       under network.allowedDomains, and your setup under commands.install.
       The agent can connect only to what you list.
    2. Commit the new files. A teammate then gets the same mound with one command.
    3. ${_DR_BOLD}dr-go${_DR_OFF}

  Look at the state with:  dr-doctor   dr-config
EOF

# TESTED, not assumed. In the modes that create the repository,
# dr_repo_commit_setup above already committed all of this. If you tell somebody
# to commit a clean tree, the reader learns to ignore the next instruction too.
if ! dr_repo_is_clean "$repo"; then
    dr_info "dr-go refuses while these are uncommitted. The mound gets a CLONE, and a"
    dr_info "clone holds only commits."
fi
