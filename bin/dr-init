#!/usr/bin/env bash
# dr-init - set this project up for Draugr.
#
# Writes .draugr.conf (commit it), a starter sbx kit at .draugr/kit/ (commit that
# too), gitignores the per-user layer, and trusts the config it just wrote.
#
#   dr-init                  set up the current repository
#   dr-init --agent codex    pick the agent up front
#   dr-init --force          overwrite files that already exist
set -euo pipefail

DR_PROG=dr-init
# readlink -f first: install.sh links this into ~/.local/bin by default, and
# through a link BASH_SOURCE is the LINK, so ../lib would be ~/.local/lib.
_dr_bin=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$_dr_bin/../lib/common.sh"

# ${2:?msg} aborts with that message when --agent is given no value.
force=
agent=
while [ $# -gt 0 ]; do
    case "$1" in
        --force|-f) force=1 ;;
        --agent)    agent=${2:?--agent needs a value}; shift ;;
        -h|--help)  dr_help "$0"; exit 0 ;;
        *) dr_die "unknown option: $1" "Try: dr-init --help" ;;
    esac
    shift
done

# dr-init and dr-up are the only two commands that may create a repository, and
# this is the more natural of the two to do it from: setting a project up is
# exactly what you came here for. Honours DRAUGR_ON_MISSING_REPO; refuses as
# before when that is "fail", which is the default.
dr_context_create
repo=$DR_REPO
[ -n "$agent" ] && DRAUGR_AGENT=$agent
name=$(dr_sandbox_name "$repo")
name=${name#draugr-}

wrote=0

# --- .draugr.conf ----------------------------------------------------------
conf="$repo/.draugr.conf"
if [ -f "$conf" ] && [ -z "$force" ]; then
    # "kept existing" would be a lie in the create modes: dr_repo_create writes
    # a .draugr.conf of its own moments earlier, and reporting that as something
    # you had already is the sort of small dishonesty that makes people stop
    # reading the output.
    if [ -n "${DR_REPO_CREATED:-}" ]; then
        dr_info "using the .draugr.conf just written for this directory"
    else
        dr_info "kept existing .draugr.conf"
    fi
else
    {
        cat "$DRAUGR_SHARE/project.example"
        if [ -n "$agent" ]; then
            printf '\nDRAUGR_AGENT=%s\n' "$agent"
        fi
    } > "$conf"
    dr_ok "wrote .draugr.conf"
    wrote=$((wrote + 1))
fi

# --- the kit ---------------------------------------------------------------
# DRAUGR_KIT is a list, and dr-init writes the project's OWN kit - the first
# entry. Using the whole value would create a directory literally named
# ".draugr/kit lua" the moment someone has added a library kit to the list.
read -ra _kit_entries <<< "${DRAUGR_KIT:-.draugr/kit}"
kitentry=${_kit_entries[0]:-.draugr/kit}
kitdir="$repo/$kitentry"
case "$kitentry" in /*) kitdir=$kitentry ;; esac

if [ -f "$kitdir/spec.yaml" ] && [ -z "$force" ]; then
    dr_info "kept existing kit at ${kitdir#"$repo"/}"
else
    mkdir -p "$kitdir"
    # Two substitutions from one project name: @SLUG@ for the `name:` field,
    # which sbx requires to be lowercase alphanumeric with hyphens, and @NAME@
    # for the free-text fields, which should read the way you spell it.
    #
    # The agent is NOT written in. A kit that pins one cannot be composed with
    # any other, so freezing today's choice into a committed file would make
    # trying a different agent an edit rather than a setting.
    sed -e "s|@SLUG@|$(dr_kit_slug "$name")|g" \
        -e "s|@NAME@|$name|g" \
        "$DRAUGR_SHARE/kit.example/spec.yaml" > "$kitdir/spec.yaml"
    dr_ok "wrote ${kitdir#"$repo"/}/spec.yaml"
    wrote=$((wrote + 1))
fi

# --- gitignore what describes this checkout rather than the project ----------
#
# .draugr/kit/ is meant to be committed - it is the project's sandbox rules. The
# four below are not, and each would otherwise show up as an untracked file:
# with DRAUGR_REQUIRE_CLEAN=true that is not merely untidy, it blocks dr-go.
ignore="$repo/.gitignore"
ignore_entries=(
    '.draugr.local.conf'     # per-user settings, never shared
    '.draugr/kit.applied'    # which kit this checkout's mound was built from
    '.draugr/create.applied' # the settings it was built with - ports, mounts, memory
    '.draugr/tmp/'           # staging for sbx cp, removed after every transfer
)

# Tested one at a time rather than all-or-nothing, so a repo initialised by an
# older Draugr picks up the entries that did not exist then. In data-only mode
# there is nothing to add: that .gitignore is a single "*", which already covers
# these and everything else, and three redundant lines under it would only
# invite the question of what they are for.
missing=()
if [ "${DR_REPO_CREATED:-}" != create-data-only ]; then
    for entry in "${ignore_entries[@]}"; do
        grep -qxF "$entry" "$ignore" 2>/dev/null || missing+=("$entry")
    done
fi

if [ ${#missing[@]} -gt 0 ]; then
    # Decide whether the file ends mid-line BEFORE opening the append redirect:
    # reading and writing the same file in one pipeline is asking for trouble.
    # $(...) strips trailing newlines, so a non-empty result means no final \n.
    terminator=
    if [ -s "$ignore" ] && [ -n "$(tail -c1 "$ignore")" ]; then
        terminator=$'\n'
    fi
    {
        printf '%s\n# Draugr: describes this checkout, not the project.\n' "$terminator"
        printf '%s\n' "${missing[@]}"
    } >> "$ignore"
    dr_ok "gitignored ${missing[*]}"
    wrote=$((wrote + 1))
fi

# --- trust what we just wrote ----------------------------------------------
# Draugr wrote this file itself, so there is nothing for the user to review yet.
# The prompt exists to stop a *cloned* config running unread; it would be theatre
# here, and theatre is how people learn to click through real warnings.
dr_trust_add "$conf"

# If this repository did not exist when dr-init started, everything above is an
# uncommitted change in it. Committing them here is what makes "dr-init leaves
# you with a clean tree" true in the modes that create a repo; it does nothing
# in the ordinary case, where the repo was yours all along.
dr_repo_commit_setup "$repo"

# Say plainly whether anything changed: re-running dr-init is harmless, and you
# should be able to tell the difference without diffing your own repo.
printf '\n'
if [ "$wrote" -eq 0 ]; then
    dr_info "nothing to do - this project was already initialised"
else
    dr_ok "$name is ready"
fi

cat >&2 <<EOF

  ${_DR_BOLD}Next${_DR_OFF}
    1. Edit ${_DR_BOLD}${kitdir#"$repo"/}/spec.yaml${_DR_OFF} - list the domains your build needs
       under network.allowedDomains, and your setup under commands.install.
       The agent reaches nothing you do not list.
    2. Commit both files. A teammate then gets the same mound in one command.
    3. ${_DR_BOLD}dr-go${_DR_OFF}

  Check anything with:  dr-doctor   dr-config
EOF
