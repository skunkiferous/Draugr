#!/usr/bin/env bash
# dr-go - the one you type. Create-or-start the mound, then attach to the agent.
#
# Everything after "--" is handed to the agent, so `dr-go -- --continue` resumes
# a Claude session. If you nearly always want the same flags, put them in
# DRAUGR_AGENT_ARGS and they are passed for you; --bare then means "not today".
# Leaving the agent returns you here; the mound keeps running until you dr-stop it.
#
# Ctrl-Z suspends the agent and drops you into a shell INSIDE the mound; fg puts
# you back, with the session as you left it. Ctrl-D leaves as usual.
#
#   dr-go                  go, with DRAUGR_AGENT_ARGS if you have set any
#   dr-go -- --continue    go, resuming the agent's last session
#   dr-go --bare           go with NO agent arguments, ignoring DRAUGR_AGENT_ARGS
#   dr-go --dirty          skip the clean-tree check, just this once
set -euo pipefail

DR_PROG=dr-go
_dr_bin=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$_dr_bin/../lib/common.sh"

# Options are ours until "--", after which everything belongs to the agent.
#
# $args_given records whether the command line said anything about agent
# arguments at all. It has to be separate from the array, because "you asked for
# none" and "you did not ask" are different answers and an empty array cannot
# tell them apart - the first must beat DRAUGR_AGENT_ARGS, the second must not.
dirty=
args_given=
agent_args=()
while [ $# -gt 0 ]; do
    case "$1" in
        --dirty)   dirty=1 ;;
        -y|--yes)  DR_ASSUME_YES=1 ;;
        --bare)    args_given=1; agent_args=() ;;
        -h|--help) dr_help "$0"; exit 0 ;;
        --) shift; args_given=1; agent_args=("$@"); break ;;
        *) dr_die "unknown option: $1" "Agent arguments go after --, e.g. dr-go -- --continue" ;;
    esac
    shift
done

dr_context
dr_attach_check

# Fall back to the configured arguments only when the command line said nothing.
# The command line REPLACES them rather than adding to them, which is the same
# rule the whole config cascade follows: an explicit flag beats a config file.
# It is also the only way to *remove* a configured argument for one run.
if [ -z "$args_given" ] && [ -n "$DRAUGR_AGENT_ARGS" ]; then
    read -ra agent_args <<< "$DRAUGR_AGENT_ARGS"
    dr_debug "agent args from ${DR_ORIGIN[DRAUGR_AGENT_ARGS]}: $DRAUGR_AGENT_ARGS"
fi

# --- the two things worth refusing over -------------------------------------
#
# A clone-mode sandbox is built from committed history, so uncommitted work is
# simply not in it. Without this check the agent quietly builds on stale code and
# you find out an hour later. --dirty is the escape hatch when that is fine.
if dr_is_true "$DRAUGR_REQUIRE_CLEAN" && [ -z "$dirty" ] && dr_is_true "$DRAUGR_CLONE"; then
    # DRAUGR_DATA files are exempt: they travel by rsync rather than through git,
    # so churning a parquet file is not the mistake this check exists to catch.
    # A single dirty *source* file still blocks, which is the point.
    if ! dr_repo_is_clean "$DR_REPO" && ! dr_data_dirty_only "$DR_REPO"; then
        dr_error "your working tree has uncommitted changes"
        git -C "$DR_REPO" status --short >&2
        # Not "stash them": a stash is still in .git, and .git is inside the
        # read-only mount, so stashing hides the change from the agent's clone
        # AND from dr-scan while leaving it readable. Committing or reverting
        # are the two that mean what people think stashing means here.
        dr_die "the agent would not see them" \
            "The sandbox gets a CLONE of this repo, and a clone only contains commits." \
            "Commit them, put them aside outside the repo, or run:  dr-go --dirty" \
            "(Stashing works too, but the stash stays readable at /run/sandbox/source.)"
    fi
fi

# The other direction: DRAUGR_CLONE=false bind-mounts your real working tree
# read-write, which is precisely the thing Draugr exists to prevent. It prompts
# every single time, and no config key silences it - that is the point.
if ! dr_is_true "$DRAUGR_CLONE"; then
    dr_warn "DRAUGR_CLONE is false"
    printf '  %sThe agent gets your real working tree, read-write. It can change and%s\n' "$_DR_DIM" "$_DR_OFF" >&2
    printf '  %sdelete files in %s directly. There is no clone to review first.%s\n' "$_DR_DIM" "$DR_REPO" "$_DR_OFF" >&2
    dr_confirm "Continue without the mound?" || dr_die "cancelled"
fi

# Scan BEFORE the mound exists, not after: the point is to catch a credential
# before anything can read it, and dr-up is what makes the read-only mount. With
# DRAUGR_SCAN_FAIL=block a finding aborts here, which is the whole reason the
# check is worth having.
if dr_is_true "$DRAUGR_SCAN" && [ -x "$_dr_bin/dr-scan" ]; then
    "$_dr_bin/dr-scan" --quiet
fi

# dr-up is a separate process on purpose: one implementation of the state
# machine, and `dr-up --print` stays a truthful preview of what dr-go will do.
"$_dr_bin/dr-up" ${DR_ASSUME_YES:+--yes}

# Checked after dr-up so that `dr-go` from a script still creates the mound
# before complaining that it cannot attach to it.
dr_require_tty dr-go

dr_hook pre-attach "$DR_REPO"

# Name the arguments in the attach line. If DRAUGR_AGENT_ARGS is doing something
# on your behalf you should see it, rather than wondering why the agent resumed.
if [ ${#agent_args[@]} -gt 0 ]; then
    dr_info "attaching to $DRAUGR_SANDBOX ($DRAUGR_AGENT ${agent_args[*]})"
else
    dr_info "attaching to $DRAUGR_SANDBOX ($DRAUGR_AGENT)"
fi

if [ "$DRAUGR_ATTACH" = ssh ]; then
    # The agent runs as a job of an interactive shell in the mound, so Ctrl-Z
    # gets you that shell instead of killing the session. See dr_attach_rc.
    mound=$(dr_path_mound "$DR_REPO") || dr_die \
        "$DR_REPO is not on a Windows drive, so it has no path inside the mound"
    dr_info "Ctrl-Z for a shell in the mound, fg to come back"

    # DRAUGR_AGENT=shell means "no agent, just put me in there", so there is no
    # command to start and the rcfile would have nothing to do.
    if [ "$DRAUGR_AGENT" = shell ]; then
        dr_ssh_attach "$mound" || rc=$?
    else
        # ${arr[0]+"${arr[@]}"} expands to nothing when the array is empty rather
        # than to one empty string, which would reach the agent as a blank
        # argument. Needed because `set -u` rejects an empty array expansion on
        # bash 4.3.
        dr_ssh_attach "$mound" "$DRAUGR_AGENT" ${agent_args[0]+"${agent_args[@]}"} || rc=$?
    fi
else
    # ${arr[0]+-- "${arr[@]}"} expands to nothing at all when the array is empty,
    # rather than to one empty string - so no stray "--" reaches the agent.
    dr_sbx run --name "$DRAUGR_SANDBOX" \
        ${agent_args[0]+-- "${agent_args[@]}"} || rc=$?
fi

# The agent exiting is normal, and so is a non-zero code from it, so neither is
# reported as a Draugr failure. What matters is that we are back on the host.
rc=${rc:-0}
dr_info "left $DRAUGR_SANDBOX"
dr_hook post-attach "$DR_REPO"

# Fetch what the agent committed, while you are still thinking about it. It only
# fetches - nothing is merged and your branch does not move - so the worst case
# is a few seconds and a remote-tracking branch you ignore.
if dr_is_true "$DRAUGR_AUTO_SYNC" && [ -x "$_dr_bin/dr-sync" ]; then
    "$_dr_bin/dr-sync" || dr_warn "auto-sync failed; fetch by hand with:  dr-sync"
fi

# Memory out, while the mound is certainly still alive. This is the half of
# DRAUGR_MEM_SYNC that matters: the import can always be repeated, but anything
# the agent learned this session exists only inside the mound until now, and
# dr-rm would take it with no way to get it back.
if [ "$DRAUGR_MEM_SYNC" = auto ] && [ -x "$_dr_bin/dr-mem" ]; then
    "$_dr_bin/dr-mem" export --yes || dr_warn "auto memory export failed; retry with:  dr-mem export"
fi

# A pull overwrites host files with the sandbox's, so it is opt-in per the
# config and never the default. --yes because you are being handed back a
# terminal, not asked a question you were expecting.
if [ "$DRAUGR_DATA_PULL" = auto ] && [ -n "$DRAUGR_DATA" ] && [ -x "$_dr_bin/dr-data" ]; then
    "$_dr_bin/dr-data" pull --yes || dr_warn "auto data pull failed; retry with:  dr-data pull"
fi

# Last of all, because everything above needs the mound alive: the sync, the
# memory export and the data pull all talk to it. Stopping first would turn each
# of them into a four-second restart, or a failure.
#
# Off by default. Stopping is hygiene rather than durability - what protects the
# agent's work is the sync that has just run - and it silently kills anything the
# kit starts through publishedPorts or startup commands. Worth opting into for a
# project that serves nothing; the mound holds around 1.4 GB while it idles.
if dr_is_true "$DRAUGR_STOP_ON_EXIT"; then
    # Not fatal. The session is over and the work is already fetched, so a mound
    # that will not stop is untidy rather than dangerous.
    if dr_sbx stop "$DRAUGR_SANDBOX" >/dev/null 2>&1; then
        dr_ok "stopped $DRAUGR_SANDBOX (DRAUGR_STOP_ON_EXIT)"
    else
        dr_warn "could not stop $DRAUGR_SANDBOX - it is still running"
    fi
else
    dr_info "$DRAUGR_SANDBOX is still running - dr-stop to shut it down"
fi

exit "$rc"
