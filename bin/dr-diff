#!/usr/bin/env bash
# dr-diff - review what the agent actually changed, properly.
#
# Uses the three-dot form, HEAD...draugr/<branch>, which diffs from where the two
# diverged. That matters once you have committed on the host as well: two-dot
# would also show your own commits, inverted, as though the agent had reverted
# them. Three-dot shows only the agent's work.
#
#   dr-diff                  the whole change
#   dr-diff --stat           just the shape of it
#   dr-diff -- src/foo.py    one path
set -euo pipefail

DR_PROG=dr-diff
# readlink -f first: install.sh links this into ~/.local/bin by default, and
# through a link BASH_SOURCE is the LINK, so ../lib would be ~/.local/lib.
_dr_bin=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$_dr_bin/../lib/common.sh"

case "${1:-}" in
    -h|--help) dr_help "$0"; exit 0 ;;
esac

dr_context
dr_require_tracking_ref
tracking=$(dr_tracking_ref)

exec git -C "$DR_REPO" diff "HEAD...$tracking" "$@"
