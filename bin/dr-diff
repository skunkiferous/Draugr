#!/usr/bin/env bash
# dr-diff: review what the agent changed.
#
# It uses the three-dot form, HEAD...draugr/<branch>. That diff starts where the
# two branches split. If you also commit on the host, this is important. The
# two-dot form then shows your commits inverted, like a revert by the agent.
# The three-dot form shows only the work of the agent.
#
#   dr-diff                  the whole change
#   dr-diff --stat           only a summary
#   dr-diff -- src/foo.py    one path
set -euo pipefail

DR_PROG=dr-diff
# readlink -f comes first. install.sh links this file into ~/.local/bin, and
# through a link BASH_SOURCE is the LINK. Without it, ../lib is ~/.local/lib.
_dr_bin=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$_dr_bin/../lib/common.sh"

case "${1:-}" in
    -h|--help) dr_help "$0"; exit 0 ;;
esac

dr_context
dr_require_tracking_ref
tracking=$(dr_tracking_ref)

exec git -C "$DR_REPO" diff "HEAD...$tracking" "$@"
