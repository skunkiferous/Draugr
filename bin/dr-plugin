#!/usr/bin/env bash
# dr-plugin - manage the plugin library every mound reads, without ever
# installing a plugin on your host.
#
#   dr-plugin                          what the library holds, and whether it is wired up
#   dr-plugin list                     the plugins in it, with versions
#   dr-plugin skills                   the skills those plugins ship, and from which
#   dr-plugin kit [<plugin>@<mkt>...]  write the per-mound install out as a kit
#   dr-plugin add <owner>/<repo> [<plugin>...]  register the MARKETPLACE, install, enable
#   dr-plugin update [<plugin>@<mkt>]  all of them, or one
#   dr-plugin remove <plugin>@<mkt>    uninstall, deregister, disable
#   dr-plugin enable <plugin>@<mkt>    the switch only - no mound, instant
#   dr-plugin disable <plugin>@<mkt>   likewise
#   dr-plugin clean                    drop superseded versions that nothing reaps
#   dr-plugin rollback                 put the previous library back
#
# `add` takes a MARKETPLACE, not a plugin. It registers the repository and then
# installs what that marketplace lists - all of it, or only the plugins you name
# after it - so there is no separate step for adding a marketplace. The name it
# registers under is discovered rather than typed, because a repository decides
# that for itself: obra/superpowers arrives as superpowers-marketplace. A plugin
# you name may therefore be bare, and gets completed with whatever appeared - or,
# on a REPEAT add, where nothing appears because the marketplace is registered
# already, with the name the registry holds for that source.
#
# A plugin is code that runs - hooks fire on session start, MCP servers are
# processes, bin/ lands on the Bash tool's PATH. So the rule is the one in
# docs/CLAUDE_PLUGINS.md: your host STORES plugin bytes and never RUNS them.
# Every install here happens inside a throwaway mound, and the host only ever
# receives files.
#
# The three verbs that need a mound build it fresh and destroy it afterwards.
# They work on a copy at $DRAUGR_PLUGIN_STORE/.build and swap it into place at
# the end, so the library your mounds are reading is never the one being edited,
# a failed build changes nothing, and the previous one stays as seed.old.
#
# WHY A COPY AND A SWAP, rather than editing the library in place: sbx bind-mounts
# a sandbox workspace read-write, so plugin install code would be writing into the
# directory that is mounted into every mound on this machine. One bad install
# could rewrite plugins you trust. Building beside it costs a copy and removes
# that entirely.
#
# WHY THE WORK HAPPENS IN THE MOUND'S ROOTFS and not straight on that copy:
# a Windows-backed workspace cannot rename a git clone. Measured, in a mound,
# on the bind-mounted workspace:
#
#   git clone -q https://github.com/… X   -> clone: OK
#   mv X Y                                -> cannot move 'X' to 'Y': Permission denied
#
# while renaming a plain directory in the same place succeeds, and both succeed
# in the rootfs. `claude plugin marketplace add` clones to a temporary name and
# renames it into place, so it fails there and `remove`, which only deletes,
# does not - the worst possible split. So the library is copied into
# /home/agent/seed, worked on with full POSIX semantics, and copied back out
# afterwards with cp -a, which only ever creates.
#
# Note what is still absent: dr-cp. `sbx cp` extracts a tar and therefore MERGES,
# which is what makes a manual update accumulate versions for ever and a manual
# removal reclaim nothing. Every copy here is cp -a onto a path that was just
# deleted, so it is exact.
#
# Set DRAUGR_PLUGIN_STORE to a directory on a Windows drive, then point your
# mounds at it - `dr-plugin` with no arguments prints the three lines to add.
#
# shellcheck disable=SC2016
# Single-quoted "$1" appears in the copy helpers and is deliberate: those strings
# are scripts for the MOUND's shell, and the whole point is that the host does
# not expand them.
set -euo pipefail

DR_PROG=dr-plugin
# readlink -f first: install.sh links this into ~/.local/bin by default, and
# through a link BASH_SOURCE is the LINK, so ../lib would be ~/.local/lib.
_dr_bin=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$_dr_bin/../lib/common.sh"

# status is the default because it is the only verb that moves nothing, and
# "what have I actually got" is the question you have first. Same reasoning as
# dr-mem.
action=${1:-status}
case "$action" in
    -h|--help) dr_help "$0"; exit 0 ;;
    status|list|skills|kit|add|update|remove|enable|disable|clean|rollback) shift || : ;;
    *) dr_die "unknown action: $action" \
              "One of: status, list, skills, kit, add, update, remove, enable," \
              "disable, clean, rollback" ;;
esac

# Options are read once for every verb rather than per verb: rejecting --yes on
# a verb that does not prompt would be noise, and the positional arguments differ
# enough that a shared parser is simpler than eight of them.
force=
args=()
while [ $# -gt 0 ]; do
    case "$1" in
        -y|--yes)  DR_ASSUME_YES=1 ;;
        --force)   force=1 ;;
        -h|--help) dr_help "$0"; exit 0 ;;
        -*) dr_die "unknown option: $1" "Try: dr-plugin --help" ;;
        *) args+=("$1") ;;
    esac
    shift
done

dr_context

# The library layout is the agent's, not Draugr's, and only Claude Code's has
# been measured. Refusing beats building a directory in a shape the agent will
# never read - and unlike a wrong memory copy, a wrong plugin library would put
# third-party code somewhere every mound on the machine mounts.
dr_agent_plugin_supported || dr_die \
    "Draugr does not know how ${DRAUGR_AGENT:-this agent} keeps plugins" \
    "Plugin layout is per-agent and only measured ones are offered." \
    "Known: $(dr_agent_known). See docs/CLAUDE_PLUGINS.md."

# Empty by default, so the feature is off until it is configured. There is no
# sensible location to invent: it has to be mountable into a mound, and $HOME
# under WSL is not on a Windows drive.
[ -n "$DRAUGR_PLUGIN_STORE" ] || dr_die \
    "DRAUGR_PLUGIN_STORE is not set" \
    "It names the directory holding the plugins every mound reads. Put it on a" \
    "Windows drive so a mound can be pointed at it, then add this line to" \
    "your ~/.config/draugr/config:" \
    '  DRAUGR_PLUGIN_STORE="/mnt/c/Code/claude-plugins"'

# sbx.exe is a Windows binary and its workspaces are Windows paths, so a store on
# WSL's own filesystem could never be mounted into a mound. Better to say so here
# than to fail later inside sbx with a path nobody typed.
dr_require_win_path "$DRAUGR_PLUGIN_STORE"

# The layout, in one place. `seed` is the name Claude Code's own documentation
# uses for a pre-built plugin library, and the mounds read it through
# DRAUGR_MOUNTS, so it is a published name rather than an internal one.
STORE=$DRAUGR_PLUGIN_STORE
SEED="$STORE/seed"
PREV="$STORE/seed.old"
BUILD="$STORE/.build"
SETTINGS="$STORE/settings.json"
BUILD_SANDBOX=draugr-plugin-build
# Where the CLI actually works, inside the mound. Rootfs, so that a git clone can
# be renamed - see the header.
WORK=/home/agent/seed

# Force github to HTTPS for every git the plugin CLI runs.
#
# WHY: a mound has no SSH key and must not be given one, but `claude plugin
# install` clones a github plugin source over SSH and does NOT fall back -
# unlike `claude plugin marketplace add`, which prints "SSH not configured,
# cloning via HTTPS" and retries. Measured against iha2/superlite: the
# marketplace cloned fine over HTTPS and the install then died with
# "Connection closed by 140.82.121.4 port 22", which is what GitHub says to an
# SSH client it cannot authenticate. Egress was never the problem.
#
# GIT_CONFIG_COUNT rather than `git config --global`: this rides on the env that
# build_run is already setting, so nothing has to guess which HOME the CLI runs
# under, no file is written into the mound, and the redirect reaches every git
# the CLI spawns. insteadOf is multi-valued, so both spellings share one key.
#
# It can only widen what works: an SSH clone could never have succeeded in here.
_DR_GIT_HTTPS=(
    GIT_CONFIG_COUNT=2
    "GIT_CONFIG_KEY_0=url.https://github.com/.insteadOf"
    "GIT_CONFIG_VALUE_0=git@github.com:"
    "GIT_CONFIG_KEY_1=url.https://github.com/.insteadOf"
    "GIT_CONFIG_VALUE_1=ssh://git@github.com/"
)

# Which variables redirect this agent's library. Both come from the agent module
# because they are its private business - see lib/agents/claude.sh.
CACHE_VAR=$(dr_agent_plugin_cache_var)
SEED_VAR=$(dr_agent_plugin_seed_var)

# --- reading the library ------------------------------------------------------

# The three files the library is made of. Absent is normal before the first add,
# so every reader answers empty rather than failing.
marketplaces() {
    [ -f "$SEED/known_marketplaces.json" ] || return 0
    jq -r '. // {} | keys[]' "$SEED/known_marketplaces.json" 2>/dev/null || true
}

# The same, against the copy being built, before any mound has touched it.
build_marketplaces() {
    [ -f "$BUILD/seed/known_marketplaces.json" ] || return 0
    jq -r '. // {} | keys[]' "$BUILD/seed/known_marketplaces.json" 2>/dev/null || true
}

# work_cat <relative path> - one file out of the working copy INSIDE the mound.
#
# The host's build directory is a snapshot from before the CLI ran, so anything
# decided from what an operation actually did has to be read from here instead.
work_cat() {
    dr_sbx exec "$BUILD_SANDBOX" cat "$WORK/$1" 2>/dev/null || true
}

# What the mound's copy has registered. `add` needs it to see what a marketplace
# called itself, which is not derivable from the source: obra/superpowers
# registers as superpowers-marketplace.
work_marketplaces() {
    work_cat known_marketplaces.json | jq -r '. // {} | keys[]' 2>/dev/null || true
}

# "<id> <version>" a line. The id is already <plugin>@<marketplace>, which is the
# spelling every other command here takes.
installed() {
    [ -f "$SEED/installed_plugins.json" ] || return 0
    jq -r '.plugins // {} | to_entries[] | "\(.key) \(.value[0].version // "?")"' \
        "$SEED/installed_plugins.json" 2>/dev/null || true
}

# Enabled is a different question from installed - the seed carries content, the
# settings file carries the decision - and dr-plugin reports both because a
# plugin that is one and not the other is the confusing case.
#
# Space separated on ONE line, because every caller tests membership with a
# `case " $list " in *" $id "*` and a newline between two ids would defeat the
# space either side of the pattern.
enabled_ids() {
    [ -f "$SETTINGS" ] || return 0
    jq -r '.enabledPlugins // {} | to_entries[] | select(.value) | .key' \
        "$SETTINGS" 2>/dev/null | tr '\n' ' ' || true
}

# marketplace_for_source <owner>/<repo> - the name that source is ALREADY
# registered under, or empty.
#
# `add` discovers a marketplace's name by watching for one to APPEAR, which
# answers nothing on a second add: the marketplace is already there, so nothing
# appears - and that name is exactly what the refusal then needs in order to say
# anything useful. The registry records each source, so it can simply be asked.
marketplace_for_source() {
    [ -f "$SEED/known_marketplaces.json" ] || return 0
    # shellcheck disable=SC2016  # $src is jq's variable, not the shell's
    jq -r --arg src "$1" \
        '. // {} | to_entries[] | select(.value.source.repo == $src) | .key' \
        "$SEED/known_marketplaces.json" 2>/dev/null | head -1 || true
}

# installed_from <marketplace> - "<id> <version> enabled|disabled" a line, for
# whatever the library already holds from that marketplace.
#
# Both halves, because installed and enabled are different questions and a
# plugin that is one but not the other is the confusing case - the same reason
# `dr-plugin list` prints both.
installed_from() {
    local mkt=$1 en id ver
    en=$(enabled_ids)
    while read -r id ver; do
        [ -n "$id" ] || continue
        case "$id" in *"@$mkt") ;; *) continue ;; esac
        case " $en " in
            *" $id "*) printf '%s %s enabled\n'  "$id" "$ver" ;;
            *)         printf '%s %s disabled\n' "$id" "$ver" ;;
        esac
    done < <(installed)
}

# --- the switch ---------------------------------------------------------------

# settings_write <id> <true|false|drop> - the enable decision, host-side only.
#
# Written through a temporary file and moved into place: settings.json is read by
# every mound at every attach, and a half-written one would take them all down.
settings_write() {
    local id=$1 how=$2 tmp filter
    [ -f "$SETTINGS" ] || printf '{\n  "enabledPlugins": {}\n}\n' > "$SETTINGS"

    # shellcheck disable=SC2016  # $id and $v are jq's variables, not the shell's
    case "$how" in
        drop) filter='.enabledPlugins |= (. // {} | del(.[$id]))' ;;
        *)    filter='.enabledPlugins |= ((. // {}) + {($id): ($v == "true")})' ;;
    esac

    tmp=$(mktemp)
    jq --arg id "$id" --arg v "$how" "$filter" "$SETTINGS" > "$tmp" \
        || dr_die "could not update $SETTINGS"
    mv "$tmp" "$SETTINGS"
}

# --- the build transaction ----------------------------------------------------

# build_begin - a fresh copy of the library to work on.
#
# cp -a on the host rather than dr-cp through the mound. That is the whole reason
# this command exists: `sbx cp` extracts a tar, so it MERGES directories and
# replaces same-named files, which means a copy back over the library adds and
# never removes. A host-side copy is exact, so an uninstall really uninstalls.
build_begin() {
    rm -rf "$BUILD"
    mkdir -p "$BUILD"
    if [ -d "$SEED" ]; then
        # Announced because it is slow and was silent. A library of three plugins
        # measures 43 MB over 4581 files, most of it the marketplaces' own git
        # clones, and it is being copied on a WINDOWS drive. Before this the
        # command printed nothing at all for the first several seconds, with
        # nothing to say which of its three slow steps was running.
        dr_info "copying the library aside to work on ($SEED)"
        cp -a "$SEED" "$BUILD/seed"
    else
        mkdir -p "$BUILD/seed"
    fi
    build_repath
}

# build_repath - point installed_plugins.json at where the library will be WORKED
# ON, which is the rootfs path rather than either the store or the build copy.
#
# Every entry records an ABSOLUTE installPath - measured, e.g.
# /home/agent/seed/cache/claude-code-plugins/commit-commands/1.0.0 - so a library
# copied anywhere else carries paths that do not exist. Rewriting after every
# copy makes the first migration from a hand-built seed and every later run the
# same case, which is cheaper than having two.
#
# Done on the host, where jq is known to exist, rather than inside the mound.
build_repath() {
    local f="$BUILD/seed/installed_plugins.json" mound tmp
    [ -f "$f" ] || return 0
    mound=$WORK

    # Keep everything from /cache/ onwards and re-root it: that tail is the only
    # part of the path the layout guarantees, so this works whatever directory
    # the library was built in before.
    # shellcheck disable=SC2016  # $root is jq's variable, not the shell's
    tmp=$(mktemp)
    jq --arg root "$mound" '
        .plugins |= ((. // {}) | map_values(map(
            .installPath |= ($root + (. | sub("^.*/cache/"; "/cache/")))
        )))' "$f" > "$tmp" || dr_die "could not rewrite installPath in $f"
    mv "$tmp" "$f"
}

# build_run <verb> [arg...] - one plugin CLI operation, inside a throwaway mound.
#
# The mound's workspace IS the build directory, bind-mounted read-write, so the
# CLI writes its results straight to the host and nothing has to be copied back.
# The trap is what makes "throwaway" true even when the operation fails.
build_run() {
    local argv=() line
    while IFS= read -r line; do argv+=("$line"); done < <(dr_agent_plugin_cli "$@")
    [ ${#argv[@]} -gt 0 ] || dr_die "no command for plugin verb: $1"

    # env rather than a quoted command line: dr_agent_plugin_cli hands back one
    # word a line precisely so that nothing here has to re-split a string.
    build_mound_start
    dr_info "${argv[*]}"
    # </dev/null because sbx exec CONSUMES STDIN. Without it, a caller looping
    # over `installed()` has the rest of its list eaten by the first iteration -
    # measured as an `update` that reported success having touched exactly one
    # plugin of three, which is the worst way for this to be wrong.
    dr_sbx exec "$BUILD_SANDBOX" env "$CACHE_VAR=$WORK" "${_DR_GIT_HTTPS[@]}" \
        "${argv[@]}" </dev/null \
        || dr_die "plugin command failed: ${argv[*]}" \
                  "The library was not changed - $SEED is untouched."
}

# build_harvest - the finished library, back onto the workspace and so onto the
# host. rm then cp -a, never a merge: what comes out is exactly what is in the
# mound, which is what makes an uninstall actually remove something.
build_harvest() {
    local mount; mount=$(dr_path_mound "$BUILD/seed")
    dr_sbx exec "$BUILD_SANDBOX" sh -c \
        'rm -rf "$1" && cp -a "$2" "$1"' sh "$mount" "$WORK" \
        || dr_die "could not carry the built library back out"
}

# build_mound_start - create it once per run, and arrange for it to go away.
#
# A pre-existing one is a crashed run rather than something to reuse: its
# workspace is a build directory this run has already deleted, so it would be
# pointed at nothing. Refusing names --force instead of guessing.
build_mound_start() {
    [ -z "${_dr_mound_up:-}" ] || return 0

    # --force removes it rather than adopting it: adopting would run the install
    # inside a mound whose workspace this run has already deleted.
    if dr_sandbox_exists "$BUILD_SANDBOX"; then
        [ -n "$force" ] || dr_die \
            "$BUILD_SANDBOX already exists" \
            "A previous dr-plugin run did not clean up, or one is running now." \
            "If nothing else is running:  dr-plugin $action --force"
        dr_sbx rm --force "$BUILD_SANDBOX" >/dev/null 2>&1 || :
    fi

    # The trap goes on BEFORE the create, so a mound that comes up and then fails
    # something later is still removed. No kit, no ports, no clone: this mound
    # exists to run one CLI against one directory.
    trap build_mound_stop EXIT INT TERM
    # Naming the step rather than just the sandbox: creating a microVM takes
    # seconds and says nothing while it does.
    dr_info "creating the build mound $BUILD_SANDBOX"
    dr_sbx create --name "$BUILD_SANDBOX" -q "$DRAUGR_AGENT" "$(dr_path_win "$BUILD")" \
        || dr_die "could not create the build mound" \
                  "Check that sbx works:  dr-doctor"
    _dr_mound_up=1

    # The working copy, in the rootfs, for the rename reason in the header. The
    # third of the slow steps, and the third that used to be silent.
    dr_info "staging the library into the mound's rootfs"
    dr_sbx exec "$BUILD_SANDBOX" sh -c \
        'rm -rf "$1" && cp -a "$2" "$1"' sh "$WORK" "$(dr_path_mound "$BUILD/seed")" \
        || dr_die "could not stage the library inside $BUILD_SANDBOX"
}

# A warning rather than a failure: by the time this runs the work is either
# committed or abandoned, and exiting non-zero here would report the wrong thing.
build_mound_stop() {
    [ -n "${_dr_mound_up:-}" ] || return 0
    _dr_mound_up=
    dr_sbx rm --force "$BUILD_SANDBOX" >/dev/null 2>&1 \
        || dr_warn "could not remove $BUILD_SANDBOX - remove it with: dr-rm --force"
}

# build_commit - the swap, which is the only moment the live library changes.
#
# mv rather than a copy, so it is as close to atomic as a directory gets: a mound
# reads the library at startup, and there is no window in which it would see half
# of one. The previous library stays as seed.old for `dr-plugin rollback`.
build_commit() {
    # Harvest first when a mound did the work; verbs that only touched the host
    # copy have nothing to bring back.
    if [ -n "${_dr_mound_up:-}" ]; then
        build_harvest
    fi
    [ -d "$BUILD/seed" ] || dr_die "nothing was built"
    rm -rf "$PREV"
    # An `if` rather than `[ ] && mv`, which under set -e would exit the script
    # the first time there was no library to move aside - i.e. on the first add.
    if [ -d "$SEED" ]; then
        mv "$SEED" "$PREV"
    fi
    mv "$BUILD/seed" "$SEED"
    rm -rf "$BUILD"
    dr_ok "library updated - previous one kept as $PREV"
}

case "$action" in

# --- status -------------------------------------------------------------------
status)
    dr_heading "library"
    printf '  %s\n' "$STORE" >&2
    if [ ! -d "$SEED" ]; then
        printf '  %s\n' "empty - add one with:  dr-plugin add <owner>/<repo>" >&2
    fi

    # Marketplaces and plugins are listed separately because the seed supplies
    # the first and not the second: a marketplace with no plugin under it is the
    # normal state after a manual `marketplace add`, not a fault.
    _m=$(marketplaces)
    if [ -n "$_m" ]; then
        dr_heading "marketplaces"
        # sed rather than printf: the list is one name a line, and printf would
        # indent only the first of them.
        printf '%s\n' "$_m" | sed 's/^/  /' >&2
    fi

    _enabled=$(enabled_ids)
    if [ -n "$(installed)" ]; then
        dr_heading "plugins"
        while read -r _id _ver; do
            [ -n "$_id" ] || continue
            # "enabled" is what the settings file says, and a plugin that is
            # installed but not enabled does nothing at all - worth seeing.
            case " $_enabled " in
                *" $_id "*) _state="enabled" ;;
                *)          _state="INSTALLED, NOT ENABLED" ;;
            esac
            printf '  %-45s %-8s %s\n' "$_id" "$_ver" "$_state" >&2
        done < <(installed)
    fi

    # The library is useless until the mounds are pointed at it, and that is
    # three settings in a file this command does not own. Checking them here is
    # the only place the two halves meet.
    dr_heading "wiring"
    _seed_mound=$(dr_path_mound "$SEED")
    _set_mound=$(dr_path_mound "$SETTINGS")
    _args_key=$(dr_agent_args_key "$DRAUGR_AGENT")
    _want_mount="$STORE:ro"
    _missing=()
    case " $DRAUGR_MOUNTS " in *" $_want_mount "*) ;; *) _missing+=(mount) ;; esac
    case " $DRAUGR_ENV " in *"$SEED_VAR=$_seed_mound"*) ;; *) _missing+=(env) ;; esac
    case " ${!_args_key:-} " in *"--settings $_set_mound"*) ;; *) _missing+=(args) ;; esac

    # Printing the exact lines rather than "see the docs": the last of the three
    # is per-agent, and its name is one nobody guesses on the first try.
    if [ ${#_missing[@]} -eq 0 ]; then
        printf '  %s\n' "all three settings point at this library" >&2
    else
        printf '  %s\n' "not wired up (${_missing[*]}). Add to ~/.config/draugr/config:" >&2
        printf '    DRAUGR_MOUNTS="%s"\n'     "$_want_mount" >&2
        printf '    DRAUGR_ENV="%s=%s"\n'     "$SEED_VAR" "$_seed_mound" >&2
        printf '    %s="--settings %s"\n'     "$_args_key" "$_set_mound" >&2
        printf '  %s\n' "DRAUGR_MOUNTS and DRAUGR_ENV are single strings that a project config" >&2
        printf '  %s\n' "REPLACES rather than adds to. Append if you already set them." >&2
    fi
    ;;

# --- list ---------------------------------------------------------------------
list)
    _enabled=$(enabled_ids)
    while read -r _id _ver; do
        [ -n "$_id" ] || continue
        case " $_enabled " in
            *" $_id "*) _state=enabled ;;
            *)          _state=disabled ;;
        esac
        printf '%s %s %s\n' "$_id" "$_ver" "$_state"
    done < <(installed)
    ;;

# --- skills -------------------------------------------------------------------
#
# A plugin's skills are NOT in the shared skills store and never will be: they
# load from the plugin itself. dr-skills reports the same list under a heading of
# its own, and the walk they share is dr_plugin_skills in lib/common.sh.
skills)
    _rows=$(dr_plugin_skills "$STORE")
    # Nothing is a normal answer, not a fault: plenty of plugins ship no skill.
    [ -n "$_rows" ] || { dr_info "no installed plugin ships a skill"; exit 0; }

    # Content on stdout, like `list`, so a pipe keeps it. See dr-status.
    printf '%s\n' "$_rows" | while read -r _s _id _v; do
        printf '%-32s %s %s\n' "$_s" "$_id" "$_v"
    done
    ;;

# --- kit ----------------------------------------------------------------------
#
# The seed removes the marketplace add and the network fetch. It does not remove
# the INSTALL, which lands in each mound's own rootfs and dies with dr-rm - and
# that one repeated step is what this writes out as a kit.
#
# ONE KIT PER PLUGIN, because sbx can only ADD a kit to a running mound. A single
# combined kit would have to be EDITED whenever a plugin was added, and an edited
# kit needs dr-up --recreate; separate kits make adding a plugin an append, which
# is the one change that applies in place.
#
# NO VERSION IS PINNED. The install line names <plugin>@<marketplace> and nothing
# more, so it resolves against whatever the seed holds when a mound is created.
# That is what keeps `dr-plugin update` and this verb independent: after an update
# the same kit installs the new version. See docs/CLAUDE_PLUGINS.md.
kit)
    # The kit runs INSIDE a mound, so the seed has to be named in the mound's
    # spelling - the same translation `status` checks the wiring against.
    _seed_mound=$(dr_path_mound "$SEED") || dr_die \
        "the seed is not on a Windows drive, so no mound could be pointed at it" \
        "  $SEED"
    _ks=$(dr_kit_store)

    # With nothing named, every installed plugin - the same shape as `add`: all
    # of it, or only the ones you name.
    _want=()
    if [ ${#args[@]} -gt 0 ]; then
        _want=("${args[@]}")
    else
        while read -r _id _; do
            [ -n "$_id" ] && _want+=("$_id")
        done < <(installed)
    fi
    [ ${#_want[@]} -gt 0 ] || dr_die "no plugin is installed" \
        "Add one first:  dr-plugin add <owner>/<repo>"

    mkdir -p "$_ks"
    _made=()
    for _p in "${_want[@]}"; do
        # Installed is the precondition, and the version is read only to prove
        # it - nothing written below records a version.
        _ver=$(installed | awk -v id="$_p" '$1 == id {print $2; exit}')
        [ -n "$_ver" ] || dr_die "not installed: $_p" \
            "A kit can only install what the seed holds, and the id is in full," \
            "as <plugin>@<marketplace>. See what there is:  dr-plugin list"

        # sbx constrains `name` to lowercase alphanumeric and hyphens, so the
        # plugin half of the id is slugged rather than used as it stands.
        _slug=plugin-$(printf '%s' "${_p%@*}" | tr '[:upper:]' '[:lower:]' \
            | tr -cs 'a-z0-9' '-')
        _slug=${_slug%-}
        _dir="$_ks/$_slug"

        # A kit already in the library may have been edited by hand, so
        # replacing one is a decision rather than a detail.
        if [ -d "$_dir" ] && [ -z "$force" ]; then
            dr_warn "$_slug is already in the kit library"
            printf '  %s%s%s\n' "$_DR_DIM" "$_dir/spec.yaml" "$_DR_OFF" >&2
            dr_confirm "Overwrite it?" || { dr_info "kept $_slug"; continue; }
        fi

        # Unquoted heredoc: the id, the slug and the seed path are substituted,
        # and there is nothing else in here that a shell would touch.
        mkdir -p "$_dir"
        cat > "$_dir/spec.yaml" <<YAML
schemaVersion: "2"
kind: mixin
name: $_slug
displayName: Install $_p into the mound
description: >-
  Generated by dr-plugin kit. Installs the plugin named below from the seed as
  the mound is created. No version is pinned: it resolves against whatever the
  seed holds, so dr-plugin update needs no regeneration here.

commands:
  install:
    - command: "env HOME=/home/agent $SEED_VAR=$_seed_mound claude plugin install $_p -y"
      user: "1000"
      description: Install $_p from the seed, with no marketplace add and no clone
YAML
        _made+=("$_slug")
        dr_ok "wrote $_dir/spec.yaml  ($_p $_ver)"
    done

    # Nothing to say if every kit was already there and kept.
    [ ${#_made[@]} -gt 0 ] || exit 0

    # Draugr does not parse kit YAML - sbx does - so dr-kit is the authority on
    # whether what was just written is valid, not this command.
    dr_info "validate it, then add it to a project's kit list:"
    printf '  dr-kit validate\n' >&2
    printf '  DRAUGR_KIT=".draugr/kit %s"\n' "${_made[*]}" >&2

    # Both halves, because only one of them is measured: a kit added to the end
    # of the list can be applied to a running mound, but whether commands.install
    # runs on apply or only at creation is still open.
    printf '  %sA mound built from now on installs it as it is created. For the one\n' "$_DR_DIM" >&2
    printf '  you are in, "dr-kit apply" adds the kit in place - then confirm with\n' >&2
    printf '  "dr-shell -- claude plugin list", and install once by hand if it is\n' >&2
    printf '  absent. See docs/CLAUDE_PLUGINS.md.%s\n' "$_DR_OFF" >&2
    ;;

# --- add ----------------------------------------------------------------------
add)
    [ ${#args[@]} -ge 1 ] || dr_die "add needs a marketplace" \
        "  dr-plugin add <owner>/<repo>               every plugin the marketplace lists" \
        "  dr-plugin add <owner>/<repo> <plugin>...   only the ones you name"
    _source=${args[0]}

    build_begin
    # What a repository registers ITSELF as is its own business - "obra/superpowers"
    # arrives as "superpowers-marketplace" - so the name is discovered by watching
    # what appeared rather than derived from what was typed.
    _before=$(build_marketplaces)
    build_run market-add "$_source"
    _mkt=$(comm -13 <(printf '%s\n' "$_before" | sort) \
                    <(work_marketplaces | sort) | head -1)

    # Nothing NEW is not the same as nothing there: a repeat add registers no
    # marketplace because the library already holds it. Discovery cannot name it
    # - it watches for an arrival - so the registry is asked instead, which is
    # what turns both refusals below into answers rather than dead ends.
    _known=
    [ -n "$_mkt" ] || _known=$(marketplace_for_source "$_source")

    # With no plugin named, install everything the new marketplace offers. Its
    # catalogue is on disk by now, because market-add cloned it.
    if [ ${#args[@]} -ge 2 ]; then
        # A bare name is completed with the marketplace this add discovered, or
        # failing that the one the registry already holds for this source.
        # Demanding <plugin>@<marketplace> up front would be asking for a name a
        # FIRST add cannot know - and a repeat add knows only via the registry.
        _plugins=()
        for _p in "${args[@]:1}"; do
            case "$_p" in
                *@*) _plugins+=("$_p") ;;
                *)   _m=${_mkt:-$_known}
                     [ -n "$_m" ] || dr_die \
                         "cannot tell which marketplace $_p belongs to" \
                         "$_source registered nothing new, and no registered marketplace" \
                         "names that source either. Give the full id:" \
                         "  dr-plugin add $_source <plugin>@<marketplace>" \
                         "The registered names are listed by:  dr-plugin"
                     _plugins+=("$_p@$_m") ;;
            esac
        done
    else
        # Nothing new is not a failure to report as one. The advice that used to
        # stand here sent you to `dr-plugin add <source> <plugin>`, which the
        # bare-name branch above then refused over the very same missing name.
        if [ -z "$_mkt" ]; then
            [ -n "$_known" ] || dr_die \
                "$_source registered no new marketplace" \
                "No registered marketplace names that source either, so there is" \
                "nothing here to install from." \
                "The registered names are listed by:  dr-plugin"

            # Registered already, so this is a repeat: report what is there, and
            # name the verb that acts on it.
            mapfile -t _have < <(installed_from "$_known")
            [ ${#_have[@]} -gt 0 ] || dr_die \
                "$_source is already registered, as $_known" \
                "Nothing from it is installed yet. Name what you want:" \
                "  dr-plugin add $_source <plugin>@$_known"
            dr_die "$_source is already registered, as $_known" \
                "Installed from it:" \
                "${_have[@]/#/  }" \
                "To refresh it:    dr-plugin update <plugin>@$_known" \
                "To add another:   dr-plugin add $_source <plugin>@$_known"
        fi
        mapfile -t _plugins < <(work_cat "marketplaces/$_mkt/.claude-plugin/marketplace.json" \
            | jq -r '.plugins[]?.name' 2>/dev/null)
        [ ${#_plugins[@]} -gt 0 ] || dr_die "no plugins listed in $_mkt"
        _plugins=("${_plugins[@]/%/@$_mkt}")
    fi

    for _p in "${_plugins[@]}"; do build_run install "$_p"; done
    build_commit
    # Enabling last, and only after the swap: a switch pointing at a plugin the
    # library does not have is a lie, and the swap is the moment it does.
    for _p in "${_plugins[@]}"; do
        settings_write "$_p" true
        dr_ok "enabled $_p"
    done
    ;;

# --- update -------------------------------------------------------------------
update)
    build_begin
    # marketplace update refreshes the catalogues; plugin update acts on what
    # they now offer. Doing the first unconditionally means "update" means the
    # same thing whether or not a plugin was named.
    build_run market-update ""
    if [ ${#args[@]} -ge 1 ]; then
        for _p in "${args[@]}"; do build_run update "$_p"; done
    else
        # The whole list first, then the loop. Reading it as the loop runs would
        # put a command that touches stdin inside the pipeline feeding it - see
        # the redirect in build_run.
        mapfile -t _ids < <(installed | cut -d' ' -f1)
        for _id in "${_ids[@]}"; do
            [ -n "$_id" ] || continue
            build_run update "$_id"
        done
    fi
    build_commit
    dr_info "superseded versions are not reaped by the CLI - run: dr-plugin clean"
    ;;

# --- remove -------------------------------------------------------------------
remove)
    [ ${#args[@]} -ge 1 ] || dr_die "remove needs a plugin" \
        "  dr-plugin remove <plugin>@<marketplace>" \
        "See what is installed with:  dr-plugin list"

    build_begin
    for _p in "${args[@]}"; do
        build_run uninstall "$_p"

        # The marketplace goes too when nothing else came from it. Leaving it
        # would keep a catalogue registered in every mound for no plugin, and
        # the clone it brought with it on disk.
        _mkt=${_p#*@}
        _left=$(work_cat installed_plugins.json | jq -r --arg m "$_mkt" \
            '[.plugins // {} | keys[] | select(endswith("@" + $m))] | length' \
            2>/dev/null || echo 1)
        if [ "$_left" = 0 ]; then
            build_run market-remove "$_mkt"
        fi
    done
    build_commit
    for _p in "${args[@]}"; do settings_write "$_p" drop; done

    # A generated kit installs this plugin by name, and the plugin is now gone
    # from the seed - so that kit would send a mound to the network for it, or
    # fail. Reported, NOT deleted: a kit in your library may have been edited
    # since it was generated, and removing a plugin is not consent to discard it.
    _ks=$(dr_kit_store)
    if [ -d "$_ks" ]; then
        for _p in "${args[@]}"; do
            _hits=$(grep -rlF "claude plugin install $_p " "$_ks" 2>/dev/null) || continue
            [ -n "$_hits" ] || continue
            dr_warn "a kit in your library still installs $_p:"
            printf '%s\n' "$_hits" | sed "s|^|    |" >&2
            dr_info "drop it from DRAUGR_KIT, or delete that directory"
        done
    fi
    ;;

# --- enable / disable ---------------------------------------------------------
enable|disable)
    [ ${#args[@]} -ge 1 ] || dr_die "$action needs a plugin" \
        "  dr-plugin $action <plugin>@<marketplace>"
    # No mound and no build: this is one key in one JSON file, and it takes
    # effect at the next attach because that is when a session reads settings.
    for _p in "${args[@]}"; do
        if [ "$action" = enable ]; then
            settings_write "$_p" true
        else
            settings_write "$_p" false
        fi
        dr_ok "$action $_p - takes effect at the next dr-go"
    done
    ;;

# --- clean --------------------------------------------------------------------
clean)
    [ -d "$SEED/cache" ] || { dr_ok "nothing to clean"; exit 0; }

    # Superseded versions are invisible and permanent: measured, a stale 0.9.0
    # left beside a live 1.0.0 survived `plugin update`, `plugin prune` and
    # `plugin list`, and list never mentioned it. Only the version the library
    # says is installed is kept.
    _kept=0 _dropped=0
    while read -r _id _ver; do
        [ -n "$_id" ] || continue
        _plug=${_id%@*}; _mkt=${_id#*@}
        _dir="$SEED/cache/$_mkt/$_plug"
        [ -d "$_dir" ] || continue
        for _v in "$_dir"/*; do
            [ -d "$_v" ] || continue
            if [ "$(basename "$_v")" = "$_ver" ]; then
                _kept=$((_kept + 1))
            else
                dr_info "dropping $_mkt/$_plug/$(basename "$_v")"
                rm -rf "$_v"; _dropped=$((_dropped + 1))
            fi
        done
    done < <(installed)

    # An uninstall leaves the empty parents behind - cache/<mkt>/<plugin>/ with
    # no version in it - which costs nothing but makes a find in the library name
    # plugins that are gone.
    #
    # Twice, deepest first: emptying <plugin> is what makes <mkt> empty, and a
    # single find has already walked past <mkt> by the time that happens.
    find "$SEED/cache" -mindepth 2 -maxdepth 2 -type d -empty -delete 2>/dev/null || :
    find "$SEED/cache" -mindepth 1 -maxdepth 1 -type d -empty -delete 2>/dev/null || :
    dr_ok "kept $_kept, dropped $_dropped"
    ;;

# --- rollback -----------------------------------------------------------------
rollback)
    [ -d "$PREV" ] || dr_die "there is no $PREV to go back to"
    dr_confirm "Swap $SEED and $PREV?" || dr_die "cancelled"
    # A swap rather than a restore, so running it twice returns you to where you
    # started - which is what you want when the rollback was the mistake.
    _tmp="$STORE/.swap.$$"
    mv "$SEED" "$_tmp"
    mv "$PREV" "$SEED"
    mv "$_tmp" "$PREV"
    dr_ok "rolled back - run it again to undo"
    ;;
esac
