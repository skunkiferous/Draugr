#!/usr/bin/env bash
# dr-plugin: manage the plugin library that each mound reads, and never install
# a plugin on your host.
#
#   dr-plugin                          what the library holds, and if it is connected
#   dr-plugin list                     the plugins in it, with versions
#   dr-plugin skills                   the skills of those plugins, and their source
#   dr-plugin kit [<plugin>@<mkt>...]  write the install for each mound as a kit
#   dr-plugin add <owner>/<repo> [<plugin>...]  register the MARKETPLACE, install, enable
#   dr-plugin update [<plugin>@<mkt>]  all of them, or one
#   dr-plugin remove <plugin>@<mkt>    uninstall, remove the registration, disable
#   dr-plugin enable <plugin>@<mkt>    only the switch. No mound, instant
#   dr-plugin disable <plugin>@<mkt>   the same
#   dr-plugin clean                    remove old versions that nothing removes
#   dr-plugin rollback                 put the previous library back
#
# `add` takes a MARKETPLACE, not a plugin. It registers the repository, and then
# installs what that marketplace lists: all of it, or only the plugins that you
# name after it. Thus a marketplace needs no separate step. The code finds the
# name of the registration, and you do not type it, because a repository decides
# it: obra/superpowers arrives as superpowers-marketplace. Thus a plugin that
# you name can be bare. The code completes it with the new name. On a REPEAT
# add, no new name appears, because the marketplace is already registered. Then
# the code uses the name that the registry holds for that source.
#
# A plugin is code that runs. Hooks run at session start, MCP servers are
# processes, and bin/ goes on the PATH of the Bash tool. Thus the rule is the
# one in docs/CLAUDE_PLUGINS.md: your host STORES plugin bytes, and never RUNS
# them. Each install here happens inside a temporary mound, and the host only
# gets files.
#
# The three verbs that need a mound build a new one and destroy it after. They
# work on a copy at $DRAUGR_PLUGIN_STORE/.build, and swap it into place at the
# end. Thus nobody edits the library that your mounds read, a failed build
# changes nothing, and the previous library stays as seed.old.
#
# WHY A COPY AND A SWAP, and not an edit in place: sbx bind-mounts a sandbox
# workspace read-write. Then plugin install code writes into the directory that
# each mound on this machine mounts. One bad install can rewrite plugins that
# you trust. A build next to it costs a copy, and removes that risk.
#
# WHY THE WORK HAPPENS IN THE ROOTFS OF THE MOUND, and not directly on that
# copy: a workspace on a Windows drive cannot rename a git clone. A test in a
# mound, on the bind-mounted workspace, showed this:
#
#   git clone -q https://github.com/… X   -> clone: OK
#   mv X Y                                -> cannot move 'X' to 'Y': Permission denied
#
# A rename of a plain directory in the same place works, and both work in the
# rootfs. `claude plugin marketplace add` clones to a temporary name, and
# renames it into place. Thus it fails there, but `remove` only deletes, and
# works. That is the worst split. Thus the code copies the library into
# /home/agent/seed, and works on it with full POSIX semantics. After that, it
# copies it back out with cp -a, which only creates.
#
# dr-cp is still not used. `sbx cp` extracts a tar, so it MERGES. Thus a manual
# update collects versions forever, and a manual removal frees nothing. Each
# copy here is cp -a onto a path that was just deleted, so it is exact.
#
# Set DRAUGR_PLUGIN_STORE to a directory on a Windows drive, then point your
# mounds at it. `dr-plugin` with no arguments prints the three lines to add.
#
# shellcheck disable=SC2016
# Single-quoted "$1" is in the copy helpers, on purpose. Those strings are
# scripts for the shell of the MOUND, and the host must not expand them.
set -euo pipefail

DR_PROG=dr-plugin
# readlink -f comes first. install.sh links this file into ~/.local/bin, and
# through a link BASH_SOURCE is the LINK. Without it, ../lib is ~/.local/lib.
_dr_bin=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$_dr_bin/../lib/common.sh"

# status is the default, because it is the only verb that moves nothing, and
# "what do I have?" is your first question. The same reason as in dr-mem.
action=${1:-status}
case "$action" in
    -h|--help) dr_help "$0"; exit 0 ;;
    status|list|skills|kit|add|update|remove|enable|disable|clean|rollback) shift || : ;;
    *) dr_die "unknown action: $action" \
              "One of: status, list, skills, kit, add, update, remove, enable," \
              "disable, clean, rollback" ;;
esac

# One loop reads the options for all verbs. A refusal of --yes on a verb that
# asks nothing is only noise. The positional arguments differ, so one shared
# parser is simpler than eight.
force=
args=()
while [ $# -gt 0 ]; do
    case "$1" in
        -y|--yes)  DR_ASSUME_YES=1 ;;
        --force)   force=1 ;;
        -h|--help) dr_help "$0"; exit 0 ;;
        -*) dr_die "unknown option: $1" "Try: dr-plugin --help" ;;
        *) args+=("$1") ;;
    esac
    shift
done

dr_context

# The agent owns the library layout, not Draugr, and only the layout of Claude
# Code was tested. A refusal is better than a directory in a layout that the
# agent never reads. A wrong plugin library is worse than a wrong memory copy.
# It puts third-party code in a place that each mound on the machine mounts.
dr_agent_plugin_supported || dr_die \
    "Draugr does not know how ${DRAUGR_AGENT:-this agent} keeps plugins" \
    "Each agent has its own plugin layout, and Draugr offers only tested ones." \
    "Known: $(dr_agent_known). See docs/CLAUDE_PLUGINS.md."

# Empty by default, so the feature is off until you configure it. No default
# location is correct. A mound must be able to mount it, and $HOME under WSL is
# not on a Windows drive.
[ -n "$DRAUGR_PLUGIN_STORE" ] || dr_die \
    "DRAUGR_PLUGIN_STORE is not set" \
    "It names the directory with the plugins that each mound reads. Put it on a" \
    "Windows drive, so that a mound can use it. Then add this line to" \
    "your ~/.config/draugr/config:" \
    '  DRAUGR_PLUGIN_STORE="/mnt/c/Code/claude-plugins"'

# sbx.exe is a Windows binary, and its workspaces are Windows paths. Thus a
# mound can never mount a store on the file system of WSL. A message here is
# better than a later failure in sbx, with a path that nobody typed.
dr_require_win_path "$DRAUGR_PLUGIN_STORE"

# The layout, in one place. The documentation of Claude Code uses `seed` for a
# pre-built plugin library, and the mounds read it through DRAUGR_MOUNTS. Thus
# it is a published name, not an internal one.
STORE=$DRAUGR_PLUGIN_STORE
SEED="$STORE/seed"
PREV="$STORE/seed.old"
BUILD="$STORE/.build"
SETTINGS="$STORE/settings.json"
BUILD_SANDBOX=draugr-plugin-build
# Where the CLI works, inside the mound. Rootfs, so that a git clone can get a
# new name. See the header.
WORK=/home/agent/seed

# Force github to HTTPS for each git that the plugin CLI runs.
#
# WHY: a mound has no SSH key, and must not get one. But `claude plugin install`
# clones a github plugin source through SSH, and does NOT try HTTPS after a
# failure. `claude plugin marketplace add` does: it prints "SSH not configured,
# cloning via HTTPS", and tries again. A test with iha2/superlite showed this.
# The marketplace cloned through HTTPS, and then the install failed with
# "Connection closed by 140.82.121.4 port 22". GitHub says that to an SSH client
# that it cannot authenticate. Egress was never the problem.
#
# GIT_CONFIG_COUNT, not `git config --global`. This goes in the env that
# build_run already sets. Thus nothing must guess the HOME of the CLI, no file
# goes into the mound, and the redirect reaches each git that the CLI starts.
# insteadOf has many values, so both forms share one key.
#
# It can only make more things work. An SSH clone never works in here.
_DR_GIT_HTTPS=(
    GIT_CONFIG_COUNT=2
    "GIT_CONFIG_KEY_0=url.https://github.com/.insteadOf"
    "GIT_CONFIG_VALUE_0=git@github.com:"
    "GIT_CONFIG_KEY_1=url.https://github.com/.insteadOf"
    "GIT_CONFIG_VALUE_1=ssh://git@github.com/"
)

# The variables that redirect the library of this agent. Both come from the
# agent module, because they are its private details. See lib/agents/claude.sh.
CACHE_VAR=$(dr_agent_plugin_cache_var)
SEED_VAR=$(dr_agent_plugin_seed_var)

# --- reading the library ------------------------------------------------------

# The three files of the library. Before the first add, they do not exist, and
# that is normal. Thus each reader answers empty, and does not fail.
marketplaces() {
    [ -f "$SEED/known_marketplaces.json" ] || return 0
    jq -r '. // {} | keys[]' "$SEED/known_marketplaces.json" 2>/dev/null || true
}

# The same, for the copy in the build, before a mound touched it.
build_marketplaces() {
    [ -f "$BUILD/seed/known_marketplaces.json" ] || return 0
    jq -r '. // {} | keys[]' "$BUILD/seed/known_marketplaces.json" 2>/dev/null || true
}

# work_cat <relative path>: one file from the working copy INSIDE the mound.
#
# The build directory of the host is a snapshot from before the CLI ran. Thus a
# decision about the result of an operation must read from here.
work_cat() {
    dr_sbx exec "$BUILD_SANDBOX" cat "$WORK/$1" 2>/dev/null || true
}

# The registrations in the copy of the mound. `add` needs them to see the name
# of a marketplace. The source does not tell it: obra/superpowers registers as
# superpowers-marketplace.
work_marketplaces() {
    work_cat known_marketplaces.json | jq -r '. // {} | keys[]' 2>/dev/null || true
}

# "<id> <version>" on each line. The id is already <plugin>@<marketplace>, the
# form that each other command here takes.
installed() {
    [ -f "$SEED/installed_plugins.json" ] || return 0
    jq -r '.plugins // {} | to_entries[] | "\(.key) \(.value[0].version // "?")"' \
        "$SEED/installed_plugins.json" 2>/dev/null || true
}

# Enabled is a different question from installed. The seed holds the content,
# and the settings file holds the decision. dr-plugin reports both, because a
# plugin that is one and not the other is the confusing case.
#
# On ONE line, with spaces, because each caller tests membership with a
# `case " $list " in *" $id "*`. A newline between two ids breaks the spaces
# around the pattern.
enabled_ids() {
    [ -f "$SETTINGS" ] || return 0
    jq -r '.enabledPlugins // {} | to_entries[] | select(.value) | .key' \
        "$SETTINGS" 2>/dev/null | tr '\n' ' ' || true
}

# marketplace_for_source <owner>/<repo>: the name of the registration that this
# source ALREADY has, or empty.
#
# `add` finds the name of a marketplace from a new name that APPEARS. On a
# second add, that gives nothing. The marketplace is already there, so nothing
# appears. The refusal then needs that name to say something useful. The
# registry records each source, so the code asks it.
marketplace_for_source() {
    [ -f "$SEED/known_marketplaces.json" ] || return 0
    # shellcheck disable=SC2016  # $src is jq's variable, not the shell's
    jq -r --arg src "$1" \
        '. // {} | to_entries[] | select(.value.source.repo == $src) | .key' \
        "$SEED/known_marketplaces.json" 2>/dev/null | head -1 || true
}

# installed_from <marketplace>: "<id> <version> enabled|disabled" on each line,
# for each plugin from that marketplace in the library.
#
# Both halves, because installed and enabled are different questions. A plugin
# that is one but not the other is the confusing case. `dr-plugin list` prints
# both for the same reason.
installed_from() {
    local mkt=$1 en id ver
    en=$(enabled_ids)
    while read -r id ver; do
        [ -n "$id" ] || continue
        case "$id" in *"@$mkt") ;; *) continue ;; esac
        case " $en " in
            *" $id "*) printf '%s %s enabled\n'  "$id" "$ver" ;;
            *)         printf '%s %s disabled\n' "$id" "$ver" ;;
        esac
    done < <(installed)
}

# --- the switch ---------------------------------------------------------------

# settings_write <id> <true|false|drop>: the enable decision, only on the host.
#
# The code writes a temporary file, and moves it into place. Each mound reads
# settings.json at each attach, and a half-written one breaks all of them.
settings_write() {
    local id=$1 how=$2 tmp filter
    [ -f "$SETTINGS" ] || printf '{\n  "enabledPlugins": {}\n}\n' > "$SETTINGS"

    # shellcheck disable=SC2016  # $id and $v are jq's variables, not the shell's
    case "$how" in
        drop) filter='.enabledPlugins |= (. // {} | del(.[$id]))' ;;
        *)    filter='.enabledPlugins |= ((. // {}) + {($id): ($v == "true")})' ;;
    esac

    tmp=$(mktemp)
    jq --arg id "$id" --arg v "$how" "$filter" "$SETTINGS" > "$tmp" \
        || dr_die "could not update $SETTINGS"
    mv "$tmp" "$SETTINGS"
}

# --- the build transaction ----------------------------------------------------

# build_begin: a new copy of the library to work on.
#
# cp -a on the host, not dr-cp through the mound. That is the reason for this
# command. `sbx cp` extracts a tar, so it MERGES directories, and replaces files
# with the same name. Thus a copy back over the library adds, and never removes.
# A copy on the host is exact, so an uninstall really removes the plugin.
build_begin() {
    rm -rf "$BUILD"
    mkdir -p "$BUILD"
    if [ -d "$SEED" ]; then
        # A message, because it is slow and was silent. A library of three
        # plugins is 43 MB in 4581 files, mostly the git clones of the
        # marketplaces. The copy is on a WINDOWS drive. Before this, the
        # command printed nothing for the first seconds. Nothing told which of
        # its three slow steps ran.
        dr_info "copying the library to a work copy ($SEED)"
        cp -a "$SEED" "$BUILD/seed"
    else
        mkdir -p "$BUILD/seed"
    fi
    build_repath
}

# build_repath: point installed_plugins.json to the place where the work on the
# library HAPPENS. That is the rootfs path, not the store or the build copy.
#
# Each entry records an ABSOLUTE installPath (a test showed this), for example
# /home/agent/seed/cache/claude-code-plugins/commit-commands/1.0.0. Thus a
# library copy in a different place has paths that do not exist. A rewrite after
# each copy makes the first migration from a manual seed and each later run the
# same case. One case costs less than two.
#
# On the host, where jq exists for sure, not inside the mound.
build_repath() {
    local f="$BUILD/seed/installed_plugins.json" mound tmp
    [ -f "$f" ] || return 0
    mound=$WORK

    # Keep all from /cache/ to the end, and give it a new root. The layout
    # guarantees only that end of the path. Thus this works for each directory
    # where the library was built before.
    # shellcheck disable=SC2016  # $root is jq's variable, not the shell's
    tmp=$(mktemp)
    jq --arg root "$mound" '
        .plugins |= ((. // {}) | map_values(map(
            .installPath |= ($root + (. | sub("^.*/cache/"; "/cache/")))
        )))' "$f" > "$tmp" || dr_die "could not rewrite installPath in $f"
    mv "$tmp" "$f"
}

# build_run <verb> [arg...]: one plugin CLI operation, inside a temporary mound.
#
# The workspace of the mound IS the build directory, bind-mounted read-write.
# Thus the CLI writes its results directly to the host, and nothing must be
# copied back. Because of the trap, "temporary" is true, also for a failed
# operation.
build_run() {
    local argv=() line
    while IFS= read -r line; do argv+=("$line"); done < <(dr_agent_plugin_cli "$@")
    [ ${#argv[@]} -gt 0 ] || dr_die "no command for plugin verb: $1"

    # env, not a quoted command line. dr_agent_plugin_cli gives one word on each
    # line, so that nothing here must split a string again.
    build_mound_start
    dr_info "${argv[*]}"
    # </dev/null, because sbx exec READS ALL OF STDIN. Without it, a caller with
    # a loop over `installed()` loses the rest of its list in the first pass. A
    # test showed this: an `update` reported success, but touched only one
    # plugin of three. That is the worst way for this to be wrong.
    dr_sbx exec "$BUILD_SANDBOX" env "$CACHE_VAR=$WORK" "${_DR_GIT_HTTPS[@]}" \
        "${argv[@]}" </dev/null \
        || dr_die "plugin command failed: ${argv[*]}" \
                  "The library did not change. $SEED is as it was."
}

# build_harvest: the finished library, back onto the workspace, and thus onto
# the host. rm, then cp -a, never a merge. What comes out is exactly what is in
# the mound. Thus an uninstall really removes something.
build_harvest() {
    local mount; mount=$(dr_path_mound "$BUILD/seed")
    dr_sbx exec "$BUILD_SANDBOX" sh -c \
        'rm -rf "$1" && cp -a "$2" "$1"' sh "$mount" "$WORK" \
        || dr_die "could not copy the built library back out"
}

# build_mound_start: create it once for each run, and make sure that it goes
# away.
#
# A mound that already exists is from a crashed run, not one to use again. Its
# workspace is a build directory that this run already deleted, so it points to
# nothing. The refusal names --force, and does not guess.
build_mound_start() {
    [ -z "${_dr_mound_up:-}" ] || return 0

    # --force removes it, and does not adopt it. With an adopt, the install runs
    # inside a mound whose workspace this run already deleted.
    if dr_sandbox_exists "$BUILD_SANDBOX"; then
        [ -n "$force" ] || dr_die \
            "$BUILD_SANDBOX already exists" \
            "A previous dr-plugin run did not clean up, or one runs now." \
            "If nothing else runs:  dr-plugin $action --force"
        dr_sbx rm --force "$BUILD_SANDBOX" >/dev/null 2>&1 || :
    fi

    # The trap comes BEFORE the create. Thus the code still removes a mound that
    # starts and then fails later. No kit, no ports, no clone: this mound is
    # only for one CLI on one directory.
    trap build_mound_stop EXIT INT TERM
    # Name the step, not only the sandbox. The creation of a microVM takes
    # seconds, and shows nothing during that time.
    dr_info "creating the build mound $BUILD_SANDBOX"
    dr_sbx create --name "$BUILD_SANDBOX" -q "$DRAUGR_AGENT" "$(dr_path_win "$BUILD")" \
        || dr_die "could not create the build mound" \
                  "Make sure that sbx works:  dr-doctor"
    _dr_mound_up=1

    # The working copy, in the rootfs, for the rename reason in the header. The
    # third slow step, and the third that was silent before.
    dr_info "copying the library into the rootfs of the mound"
    dr_sbx exec "$BUILD_SANDBOX" sh -c \
        'rm -rf "$1" && cp -a "$2" "$1"' sh "$WORK" "$(dr_path_mound "$BUILD/seed")" \
        || dr_die "could not copy the library inside $BUILD_SANDBOX"
}

# A warning, not a failure. When this runs, the work is committed or stopped.
# A non-zero exit here reports the wrong result.
build_mound_stop() {
    [ -n "${_dr_mound_up:-}" ] || return 0
    _dr_mound_up=
    dr_sbx rm --force "$BUILD_SANDBOX" >/dev/null 2>&1 \
        || dr_warn "could not remove $BUILD_SANDBOX. Remove it with: dr-rm --force"
}

# build_commit: the swap. Only at this time does the live library change.
#
# mv, not a copy, so that it is almost atomic. A mound reads the library at its
# start, and at no time can it see half of one. The previous library stays as
# seed.old for `dr-plugin rollback`.
build_commit() {
    # If a mound did the work, harvest first. Verbs that only touched the host
    # copy have nothing to bring back.
    if [ -n "${_dr_mound_up:-}" ]; then
        build_harvest
    fi
    [ -d "$BUILD/seed" ] || dr_die "nothing was built"
    rm -rf "$PREV"
    # An `if`, not `[ ] && mv`. Under set -e, that form exits the script the
    # first time that there is no library to move, that is, on the first add.
    if [ -d "$SEED" ]; then
        mv "$SEED" "$PREV"
    fi
    mv "$BUILD/seed" "$SEED"
    rm -rf "$BUILD"
    dr_ok "library updated. The previous one is in $PREV"
}

case "$action" in

# --- status -------------------------------------------------------------------
status)
    dr_heading "library"
    printf '  %s\n' "$STORE" >&2
    if [ ! -d "$SEED" ]; then
        printf '  %s\n' "empty. Add one with:  dr-plugin add <owner>/<repo>" >&2
    fi

    # Separate lists for marketplaces and plugins, because the seed gives the
    # first and not the second. A marketplace with no plugin is the normal state
    # after a manual `marketplace add`, not a fault.
    _m=$(marketplaces)
    if [ -n "$_m" ]; then
        dr_heading "marketplaces"
        # sed, not printf. The list has one name on each line, and printf
        # indents only the first.
        printf '%s\n' "$_m" | sed 's/^/  /' >&2
    fi

    _enabled=$(enabled_ids)
    if [ -n "$(installed)" ]; then
        dr_heading "plugins"
        while read -r _id _ver; do
            [ -n "$_id" ] || continue
            # "enabled" comes from the settings file. A plugin that is installed
            # but not enabled does nothing, and you must see that.
            case " $_enabled " in
                *" $_id "*) _state="enabled" ;;
                *)          _state="INSTALLED, NOT ENABLED" ;;
            esac
            printf '  %-45s %-8s %s\n' "$_id" "$_ver" "$_state" >&2
        done < <(installed)
    fi

    # The library is useless until the mounds point to it. That needs three keys
    # in a file that this command does not own. Only here do the two halves
    # meet.
    dr_heading "wiring"
    _seed_mound=$(dr_path_mound "$SEED")
    _set_mound=$(dr_path_mound "$SETTINGS")
    _args_key=$(dr_agent_args_key "$DRAUGR_AGENT")
    _want_mount="$STORE:ro"
    _missing=()
    case " $DRAUGR_MOUNTS " in *" $_want_mount "*) ;; *) _missing+=(mount) ;; esac
    case " $DRAUGR_ENV " in *"$SEED_VAR=$_seed_mound"*) ;; *) _missing+=(env) ;; esac
    case " ${!_args_key:-} " in *"--settings $_set_mound"*) ;; *) _missing+=(args) ;; esac

    # Print the exact lines, not "see the docs". The last of the three is for
    # one agent, and nobody guesses its name at the first try.
    if [ ${#_missing[@]} -eq 0 ]; then
        printf '  %s\n' "all three keys point to this library" >&2
    else
        printf '  %s\n' "not connected (${_missing[*]}). Add to ~/.config/draugr/config:" >&2
        printf '    DRAUGR_MOUNTS="%s"\n'     "$_want_mount" >&2
        printf '    DRAUGR_ENV="%s=%s"\n'     "$SEED_VAR" "$_seed_mound" >&2
        printf '    %s="--settings %s"\n'     "$_args_key" "$_set_mound" >&2
        printf '  %s\n' "DRAUGR_MOUNTS and DRAUGR_ENV are single strings. A project configuration" >&2
        printf '  %s\n' "REPLACES them, and does not add to them. If you set them, append." >&2
    fi
    ;;

# --- list ---------------------------------------------------------------------
list)
    _enabled=$(enabled_ids)
    while read -r _id _ver; do
        [ -n "$_id" ] || continue
        case " $_enabled " in
            *" $_id "*) _state=enabled ;;
            *)          _state=disabled ;;
        esac
        printf '%s %s %s\n' "$_id" "$_ver" "$_state"
    done < <(installed)
    ;;

# --- skills -------------------------------------------------------------------
#
# The skills of a plugin are NOT in the shared skills store, and never will be.
# They load from the plugin. dr-skills reports the same list under its own
# heading. Both use the walk in dr_plugin_skills in lib/common.sh.
skills)
    _rows=$(dr_plugin_skills "$STORE")
    # Nothing is a normal answer, not a fault. Many plugins have no skill.
    [ -n "$_rows" ] || { dr_info "no installed plugin has a skill"; exit 0; }

    # Content goes to stdout, as in `list`, so that a pipe keeps it. See
    # dr-status.
    printf '%s\n' "$_rows" | while read -r _s _id _v; do
        printf '%-32s %s %s\n' "$_s" "$_id" "$_v"
    done
    ;;

# --- kit ----------------------------------------------------------------------
#
# The seed removes the marketplace add and the network fetch. It does not remove
# the INSTALL. The install goes into the own rootfs of each mound, and dies with
# dr-rm. This verb writes that one repeated step as a kit.
#
# ONE KIT FOR EACH PLUGIN, because sbx can only ADD a kit to a running mound. A
# single combined kit needs an EDIT for each new plugin, and an edited kit needs
# dr-up --recreate. With separate kits, a new plugin is an append, and that is
# the one change that applies in place.
#
# NO VERSION IS PINNED. The install line names only <plugin>@<marketplace>, so
# it resolves against the seed at the creation of a mound. Thus `dr-plugin
# update` and this verb are independent. After an update, the same kit installs
# the new version. See docs/CLAUDE_PLUGINS.md.
kit)
    # The kit runs INSIDE a mound, so the seed needs its path in the mound. That
    # is the same translation that `status` uses for its test.
    _seed_mound=$(dr_path_mound "$SEED") || dr_die \
        "the seed is not on a Windows drive, so no mound can use it" \
        "  $SEED"
    _ks=$(dr_kit_store)

    # If you name nothing, each installed plugin. The same form as `add`: all of
    # them, or only the ones that you name.
    _want=()
    if [ ${#args[@]} -gt 0 ]; then
        _want=("${args[@]}")
    else
        while read -r _id _; do
            [ -n "$_id" ] && _want+=("$_id")
        done < <(installed)
    fi
    [ ${#_want[@]} -gt 0 ] || dr_die "no plugin is installed" \
        "Add one first:  dr-plugin add <owner>/<repo>"

    mkdir -p "$_ks"
    _made=()
    for _p in "${_want[@]}"; do
        # Installed is the precondition. The code reads the version only to
        # prove it. Nothing below records a version.
        _ver=$(installed | awk -v id="$_p" '$1 == id {print $2; exit}')
        [ -n "$_ver" ] || dr_die "not installed: $_p" \
            "A kit can only install what the seed holds. Give the full id," \
            "as <plugin>@<marketplace>. See the plugins:  dr-plugin list"

        # sbx allows only lowercase letters, digits, and hyphens in `name`. Thus
        # the code changes the plugin half of the id into a slug.
        _slug=plugin-$(printf '%s' "${_p%@*}" | tr '[:upper:]' '[:lower:]' \
            | tr -cs 'a-z0-9' '-')
        _slug=${_slug%-}
        _dir="$_ks/$_slug"

        # A person possibly edited a kit in the library. Thus a replacement is a
        # decision, not a detail.
        if [ -d "$_dir" ] && [ -z "$force" ]; then
            dr_warn "$_slug is already in the kit library"
            printf '  %s%s%s\n' "$_DR_DIM" "$_dir/spec.yaml" "$_DR_OFF" >&2
            dr_confirm "Overwrite it?" || { dr_info "kept $_slug"; continue; }
        fi

        # Unquoted heredoc. The shell puts in the id, the slug, and the seed
        # path, and touches nothing else in here.
        mkdir -p "$_dir"
        cat > "$_dir/spec.yaml" <<YAML
schemaVersion: "2"
kind: mixin
name: $_slug
displayName: Install $_p into the mound
description: >-
  dr-plugin kit made this file. At the creation of the mound, it installs the
  plugin below from the seed. No version is pinned. It resolves against the
  seed, so after dr-plugin update you do not have to make it again.

commands:
  install:
    - command: "env HOME=/home/agent $SEED_VAR=$_seed_mound claude plugin install $_p -y"
      user: "1000"
      description: Install $_p from the seed, with no marketplace add and no clone
YAML
        _made+=("$_slug")
        dr_ok "wrote $_dir/spec.yaml  ($_p $_ver)"
    done

    # If each kit was already there and kept, say nothing.
    [ ${#_made[@]} -gt 0 ] || exit 0

    # Draugr does not parse kit YAML. sbx does. Thus dr-kit decides whether the
    # new file is valid, not this command.
    dr_info "validate it, then add it to the kit list of a project:"
    printf '  dr-kit validate\n' >&2
    printf '  DRAUGR_KIT=".draugr/kit %s"\n' "${_made[*]}" >&2

    # One answer now, not two. A test showed that commands.install DOES run
    # when `sbx kit add` recreates the container. Thus "dr-kit apply" installs
    # the plugin into the mound that you work in. The old text gave both
    # answers, because nobody measured it.
    #
    # This generator must make kits with install commands ONLY. The same test
    # showed that `sbx kit add` REFUSES a kit that declares commands.startup,
    # and asks for sbx rm and then sbx create. With a startup command here, you
    # cannot apply a generated kit in place.
    printf '  %sEach new mound installs it at its creation, and "dr-kit apply"\n' "$_DR_DIM" >&2
    printf '  installs it into the mound that you work in now.\n' >&2
    printf '  That recreate also runs the install commands of each other kit of\n' >&2
    printf '  the mound again. See docs/CLAUDE_PLUGINS.md.%s\n' "$_DR_OFF" >&2
    ;;

# --- add ----------------------------------------------------------------------
add)
    [ ${#args[@]} -ge 1 ] || dr_die "add needs a marketplace" \
        "  dr-plugin add <owner>/<repo>               each plugin that the marketplace lists" \
        "  dr-plugin add <owner>/<repo> <plugin>...   only the ones that you name"
    _source=${args[0]}

    build_begin
    # A repository decides its OWN registration name. "obra/superpowers" arrives
    # as "superpowers-marketplace". Thus the code finds the name from what
    # appeared, and not from what you typed.
    _before=$(build_marketplaces)
    build_run market-add "$_source"
    _mkt=$(comm -13 <(printf '%s\n' "$_before" | sort) \
                    <(work_marketplaces | sort) | head -1)

    # Nothing NEW is not the same as nothing there. A repeat add registers no
    # marketplace, because the library already holds it. The search cannot name
    # it, because it looks for a new arrival. Thus the code asks the registry.
    # That makes both refusals below into answers, not dead ends.
    _known=
    [ -n "$_mkt" ] || _known=$(marketplace_for_source "$_source")

    # If you name no plugin, install all that the new marketplace offers. Its
    # catalog is on disk now, because market-add cloned it.
    if [ ${#args[@]} -ge 2 ]; then
        # The code completes a bare name with the marketplace that this add
        # found. If there is none, it uses the one that the registry holds for
        # this source. A FIRST add cannot know <plugin>@<marketplace>, and a
        # repeat add knows it only through the registry.
        _plugins=()
        for _p in "${args[@]:1}"; do
            case "$_p" in
                *@*) _plugins+=("$_p") ;;
                *)   _m=${_mkt:-$_known}
                     [ -n "$_m" ] || dr_die \
                         "cannot tell the marketplace of $_p" \
                         "$_source registered nothing new, and no registered marketplace" \
                         "names that source. Give the full id:" \
                         "  dr-plugin add $_source <plugin>@<marketplace>" \
                         "To list the registered names:  dr-plugin"
                     _plugins+=("$_p@$_m") ;;
            esac
        done
    else
        # Nothing new is not a failure, so do not report it as one. The old
        # advice here sent you to `dr-plugin add <source> <plugin>`. The
        # bare-name branch above then refused that, for the same missing name.
        if [ -z "$_mkt" ]; then
            [ -n "$_known" ] || dr_die \
                "$_source registered no new marketplace" \
                "No registered marketplace names that source, so there is" \
                "nothing here to install from." \
                "To list the registered names:  dr-plugin"

            # Already registered, so this is a repeat. Report what is there, and
            # name the verb for it.
            mapfile -t _have < <(installed_from "$_known")
            [ ${#_have[@]} -gt 0 ] || dr_die \
                "$_source is already registered, as $_known" \
                "Nothing from it is installed yet. Name the plugin that you want:" \
                "  dr-plugin add $_source <plugin>@$_known"
            dr_die "$_source is already registered, as $_known" \
                "Installed from it:" \
                "${_have[@]/#/  }" \
                "To refresh it:    dr-plugin update <plugin>@$_known" \
                "To add another:   dr-plugin add $_source <plugin>@$_known"
        fi
        mapfile -t _plugins < <(work_cat "marketplaces/$_mkt/.claude-plugin/marketplace.json" \
            | jq -r '.plugins[]?.name' 2>/dev/null)
        [ ${#_plugins[@]} -gt 0 ] || dr_die "no plugins listed in $_mkt"
        _plugins=("${_plugins[@]/%/@$_mkt}")
    fi

    for _p in "${_plugins[@]}"; do build_run install "$_p"; done
    build_commit
    # Enable last, and only after the swap. A switch for a plugin that the
    # library does not have is a lie, and the library gets it at the swap.
    for _p in "${_plugins[@]}"; do
        settings_write "$_p" true
        dr_ok "enabled $_p"
    done
    ;;

# --- update -------------------------------------------------------------------
update)
    build_begin
    # marketplace update refreshes the catalogs. plugin update acts on what they
    # now offer. The first always runs, so "update" means the same, with or
    # without a plugin name.
    build_run market-update ""
    if [ ${#args[@]} -ge 1 ]; then
        for _p in "${args[@]}"; do build_run update "$_p"; done
    else
        # The whole list first, then the loop. A read during the loop puts a
        # command that reads stdin inside the pipeline that feeds it. See the
        # redirect in build_run.
        mapfile -t _ids < <(installed | cut -d' ' -f1)
        for _id in "${_ids[@]}"; do
            [ -n "$_id" ] || continue
            build_run update "$_id"
        done
    fi
    build_commit
    dr_info "the CLI does not remove old versions. Run: dr-plugin clean"
    ;;

# --- remove -------------------------------------------------------------------
remove)
    [ ${#args[@]} -ge 1 ] || dr_die "remove needs a plugin" \
        "  dr-plugin remove <plugin>@<marketplace>" \
        "See the installed plugins with:  dr-plugin list"

    build_begin
    for _p in "${args[@]}"; do
        build_run uninstall "$_p"

        # If nothing else came from the marketplace, it goes too. Otherwise each
        # mound keeps a registered catalog for no plugin, and its clone stays on
        # disk.
        _mkt=${_p#*@}
        _left=$(work_cat installed_plugins.json | jq -r --arg m "$_mkt" \
            '[.plugins // {} | keys[] | select(endswith("@" + $m))] | length' \
            2>/dev/null || echo 1)
        if [ "$_left" = 0 ]; then
            build_run market-remove "$_mkt"
        fi
    done
    build_commit
    for _p in "${args[@]}"; do settings_write "$_p" drop; done

    # A generated kit installs this plugin by name, and the plugin is no longer
    # in the seed. Thus that kit sends a mound to the network for it, or fails.
    # Report it, but do NOT delete it. A person possibly edited a kit in your
    # library, and the removal of a plugin is no permission to discard it.
    _ks=$(dr_kit_store)
    if [ -d "$_ks" ]; then
        for _p in "${args[@]}"; do
            _hits=$(grep -rlF "claude plugin install $_p " "$_ks" 2>/dev/null) || continue
            [ -n "$_hits" ] || continue
            dr_warn "a kit in your library still installs $_p:"
            printf '%s\n' "$_hits" | sed "s|^|    |" >&2
            dr_info "remove it from DRAUGR_KIT, or delete that directory"
        done
    fi
    ;;

# --- enable / disable ---------------------------------------------------------
enable|disable)
    [ ${#args[@]} -ge 1 ] || dr_die "$action needs a plugin" \
        "  dr-plugin $action <plugin>@<marketplace>"
    # No mound and no build. This is one key in one JSON file. It applies at the
    # next attach, because a session reads the configuration then.
    for _p in "${args[@]}"; do
        if [ "$action" = enable ]; then
            settings_write "$_p" true
        else
            settings_write "$_p" false
        fi
        dr_ok "$action $_p. It applies at the next dr-go."
    done
    ;;

# --- clean --------------------------------------------------------------------
clean)
    [ -d "$SEED/cache" ] || { dr_ok "nothing to clean"; exit 0; }

    # Old versions are hidden and permanent. A test showed this. An old 0.9.0
    # next to a live 1.0.0 stayed after `plugin update`, `plugin prune`, and
    # `plugin list`, and list never named it. The code keeps only the version
    # that the library names as installed.
    _kept=0 _dropped=0
    while read -r _id _ver; do
        [ -n "$_id" ] || continue
        _plug=${_id%@*}; _mkt=${_id#*@}
        _dir="$SEED/cache/$_mkt/$_plug"
        [ -d "$_dir" ] || continue
        for _v in "$_dir"/*; do
            [ -d "$_v" ] || continue
            if [ "$(basename "$_v")" = "$_ver" ]; then
                _kept=$((_kept + 1))
            else
                dr_info "removing $_mkt/$_plug/$(basename "$_v")"
                rm -rf "$_v"; _dropped=$((_dropped + 1))
            fi
        done
    done < <(installed)

    # An uninstall leaves the empty parents: cache/<mkt>/<plugin>/ with no
    # version in it. That costs nothing, but a find in the library then names
    # plugins that are gone.
    #
    # Twice, the deepest first. An empty <plugin> makes <mkt> empty. At that
    # time, one find is already past <mkt>.
    find "$SEED/cache" -mindepth 2 -maxdepth 2 -type d -empty -delete 2>/dev/null || :
    find "$SEED/cache" -mindepth 1 -maxdepth 1 -type d -empty -delete 2>/dev/null || :
    dr_ok "kept $_kept, removed $_dropped"
    ;;

# --- rollback -----------------------------------------------------------------
rollback)
    [ -d "$PREV" ] || dr_die "there is no $PREV to go back to"
    dr_confirm "Swap $SEED and $PREV?" || dr_die "cancelled"
    # A swap, not a restore. Thus a second run brings you back to the start.
    # That is what you want after a wrong rollback.
    _tmp="$STORE/.swap.$$"
    mv "$SEED" "$_tmp"
    mv "$PREV" "$SEED"
    mv "$_tmp" "$PREV"
    dr_ok "rolled back. To undo, run it again."
    ;;
esac
