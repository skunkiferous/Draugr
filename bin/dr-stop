#!/usr/bin/env bash
# dr-stop: shut down the mound, and do not destroy it.
#
# The clone, the history of the agent, and all software installed inside stay. A
# later dr-go starts it again in a few seconds, with no rebuild. Use this at the
# end of your work day. dr-rm destroys things.
#
# A stop keeps things clean, but it does not protect work. The fetch of dr-sync
# protects the work of the agent. dr-go does that fetch for you at exit. A
# stop frees the memory of a running microVM. If the host stops suddenly, less
# can go wrong.
#
#   dr-stop            stop the mound of this repo
#   dr-stop <name>     stop one by name
#   dr-stop --all      stop each running sandbox on this machine
set -euo pipefail

DR_PROG=dr-stop
# readlink -f comes first. install.sh links this file into ~/.local/bin, and
# through a link BASH_SOURCE is the LINK. Without it, ../lib is ~/.local/lib.
_dr_bin=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$_dr_bin/../lib/common.sh"

# A word without a dash is a sandbox name. Without one, the code uses the mound
# of this repo.
name=
all=
while [ $# -gt 0 ]; do
    case "$1" in
        --all|-a)  all=1 ;;
        -y|--yes)  DR_ASSUME_YES=1 ;;
        -h|--help) dr_help "$0"; exit 0 ;;
        -*) dr_die "unknown option: $1" "Try: dr-stop --help" ;;
        *) name=$1 ;;
    esac
    shift
done

# --- each running sandbox ---------------------------------------------------
#
# No dr_context. This is a command for the machine. You usually want it as you
# leave a terminal that is not in a repository.
if [ -n "$all" ]; then
    [ -z "$name" ] || dr_die "--all takes no sandbox name" "Try: dr-stop --help"

    mapfile -t running < <(dr_sandboxes_running)
    if [ ${#running[@]} -eq 0 ]; then
        dr_ok "nothing is running"
        exit 0
    fi

    # Listed with a question, not assumed. This also reaches sandboxes that
    # Draugr did not create, but sbx knows. Draugr must not stop a sandbox from
    # a plain `sbx run` without a question.
    dr_info "${#running[@]} running sandbox(es):"
    for s in "${running[@]}"; do printf '    %s\n' "$s" >&2; done
    printf '  %sA stop keeps each clone and all software installed inside. It does NOT%s\n' \
        "$_DR_DIM" "$_DR_OFF" >&2
    printf '  %sfetch the commits of the agents. dr-sync does that, for each repository.%s\n' \
        "$_DR_DIM" "$_DR_OFF" >&2
    dr_confirm "Stop all ${#running[@]}?" || dr_die "cancelled"

    # sbx stop takes several names at once. Thus this is one call, with one
    # failure to report, not a partial pass that stops in the middle.
    dr_sbx stop "${running[@]}" >/dev/null || dr_die \
        "could not stop all of them" "See the others:  dr-ls"
    dr_ok "stopped ${#running[@]} sandbox(es)"
    exit 0
fi

# With a name on the command line, you do not have to be in a repo. Thus you can
# stop a mound from a different directory.
if [ -z "$name" ]; then
    dr_context
    name=$DRAUGR_SANDBOX
fi

state=$(dr_sandbox_state "$name")
case "$state" in
    absent)  dr_die "$name does not exist" "See the mounds that exist:  dr-ls" ;;
    stopped) dr_ok "$name is already stopped"; exit 0 ;;
esac

dr_sbx stop "$name" >/dev/null || dr_die "could not stop $name"
dr_ok "stopped $name"

# A stopped mound is no longer a valid claimant. The warden sees that at its
# next tick. But a release now starts the linger at the time that you left, not
# up to a minute later. This needs a known repository. `dr-stop <name>` from
# another place has no claims to give back, and DR_REPO is the repository of
# somebody else.
if [ -n "${DR_REPO:-}" ] && [ -x "$_dr_bin/dr-dep" ]; then
    "$_dr_bin/dr-dep" release >/dev/null || dr_warn "could not release claims. See:  dr-dep"
fi
