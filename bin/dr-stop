#!/usr/bin/env bash
# dr-stop - shut the mound down without destroying it.
#
# The clone, the agent's history and anything installed inside all survive; a
# later dr-go starts it back up in a few seconds rather than rebuilding it. This
# is what you want at the end of the day. dr-rm is the one that destroys things.
#
# Stopping is hygiene, not durability. What protects the agent's work is dr-sync
# having fetched it, which dr-go does for you on the way out. Stopping reclaims
# the memory a running microVM holds, and leaves less to go wrong if the host
# goes down unexpectedly.
#
#   dr-stop            stop this repo's mound
#   dr-stop <name>     stop one by name
#   dr-stop --all      stop every running sandbox on this machine
set -euo pipefail

DR_PROG=dr-stop
# readlink -f first: install.sh links this into ~/.local/bin by default, and
# through a link BASH_SOURCE is the LINK, so ../lib would be ~/.local/lib.
_dr_bin=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$_dr_bin/../lib/common.sh"

# A bare word is a sandbox name; without one we fall back to this repo's mound.
name=
all=
while [ $# -gt 0 ]; do
    case "$1" in
        --all|-a)  all=1 ;;
        -y|--yes)  DR_ASSUME_YES=1 ;;
        -h|--help) dr_help "$0"; exit 0 ;;
        -*) dr_die "unknown option: $1" "Try: dr-stop --help" ;;
        *) name=$1 ;;
    esac
    shift
done

# --- every running sandbox --------------------------------------------------
#
# No dr_context: this is a machine-level command and the usual moment to want it
# is on your way out of a terminal that is not in any repository.
if [ -n "$all" ]; then
    [ -z "$name" ] || dr_die "--all takes no sandbox name" "Try: dr-stop --help"

    mapfile -t running < <(dr_sandboxes_running)
    if [ ${#running[@]} -eq 0 ]; then
        dr_ok "nothing is running"
        exit 0
    fi

    # Listed and confirmed rather than assumed, because this reaches past the
    # sandboxes Draugr created to any that sbx knows about - including ones from
    # a plain `sbx run` that Draugr has no business stopping without asking.
    dr_info "${#running[@]} running sandbox(es):"
    for s in "${running[@]}"; do printf '    %s\n' "$s" >&2; done
    printf '  %sStopping keeps every clone and anything installed inside. It does NOT%s\n' \
        "$_DR_DIM" "$_DR_OFF" >&2
    printf '  %sfetch the agents'"'"' commits - dr-sync does that, per repository.%s\n' \
        "$_DR_DIM" "$_DR_OFF" >&2
    dr_confirm "Stop all ${#running[@]}?" || dr_die "cancelled"

    # sbx stop takes several names at once, so this is one call and one failure
    # to report rather than a partial sweep that stops halfway.
    dr_sbx stop "${running[@]}" >/dev/null || dr_die \
        "could not stop them all" "See what is left:  dr-ls"
    dr_ok "stopped ${#running[@]} sandbox(es)"
    exit 0
fi

# A name on the command line means we do not need to be in a repo at all, which
# is what lets you stop a mound you have wandered away from.
if [ -z "$name" ]; then
    dr_context
    name=$DRAUGR_SANDBOX
fi

state=$(dr_sandbox_state "$name")
case "$state" in
    absent)  dr_die "$name does not exist" "See what does:  dr-ls" ;;
    stopped) dr_ok "$name is already stopped"; exit 0 ;;
esac

dr_sbx stop "$name" >/dev/null || dr_die "could not stop $name"
dr_ok "stopped $name"

# A stopped mound stops being a valid claimant anyway - the warden would work
# that out at its next tick - but releasing now starts the linger at the moment
# you actually left, rather than up to a minute later. Only when we know which
# repository we are in: `dr-stop <name>` from anywhere else has no claims to give
# back, and DR_REPO would be somebody else's repository.
if [ -n "${DR_REPO:-}" ] && [ -x "$_dr_bin/dr-dep" ]; then
    "$_dr_bin/dr-dep" release >/dev/null || dr_warn "could not release claims; see:  dr-dep"
fi
