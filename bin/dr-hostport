#!/usr/bin/env bash
# dr-hostport: let the mound connect to a service that runs on THIS machine.
#
# The opposite of dr-ports. dr-ports publishes a port that the mound listens on,
# so that a browser on Windows can connect in. This opens a port that the HOST
# listens on, so that the agent can connect out. The first case was a local
# Ollama on your GPU.
#
#   dr-hostport                 what this mound can reach on the host
#   dr-hostport 11434           open host port 11434, at its current address
#   dr-hostport --close 11434   close it again
#
# You name only the PORT, never the address. That is the purpose. WSL gets a new
# address at each boot, and you cannot pin it. A rule with a literal IP is
# correct until the next reboot. Then it fails CLOSED and SILENTLY. The
# interception layer of the sandbox accepts the connection, and drops it with
# no error. This command finds the address at each run, and removes its rules
# for addresses that this machine no longer has.
#
# If you put the port in DRAUGR_HOST_PORTS, dr-up does this at each start. Thus
# it works after a reboot, and you do not have to remember anything.
#
# The address also goes into the mound, at ~/.draugr/host.env, because nothing
# in there can find it. Nothing sources it for you. A project that wants the
# value reads it in its own run script or kit startup command.
#
# This is a hole from the sandbox to your machine. It is the more dangerous of
# the two directions, because a process outside the mound is on the other side.
# dr-policy --allow does the same for one case, and warns more clearly.
set -euo pipefail

DR_PROG=dr-hostport
# readlink -f comes first. install.sh links this file into ~/.local/bin, and
# through a link BASH_SOURCE is the LINK. Without it, ../lib is ~/.local/lib.
_dr_bin=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$_dr_bin/../lib/common.sh"

# An argument without a dash is a port to open. --close takes a port to close.
close=()
open=()
while [ $# -gt 0 ]; do
    case "$1" in
        --close|-c) shift; [ -n "${1:-}" ] || dr_die "--close needs a port"; close+=("$1") ;;
        -h|--help)  dr_help "$0"; exit 0 ;;
        -*) dr_die "unknown option: $1" "Try: dr-hostport --help" ;;
        *)  open+=("$1") ;;
    esac
    shift
done

dr_context

dr_sandbox_exists "$DRAUGR_SANDBOX" || dr_die \
    "$DRAUGR_SANDBOX does not exist" "Create it with:  dr-up"

# Only a port number. Test it early, because the value goes into a jq regex and
# to sbx. sbx accepts "11434/tcp" as a hostname. It matches nothing, and looks
# like a rule that was never added.
_check_port() {
    case "$1" in
        ''|*[!0-9]*) dr_die "not a port number: $1" "Usage:  dr-hostport 11434" ;;
    esac
    if [ "$1" -lt 1 ] || [ "$1" -gt 65535 ]; then
        dr_die "port out of range: $1" "Usage:  dr-hostport 11434"
    fi
}

# A hole to a port where nothing listens is not an error, because you can
# start the service next. A port bound only to LOOPBACK is different. It is the
# usual error with this command, and you cannot see it from inside the mound.
# There, 127.0.0.1 is the loopback of the mound, and the failure looks like a
# policy denial.
_warn_if_loopback_only() {
    local port=$1 bound
    command -v ss >/dev/null 2>&1 || return 0
    bound=$(ss -ltnH "sport = :$port" 2>/dev/null | awk '{ print $4 }') || return 0
    [ -n "$bound" ] || return 0
    case "$bound" in
        *"0.0.0.0:$port"*|*"[::]:$port"*|*"*:$port"*) return 0 ;;
    esac
    dr_warn "port $port listens only on loopback ($bound)"
    printf '  %sInside the mound, 127.0.0.1 is the MOUND, so this does not%s\n' \
        "$_DR_DIM" "$_DR_OFF" >&2
    printf '  %sconnect, whatever the rule says. Bind the service to 0.0.0.0.%s\n' \
        "$_DR_DIM" "$_DR_OFF" >&2
}

# Each address:port of this mound, from all writers. Only plain IPv4. A rule
# that names a domain is from somebody else, and is not a host port.
_all_rules() {
    dr_sbx policy ls "$DRAUGR_SANDBOX" --wide --json 2>/dev/null |
        jq -r --arg s "sandbox:$DRAUGR_SANDBOX" '
              .. | objects
              | select(.applies_to? == $s and .decision? == "allow")
              | select(.resource_type? == "network" and .editable? == true)
              | .resources[]?
              | select(test("^[0-9]+[.][0-9]+[.][0-9]+[.][0-9]+:[0-9]+$"))' \
            2>/dev/null | sort -u
}

# _write_host_env: tell the mound the address of this host, in a file.
#
# The mound cannot find it. The image has no `ip` command, and
# host.docker.internal resolves to the OWN gateway of the mound, not to this
# machine (a test showed this). Thus the process that knows must write it, and
# that is this one, at each dr-up.
#
# A FILE, and nothing more. Draugr does not touch the dotfiles of the agent, so
# nothing sources this for you. A project that wants the value reads it itself,
# in its run script or in a kit startup command. Thus the sandbox gets no
# automatic, hidden change of the environment. You must be able to see what is
# in the sandbox.
#
# The port list comes from the rules in force, not from DRAUGR_HOST_PORTS. Thus
# the file tells what is true, not what was asked for, and a --close needs no
# special case.
_write_host_env() {
    local ip ports

    # Only into a mound that already runs. A start only to write a file makes
    # `dr-hostport --close` on a stopped sandbox into a boot.
    [ "$(dr_sandbox_state "$DRAUGR_SANDBOX")" = running ] || return 0
    ip=$(dr_host_ip) || return 0

    ports=$(_all_rules | awk -F: -v ip="$ip" '$1 == ip { print $2 }' | sort -un | tr '\n' ' ')
    ports=${ports% }

    # Single-quoted lines, so that the $ and " in them go into the file without
    # change. Nothing here has an apostrophe. That is the one character that
    # this form cannot hold.
    dr_sbx exec "$DRAUGR_SANDBOX" sh -c \
        "mkdir -p \"\$HOME/.draugr\" && printf '%s\n' \
         '# dr-hostport writes this file at each dr-up. Do not edit it. It is overwritten.' \
         '# Nothing sources this for you. Use it in your own script, for example:' \
         '#   . \"\$HOME/.draugr/host.env\"' \
         '#   OLLAMA_URL=\"http://\$DRAUGR_HOST_ADDR:11435\"' \
         '# The address is valid only for this boot of the host.' \
         'DRAUGR_HOST_ADDR=$ip' \
         'DRAUGR_HOST_PORTS=\"$ports\"' \
         > \"\$HOME/.draugr/host.env\"" >/dev/null 2>&1 \
        || dr_warn "could not write the host address into $DRAUGR_SANDBOX"
}

# No arguments is a query. That is the usual case, and it must change nothing.
if [ ${#open[@]} -eq 0 ] && [ ${#close[@]} -eq 0 ]; then
    ip=$(dr_host_ip) || ip=
    rules=$(_all_rules)

    # Nothing is open. The code names both ways to open one. The configuration
    # key is the answer for a port that you want again tomorrow, and people do
    # not easily find it.
    if [ -z "$rules" ]; then
        dr_info "$DRAUGR_SANDBOX can connect to no host ports"
        printf '  %sOpen one with:  dr-hostport <port>%s\n' "$_DR_DIM" "$_DR_OFF" >&2
        printf '  %sOr declare it once:  DRAUGR_HOST_PORTS="11434"%s\n' "$_DR_DIM" "$_DR_OFF" >&2
        exit 0
    fi

    dr_heading "host ports open to $DRAUGR_SANDBOX:"
    while IFS= read -r r; do
        # A rule for an address that this machine no longer has is useless. This
        # list exists mostly to say that. A reboot leaves this state, and
        # otherwise it looks the same as a working rule.
        if [ -n "$ip" ] && [ "${r%:*}" != "$ip" ]; then
            printf '  %-24s %sold. This host is now %s%s\n' "$r" "$_DR_DIM" "$ip" "$_DR_OFF"
        else
            printf '  %s\n' "$r"
        fi
    done <<< "$rules"

    # In each list, not only the first, because you must remember the direction
    # of this hole.
    printf '\n  %sThese are holes from the sandbox to your machine. To refresh them%s\n' \
        "$_DR_DIM" "$_DR_OFF" >&2
    printf '  %sat each start, set DRAUGR_HOST_PORTS in .draugr.conf.%s\n' \
        "$_DR_DIM" "$_DR_OFF" >&2
    exit 0
fi

# A close removes each rule that this command wrote for the port, not only the
# rule for the current address. You want to remove the old ones. If they stay,
# a "closed" port still works from an address that the machine can get again.
for port in "${close[@]+"${close[@]}"}"; do
    _check_port "$port"
    n=0
    while IFS= read -r id; do
        [ -n "$id" ] || continue
        dr_sbx policy rm network --sandbox "$DRAUGR_SANDBOX" --id "$id" >/dev/null \
            || dr_warn "could not remove rule $id"
        n=$((n + 1))
    done < <(dr_hostport_rules "$port")
    if [ "$n" -eq 0 ]; then
        dr_info "host port $port was not open for $DRAUGR_SANDBOX"
    else
        dr_ok "closed host port $port for $DRAUGR_SANDBOX ($n rule(s))"
    fi
done

for port in "${open[@]+"${open[@]}"}"; do
    _check_port "$port"

    ip=$(dr_host_ip) || dr_die \
        "could not find the address of this host" \
        "dr-hostport needs the address where a mound connects to this machine." \
        "Look at it yourself with:  ip -4 route get 1.1.1.1"
    want="$ip:$port"

    # Already correct, so do nothing, and say little. This runs at each dr-up.
    # You stop reading the output of a command that changes the machine at each
    # start.
    if [ "$(dr_hostport_open "$port")" = "$want" ]; then
        dr_info "host port $port already open at $want"
        _warn_if_loopback_only "$port"
        continue
    fi

    # Remove all that this command wrote for this port, before the new rule, not
    # after it. The removed address can be the address that this machine just
    # got again. The other order then deletes the new rule.
    stale=0
    while IFS= read -r id; do
        [ -n "$id" ] || continue
        stale=$((stale + 1))
        dr_sbx policy rm network --sandbox "$DRAUGR_SANDBOX" --id "$id" >/dev/null \
            || dr_warn "could not remove old rule $id"
    done < <(dr_hostport_rules "$port")

    dr_sbx policy allow network --sandbox "$DRAUGR_SANDBOX" "$want" >/dev/null \
        || dr_die "could not open host port $port" \
                  "See the rules in force with:  dr-policy"

    # The code reports the count, because a replacement is the important case.
    # It means that the address changed. This command handles that with few
    # words, but not silently.
    if [ "$stale" -gt 0 ]; then
        dr_ok "host port $port -> $want (replaced $stale old rule(s))"
    else
        dr_ok "host port $port -> $want"
    fi
    _warn_if_loopback_only "$port"
done

# Both loops end here, so the file is written once, for any number of ports.
_write_host_env
