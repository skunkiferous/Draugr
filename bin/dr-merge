#!/usr/bin/env bash
# dr-merge: accept the work of the agent onto your branch.
#
# Treat it as the branch of a colleague. This is an ordinary git merge of
# draugr/<branch>. After it, all git commands still work: amend, rebase, reset.
# Nothing is pushed. You publish with your own `git push`.
#
#   dr-merge                 merge draugr/<branch>
#   dr-merge --pick <sha>    cherry-pick one commit instead
#   dr-merge --ff-only       refuse a change that needs a merge commit
set -euo pipefail

DR_PROG=dr-merge
# readlink -f comes first. install.sh links this file into ~/.local/bin, and
# through a link BASH_SOURCE is the LINK. Without it, ../lib is ~/.local/lib.
_dr_bin=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$_dr_bin/../lib/common.sh"

# Unknown arguments go to git merge. Thus --squash, --no-ff, and similar options
# work, and dr-merge does not have to know them.
pick=
git_args=()
while [ $# -gt 0 ]; do
    case "$1" in
        --pick) shift; pick=${1:-}; [ -n "$pick" ] || dr_die "--pick needs a commit" ;;
        -h|--help) dr_help "$0"; exit 0 ;;
        *) git_args+=("$1") ;;
    esac
    shift
done

dr_context

# A merge into a dirty tree can lose uncommitted work. git refuses some of
# these cases, but not all, and its message does not tell what to do.
if ! dr_repo_is_clean "$DR_REPO"; then
    dr_error "your working tree has uncommitted changes"
    _dirty=$(dr_dirty_list "$DR_REPO")
    printf '%s\n' "$_dirty" >&2

    # A change of only the mode is often the SAME change that the mound sends.
    # Then there is nothing to keep, and the merge brings it. The message makes
    # a dead end into one command.
    if [[ "$_dirty" == *"no content change"* ]]; then
        printf '  %sA change of only the mode is often the change that the mound sends.%s\n' \
            "$_DR_DIM" "$_DR_OFF" >&2
        printf '  %sUnstage it, and let the merge bring it:  git restore --staged <path>%s\n' \
            "$_DR_DIM" "$_DR_OFF" >&2
    fi

    dr_die "refusing to merge into it" \
        "Commit or stash them first. A merge on top of uncommitted work is hard to undo."
fi

dr_require_tracking_ref
tracking=$(dr_tracking_ref)

# --pick takes one commit, not the whole branch. It is for an agent that did
# three useful things, and one that you do not want.
if [ -n "$pick" ]; then
    dr_info "cherry-picking $pick onto $(dr_repo_branch "$DR_REPO")"
    git -C "$DR_REPO" cherry-pick "$pick" || dr_die \
        "cherry-pick failed" \
        "Resolve it, then:  git cherry-pick --continue" \
        "Or stop it with:  git cherry-pick --abort"
    dr_ok "picked $pick"
    exit 0
fi

# Say clearly that there is nothing to do. Otherwise git prints "Already up to
# date.", and you do not know whether dr-sync ran.
if [ "$(git -C "$DR_REPO" rev-list --count "HEAD..$tracking")" -eq 0 ]; then
    dr_ok "nothing to merge. $tracking has nothing that your branch does not have."
    exit 0
fi

dr_info "merging $tracking into $(dr_repo_branch "$DR_REPO")"
git -C "$DR_REPO" merge "${git_args[@]+"${git_args[@]}"}" "$tracking" || dr_die \
    "merge failed" \
    "Resolve the conflicts, then:  git commit" \
    "Or undo all of it with:  git merge --abort"

dr_ok "merged"
printf '  %sPublish it as usual:  git push%s\n' "$_DR_DIM" "$_DR_OFF" >&2
