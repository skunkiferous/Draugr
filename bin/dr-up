#!/usr/bin/env bash
# dr-up - make sure this repo's mound exists and is running. Does not attach.
#
# Idempotent: absent means create, stopped means start, running means say so and
# stop. Creation flags (ports, memory, template, kit) only apply when the sandbox
# is actually created - sbx bakes them into the spec, so changing one in the
# config and re-running dr-up will NOT take effect until you dr-rm and recreate.
#
#   dr-up              create or start it
#   dr-up --recreate   remove it first, so creation flags are re-applied
#   dr-up --print      show the sbx command line, run nothing
set -euo pipefail

DR_PROG=dr-up
_dr_bin=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$_dr_bin/../lib/common.sh"

# --print is a dry run and --recreate is destructive, so they are deliberately
# separate flags rather than one clever one.
recreate=
print=
while [ $# -gt 0 ]; do
    case "$1" in
        --recreate) recreate=1 ;;
        --print|-n) print=1 ;;
        -y|--yes)   DR_ASSUME_YES=1 ;;
        -h|--help)  sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) dr_die "unknown option: $1" "Try: dr-up --help" ;;
    esac
    shift
done

# Creating a mound implies creating whatever the mound is *of*, so this is the
# other command allowed to make a repository - and the one that lets `dr-go`
# work in a fresh directory. Identical to dr_context unless
# DRAUGR_ON_MISSING_REPO says otherwise, and that defaults to refusing.
dr_context_create

# --- assemble the creation command ------------------------------------------
#
# Built as an array, never as a string, so that a workspace path containing a
# space stays one argument. Order matters only in that the agent and the paths
# are positional and must come last: `sbx create [flags] AGENT PATH [PATH...]`.
create_args=(create --name "$DRAUGR_SANDBOX")

# The whole premise of the tool. false gives the agent your real working tree,
# read-write; dr-go is where that gets challenged, because dr-up is also called
# from scripts where a prompt would hang.
if dr_is_true "$DRAUGR_CLONE"; then
    create_args+=(--clone)
fi

# Empty means "let sbx decide", which is a better default than anything we could
# invent, so each of these is only passed when the user actually set it.
[ -n "$DRAUGR_MEMORY" ]   && create_args+=(-m "$DRAUGR_MEMORY")
[ -n "$DRAUGR_CPUS" ]     && create_args+=(--cpus "$DRAUGR_CPUS")
[ -n "$DRAUGR_TEMPLATE" ] && create_args+=(-t "$DRAUGR_TEMPLATE")

# DRAUGR_KIT is a list, and each entry becomes its own --kit. sbx takes the flag
# repeatedly and merges what it finds, so a shared library kit ADDS to the
# project's rather than replacing it - verified against sbx 0.37.1, where two
# mixins on one sandbox contributed both their install commands and both their
# network rules.
#
# A resolved entry that is a directory on this disk has to be spelled the Windows
# way for sbx.exe; anything else is a reference format we do not own and goes
# through untouched. "Is it a directory?" is the honest way to tell them apart.
if [ -n "$DRAUGR_KIT" ]; then
    while IFS= read -r _ref; do
        if [ -d "$_ref" ]; then
            # dr_path_win_kit, not dr_path_win: the kit library defaults to
            # ~/.config/draugr/kits, which is on WSL's own ext4 and has no
            # drive-letter spelling. A kit is read host-side rather than
            # bind-mounted, so the UNC form works there - see the helper.
            create_args+=(--kit "$(dr_path_win_kit "$_ref")") || dr_die \
                "cannot spell $_ref in a way sbx.exe can read" \
                "Kits outside /mnt/<drive> need \$WSL_DISTRO_NAME, which WSL sets." \
                "Move the kit onto a Windows drive, or set DRAUGR_KIT_STORE to one."
        else
            create_args+=(--kit "$_ref")
        fi
    done < <(dr_kit_refs)

    # Entries that resolved to nothing are reported one by one, by the name you
    # wrote. A kit is optional, so this warns rather than refusing - but a silent
    # miss would mean a mound quietly built without the network rules you meant.
    while IFS= read -r _miss; do
        [ -n "$_miss" ] || continue
        if [ "${DR_ORIGIN[DRAUGR_KIT]}" = "built-in default" ]; then
            # The default location, and nobody asked for it: an ordinary repo
            # that has not opted into kits, not a mistake worth a warning.
            dr_debug "no kit at $_miss (default location, none configured)"
        else
            dr_warn "no kit found for '$_miss' - creating the mound without it"
            printf '  %sLooked in %s and in the kit store %s%s\n' \
                "$_DR_DIM" "$DR_REPO" "$(dr_kit_store)" "$_DR_OFF" >&2
            printf '  %sDRAUGR_KIT came from %s. Saved kits:  dr-kit list%s\n' \
                "$_DR_DIM" "${DR_ORIGIN[DRAUGR_KIT]}" "$_DR_OFF" >&2
        fi
    done < <(dr_kit_missing)
fi

# read -ra splits on whitespace into an array. Quoting "$DRAUGR_PORTS" here would
# make it a single argument, and leaving it unquoted at the call site would work
# but relies on word splitting happening to be right - this says so explicitly.
if [ -n "$DRAUGR_PORTS" ]; then
    read -ra _ports <<< "$DRAUGR_PORTS"
    for _p in "${_ports[@]}"; do create_args+=(-p "$_p"); done
fi

# Positional tail: the agent, this repo, then any extra workspaces.
create_args+=("$DRAUGR_AGENT" "$DR_REPO_WIN")

# Extra mounts carry an optional ":ro" suffix that must survive translation, so
# the suffix is split off, the path converted, and the suffix put back.
if [ -n "$DRAUGR_MOUNTS" ]; then
    read -ra _mounts <<< "$DRAUGR_MOUNTS"
    for _m in "${_mounts[@]}"; do
        _mode=
        case "$_m" in
            *:ro) _mode=:ro; _m=${_m%:ro} ;;
            *:rw) _mode=:rw; _m=${_m%:rw} ;;
        esac
        _win=$(dr_path_win "$_m") || dr_die \
            "extra mount is not on a Windows drive: $_m" \
            "sbx can only mount Windows paths. See DRAUGR_MOUNTS in your config."
        create_args+=("$_win$_mode")
    done
fi

# Print the resolved sbx.exe rather than the bare word "sbx": it is not on WSL's
# PATH, so a line starting "sbx create" would not run if you pasted it. %q quotes
# each argument for bash, which is what makes the result pasteable at all - a
# Windows path is full of backslashes and at least one of these has a space in it.
if [ -n "$print" ]; then
    printf '%q %s\n' "$(dr_find_sbx)" "$(printf '%q ' "${create_args[@]}")"
    exit 0
fi

# --- act on the current state -----------------------------------------------

state=$(dr_sandbox_state "$DRAUGR_SANDBOX")

# --recreate exists because creation flags are frozen into the sandbox spec: the
# only way to change a port mapping or the memory limit is to build a new mound.
if [ -n "$recreate" ] && [ "$state" != absent ]; then
    dr_confirm "Remove and recreate $DRAUGR_SANDBOX? Anything uncommitted inside it is lost." \
        || dr_die "cancelled"
    dr_sbx rm --force "$DRAUGR_SANDBOX" >/dev/null
    dr_ok "removed the old $DRAUGR_SANDBOX"
    state=absent
fi

# A sandbox that already exists was built with whatever the kit said at the time.
# Editing the kit changes nothing until it is applied, and applying it recreates
# the container - so say so rather than letting the difference go unnoticed.
report_drift() {
    local stamp
    dr_kit_refs >/dev/null || return 0
    stamp=$(dr_kit_stamp)
    [ -f "$stamp" ] || return 0
    [ "$(dr_kit_hash_all)" = "$(cat "$stamp")" ] && return 0
    dr_warn "the kit has changed since $DRAUGR_SANDBOX was built"
    printf '  %sThe mound still has the old rules and setup. Apply them with:%s\n' \
        "$_DR_DIM" "$_DR_OFF" >&2
    printf '  %s  dr-kit apply      (recreates the container)%s\n' "$_DR_DIM" "$_DR_OFF" >&2
}

# pre-up runs on every dr-up; post-create only when one is actually built. Both
# run on the HOST, in WSL, which is precisely what a kit's commands cannot do.
dr_hook pre-up "$DR_REPO"

case "$state" in
running)
    dr_ok "$DRAUGR_SANDBOX is already running"
    report_drift
    ;;

# Stopped sandboxes keep their state and their clone. `exec true` is the way to
# start one without attaching: sbx starts a stopped sandbox before running the
# command, and `true` is the cheapest possible command. (`sbx run` would start it
# too, but it also attaches, which is dr-go's job rather than dr-up's.)
stopped)
    dr_info "starting $DRAUGR_SANDBOX"
    dr_sbx exec "$DRAUGR_SANDBOX" true >/dev/null \
        || dr_die "could not start $DRAUGR_SANDBOX" "Look at:  dr-ls"
    dr_ok "started $DRAUGR_SANDBOX"
    report_drift
    ;;

# The hooks bracket creation because that is the only moment a repo can set up
# something on the HOST side - a kit runs inside the mound and cannot reach it.
absent)
    dr_info "creating $DRAUGR_SANDBOX for $DR_REPO_WIN"
    dr_debug "sbx $(printf '%q ' "${create_args[@]}")"
    dr_sbx "${create_args[@]}" || dr_die \
        "could not create $DRAUGR_SANDBOX" \
        "Re-run with DRAUGR_DEBUG=1 to see the exact sbx command line."
    dr_ok "created $DRAUGR_SANDBOX"

    # Record what the kit looked like at creation, so a later edit is detectable
    # as drift instead of silently doing nothing.
    if dr_kit_refs >/dev/null; then
        mkdir -p "$DR_REPO/.draugr"
        dr_kit_hash_all > "$(dr_kit_stamp)"
    fi

    dr_hook post-create "$DR_REPO"
    ;;

# dr_sandbox_state prints "unknown" when it cannot reach sbx at all, and anything
# else here means sbx grew a state we have not seen. Neither is worth guessing at.
*)
    dr_die "$DRAUGR_SANDBOX is in an unexpected state: $state" \
           "Check it with:  dr-ls"
    ;;
esac

# Data goes in after the mound is up but before the agent starts, so the files
# are already there when it looks. Push is host-wins, which is the safe default
# direction: the host copy is the one you can still recover from git or backup.
if [ "$DRAUGR_DATA_PUSH" = auto ] && [ -n "$DRAUGR_DATA" ] && [ -x "$_dr_bin/dr-data" ]; then
    "$_dr_bin/dr-data" push --yes || dr_warn "auto data push failed; retry with:  dr-data push"
fi

# Memory, same timing and for the same reason: the agent reads it at startup, so
# it has to be in place before dr-go attaches. --if-empty is what makes this safe
# to run on every dr-up rather than only on the one that created the mound - the
# store is always the older copy, so it may fill a mound that has nothing and
# must never overwrite one that has something.
if [ "$DRAUGR_MEM_SYNC" = auto ] && [ -x "$_dr_bin/dr-mem" ]; then
    "$_dr_bin/dr-mem" import --if-empty --yes \
        || dr_warn "auto memory import failed; retry with:  dr-mem import"
fi

dr_hook post-up "$DR_REPO"
