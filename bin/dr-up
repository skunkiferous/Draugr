#!/usr/bin/env bash
# dr-up: make sure that the mound of this repo exists and runs. It does not
# attach.
#
# Idempotent (safe to run twice). Absent means create, stopped means start, and
# running means say so and stop. Creation flags (ports, memory, template, kit)
# apply only at the creation of the sandbox. sbx fixes them in the spec. If you
# change one in the configuration and run dr-up again, the change does NOT apply
# until you run dr-rm and create the mound again.
#
#   dr-up              create or start it
#   dr-up --recreate   remove it first, so that the creation flags apply again
#   dr-up --print      show the sbx command line, and run nothing
#   dr-up --force      with --recreate, also skip the unfetched/unexported tests
#   dr-up --skip-deps  start only this mound, without what DRAUGR_REQUIRES names
set -euo pipefail

DR_PROG=dr-up
# readlink -f comes first. install.sh links this file into ~/.local/bin, and
# through a link BASH_SOURCE is the LINK. Without it, ../lib is ~/.local/lib.
_dr_bin=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$_dr_bin/../lib/common.sh"

# --print is a dry run, and --recreate is destructive. Thus they are separate
# flags, on purpose, not one clever flag.
#
# --yes and --force are separate, for the same reason as in dr-rm. --yes means
# "stop asking me", and still refuses to destroy work that exists only here.
# --force means "I know that it is there, and I want it gone".
recreate=
print=
force=
skip_deps=
while [ $# -gt 0 ]; do
    case "$1" in
        --recreate) recreate=1 ;;
        --print|-n) print=1 ;;
        -y|--yes)   DR_ASSUME_YES=1 ;;
        -f|--force) force=1; DR_ASSUME_YES=1 ;;
        --skip-deps) skip_deps=1 ;;
        -h|--help)  dr_help "$0"; exit 0 ;;
        *) dr_die "unknown option: $1" "Try: dr-up --help" ;;
    esac
    shift
done

# A new mound needs the repository that it is *of*. Thus this is the other
# command that can make a repository, and the one that lets `dr-go` work in a
# new directory. It is the same as dr_context, unless DRAUGR_ON_MISSING_REPO
# says otherwise. The default of that key is to refuse.
dr_context_create

# --- assemble the creation command ------------------------------------------
#
# An array, never a string, so that a workspace path with a space stays one
# argument. The order matters only for the agent and the paths. They are
# positional, and must come last: `sbx create [flags] AGENT PATH [PATH...]`.
create_args=(create --name "$DRAUGR_SANDBOX")

# The basis of the tool. false gives the agent your real working tree,
# read-write. dr-go asks about that, because scripts also call dr-up, and there
# a question hangs.
if dr_is_true "$DRAUGR_CLONE"; then
    create_args+=(--clone)
fi

# Empty means "let sbx decide". That is better than a default that we invent.
# Thus the code passes only the values that the user set.
[ -n "$DRAUGR_MEMORY" ]   && create_args+=(-m "$DRAUGR_MEMORY")
[ -n "$DRAUGR_CPUS" ]     && create_args+=(--cpus "$DRAUGR_CPUS")
[ -n "$DRAUGR_TEMPLATE" ] && create_args+=(-t "$DRAUGR_TEMPLATE")

# DRAUGR_KIT is a list, and each entry becomes its own --kit. sbx takes the flag
# many times, and merges what it finds. Thus a shared library kit ADDS to the
# kit of the project, and does not replace it. A test with sbx 0.37.1 showed
# this: two mixins on one sandbox gave both their install commands and both
# their network rules.
#
# For sbx.exe, a resolved entry that is a directory on this disk needs a Windows
# path. Other entries are a reference format that we do not own, and go without
# change. "Is it a directory?" is the correct test to tell them apart.
if [ -n "$DRAUGR_KIT" ]; then
    while IFS= read -r _ref; do
        if [ -d "$_ref" ]; then
            # dr_path_win_kit, not dr_path_win. The default kit library is
            # ~/.config/draugr/kits. That is on the ext4 of WSL, and has no path
            # with a drive letter. sbx reads a kit on the host, and does not
            # bind-mount it, so the UNC form works there. See the helper.
            create_args+=(--kit "$(dr_path_win_kit "$_ref")") || dr_die \
                "cannot write $_ref as a path that sbx.exe can read" \
                "Kits outside /mnt/<drive> need \$WSL_DISTRO_NAME, which WSL sets." \
                "Move the kit onto a Windows drive, or set DRAUGR_KIT_STORE to one."
        else
            create_args+=(--kit "$_ref")
        fi
    done < <(dr_kit_refs)

    # Report each entry that resolved to nothing, with the name that you wrote.
    # A kit is optional, so this warns, and does not refuse. A silent miss gives
    # a mound without the network rules that you wanted, with no message.
    while IFS= read -r _miss; do
        [ -n "$_miss" ] || continue
        if [ "${DR_ORIGIN[DRAUGR_KIT]}" = "built-in default" ]; then
            # The default location, and nobody asked for it. This is an ordinary
            # repo with no kits, not an error, so it gets no warning.
            dr_debug "no kit at $_miss (default location, none configured)"
        else
            dr_warn "no kit found for '$_miss'. Creating the mound without it."
            printf '  %sLooked in %s and in the kit store %s%s\n' \
                "$_DR_DIM" "$DR_REPO" "$(dr_kit_store)" "$_DR_OFF" >&2
            printf '  %sDRAUGR_KIT came from %s. Saved kits:  dr-kit list%s\n' \
                "$_DR_DIM" "${DR_ORIGIN[DRAUGR_KIT]}" "$_DR_OFF" >&2
        fi
    done < <(dr_kit_missing)
fi

# read -ra splits on whitespace into an array. With quotes, "$DRAUGR_PORTS" is
# one argument. Without quotes at the call, it works, but only because word
# splitting is correct by chance. This form says it explicitly.
if [ -n "$DRAUGR_PORTS" ]; then
    read -ra _ports <<< "$DRAUGR_PORTS"
    for _p in "${_ports[@]}"; do create_args+=(-p "$_p"); done
fi

# The positional end: the agent, this repo, then the extra workspaces.
create_args+=("$DRAUGR_AGENT" "$DR_REPO_WIN")

# Extra mounts have an optional ":ro" suffix, and it must stay after the
# translation. Thus the code removes the suffix, converts the path, and adds the
# suffix again.
if [ -n "$DRAUGR_MOUNTS" ]; then
    read -ra _mounts <<< "$DRAUGR_MOUNTS"
    for _m in "${_mounts[@]}"; do
        _mode=
        case "$_m" in
            *:ro) _mode=:ro; _m=${_m%:ro} ;;
            *:rw) _mode=:rw; _m=${_m%:rw} ;;
        esac
        _win=$(dr_path_win "$_m") || dr_die \
            "extra mount is not on a Windows drive: $_m" \
            "sbx can only mount Windows paths. See DRAUGR_MOUNTS in your configuration."
        create_args+=("$_win$_mode")
    done
fi

# Print the resolved sbx.exe, not the word "sbx". It is not on the PATH of WSL,
# so a pasted line that starts with "sbx create" does not run. %q quotes each
# argument for bash. Only that makes the result ready to paste. A Windows path
# has many backslashes, and at least one of these has a space.
if [ -n "$print" ]; then
    printf '%q %s\n' "$(dr_find_sbx)" "$(printf '%q ' "${create_args[@]}")"
    exit 0
fi

# --- act on the current state -----------------------------------------------

state=$(dr_sandbox_state "$DRAUGR_SANDBOX")

# sbx cannot compose a kit for another agent with this one. It says so only at
# creation, in its own words, about a YAML field that you did not know it read.
# `sbx kit validate` accepts such a kit. Thus this test must be ours.
#
# It runs BEFORE the --recreate removal below, not at creation. A refusal after
# the removal leaves you with no mound. It destroys a working mound because of a
# problem that was visible before. A test showed this: somebody did exactly
# that.
if [ "$state" = absent ] || [ -n "$recreate" ]; then
    while IFS=' ' read -r _kit _want; do
        [ -n "$_kit" ] || continue
        dr_die "kit $_kit requires agent \"$_want\", but DRAUGR_AGENT is \"$DRAUGR_AGENT\"" \
               "sbx refuses to compose them, and says so in its own words." \
               "Remove the 'requires: agent:' line from $_kit/spec.yaml," \
               "or keep a separate kit for this agent:  $_kit.$DRAUGR_AGENT/"
    done < <(dr_kit_agent_conflicts)
fi

# --recreate destroys the mound, and a mound holds three things that exist only
# there. The code tests all three BEFORE it removes something, for the same
# reason as the kit-agent test above. A refusal after the removal leaves you
# with no mound, because of a problem that was visible before.
#
# The first two: commits of the agent that you never fetched, and the memory
# that it wrote. dr-rm refuses for both. Before, this path called `sbx rm
# --force` directly, and asked about neither. Thus --recreate was silently MORE
# destructive than the command whose job is to destroy. You run --recreate
# after you edit the configuration, and then nobody thinks about the memory of
# the agent.
#
# A copy of dr-rm, not shared, as the policy guard below, because the fix
# differs. There it ends with "then dr-rm again". Here it names the command
# that you ran.
if [ -n "$recreate" ] && [ -z "$force" ] && [ "$state" != absent ]; then
    if [ -x "$_dr_bin/dr-sync" ]; then
        _check=0
        "$_dr_bin/dr-sync" --check-only || _check=$?
        case "$_check" in
            1) dr_die \
                   "$DRAUGR_SANDBOX has commits that you did not fetch" \
                   "A recreate destroys them. Fetch them first with:  dr-sync" \
                   "Then run dr-up --recreate again. To discard them:  dr-up --recreate --force" ;;
            2) dr_warn "could not connect to $DRAUGR_SANDBOX to look for unfetched commits" ;;
        esac
    fi

    # DRAUGR_MEM_SYNC=off means "I do not keep agent memory". A refusal for it
    # is an obstacle, not a guard. dr-rm makes the same exception.
    if [ "${DRAUGR_MEM_SYNC:-}" != off ] && [ -x "$_dr_bin/dr-mem" ]; then
        _mcheck=0
        "$_dr_bin/dr-mem" check || _mcheck=$?
        case "$_mcheck" in
            1) dr_die \
                   "$DRAUGR_SANDBOX has memory that you did not export" \
                   "A recreate destroys it. Export it first with:  dr-mem export" \
                   "Then run dr-up --recreate again. To discard it:  dr-up --recreate --force" ;;
            2) dr_warn "could not connect to $DRAUGR_SANDBOX to look for memory that is not exported" ;;
        esac
    fi
fi

# The third: each host that dr-policy --allow opened. Those rules are for the
# sandbox, and die with it. This is the worst time to lose them. You recreate
# after the build finally works. Thus the list that made it work goes away at
# the moment that you want to make it permanent. The fix is the same as the
# guard in dr-rm.
if [ -n "$recreate" ] && [ -z "$force" ] && [ "$state" != absent ]; then
    mapfile -t _opened < <(dr_policy_unadopted)
    if [ ${#_opened[@]} -gt 0 ]; then
        dr_die "${#_opened[@]} host(s) are open for $DRAUGR_SANDBOX, and not in the kit" \
               "$(printf '%s ' "${_opened[@]}")" \
               "A recreate destroys them. Write them down first:  dr-kit adopt" \
               "Or accept the loss:  dr-up --recreate --force"
    fi
fi


# What this mound needs to RUN, before the code destroys or builds something.
#
# Before, for the same reason as the tests above. An exclusive dependency that
# another project holds refuses. A refusal after the removal leaves you with no
# mound, because of a problem that was visible before. It is also the correct
# order for its own reason. The gateway must answer before the mound that uses
# it exists.
#
# --print already exited above, so a dry run never starts anything.
if [ -z "$skip_deps" ] && [ -n "${DRAUGR_REQUIRES:-}" ]; then
    "$_dr_bin/dr-dep" up || exit 1
fi

# --recreate exists because the creation flags are frozen in the sandbox spec.
# To change a port mapping or the memory limit, you must build a new mound.
if [ -n "$recreate" ] && [ "$state" != absent ]; then
    dr_confirm "Remove and recreate $DRAUGR_SANDBOX? All uncommitted work inside it is lost." \
        || dr_die "cancelled"
    dr_sbx rm --force "$DRAUGR_SANDBOX" >/dev/null
    dr_ok "removed the old $DRAUGR_SANDBOX"
    state=absent
fi

# An existing sandbox has the kit from the time of its build. An edit of the kit
# changes nothing until you apply it, and the apply recreates the container.
# Thus say so, so that you see the difference.
report_drift() {
    local stamp changed
    if dr_kit_refs >/dev/null; then
        stamp=$(dr_kit_stamp)
        # Only the first line. The stamp also records each kit, for dr-kit
        # apply.
        if [ -f "$stamp" ] && [ "$(dr_kit_hash_all)" != "$(dr_kit_stamp_hash)" ]; then
            dr_warn "the kit changed after $DRAUGR_SANDBOX was built"
            printf '  %sThe mound still has the old rules and setup. Apply them with:%s\n' \
                "$_DR_DIM" "$_DR_OFF" >&2
            printf '  %s  dr-kit apply      (tells if it can, or if it needs a recreate)%s\n' \
                "$_DR_DIM" "$_DR_OFF" >&2
        fi
    fi

    # The same silent no-op, for the keys that sbx freezes in the sandbox spec.
    # Otherwise, after a new mount and dr-go, you look at a directory that is
    # not there, and nothing on the screen tells why.
    changed=$(dr_create_drift)
    [ -n "$changed" ] || return 0
    # tr, not an unquoted expansion. The list has a newline between items. A
    # bare $changed depends on the decisions of IFS and globbing.
    dr_warn "changed after $DRAUGR_SANDBOX was built: $(printf '%s' "$changed" | tr '\n' ' ')"
    printf '  %sThese are fixed at the creation of the mound, so the running one still%s\n' \
        "$_DR_DIM" "$_DR_OFF" >&2
    printf '  %shas the old values. Build it again with:%s\n' "$_DR_DIM" "$_DR_OFF" >&2
    printf '  %s  dr-up --recreate%s\n' "$_DR_DIM" "$_DR_OFF" >&2
    case "$changed" in
        # Only ports have an answer during a session. Thus name it, and do not
        # send somebody to rebuild a mound for a port that they can publish.
        *DRAUGR_PORTS*) printf '  %s  dr-ports          (ports only, no rebuild)%s\n' \
            "$_DR_DIM" "$_DR_OFF" >&2 ;;
    esac
}

# Set here, so that create_failed works alone. It gets a real value directly
# before the create attempt.
_log_mark=0

# The message for a refused create. Its own message is already on the
# screen, and is often only a 500. Thus the useful part is what its daemon
# recorded. See dr_sbx_log_error. Printed above the advice, and not dim, because
# it is evidence, not a suggestion.
create_failed() {
    local detail line
    detail=$(dr_sbx_log_error "$_log_mark") || detail=
    if [ -n "$detail" ]; then
        dr_heading "sandboxd recorded:"
        while IFS= read -r line; do
            printf '  %s\n' "$line" >&2
        done <<<"$detail"
        printf '\n' >&2
    fi

    # A failed install command is the one case to explain directly, because the
    # command usually looks correct. commands.install runs BEFORE the repo is in
    # the workspace. Thus a command that reads a project file cannot work. Tests
    # with sbx 0.37.1 in clone mode and in mount mode showed this. The working
    # directory is empty, and in clone mode the repo is read-only at
    # /run/sandbox/source.
    if [ "${detail#*commands.install}" != "$detail" ]; then
        dr_die "could not create $DRAUGR_SANDBOX" \
            "A kit install command failed. Those run BEFORE your repository is in" \
            "the workspace, so one that reads a project file always fails. At that" \
            "time, the working directory is empty, and the repo is read-only at" \
            "/run/sandbox/source. Install tools there, not the project."
    fi

    # A kit is the most likely other cause. sbx says so in its own words, two
    # steps from the cause. "invalid name" is about a field in a YAML file that
    # you did not know it read. Thus, with kits, name the command that tests
    # them before the debug flag.
    if dr_kit_refs >/dev/null; then
        dr_die "could not create $DRAUGR_SANDBOX" \
            "The message above is from sbx. If it names the kit, test it with:" \
            "  dr-kit validate" \
            "To see the exact sbx command line, run again with DRAUGR_DEBUG=1."
    fi
    dr_die "could not create $DRAUGR_SANDBOX" \
        "To see the exact sbx command line, run again with DRAUGR_DEBUG=1."
}

# The same evidence for a refused START. The create path has printed what
# sandboxd recorded from the beginning, and the start path printed
# "Look at: dr-ls", which is nothing to go on. A hard reset sent a
# start down this path, nine log lines named the cause, and the user saw none of
# them.
start_failed() {
    local detail line
    detail=$(dr_sbx_log_error "$_log_mark") || detail=
    if [ -n "$detail" ]; then
        dr_heading "sandboxd recorded:"
        while IFS= read -r line; do
            printf '  %s\n' "$line" >&2
        done <<<"$detail"
        printf '\n' >&2
    fi

    # The one signature worth naming. After a hard reset, the startup recovery
    # of sandboxd reopens the block images of a sandbox that still had a runtime
    # record, and then cannot open them again to boot the VM. A test found the
    # holder by trying to open the .img exclusively: held
    # before `sbx daemon stop`, free after. The process that holds the file IS
    # the daemon.
    #
    # The advice never says `sbx daemon start`. That runs in the FOREGROUND, so
    # a reader who pastes it gets a daemon in their terminal. Any ordinary sbx
    # command starts a detached one.
    case $detail in
        *"os error 32"* | *"used by another process"*)
            dr_die "could not start $DRAUGR_SANDBOX, because its disk is held open" \
                "After a hard reset, sandboxd reopens the images of a sandbox that still" \
                "had a runtime record, and then cannot open them to boot it. The process" \
                "that holds the file is the daemon itself." \
                "Make it let go, and the next sbx command starts a detached one:" \
                "  sbx daemon stop" \
                "  dr-up"
            ;;
    esac

    # Every other refused start. One remedy covers the family: a daemon that
    # came back from a crash can hold state that only a restart clears.
    dr_die "could not start $DRAUGR_SANDBOX" \
        "If it fails again, the daemon may hold state from a crash. Stop it, and" \
        "the next sbx command starts a detached one:" \
        "  sbx daemon stop" \
        "Then:  dr-up        See also:  dr-ls   sbx diagnose"
}

# pre-up runs at each dr-up. post-create runs only after a mound is built. Both
# run on the HOST, in WSL. The commands of a kit cannot do that.
dr_hook pre-up "$DR_REPO"

case "$state" in
running)
    dr_ok "$DRAUGR_SANDBOX is already running"
    report_drift
    ;;

# Stopped sandboxes keep their state and their clone. `exec true` starts one
# without an attach. sbx starts a stopped sandbox before it runs the command,
# and `true` is the cheapest command. (`sbx run` also starts it, but it attaches
# too. That is the job of dr-go, not of dr-up.)
stopped)
    dr_info "starting $DRAUGR_SANDBOX"
    # The same mark the create path takes, for the same reason: a failure report
    # must use only what THIS attempt added.
    _log_mark=$(dr_sbx_log_mark)
    dr_sbx exec "$DRAUGR_SANDBOX" true >/dev/null || start_failed
    dr_ok "started $DRAUGR_SANDBOX"
    report_drift
    ;;

# The hooks are before and after creation, because only then can a repo set up
# something on the HOST side. A kit runs inside the mound, and cannot reach it.
absent)
    dr_info "creating $DRAUGR_SANDBOX for $DR_REPO_WIN"
    dr_debug "sbx $(printf '%q ' "${create_args[@]}")"
    # The position of the log of sandboxd before the attempt. Thus a failure
    # report uses only what THIS create added, and nothing older.
    _log_mark=$(dr_sbx_log_mark)
    dr_sbx "${create_args[@]}" || create_failed
    dr_ok "created $DRAUGR_SANDBOX"

    # Record the source of the build, so that a later edit shows as drift, and
    # does not do nothing silently. The kit stamp exists only for a mound with
    # kits. The configuration stamp always exists, because each mound has a
    # configuration.
    mkdir -p "$DR_REPO/.draugr"
    if dr_kit_refs >/dev/null; then
        dr_kit_stamp_write
    fi
    dr_create_facts > "$(dr_create_stamp)"

    dr_hook post-create "$DR_REPO"
    ;;

# If dr_sandbox_state cannot reach sbx, it prints "unknown". Other values here
# mean that sbx has a new state that we did not see. Do not guess for either.
*)
    dr_die "$DRAUGR_SANDBOX is in an unexpected state: $state" \
           "Look at it with:  dr-ls"
    ;;
esac

# Data goes in after the mound starts, but before the agent starts. Thus the
# files are already there at its first look. In a push, the host wins. That is
# the safe default direction, because you can get the host copy back from git or
# a backup.
if [ "$DRAUGR_DATA_PUSH" = auto ] && [ -n "$DRAUGR_DATA" ] && [ -x "$_dr_bin/dr-data" ]; then
    "$_dr_bin/dr-data" push --yes || dr_warn "auto data push failed. Try again with:  dr-data push"
fi

# Memory, at the same time and for the same reason. The agent reads it at its
# start, so it must be there before dr-go attaches. --if-empty makes this safe
# at each dr-up, not only at the one that created the mound. The store is always
# the older copy. Thus it can fill an empty mound, but must never overwrite a
# mound that has something.
if [ "$DRAUGR_MEM_SYNC" = auto ] && [ -x "$_dr_bin/dr-mem" ]; then
    "$_dr_bin/dr-mem" import --if-empty --yes \
        || dr_warn "auto memory import failed. Try again with:  dr-mem import"
fi

# Host ports last, because their address is true only for this boot. The code
# resolves it again at each up, and does not store it. Only that makes
# DRAUGR_HOST_PORTS work after a reboot. See dr_host_ip. A failure warns, and
# does not stop. The mound already runs, and a session without the hole is still
# a session.
if [ -n "$DRAUGR_HOST_PORTS" ] && [ -x "$_dr_bin/dr-hostport" ]; then
    read -ra _hostports <<< "$DRAUGR_HOST_PORTS"
    for _hp in "${_hostports[@]}"; do
        "$_dr_bin/dr-hostport" "$_hp" \
            || dr_warn "could not open host port $_hp. Try again with:  dr-hostport $_hp"
    done
fi

dr_hook post-up "$DR_REPO"
