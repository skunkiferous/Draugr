#!/usr/bin/env bash
# dr-rm - destroy the mound. The agent's clone goes with it.
#
# Everything the agent committed but you never fetched is gone for good, which is
# why this asks first. dr-stop is the one you want if you just wish it would stop
# using memory.
#
#   dr-rm              destroy this repo's mound
#   dr-rm <name>       destroy one by name
#   dr-rm --yes        skip the confirmation prompt
#   dr-rm --force      also skip the unfetched-commits check. This throws work away.
set -euo pipefail

DR_PROG=dr-rm
_dr_bin=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$_dr_bin/../lib/common.sh"

# A bare word is a sandbox name, which is how you remove one belonging to a repo
# you have since deleted - the commonest reason to reach for dr-rm by name.
#
# --yes and --force are deliberately different. --yes means "stop asking me", and
# still refuses to destroy work you have not fetched. --force means "I know there
# is unfetched work and I want it gone" - two separate decisions, so answering
# one does not silently answer the other.
name=
force=
while [ $# -gt 0 ]; do
    case "$1" in
        -y|--yes)   DR_ASSUME_YES=1 ;;
        -f|--force) force=1; DR_ASSUME_YES=1 ;;
        -h|--help)  dr_help "$0"; exit 0 ;;
        -*) dr_die "unknown option: $1" "Try: dr-rm --help" ;;
        *) name=$1 ;;
    esac
    shift
done

# $repo stays empty when a name was given, because there may not be a repo to
# find - and the unsynced-work check below has nothing to compare against then.
repo=
if [ -z "$name" ]; then
    dr_context
    name=$DRAUGR_SANDBOX
    repo=$DR_REPO
fi

[ "$(dr_sandbox_state "$name")" != absent ] || dr_die "$name does not exist" "See what does:  dr-ls"

# Ask the mound what it has before destroying it. This costs a few seconds and
# will start a stopped sandbox, because the only way to know whether the agent
# committed something you never fetched is to ask it - a local tracking ref only
# says what was true at the last dr-sync. Worth it: the alternative is losing
# work permanently. Skipped when a bare name was given, since without a repo
# there is nothing to compare against.
if [ -z "$force" ] && [ -n "$repo" ] && [ -x "$_dr_bin/dr-sync" ]; then
    check=0
    "$_dr_bin/dr-sync" --check-only || check=$?
    case "$check" in
        1) dr_die \
               "$name has commits you have not fetched" \
               "Fetch them first with:  dr-sync" \
               "Then dr-rm again. To throw them away instead:  dr-rm --force" ;;
        # Could not reach the mound. Not proof that it is safe, so say so and let
        # the confirmation below be an informed one rather than a formality.
        2) dr_warn "could not reach $name to check for unfetched commits"
           printf '  %sIf the agent committed something you never fetched, this destroys it.%s\n' \
               "$_DR_DIM" "$_DR_OFF" >&2 ;;
    esac
fi

# The same question again for the other thing a mound holds that exists nowhere
# else. Commits at least leave a trace in the clone's reflog until it is gone;
# memory the agent wrote is simply the disk image, and dr-rm deletes that.
#
# DRAUGR_MEM_SYNC=off skips it: that value means "I do not keep agent memory",
# and refusing to remove a mound over something you have said you do not want is
# just an obstacle. manual still checks - it only turns off the automatic half.
if [ -z "$force" ] && [ -n "$repo" ] && [ "${DRAUGR_MEM_SYNC:-}" != off ] \
   && [ -x "$_dr_bin/dr-mem" ]; then
    mcheck=0
    "$_dr_bin/dr-mem" check || mcheck=$?
    case "$mcheck" in
        1) dr_die \
               "$name has memory you have not exported" \
               "Export it first with:  dr-mem export" \
               "Then dr-rm again. To throw it away instead:  dr-rm --force" ;;
        2) dr_warn "could not reach $name to check for unexported memory" ;;
    esac
fi

dr_confirm "Destroy $name and its clone? Any commits you have not fetched are lost." \
    || dr_die "cancelled"

dr_hook pre-rm "${repo:-$PWD}"
# --force does two jobs here: it skips sbx's own confirmation, which we have
# already asked in our own words, and it removes a sandbox that still has an SSH
# connection open - a stale one otherwise blocks removal for no good reason.
dr_sbx rm --force "$name" >/dev/null || dr_die "could not remove $name"
dr_ok "removed $name"
