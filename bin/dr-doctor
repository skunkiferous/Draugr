#!/usr/bin/env bash
# dr-doctor: test each precondition, and tell what to fix.
#
# Run it first. If something does not work as expected, run it again. Each
# failure comes with its fix, so you never must search for the meaning of a
# line.
#
#   dr-doctor          test everything
#   dr-doctor --quiet  only report problems
set -euo pipefail

DR_PROG=dr-doctor
# readlink -f comes first. install.sh links this file into ~/.local/bin, and
# through a link BASH_SOURCE is the LINK. Without it, ../lib is ~/.local/lib.
_dr_bin=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$_dr_bin/../lib/common.sh"

# There is only one option, so a case is simpler than an argument loop.
quiet=
case "${1:-}" in
    --quiet|-q) quiet=1 ;;
    -h|--help)  dr_help "$0"; exit 0 ;;
    "") ;;
    *) dr_die "unknown option: $1" ;;
esac

fails=0
warns=0

# Three report helpers, all called the same way:
#
#     bad "<label>" "<what is wrong>" "<remedy line>" "<remedy line>" ...
#
# %-34s pads the label to 34 columns, so that the second column lines up.
# `shift 2` removes the label and the summary. The fix lines stay in "$@", and
# print indented below. `|| shift $#` is for a call with fewer than two
# arguments. Then `shift 2` fails, and `set -e` stops the script.
ok()   { [ -n "$quiet" ] || printf '  %s✓%s %-34s %s\n' "$_DR_GREEN" "$_DR_OFF" "$1" "${2:-}"; }
bad()  {
    fails=$((fails + 1))
    printf '  %s✗%s %-34s %s\n' "$_DR_RED" "$_DR_OFF" "$1" "${2:-}"
    shift 2 || shift $#
    for l in "$@"; do printf '      %s%s%s\n' "$_DR_DIM" "$l" "$_DR_OFF"; done
}
soft() {
    warns=$((warns + 1))
    printf '  %s!%s %-34s %s\n' "$_DR_YELLOW" "$_DR_OFF" "$1" "${2:-}"
    shift 2 || shift $#
    for l in "$@"; do printf '      %s%s%s\n' "$_DR_DIM" "$l" "$_DR_OFF"; done
}

# version_ge 0.37.1 0.37  ->  true
#
# Print both versions, and sort them with `sort -V` (a version sort: 0.10 is
# newer than 0.9). If the minimum is first, the version that we have is at
# least the minimum.
version_ge() {
    [ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -1)" = "$2" ]
}

printf '%sDraugr %s%s\n' "$_DR_BOLD" "$DRAUGR_VERSION" "$_DR_OFF"

# --- the host --------------------------------------------------------------
printf '\n%sHost%s\n' "$_DR_BOLD" "$_DR_OFF"

# Two independent signs. Some shells do not set WSL_DISTRO_NAME (cron, some IDE
# terminals), but /proc/version always names the kernel.
if [ -n "${WSL_DISTRO_NAME:-}" ] || grep -qi microsoft /proc/version 2>/dev/null; then
    ok "WSL" "${WSL_DISTRO_NAME:-detected}"
else
    soft "WSL" "not detected" \
        "Draugr is for WSL2 on Windows. It runs sbx.exe, translates /mnt/c" \
        "paths, and connects to the mound through the *.sbx ssh transport." \
        "Draugr does not support other platforms yet."
fi

if version_ge "${BASH_VERSINFO[0]}.${BASH_VERSINFO[1]}" 4.2; then
    ok "bash" "${BASH_VERSION%%(*}"
else
    bad "bash" "${BASH_VERSION%%(*} is too old" "Draugr needs bash 4.2 or newer."
fi

# --- required tools --------------------------------------------------------
printf '\n%sTools%s\n' "$_DR_BOLD" "$_DR_OFF"

# git: required. Old versions do not have flags that dr-sync needs.
if command -v git >/dev/null 2>&1; then
    gitver=$(git --version | awk '{print $3}')
    if version_ge "$gitver" 2.40; then
        ok "git" "$gitver"
    else
        soft "git" "$gitver is older than 2.40" "Draugr was tested only with 2.40 and newer."
    fi
else
    bad "git" "not found" "sudo apt install git"
fi

# jq: required. Each lookup of a sandbox state parses 'sbx ls --json'.
if command -v jq >/dev/null 2>&1; then
    ok "jq" "$(jq --version 2>/dev/null)"
else
    bad "jq" "not found" \
        "Draugr reads 'sbx ls --json' to find the state of your sandboxes." \
        "sudo apt install jq"
fi

# rsync: optional. Only DRAUGR_DATA needs it, so it is soft, not bad.
if command -v rsync >/dev/null 2>&1; then
    ok "rsync" "$(rsync --version 2>/dev/null | head -1 | awk '{print $3}')"
else
    soft "rsync" "not found" \
        "Only the DRAUGR_DATA file sync needs it. All else works without it." \
        "sudo apt install rsync"
fi

# ssh: required. Commits, data, AND the terminal of the agent all go through it.
if command -v ssh >/dev/null 2>&1; then
    ok "ssh" "$(ssh -V 2>&1 | cut -d, -f1)"
else
    bad "ssh" "not found" \
        "dr-sync moves commits through the ssh:// transport of git. dr-go attaches" \
        "through the same one. It is the only transport where Ctrl-Z works." \
        "sudo apt install openssh-client"
fi

# --- sbx -------------------------------------------------------------------
printf '\n%sDocker Sandboxes%s\n' "$_DR_BOLD" "$_DR_OFF"

if sbx_path=$(dr_find_sbx 2>/dev/null); then
    ok "sbx.exe" "$sbx_path"

    # Take the first x.y.z from the output of 'sbx version'. If the words around
    # it change, the test still works.
    if sbxver=$("$sbx_path" version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1); then
        if version_ge "$sbxver" 0.37; then
            ok "sbx version" "$sbxver"
        else
            bad "sbx version" "$sbxver is older than 0.37" \
                "Draugr uses 'sbx ls --json' and policies for each sandbox." \
                "winget upgrade Docker.sbx"
        fi
    else
        soft "sbx version" "could not parse the output of 'sbx version'"
    fi

    # An 'ls' that works is the cheapest proof that the daemon runs.
    if "$sbx_path" ls --json >/dev/null 2>&1; then
        count=$("$sbx_path" ls --json 2>/dev/null | jq '(.sandboxes // []) | length' 2>/dev/null || echo '?')
        ok "sandbox daemon" "reachable, $count sandbox(es)"
    else
        bad "sandbox daemon" "not reachable" \
            "Start it, or find the cause with:  sbx diagnose" \
            "On Windows, the Hypervisor Platform feature must be on."
    fi
else
    bad "sbx.exe" "not found" \
        "sbx is a Windows binary. By default, it is not on the PATH of WSL." \
        "Install:  winget install Docker.sbx" \
        "Or tell Draugr where it is:  export DRAUGR_SBX=/mnt/c/path/to/sbx.exe"
fi

# --- the WSL ssh bridge ----------------------------------------------------
printf '\n%sssh bridge (WSL)%s\n' "$_DR_BOLD" "$_DR_OFF"

# The block must exist, AND its ProxyCommand must name sbx. An ssh configuration
# can have a Host *.sbx block that does not connect to a sandbox.
ssh_config="$HOME/.ssh/config"
if [ -f "$ssh_config" ] && grep -qE '^[[:space:]]*Host[[:space:]]+\*\.sbx' "$ssh_config"; then
    proxy=$(grep -A6 -E '^[[:space:]]*Host[[:space:]]+\*\.sbx' "$ssh_config" \
            | grep -i ProxyCommand | head -1 | sed 's/.*ProxyCommand //' || true)
    if printf '%s' "$proxy" | grep -q 'sbx'; then
        ok "*.sbx block" "present in ~/.ssh/config"
    else
        bad "*.sbx block" "present, but without an sbx ProxyCommand" \
            "Rewrite it with:  dr-setup --force"
    fi
else
    bad "*.sbx block" "missing from the ~/.ssh/config of WSL" \
        "People often forget this step. 'sbx setup ssh' configures only the" \
        "WINDOWS ssh client. WSL has its own configuration. Without this block," \
        "'ssh <name>.sbx' and the ssh:// transport of git do not work here." \
        "Thus dr-go cannot attach, and dr-sync does not work." \
        "Fix:  dr-setup"
fi

# --- this project ----------------------------------------------------------
printf '\n%sThis project%s\n' "$_DR_BOLD" "$_DR_OFF"

# All of the tests below are about the current project. Outside a repository,
# dr-doctor skips them, with a warning and not an error.
if repo=$(git rev-parse --show-toplevel 2>/dev/null); then
    ok "git repository" "$repo"

    # The first constraint of the README. Test it before other tests need it.
    if mound=$(dr_path_mound "$repo" 2>/dev/null); then
        ok "on a Windows drive" "$(dr_path_win "$repo")  ->  $mound in the mound"
    else
        bad "on a Windows drive" "$repo is not under /mnt/<drive>/" \
            "sbx.exe workspaces are Windows paths. A repo on the ext4 file system" \
            "of WSL has no path that sbx can mount." \
            "Move the project under /mnt/c/, and work on it there."
    fi

    # The loader ignores a configuration that is not trusted, with no message.
    # Without this test, a person can look for an hour and not see it.
    for f in "$repo/.draugr.conf" "$repo/.draugr.local.conf"; do
        [ -f "$f" ] || continue
        name=./${f#"$repo"/}
        if dr_trust_is_trusted "$f"; then
            ok "$name" "trusted"
        else
            bad "$name" "not trusted, so Draugr IGNORES it" \
                "Draugr sources this file, so it runs the file." \
                "Read it, then run:  dr-trust"
        fi
    done

    # The kit holds the network rules. Without a kit, the mound gets no allow
    # list.
    dr_load_config "$repo"

    # dr_kit_resolve searches DR_REPO for an entry relative to the repo.
    # dr-doctor gets here without dr_context. It continues on purpose where
    # dr_context stops. Thus the code sets DR_REPO here, and does not assume it.
    DR_REPO=$repo

    # A key for one agent REPLACES the general DRAUGR_AGENT_ARGS. The swap
    # comes after Draugr reads ALL the layers, when it knows DRAUGR_AGENT. Thus
    # a DRAUGR_AGENT_ARGS_CLAUDE of the user replaces a DRAUGR_AGENT_ARGS of the
    # project, against the usual order of the layers. The value of the project
    # is then lost, and no message says so.
    #
    # A user found this. A .draugr.conf asked for --continue, and the
    # machine-wide configuration held a DRAUGR_AGENT_ARGS_CLAUDE for the plugin
    # seed. Thus dr-go started a new conversation in each repo on the machine.
    # dr-config --changed showed it, but only to a person who already looked
    # for it.
    #
    # A soft note, not a fault. The replacement is the documented rule, and it
    # is often what you want. The note is useful only when the lost general
    # value is NOT EMPTY, because then somebody wrote a value that never
    # arrives. The test is on the value, not on its origin. With no general
    # value anywhere, the origin is still "built-in default", and a note on
    # that comes on each run of each project.
    if [ -n "$DR_AGENT_ARGS_REPLACED" ]; then
        # The form that adds works because one shell sources the layers in
        # order. Thus the key for the agent can read its own earlier value.
        _append="$DR_AGENT_ARGS_REPLACED_BY=\"\${$DR_AGENT_ARGS_REPLACED_BY:+\$$DR_AGENT_ARGS_REPLACED_BY }$DR_AGENT_ARGS_REPLACED\""
        soft "agent args" "$DR_AGENT_ARGS_REPLACED_BY replaced DRAUGR_AGENT_ARGS" \
            "dropped:  $DR_AGENT_ARGS_REPLACED" \
            "          from $DR_AGENT_ARGS_REPLACED_FROM" \
            "in use:   $DRAUGR_AGENT_ARGS" \
            "          from ${DR_ORIGIN[DRAUGR_AGENT_ARGS]:-unknown}" \
            "A key for one agent replaces the general key. To keep both, add to" \
            "the key in the layer that sets it:" \
            "  $_append" \
            "A change to a trusted .draugr.conf changes its hash and removes the" \
            "trust. Then run dr-trust again, or Draugr ignores the whole file."
    fi

    if [ -n "$DRAUGR_KIT" ]; then
        # Report each entry alone. If two of three entries resolved, and one
        # name has a spelling error, "the kit is missing" is wrong.
        mapfile -t _kit_missing < <(dr_kit_missing)
        if [ ${#_kit_missing[@]} -eq 0 ]; then
            ok "kit" "$DRAUGR_KIT"
        else
            for _k in "${_kit_missing[@]}"; do
                soft "kit '$_k'" "not found" \
                    "Looked in $repo and in the kit store $(dr_kit_store)." \
                    "The kit holds the network rules and the setup commands." \
                    "Your library:  dr-kit list      A starter kit:  dr-init"
            done
        fi

        # A kit for another agent is valid. It fails only at creation, with a
        # message from sbx about a field that you did not know sbx read.
        while IFS=' ' read -r _k _want; do
            [ -n "$_k" ] || continue
            bad "kit agent" "$_k requires \"$_want\", not \"$DRAUGR_AGENT\"" \
                "sbx refuses to compose them, so dr-up cannot create the mound." \
                "Remove the 'requires: agent:' line, or keep a $_k.$DRAUGR_AGENT/"
        done < <(dr_kit_agent_conflicts)
    fi

    # The agent needs credentials. sbx keeps them on the HOST, not in the mound.
    # The proxy adds them to each request, so creation does not put them in the
    # mound. A later sign-in needs no rebuild. sbx warns about a missing secret
    # only at the creation of a sandbox. That is the wrong time, because you see
    # the problem later, as an agent that is not signed in.
    _svc=$(dr_agent_secret) || _svc=
    if [ -n "$_svc" ]; then
        if dr_sbx secret ls 2>/dev/null | grep -qE "^\(global\)[[:space:]]+service[[:space:]]+$_svc\b"; then
            ok "$DRAUGR_AGENT credentials" "$_svc configured with sbx"
        else
            # The instructions come from the agent module, because they differ.
            # sbx runs the OAuth flow for openai. For anthropic, it refuses, and
            # tells you to sign in inside the sandbox. One fixed line was wrong
            # for one of the two agents that Draugr knows. It named a command
            # that sbx refuses.
            mapfile -t _hints < <(dr_agent_signin "$_svc")
            soft "$DRAUGR_AGENT credentials" "no '$_svc' secret. The agent starts signed out." \
                "The token stays on the host. The proxy of sbx adds it to each request." \
                "${_hints[@]}"
        fi
    fi

    # The model of the agent, for a DRAUGR_MODEL that names one. The default of
    # DRAUGR_MODEL_URL is the ollama-proxy port. A default that assumes a
    # program must make sure that the program is there. Nothing here imports
    # from share/ollama-proxy. These are plain HTTP requests, so the two stay
    # independent.
    if [ -n "${DRAUGR_MODEL:-}" ]; then
        _mok=1

        # The refusal that dr-go gives. Report it here first. Then you find it
        # during a search for problems, not at the start of work.
        if dr_model_is_port "${DRAUGR_MODEL_URL:-}"; then
            _mfound=
            for _p in ${DRAUGR_HOST_PORTS:-}; do
                [ "$_p" = "$DRAUGR_MODEL_URL" ] && _mfound=1
            done
            if [ -z "$_mfound" ]; then
                bad "DRAUGR_MODEL_URL" "port $DRAUGR_MODEL_URL is not in DRAUGR_HOST_PORTS" \
                    "The mound cannot connect to it, and dr-go refuses to start." \
                    "Add it:  DRAUGR_HOST_PORTS=\"$DRAUGR_MODEL_URL\""
                _mok=
            fi
        fi

        # An agent that nobody tested gets a refusal, not a silent no-op. It
        # continues to use its cloud, while you think that the work stays here.
        if ! dr_agent_model_supported; then
            bad "DRAUGR_MODEL" "Draugr cannot point $DRAUGR_AGENT at another endpoint" \
                "Nobody tested which variables this agent reads for this." \
                "Unset DRAUGR_MODEL, or use DRAUGR_AGENT=claude."
        elif [ -n "$_mok" ]; then
            _murl=$(dr_model_url) || _murl=

            # One probe, shared with dr-go. The test that refuses to attach and
            # the test that tells why must be the same test. Otherwise this
            # command approves what dr-go then refuses.
            if [ -z "$_murl" ]; then
                bad "DRAUGR_MODEL" "could not resolve the address of this machine" \
                    "A DRAUGR_MODEL_URL with only a port needs it, and dr-up needs it too."
            else
                case $(dr_model_probe "$_murl") in
                    proxy)
                        ok "$DRAUGR_AGENT model" "$DRAUGR_MODEL via the proxy at $_murl" ;;
                    alive)
                        ok "$DRAUGR_AGENT model" "$DRAUGR_MODEL at $_murl" ;;
                    stalled)
                        bad "$DRAUGR_AGENT model" "the proxy answers, but no server is behind it" \
                            "$_murl serves /healthz but not /api/version. Thus the" \
                            "proxy runs, and the model server does not." \
                            "Start it:  ollama serve" ;;
                    bare)
                        soft "$DRAUGR_AGENT model" "answers at $_murl, with no proxy" \
                            "There is no /healthz, so this is the model server. The" \
                            "agent can POST /api/pull and DELETE /api/delete on the" \
                            "same port. A proxy in front:  $DRAUGR_SHARE/ollama-proxy/" ;;
                    dead)
                        bad "$DRAUGR_AGENT model" "nothing answers at $_murl" \
                            "dr-go refuses to attach. Otherwise each prompt fails with" \
                            "a dial error, which names only that address." \
                            "Start it:  $DRAUGR_SHARE/ollama-proxy/ollama-proxy start" ;;
                    unknown)
                        soft "$DRAUGR_AGENT model" "cannot test $_murl, because curl is missing" \
                            "Install curl, or test it yourself:  curl $_murl/healthz" ;;
                esac
            fi
        fi
    fi

    # Dependencies. Each failure here also happens at the next dr-up, so find it
    # now. A missing path, a directory that is not a repository, and a
    # configuration that nobody read are refusals, not warnings. dr-up stops on
    # each of them. dr-up finds cycles, because it sees the whole chain.
    if [ -n "${DRAUGR_REQUIRES:-}" ]; then
        while read -r _dep; do
            [ -n "$_dep" ] || continue
            if [ ! -d "$_dep" ]; then
                bad "requires $(basename "$_dep")" "no such directory: $_dep" \
                    "Named in DRAUGR_REQUIRES (${DR_ORIGIN[DRAUGR_REQUIRES]:-built-in default})."
            elif ! git -C "$_dep" rev-parse --show-toplevel >/dev/null 2>&1; then
                bad "requires $(basename "$_dep")" "not a git repository: $_dep" \
                    "dr-up starts repositories, so a dependency must be one."
            elif [ -f "$_dep/.draugr.conf" ] && ! dr_trust_is_trusted "$_dep/.draugr.conf"; then
                bad "requires $(basename "$_dep")" "its configuration is not trusted" \
                    "A required repo runs its configuration and hooks, as you." \
                    "Read it, then run:  dr-trust $_dep/.draugr.conf"
            else
                _dn=$(dr_dep_config "$_dep" DRAUGR_SANDBOX)
                ok "requires ${_dn:-$(basename "$_dep")}" \
                   "$(dr_sandbox_state "${_dn:-?}"), $(dr_dep_claims "${_dn:-?}" | grep -c .) claim(s)"
            fi
        done < <(dr_dep_requires "$DR_REPO")
    fi

    # Claims of this repo on resources that it no longer requires. They do no
    # damage. They expire, and another repo takes an exclusive one and does not
    # wait. But they keep a warden alive, and the warden keeps a mound running.
    # Below are the names that this repo can hold, so that other claims are easy
    # to see. The list is made once, not for each claim, because each entry
    # costs a dr-config in another repository.
    _wanted=" "
    if [ -n "${DRAUGR_REQUIRES:-}" ]; then
        while read -r _dep; do
            [ -d "$_dep" ] || continue
            _wanted="$_wanted$(dr_dep_config "$_dep" DRAUGR_SANDBOX) "
        done < <(dr_dep_requires "$DR_REPO")
    fi

    _mine=$(_dr_hash_text "$DR_REPO")
    for _cdir in "$DR_RUN_DIR"/*/; do
        [ -f "$_cdir$_mine.claim" ] || continue
        # The key of the claim, not the cleaned directory name. dr-forge claims
        # the VM, which is not a mound, as "vm:<name>". That key is never in
        # DRAUGR_REQUIRES, so it is not an orphan.
        _ckey=$(sed -n 's/^key=//p' "$_cdir$_mine.claim" | head -1)
        case "$_ckey" in *:*) continue ;; esac
        case "$_wanted" in *" $_ckey "*) continue ;; esac
        soft "claim on $_ckey" "held by this repo, which no longer requires it" \
            "Nothing breaks, but the resource continues to run. To release it:  dr-dep release"
    done
else
    soft "git repository" "$PWD is not one" \
        "Draugr works on one repository at a time. Go to a project, or run 'git init'."
fi

# --- verdict ---------------------------------------------------------------
#
# A script reads the exit status, so only real failures make it non-zero. A
# warning is information, not a block.
printf '\n'
if [ "$fails" -gt 0 ]; then
    printf '%s%d problem(s) to fix.%s' "$_DR_RED" "$fails" "$_DR_OFF"
    [ "$warns" -gt 0 ] && printf ' %s%d warning(s).%s' "$_DR_YELLOW" "$warns" "$_DR_OFF"
    printf '\n'
    exit 1
fi
if [ "$warns" -gt 0 ]; then
    printf '%sReady, with %d warning(s).%s\n' "$_DR_YELLOW" "$warns" "$_DR_OFF"
    exit 0
fi
printf '%sAll tests passed.%s\n' "$_DR_GREEN" "$_DR_OFF"
