#!/usr/bin/env bash
# dr-sync: fetch the commits of the agent from the mound onto draugr/<branch>.
#
# This is the important direction. The sandbox never pushes to you. You pull
# from it. Nothing merges, and nothing on your branch moves. After this, you
# have a remote-tracking branch to review with dr-log and dr-diff. When you
# accept it, use dr-merge.
#
#   dr-sync              fetch and report
#   dr-sync --no-fetch   report on what you already fetched, and contact nothing
#   dr-sync --quiet      say something only if something is new
#   dr-sync --check-only do not fetch. Exit 0: nothing to lose. 1: unfetched
#                        commits exist. 2: unknown (dr-rm uses it)
set -euo pipefail

DR_PROG=dr-sync
# readlink -f comes first. install.sh links this file into ~/.local/bin, and
# through a link BASH_SOURCE is the LINK. Without it, ../lib is ~/.local/lib.
_dr_bin=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$_dr_bin/../lib/common.sh"

# dr-rm uses --check-only before it destroys a mound, so it must change nothing.
# It asks the sandbox what it has, and compares, with no fetch.
fetch=1
check_only=
quiet=
while [ $# -gt 0 ]; do
    case "$1" in
        --no-fetch)   fetch= ;;
        --check-only) check_only=1 ;;
        -q|--quiet)   quiet=1 ;;
        -h|--help)    dr_help "$0"; exit 0 ;;
        *) dr_die "unknown option: $1" "Try: dr-sync --help" ;;
    esac
    shift
done

dr_context

# No $branch here now. Before, --check-only asked the mound about one named
# branch. Now it asks about all of them.
tracking=$(dr_tracking_ref)

# --- check-only: does the destruction of the mound lose work? ---------------
#
# The correct test is not "did I merge it?", but "do I have the objects?". After
# a fetch, they are in the host repo, and stay after dr-rm. ls-remote asks the
# sandbox directly, and does not trust a tracking ref that can be old.
#
# Three results, not two. Do not report "I could not connect to the mound" as
# "nothing to lose". That opens the gate on the one command that destroys work.
# dr-rm changes a 2 into a warning and a question, not a silent permission.
if [ -n "$check_only" ]; then
    if ! dr_sandbox_exists "$DRAUGR_SANDBOX"; then
        exit 0
    fi

    url=$(dr_sandbox_url)

    # ls-remote connects to the mound through ssh, and that starts a stopped
    # mound. The timeout is a safety net, so that a host with no connection
    # fails and does not hang. `timeout` is in coreutils and can be missing.
    # Thus there are two branches with the same commands.
    #
    # To capture the status, the assignment must BE the tested command. With
    # `out=$(…) || out=` and then $?, the status is from the fallback
    # assignment. That always works, and no connection looks like a success.
    # EACH branch, not only the tracked one. Before, the code asked only about
    # refs/heads/$branch. Then an agent that committed on its own branch got
    # "nothing to lose", and dr-rm trusts this answer before it destroys the
    # mound. The guard had a hole exactly where agents really work.
    rc=0
    if command -v timeout >/dev/null 2>&1; then
        out=$(timeout 60 git -C "$DR_REPO" ls-remote --heads "$url" 2>/dev/null) || rc=$?
    else
        out=$(git -C "$DR_REPO" ls-remote --heads "$url" 2>/dev/null) || rc=$?
    fi

    # "Answered, and nothing is there" differs from "never answered". For a
    # mound with no branches, ls-remote works and gives empty output. That is a
    # real answer: the agent never committed anything.
    if [ -n "$out" ]; then
        while IFS= read -r line; do
            [ -n "$line" ] || continue
            tip=${line%%	*}
            # ^{commit} forces the object to resolve as a commit. cat-file -e is
            # a silent "do we already have this?" test. One missing tip on a
            # branch is enough for the answer "yes, this loses work".
            git -C "$DR_REPO" cat-file -e "$tip^{commit}" 2>/dev/null || exit 1
        done <<< "$out"
        exit 0
    fi
    [ "$rc" -eq 0 ] && exit 0
    exit 2
fi

# --- the normal path --------------------------------------------------------

# Only a fetch needs a mound. --no-fetch reports on refs that are already on
# this disk. Before, it refused without a sandbox. After dr-rm, you most want to
# ask "what did I keep?", and exactly then it did not answer.
if [ -n "$fetch" ] && ! dr_sandbox_exists "$DRAUGR_SANDBOX"; then
    dr_die "$DRAUGR_SANDBOX does not exist, so there is nothing to fetch" \
           "To report on what you already fetched:  dr-sync --no-fetch" \
           "Create it with:  dr-up"
fi

if [ -n "$fetch" ]; then
    url=$(dr_remote_ensure)
    [ -n "$quiet" ] || dr_info "fetching from $url"

    # The ssh connection starts a stopped sandbox, and that takes a few seconds.
    # Thus this can wait with no output.
    git -C "$DR_REPO" fetch --prune "$DRAUGR_REMOTE" || dr_die \
        "could not fetch from $DRAUGR_SANDBOX" \
        "Make sure that the mound is reachable:  dr-status" \
        "And that the ssh of WSL knows about *.sbx hosts:  dr-doctor"
fi

dr_require_tracking_ref

# --- report -----------------------------------------------------------------
#
# Two counts, because they answer different questions. What did the agent do
# that you did not see? What do you have that it did not get (dr-send)?
ahead=$(git -C "$DR_REPO" rev-list --count "HEAD..$tracking" 2>/dev/null || printf 0)
behind=$(git -C "$DR_REPO" rev-list --count "$tracking..HEAD" 2>/dev/null || printf 0)

# Read before the report, not after it, because the first line of the report
# depends on it. `ahead` counts ONE branch, and "nothing new in the mound" is a
# claim about the whole mound. When the agent worked on a branch of its own,
# that line landed directly above the list of what it did, and the two read as a
# contradiction. A user hit exactly that and asked which one to believe.
mapfile -t _others < <(dr_other_branches)

# For new work, list it, and name the next two commands. At this step of the
# loop, you decide to look more closely, or to accept.
if [ "$ahead" -eq 0 ]; then
    # "in the mound" only when it is true of the mound. With untracked branches
    # present, something IS new there, and the next lines name it.
    if [ ${#_others[@]} -gt 0 ]; then
        [ -n "$quiet" ] || dr_ok "nothing new on $tracking. It is the same as your branch."
    else
        [ -n "$quiet" ] || dr_ok "nothing new in the mound. $tracking is the same as your branch."
    fi
else
    dr_ok "$ahead new commit(s) on $tracking"
    git -C "$DR_REPO" log --oneline --no-decorate "HEAD..$tracking" | sed 's/^/  /'
    printf '\n  %sReview:  dr-diff        Accept:  dr-merge%s\n' "$_DR_DIM" "$_DR_OFF" >&2
fi

# Say it, because the agent works from a clone that is older than these, and
# sooner or later the two conflict.
#
# The advice depends on where the commits are. dr-send leaves them on
# refs/remotes/host/<branch> inside the mound, and does NOT move the branch of
# the agent. Thus draugr/<branch> stays behind. Before, this always said "send
# them with dr-send", also directly after a dr-send that worked. A second send
# changed nothing, so the loop had no exit.
if [ "$behind" -gt 0 ] && [ -z "$quiet" ]; then
    if [ "$(dr_send_state)" = unmerged ]; then
        dr_info "the mound has your $behind commit(s) on host/$DRAUGR_BRANCH, not merged"
        printf '  %sThe agent decides when to take them:  git merge host/%s%s\n' \
            "$_DR_DIM" "$DRAUGR_BRANCH" "$_DR_OFF" >&2
        printf '  %sOr do it for the agent:  dr-send --merge%s\n' "$_DR_DIM" "$_DR_OFF" >&2
    else
        dr_info "you have $behind commit(s) that the mound does not have. Send them with:  dr-send"
    fi
fi

# --- the branches nobody was looking at -------------------------------------
#
# Always reported, also with --quiet, because this case was silent before. The
# fetch got these, and then each command said that there was nothing new. An
# agent that makes its own branch name is normal, not an error. Thus this
# informs, and does not warn. The exception: the tracked branch is empty, and
# these are the only work.
#
# _others is read further up, because the first line of the report needs it.
if [ ${#_others[@]} -gt 0 ]; then
    if [ "$ahead" -eq 0 ]; then
        dr_warn "the agent worked on ${#_others[@]} branch(es) that you do NOT track:"
    else
        dr_info "the agent also worked on ${#_others[@]} branch(es) that you do not track:"
    fi
    for _entry in "${_others[@]}"; do
        printf '    %-44s %s commit(s)\n' "${_entry% *}" "${_entry##* }" >&2
    done

    # DRAUGR_BRANCH is an ordinary configuration key, so the environment can
    # change it for one command. A review of one of these needs no new flag.
    _first=${_others[0]%% *}
    printf '  %sReview one with:  DRAUGR_BRANCH=%s dr-diff%s\n' \
        "$_DR_DIM" "${_first#"$DRAUGR_REMOTE"/}" "$_DR_OFF" >&2
    printf '  %sThese are already fetched. They are on your disk, not only in the mound.%s\n' \
        "$_DR_DIM" "$_DR_OFF" >&2
fi

dr_hook post-sync "$DR_REPO"
