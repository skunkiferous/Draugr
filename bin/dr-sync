#!/usr/bin/env bash
# dr-sync - fetch the agent's commits out of the mound onto draugr/<branch>.
#
# This is the direction that matters: the sandbox never pushes to you, you pull
# from it. Nothing is merged and nothing on your branch moves - after this you
# have a remote-tracking branch to review with dr-log and dr-diff, and dr-merge
# accepts it when you are happy.
#
#   dr-sync              fetch and report
#   dr-sync --no-fetch   report on what you already fetched, contacting nothing
#   dr-sync --quiet      say nothing unless something is new
#   dr-sync --check-only do not fetch; exit 0 nothing to lose, 1 unfetched
#                        commits exist, 2 could not tell (used by dr-rm)
set -euo pipefail

DR_PROG=dr-sync
# readlink -f first: install.sh links this into ~/.local/bin by default, and
# through a link BASH_SOURCE is the LINK, so ../lib would be ~/.local/lib.
_dr_bin=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$_dr_bin/../lib/common.sh"

# --check-only is what dr-rm uses before destroying a mound, so it must not
# change anything: it asks the sandbox what it has and compares, without fetching.
fetch=1
check_only=
quiet=
while [ $# -gt 0 ]; do
    case "$1" in
        --no-fetch)   fetch= ;;
        --check-only) check_only=1 ;;
        -q|--quiet)   quiet=1 ;;
        -h|--help)    dr_help "$0"; exit 0 ;;
        *) dr_die "unknown option: $1" "Try: dr-sync --help" ;;
    esac
    shift
done

dr_context

# No $branch here any more: --check-only used to ask the mound about one named
# branch, and now asks about all of them.
tracking=$(dr_tracking_ref)

# --- check-only: would destroying the mound lose work? ----------------------
#
# The honest test is not "have I merged it" but "do I have the objects at all",
# because once fetched they live in the host repo and survive dr-rm. ls-remote
# asks the sandbox directly rather than trusting a possibly stale tracking ref.
#
# Three outcomes, not two: "I could not reach the mound" must not be reported as
# "nothing to lose", which would fail open on the one command that destroys work.
# dr-rm turns a 2 into a warning and a prompt rather than silent permission.
if [ -n "$check_only" ]; then
    if ! dr_sandbox_exists "$DRAUGR_SANDBOX"; then
        exit 0
    fi

    url=$(dr_sandbox_url)

    # ls-remote reaches the mound over ssh, which will start it if stopped. The
    # timeout is a backstop so an unreachable host fails rather than hanging;
    # `timeout` is coreutils and may be absent, hence the two branches running
    # otherwise-identical commands.
    #
    # Capturing the status needs the assignment to BE the tested command. Writing
    # `out=$(…) || out=` and then reading $? would report on the fallback
    # assignment, which always succeeds - and unreachable would look like success.
    # EVERY branch, not just the tracked one. Asking only about refs/heads/$branch
    # meant an agent that committed on a branch of its own was reported as
    # "nothing to lose" - and dr-rm believes this answer before destroying the
    # mound. The guard had a hole exactly where agents actually behave.
    rc=0
    if command -v timeout >/dev/null 2>&1; then
        out=$(timeout 60 git -C "$DR_REPO" ls-remote --heads "$url" 2>/dev/null) || rc=$?
    else
        out=$(git -C "$DR_REPO" ls-remote --heads "$url" 2>/dev/null) || rc=$?
    fi

    # Distinguish "answered, and there is nothing there" from "never answered".
    # ls-remote succeeds with empty output for a mound with no branches at all,
    # which is a real answer and means the agent never committed anything.
    if [ -n "$out" ]; then
        while IFS= read -r line; do
            [ -n "$line" ] || continue
            tip=${line%%	*}
            # ^{commit} forces the object to resolve as a commit; cat-file -e is a
            # silent "do we already have this here" test. One missing tip on any
            # branch is enough to answer "yes, this would lose work".
            git -C "$DR_REPO" cat-file -e "$tip^{commit}" 2>/dev/null || exit 1
        done <<< "$out"
        exit 0
    fi
    [ "$rc" -eq 0 ] && exit 0
    exit 2
fi

# --- the normal path --------------------------------------------------------

# Only fetching needs a mound. --no-fetch reports on refs that are already on
# this disk, and refusing it without a sandbox made the one moment you most want
# that report - after dr-rm, asking "what did I keep?" - the one moment it would
# not answer.
if [ -n "$fetch" ] && ! dr_sandbox_exists "$DRAUGR_SANDBOX"; then
    dr_die "$DRAUGR_SANDBOX does not exist, so there is nothing to fetch" \
           "Report on what you already fetched:  dr-sync --no-fetch" \
           "Create it with:  dr-up"
fi

if [ -n "$fetch" ]; then
    url=$(dr_remote_ensure)
    [ -n "$quiet" ] || dr_info "fetching from $url"

    # A stopped sandbox is started by the ssh connection itself, which takes a
    # few seconds; that is why this can pause with no output.
    git -C "$DR_REPO" fetch --prune "$DRAUGR_REMOTE" || dr_die \
        "could not fetch from $DRAUGR_SANDBOX" \
        "Check the mound is reachable:  dr-status" \
        "And that WSL's ssh knows about *.sbx hosts:  dr-doctor"
fi

dr_require_tracking_ref

# --- report -----------------------------------------------------------------
#
# Two counts, because they answer different questions: what the agent did that
# you have not seen, and what you have that it has not been given (dr-send).
ahead=$(git -C "$DR_REPO" rev-list --count "HEAD..$tracking" 2>/dev/null || printf 0)
behind=$(git -C "$DR_REPO" rev-list --count "$tracking..HEAD" 2>/dev/null || printf 0)

# When there is something new, list it and name the next two commands: this is
# the moment in the loop where you decide whether to look closer or just accept.
if [ "$ahead" -eq 0 ]; then
    [ -n "$quiet" ] || dr_ok "nothing new in the mound - $tracking matches your branch"
else
    dr_ok "$ahead new commit(s) on $tracking"
    git -C "$DR_REPO" log --oneline --no-decorate "HEAD..$tracking" | sed 's/^/  /'
    printf '\n  %sReview:  dr-diff        Accept:  dr-merge%s\n' "$_DR_DIM" "$_DR_OFF" >&2
fi

# Worth saying, because the agent is working from a clone that predates these and
# will conflict with them sooner or later.
#
# Which advice depends on where the commits have got to. dr-send leaves them on
# refs/remotes/host/<branch> inside the mound and does NOT move the agent's
# branch, so draugr/<branch> stays behind afterwards - and this used to answer
# "send them with dr-send" every time, including immediately after a dr-send that
# had worked. Re-sending changed nothing, so the loop had no exit.
if [ "$behind" -gt 0 ] && [ -z "$quiet" ]; then
    if [ "$(dr_send_state)" = unmerged ]; then
        dr_info "the mound has your $behind commit(s) on host/$DRAUGR_BRANCH, not merged"
        printf '  %sThe agent decides when to take them:  git merge host/%s%s\n' \
            "$_DR_DIM" "$DRAUGR_BRANCH" "$_DR_OFF" >&2
        printf '  %sOr do it for it:  dr-send --merge%s\n' "$_DR_DIM" "$_DR_OFF" >&2
    else
        dr_info "you have $behind commit(s) the mound does not - send them with:  dr-send"
    fi
fi

# --- the branches nobody was looking at -------------------------------------
#
# Reported unconditionally, including under --quiet, because this is the case
# that used to be silent: the fetch brought these down, and every command then
# claimed there was nothing new. An agent inventing its own branch name is
# ordinary behaviour, not an error - so this informs rather than warns, except
# when the tracked branch is empty and these are the only work there is.
mapfile -t _others < <(dr_other_branches)
if [ ${#_others[@]} -gt 0 ]; then
    if [ "$ahead" -eq 0 ]; then
        dr_warn "the agent worked on ${#_others[@]} branch(es) you are NOT tracking:"
    else
        dr_info "the agent also worked on ${#_others[@]} branch(es) you are not tracking:"
    fi
    for _entry in "${_others[@]}"; do
        printf '    %-44s %s commit(s)\n' "${_entry% *}" "${_entry##* }" >&2
    done

    # DRAUGR_BRANCH is an ordinary config key, so the environment overrides it
    # for one command. No new flag is needed to review one of these.
    _first=${_others[0]%% *}
    printf '  %sReview one with:  DRAUGR_BRANCH=%s dr-diff%s\n' \
        "$_DR_DIM" "${_first#"$DRAUGR_REMOTE"/}" "$_DR_OFF" >&2
    printf '  %sThese are already fetched - they are on your disk, not only the mound.%s\n' \
        "$_DR_DIM" "$_DR_OFF" >&2
fi

dr_hook post-sync "$DR_REPO"
