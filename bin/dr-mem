#!/usr/bin/env bash
# dr-mem: keep the memory of the agent across dr-rm.
#
# The disk image of the mound stays after dr-stop, and dies with dr-rm. All that
# the agent learned about your project dies with it, unless you exported it
# first. Each agent keeps its memory in its own place, so the layout comes from
# lib/agents/<agent>.sh, not from here. Claude Code files it under a key from
# the absolute path of the project. That path differs on each side of the
# boundary. Thus a simple copy goes to a directory that the agent never reads,
# with no message. That is why this command exists.
#
#   dr-mem status              where memory is on each side, and how much
#   dr-mem export              mound -> $DRAUGR_MEM_STORE. Do this before dr-rm
#   dr-mem import              store -> mound. Do this before you start the agent
#   dr-mem import --from-host  the memory of the agent on your host -> mound
#   dr-mem import --source D   a different directory -> mound
#   dr-mem import --if-empty   import only into a mound that has no memory yet
#   dr-mem diff                what each side knows that the other does not
#   dr-mem check               does dr-rm lose something? (for scripts)
#
# If the two sides differ, diff exits 1, so you can use it as a test. The exit
# codes of check: 0 means that the store has all that the mound has. 1 means
# that the mound holds memory that was never exported. 2 means no connection.
# These are the three answers of dr-sync --check-only, for the same reason.
#
# shellcheck disable=SC2016
# Single-quoted "$1" is in many places, on purpose. Those strings are scripts
# for the shell of the MOUND, and the host must not expand them. See dr_mound_sh
# in lib/common.sh for how the arguments get there.
set -euo pipefail

DR_PROG=dr-mem
# readlink -f comes first. install.sh links this file into ~/.local/bin, and
# through a link BASH_SOURCE is the LINK. Without it, ../lib is ~/.local/lib.
_dr_bin=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$_dr_bin/../lib/common.sh"

# status is the default, because it is the only action that moves nothing, and
# "which side has what?" is your first question.
action=${1:-status}
case "$action" in
    -h|--help) dr_help "$0"; exit 0 ;;
    status|export|import|diff|check) shift || : ;;
    *) dr_die "unknown action: $action" "One of: status, export, import, diff, check" ;;
esac

# --source and --from-host both name the source of the memory. --if-empty
# decides whether to import at all. One loop reads them for all actions. Only
# `import` uses them, and a refusal in other actions is only noise.
source_dir=
from_host=
if_empty=
while [ $# -gt 0 ]; do
    case "$1" in
        -y|--yes)     DR_ASSUME_YES=1 ;;
        --from-host)  from_host=1 ;;
        --if-empty)   if_empty=1 ;;
        --source)     shift; source_dir=${1:-} ;;
        --source=*)   source_dir=${1#--source=} ;;
        *) dr_die "unknown option: $1" "Try: dr-mem --help" ;;
    esac
    shift
done

dr_context

# Each agent has its own memory layout, and Draugr knows only the layouts that
# it tested (see lib/agents/). A refusal is better than a copy into a place that
# the agent never reads. That copy looks like a success, but the agent still
# forgot everything. `check` is the exception. dr-rm calls it before it destroys
# a mound. "I do not know this agent" must answer "nothing to lose", and must
# not close the guard.
if ! dr_agent_mem_supported; then
    [ "$action" = check ] && exit 0
    dr_die "Draugr does not know where $(dr_agent_mem_label) keeps its memory" \
           "Memory is the one thing that differs for each agent. All else works." \
           "Known layouts:  $(dr_agent_known)" \
           "Turn the automatic export off with:  DRAUGR_MEM_SYNC=off"
fi

# The directory that the agent reads, and its parent. The code creates the
# parent and copies into it. The parent comes from the child, and the code does
# not ask for both. Thus the two cannot differ.
mem_dir=$(dr_agent_mem_dir "$DR_REPO")
dr_mem_store_migrate "$DR_REPO"
store_dir=$(dr_mem_store_dir "$DR_REPO")
marker="$store_dir/.draugr-export"

# This is a report and a command, so its output is content, and goes to stdout.
# dr_heading writes to stderr. That is correct for questions, but wrong here.
# The two streams have separate buffers, and in a pipe the headings go to the
# wrong places.
heading() { printf '\n%s%s%s\n' "$_DR_BOLD" "$*" "$_DR_OFF"; }

# --- talking to the mound ---------------------------------------------------
#
# dr_mound_sh (quiet) and dr_mound_run (loud) are in lib/common.sh, because the
# agent modules need them too. The old short names stay here, so that the
# scripts below do not change.
mound_sh()  { dr_mound_sh  "$@"; }
mound_run() { dr_mound_run "$@"; }

require_mound() {
    dr_sandbox_exists "$DRAUGR_SANDBOX" || dr_die \
        "$DRAUGR_SANDBOX does not exist" \
        "Create it with:  dr-up"
}

# --- listing both sides in one shape ----------------------------------------
#
# Both make the "<hash>  <name>" lines of sha256sum, with names relative to the
# memory directory. Thus you can compare the two directly.
#
# find -printf '%P' prints the path without the starting directory. With no
# files, xargs -r does not run sha256sum. Without -r, an empty directory makes
# sha256sum read stdin forever.
list_local() {
    local dir=$1
    [ -d "$dir" ] || return 0
    ( cd "$dir" && find . -type f -printf '%P\0' | sort -z | xargs -0 -r sha256sum )
}

# The half of the mound comes from the agent module, because only it knows what
# to keep. One more precaution here: keep only lines that really are sha256sum
# output, with 64 hex digits, two spaces, and a name.
#
# Otherwise the code reads each other line on stdout as a file. Nothing in sbx
# 0.37.1 does that. Its "Sandbox … started successfully" banner goes to stderr
# (a test showed this). But an error here is silent and expensive. With one
# extra line, each comparison sees a file that does not exist. Then dr-rm
# refuses to destroy a mound because of memory that was never there. A test of
# the format costs less.
#
# A failed list and an empty list are different answers. Thus the failure of the
# module goes out, but the "no lines matched" of grep does not.
list_mound() {
    local out
    out=$(dr_agent_mem_list "$DR_REPO") || return 1
    printf '%s\n' "$out" | grep -E '^[0-9a-f]{64}  ' || true
}

# With no match, grep -c prints 0 and exits 1, and set -e sees that as fatal.
count_lines() { grep -c . || true; }

case "$action" in

# --- status -----------------------------------------------------------------
status)
    # The own report of this agent: the three project keys of Claude Code, or
    # the feature flag of Codex. Each prints its own heading, or nothing.
    dr_agent_mem_status_extra "$DR_REPO"

    heading "memory"
    printf '  %-6s %3s file(s)  %s\n' store \
        "$(list_local "$store_dir/memory" | count_lines)" "$store_dir/memory"

    # A missing directory gets a sentence, not "0 file(s)". No host install and
    # an empty one are different cases, and only the first is normal.
    if host_dir=$(dr_agent_mem_host_dir "$DR_REPO"); then
        printf '  %-6s %3s file(s)  %s\n' host \
            "$(list_local "$host_dir" | count_lines)" "$host_dir"
    else
        printf '  %-6s %s\n' host "no host $(dr_agent_mem_label) memory for this repo"
    fi

    # The same difference for the mound. Thus status never creates one. You run
    # this to decide what to do, not to make something happen.
    if dr_sandbox_exists "$DRAUGR_SANDBOX"; then
        printf '  %-6s %3s file(s)  %s\n' mound \
            "$(list_mound | count_lines)" "$mem_dir"
    else
        printf '  %-6s %s\n' mound "$DRAUGR_SANDBOX does not exist"
    fi

    if [ -f "$marker" ]; then
        heading "last export"
        sed 's/^/  /' "$marker"
    fi
    ;;

# --- export -----------------------------------------------------------------
export)
    require_mound

    # Nothing to export is a usual state, not a failure. With
    # DRAUGR_MEM_SYNC=auto, this runs at each detach, also before the agent
    # wrote its first memory.
    if ! dr_agent_mem_present "$DR_REPO"; then
        dr_ok "no memory in $DRAUGR_SANDBOX yet. Nothing to export."
        printf '  %s%s creates it when it writes the first one.%s\n' \
            "$_DR_DIM" "$(dr_agent_mem_label)" "$_DR_OFF" >&2
        exit 0
    fi

    # Staging, because sbx cp does not write to a WSL path. See dr_stage.
    dr_stage
    trap 'rm -rf "$DR_STAGE"' EXIT

    # Pack it inside the mound first. The memory can be several files in several
    # places (Codex keeps markdown and databases together). Thus the module puts
    # them into one directory, and this code moves it in one copy. You can test
    # the result of that copy, and you do not have to trust it.
    dr_info "exporting $DRAUGR_SANDBOX memory"
    dr_agent_mem_pack "$DR_REPO" "$DR_MOUND_STAGE" \
        || dr_die "could not collect the memory of $(dr_agent_mem_label) in the mound" \
                  "Is the mound running?  dr-status"

    dr_sbx cp "$DRAUGR_SANDBOX:$DR_MOUND_STAGE" "$DR_STAGE_WIN" \
        || dr_die "sbx cp failed" "Is the mound running?  dr-status"
    mound_sh 'rm -rf "$1"' "$DR_MOUND_STAGE" || :

    # "sbx cp exited 0" and "a directory is here now" are different claims. Only
    # the second one makes the rename below safe.
    packed="$DR_STAGE/$(basename "$DR_MOUND_STAGE")"
    [ -d "$packed" ] || dr_die \
        "sbx cp reported success, but made no memory directory" \
        "Looked in: $DR_STAGE"

    # Put it in place with a rename, never with a write in place. Thus a stopped
    # export cannot leave a store with part of this copy and part of the last
    # one. The replaced copy stays as memory.previous, and is not deleted. An
    # export always overwrites. The painful case is a mound that started empty,
    # and overwrites a store that was not empty. Then one `mv` brings it back.
    mkdir -p "$store_dir"
    rm -rf "$store_dir/memory.incoming"
    mv "$packed" "$store_dir/memory.incoming"
    if [ -d "$store_dir/memory" ]; then
        rm -rf "$store_dir/memory.previous"
        mv "$store_dir/memory" "$store_dir/memory.previous"
    fi
    mv "$store_dir/memory.incoming" "$store_dir/memory"

    n=$(list_local "$store_dir/memory" | count_lines)

    # With the marker, `dr-mem import` knows your own export from a directory
    # with the memories of somebody else. See the import path below.
    {
        printf 'repo:    %s\n' "$DR_REPO"
        printf 'sandbox: %s\n' "$DRAUGR_SANDBOX"
        printf 'date:    %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
        printf 'files:   %s\n' "$n"
    } > "$marker"

    dr_ok "exported $n file(s) to $store_dir/memory"
    ;;

# --- import -----------------------------------------------------------------
import)
    require_mound

    # --if-empty makes DRAUGR_MEM_SYNC=auto safe at each dr-up. An import
    # without a condition puts the store over memory that the agent wrote later.
    # The store is always the older copy. Thus the automatic path fills only a
    # mound that has nothing.
    if [ -n "$if_empty" ] && [ -n "$(list_mound)" ]; then
        dr_debug "$DRAUGR_SANDBOX already has memory; --if-empty declines to import"
        exit 0
    fi

    # Three sources, the most explicit first. --from-host is the migration for
    # "I ran the agent on this machine before, and the mound must know what it
    # knew".
    trusted=
    if [ -n "$source_dir" ]; then
        :
    elif [ -n "$from_host" ]; then
        source_dir=$(dr_agent_mem_host_dir "$DR_REPO") || dr_die \
            "no host $(dr_agent_mem_label) memory for this repo" \
            "$(dr_agent_mem_host_hint "$DR_REPO")"
    else
        source_dir="$store_dir/memory"
        # Our own marker names this repo. Only in this case can we prove that
        # the content came from the agent of this project.
        if [ -f "$marker" ] && grep -qxF "repo:    $DR_REPO" "$marker"; then
            trusted=1
        fi
    fi

    # With --if-empty, an empty store is the usual state of a project that never
    # had a session. DRAUGR_MEM_SYNC=auto runs this at each dr-up. Before, the
    # first one printed "auto memory import failed". That message frightens and
    # tells nothing. For an explicit request, "there is nothing there" is still
    # useful.
    if [ ! -d "$source_dir" ] || [ -z "$(list_local "$source_dir")" ]; then
        if [ -n "$if_empty" ]; then
            dr_debug "nothing in $source_dir to import"
            exit 0
        fi
        [ -d "$source_dir" ] || dr_die \
            "no memory at $source_dir" \
            "Export some first with:  dr-mem export" \
            "Or import the memory of your host:  dr-mem import --from-host"
        dr_die "$source_dir has no files"
    fi

    n=$(list_local "$source_dir" | count_lines)

    # Memory is not notes. An agent loads it into context, and mostly acts on
    # it. Thus the import of a directory is more like a run of a script than a
    # copy of data. That is why an unknown source gets a question each time.
    dr_warn "memory is instructions, not only notes"
    printf '  %sThe agent loads imported files into its context, and mostly%s\n' \
        "$_DR_DIM" "$_DR_OFF" >&2
    printf '  %strusts them. Import your own freely. Read the files of others first.%s\n' \
        "$_DR_DIM" "$_DR_OFF" >&2
    if [ -z "$trusted" ]; then
        dr_confirm "Import $n file(s) from $source_dir into $DRAUGR_SANDBOX?" \
            || dr_die "cancelled"
    fi

    # The same packed tree that the export made, in the other direction. Its
    # name must be the name of the staging directory in the mound. sbx cp puts
    # the source INSIDE the destination, and does not rename it.
    stage_name=$(basename "$DR_MOUND_STAGE")
    dr_stage
    trap 'rm -rf "$DR_STAGE"' EXIT
    cp -a "$source_dir" "$DR_STAGE/$stage_name"

    # The parent of the staging directory must exist before cp puts anything in
    # it. Files from a stopped transfer must not look like part of this one.
    mound_run 'mkdir -p "$(dirname "$1")"' "$DR_MOUND_STAGE" \
        || dr_die "could not create $DR_MOUND_STAGE in the mound"
    mound_sh 'sudo -n rm -rf "$1" || rm -rf "$1"' "$DR_MOUND_STAGE" || :

    dr_info "importing $n file(s) into $DRAUGR_SANDBOX"
    dr_sbx cp "$DR_STAGE_WIN\\$stage_name" "$DRAUGR_SANDBOX:$(dirname "$DR_MOUND_STAGE")/" \
        || dr_die "sbx cp failed" "Is the mound running?  dr-status"

    # sbx cp writes files as root:root, but the agent runs as uid 1000. Without
    # this, the agent can read the imported memories, but never update them. It
    # also cannot create new ones in that directory. Then memory stops growing,
    # and nobody knows why. The code does this to the staging copy, not to the
    # destination. Thus the agent owns the copy of the module from the start,
    # and no agent has to know this about sbx.
    mound_sh 'sudo -n chown -R agent:agent "$1" && sudo -n chmod -R u+rwX "$1"' \
        "$DR_MOUND_STAGE" \
        || dr_warn "chown failed. The agent possibly cannot update these memories."

    dr_agent_mem_unpack "$DR_REPO" "$DR_MOUND_STAGE" \
        || dr_die "could not place the memory in $DRAUGR_SANDBOX"
    mound_sh 'rm -rf "$1"' "$DR_MOUND_STAGE" || :

    dr_ok "imported $n file(s) into $mem_dir"
    ;;

# --- diff -------------------------------------------------------------------
diff)
    require_mound
    # A mound with no memory is not an error here. It compares as empty, and
    # "all is only in the store" is useful information. The module still runs.
    # If it finds a layout in the mound that it did not expect, its guess is
    # wrong, and you must know that.
    dr_agent_mem_present "$DR_REPO" || :

    # Two name->hash maps, then three questions. An associative array is better
    # than sort and comm here, because it keeps whole lines. `read hash name`
    # puts all text after the hash into $name. Thus a file name with a space
    # stays whole. A pipeline that cuts on spaces breaks it.
    declare -A in_mound=() in_store=()
    while read -r hash name; do
        [ -n "$name" ] && in_mound[$name]=$hash
    done <<< "$(list_mound)"
    while read -r hash name; do
        [ -n "$name" ] && in_store[$name]=$hash
    done <<< "$(list_local "$store_dir/memory")"

    only_mound=() only_store=() changed=()
    # ${arr[$k]+set} is "set" only for a key that exists. This test works under
    # set -u, and does not mistake an empty value for a missing key.
    if [ ${#in_mound[@]} -gt 0 ]; then
        for name in "${!in_mound[@]}"; do
            if [ -z "${in_store[$name]+set}" ]; then
                only_mound+=("$name")
            elif [ "${in_mound[$name]}" != "${in_store[$name]}" ]; then
                changed+=("$name")
            fi
        done
    fi
    if [ ${#in_store[@]} -gt 0 ]; then
        for name in "${!in_store[@]}"; do
            [ -z "${in_mound[$name]+set}" ] && only_store+=("$name")
        done
    fi

    if [ $((${#only_mound[@]} + ${#only_store[@]} + ${#changed[@]})) -eq 0 ]; then
        dr_ok "$DRAUGR_SANDBOX and the store hold the same memory"
        exit 0
    fi

    # Associative arrays have no order, so sort for a stable report.
    show() {
        local label=$1; shift
        [ $# -gt 0 ] || return 0
        printf '%s\n' "$@" | sort | sed "s/^/  $label /"
    }

    # For an empty array, ${arr[0]+"${arr[@]}"} expands to nothing, not to one
    # empty string. Thus show() sees no arguments and returns. It does not print
    # a blank line below a heading.
    heading "memory differences"
    show "only in mound:" ${only_mound[0]+"${only_mound[@]}"}
    show "only in store:" ${only_store[0]+"${only_store[@]}"}
    show "changed:      " ${changed[0]+"${changed[@]}"}
    exit 1
    ;;

# --- check ------------------------------------------------------------------
#
# The question of dr-rm before it destroys a mound, and only that question: is
# there memory in it that no export captured? It is not symmetric, on purpose.
# The store can have files that the mound does not have. That is no reason to
# refuse, because the destruction of the mound does not touch the store.
check)
    dr_sandbox_exists "$DRAUGR_SANDBOX" || exit 0

    # Not reachable is not the same as safe. Do not report it as safe or unsafe.
    if ! mound_list=$(list_mound); then exit 2; fi
    [ -n "$mound_list" ] || exit 0

    # The store as a lookup table, so that one pass over the mound is enough.
    declare -A in_store=()
    while read -r hash name; do
        [ -n "$name" ] && in_store[$name]=$hash
    done <<< "$(list_local "$store_dir/memory")"

    # One miss answers the question, so this exits on the first one, and does
    # not count. A herestring loop runs in this shell, not in a subshell. Thus
    # that exit is the exit of the command.
    while read -r hash name; do
        [ -n "$name" ] || continue
        [ -n "${in_store[$name]+set}" ] || exit 1
        [ "${in_store[$name]}" = "$hash" ] || exit 1
    done <<< "$mound_list"
    exit 0
    ;;
esac
