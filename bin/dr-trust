#!/usr/bin/env bash
# dr-trust: accept a project configuration after you review it.
#
# .draugr.conf is shell, and a source of it runs it. At your first accept,
# Draugr records its hash. It refuses to source a version that it did not see.
# Your shell makes the same agreement with direnv, for the same reason.
#
#   dr-trust                 review and accept the configuration files of this repo
#   dr-trust <file>          accept one file
#   dr-trust --list          the files that are trusted now
#   dr-trust --revoke <file> remove the trust
set -euo pipefail

DR_PROG=dr-trust
# readlink -f comes first. install.sh links this file into ~/.local/bin, and
# through a link BASH_SOURCE is the LINK. Without it, ../lib is ~/.local/lib.
_dr_bin=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$_dr_bin/../lib/common.sh"

# Each argument that is not an option is the path of a configuration file.
action=accept
files=()

# -* catches a wrong option. A word without a dash is a file path.
while [ $# -gt 0 ]; do
    case "$1" in
        --list)    action=list ;;
        --revoke)  action=revoke ;;
        -y|--yes)  DR_ASSUME_YES=1 ;;
        -h|--help) dr_help "$0"; exit 0 ;;
        -*) dr_die "unknown option: $1" "Try: dr-trust --help" ;;
        *)  files+=("$1") ;;
    esac
    shift
done

# --list: read the trust file, and hash each entry again. Thus the report tells
# what you trusted, and also whether the file is still the same.
if [ "$action" = list ]; then
    [ -f "$DR_TRUST_FILE" ] || { printf 'Nothing trusted yet.\n'; exit 0; }
    printf '%s\n' "Trusted project configuration files ($DR_TRUST_FILE):"

    # Each record is "<hash>  <path>", and read splits it into two variables.
    while read -r hash path; do
        [ -n "$path" ] || continue
        if [ ! -f "$path" ]; then
            state="${_DR_DIM}(file is gone)${_DR_OFF}"
        elif [ "$(_dr_hash "$path")" = "$hash" ]; then
            state="${_DR_GREEN}current${_DR_OFF}"
        else
            state="${_DR_YELLOW}EDITED after you trusted it${_DR_OFF}"
        fi
        printf '  %-58s %b\n' "$path" "$state"
    done < "$DR_TRUST_FILE"
    exit 0
fi

# By default, all files in this repo that Draugr runs on your machine. Hooks are
# in that set, as the configuration files are. They are scripts that run on the
# HOST, as you, and they come with a clone, as a configuration does.
if [ ${#files[@]} -eq 0 ]; then
    repo=$(dr_repo_root)
    for f in "$repo/.draugr.conf" "$repo/.draugr.local.conf"; do
        [ -f "$f" ] && files+=("$f")
    done

    # Only the hooks that really run. dr_hook ignores a hook that is not
    # executable. Its trust records a promise about a file that nothing reads.
    for f in "$repo"/.draugr/hooks/*; do
        [ -x "$f" ] && files+=("$f")
    done

    [ ${#files[@]} -gt 0 ] || dr_die \
        "nothing to trust in $repo" \
        "Draugr runs .draugr.conf, .draugr.local.conf, and .draugr/hooks/*." \
        "Create a config with:  dr-init"
fi

# --revoke: remove the path from the trust file. The key of each entry is the
# absolute path. Thus resolve the typed path before the comparison, and fix its
# case. On a Windows drive, `pwd` reports the path as you typed it
# (dr_path_canon_case).
if [ "$action" = revoke ]; then
    for f in "${files[@]}"; do
        abs=$(dr_path_canon_case "$(cd "$(dirname "$f")" && pwd)/$(basename "$f")")
        if [ -f "$DR_TRUST_FILE" ] && grep -qF "  $abs" "$DR_TRUST_FILE"; then
            grep -vF "  $abs" "$DR_TRUST_FILE" > "$DR_TRUST_FILE.tmp" || :
            mv "$DR_TRUST_FILE.tmp" "$DR_TRUST_FILE"
            dr_ok "revoked $abs"
        else
            dr_warn "$abs was not trusted"
        fi
    done
    exit 0
fi

for f in "${files[@]}"; do
    [ -f "$f" ] || dr_die "no such file: $f"
    abs=$(dr_path_canon_case "$(cd "$(dirname "$f")" && pwd)/$(basename "$f")")

    if dr_trust_is_trusted "$abs"; then
        dr_ok "already trusted, unchanged: $abs"
        continue
    fi

    # Show it. This is the purpose of the command. A question that you accept
    # without a read is worse than no question, because it feels like care.
    dr_heading "$abs"
    printf '%s\n' "${_DR_DIM}---------------------------------------------------------------${_DR_OFF}" >&2
    cat "$abs" >&2
    printf '%s\n' "${_DR_DIM}---------------------------------------------------------------${_DR_OFF}" >&2
    printf 'This file is shell. Draugr runs it. ' >&2

    # Three cases: --yes (you already reviewed it), an interactive question, or
    # no terminal. With no terminal, refuse. A silent trust of a configuration
    # in a script is exactly the failure that this guards against.
    if [ -n "${DR_ASSUME_YES:-}" ]; then
        printf 'Accepting (--yes).\n' >&2
    elif [ -t 0 ]; then
        printf 'Trust it? [y/N] ' >&2
        read -r reply
        case "$reply" in
            y|Y|yes|Yes) ;;
            *) dr_warn "not trusted: $abs"; continue ;;
        esac
    else
        dr_die "refusing to trust $abs without a terminal" \
               "Run dr-trust in a terminal, or give --yes if you already reviewed it."
    fi

    dr_trust_add "$abs"
    dr_ok "trusted $abs"
done
