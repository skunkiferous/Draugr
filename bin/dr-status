#!/usr/bin/env bash
# dr-status - what is true about this repo right now.
#
# One screen: which mound, what state, what the host tree looks like, what is
# waiting to be reviewed, and what the config decided.
#
# Nothing here starts a stopped mound. Anything that would have to ask the
# sandbox is either read from local state instead, or reported only when the
# mound is already running - a command people run to decide whether to do
# something must not itself be the thing that does something.
#
#   dr-status
set -euo pipefail

DR_PROG=dr-status
_dr_bin=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$_dr_bin/../lib/common.sh"

case "${1:-}" in
    -h|--help) dr_help "$0"; exit 0 ;;
    ?*) dr_die "unknown option: $1" "dr-status takes no arguments." ;;
esac

dr_context

# A two-column layout, so the labels line up and the values are scannable.
row() { printf '  %-14s %s\n' "$1" "$2"; }

# dr-status is a report: all of it is content, so all of it belongs on stdout.
# dr_heading writes to stderr - correct for the prompts it was written for, wrong
# here, because the two streams are buffered independently and the headings came
# out in the wrong places the moment the output was piped anywhere.
heading() { printf '\n%s%s%s\n' "$_DR_BOLD" "$*" "$_DR_OFF"; }

heading "repository"
row repo "$DR_REPO"
row windows "$DR_REPO_WIN"
row branch "$(dr_repo_branch "$DR_REPO")"

# The dirty-tree line is the one people actually act on, so it says what the
# consequence is rather than just counting files.
#
# DRAUGR_DATA files are counted apart from the rest, because "the clone will not
# have them" is FALSE for those: they travel by rsync instead of git and arrive
# before the agent starts. Counting them together told a repo whose content IS
# data that it had sixteen problems, every one of which was already handled.
if dr_repo_is_clean "$DR_REPO"; then
    row tree "${_DR_GREEN}clean${_DR_OFF}"
else
    total=$(git -C "$DR_REPO" status --porcelain | wc -l | tr -d ' ')
    blocking=$(dr_data_dirty_blockers "$DR_REPO" | wc -l | tr -d ' ')

    if [ "$blocking" -gt 0 ]; then
        row tree "${_DR_YELLOW}$blocking uncommitted change(s)${_DR_OFF} - the clone will not have them"
    else
        row tree "${_DR_GREEN}clean${_DR_OFF} apart from data"
    fi

    # Named with its transport, because the answer to "why is that not blocking
    # me" and the answer to "how does it get there" are the same answer.
    if [ "$((total - blocking))" -gt 0 ]; then
        row data "$((total - blocking)) changed - carried by dr-data push ($DRAUGR_DATA_PUSH), not git"
    fi
fi

# Each state names the command that changes it, so the status screen doubles as
# the prompt for whatever you were about to look up.
heading "mound"
state=$(dr_sandbox_state "$DRAUGR_SANDBOX")
case "$state" in
    running) row state "${_DR_GREEN}running${_DR_OFF}" ;;
    stopped) row state "${_DR_DIM}stopped${_DR_OFF} - dr-go starts it" ;;
    absent)  row state "${_DR_DIM}does not exist${_DR_OFF} - dr-up creates it" ;;
    *)       row state "${_DR_YELLOW}$state${_DR_OFF}" ;;
esac
row name "$DRAUGR_SANDBOX"
row agent "$DRAUGR_AGENT"

# What dr-sync last brought back. Deliberately read from local refs only: asking
# the mound would start a stopped one, and a status command should not have side
# effects. So this is "as of your last dr-sync", and says so when it is empty.
tracking=$(dr_tracking_ref)
if git -C "$DR_REPO" rev-parse --verify --quiet "$tracking" >/dev/null; then
    ahead=$(git -C "$DR_REPO" rev-list --count "HEAD..$tracking")
    behind=$(git -C "$DR_REPO" rev-list --count "$tracking..HEAD")
    if [ "$ahead" -gt 0 ]; then
        row unmerged "${_DR_YELLOW}$ahead commit(s)${_DR_OFF} on $tracking - dr-diff, then dr-merge"
    else
        row unmerged "${_DR_GREEN}none${_DR_OFF} as of your last dr-sync"
    fi
    # Commits the agent may be working without - and the two reasons it might be,
    # which look identical from the tracking ref alone. dr-send drops them on
    # host/<branch> inside the mound without moving the agent's branch, so
    # "not in draugr/main - dr-send" was the standing answer even once they were
    # delivered, and following it did nothing.
    if [ "$behind" -gt 0 ]; then
        if [ "$(dr_send_state)" = unmerged ]; then
            row unsent "${_DR_DIM}$behind commit(s) delivered, not merged - dr-send --merge${_DR_OFF}"
        else
            row unsent "${_DR_DIM}$behind commit(s) not in $tracking - dr-send${_DR_OFF}"
        fi
    fi
else
    row unmerged "${_DR_DIM}never synced${_DR_OFF} - dr-sync fetches the agent's commits"
fi

# Branches other than the tracked one. dr-sync fetches every branch, but only the
# tracked one was ever reported - so an agent working on a branch of its own was
# invisible here too, and "unmerged: none" was actively misleading.
# Each line is "<ref> <count>", so both halves are split off before use: taking
# the branch name straight out of the whole line leaves the count inside the
# suggested command, which then does not work when pasted.
mapfile -t other_branches < <(dr_other_branches)
for entry in "${other_branches[@]+"${other_branches[@]}"}"; do
    ob_ref=${entry% *}
    ob_count=${entry##* }
    row "${_DR_YELLOW}untracked${_DR_OFF}" \
        "$ob_count commit(s) on $ob_ref - DRAUGR_BRANCH=${ob_ref#"$DRAUGR_REMOTE"/} dr-diff"
done

# Workspaces are worth showing because an extra read-only mount is easy to forget
# and is the most likely answer to "why can the agent see that?".
if [ "$state" != absent ]; then
    dr_sbx ls --json 2>/dev/null | jq -r --arg n "$DRAUGR_SANDBOX" \
        '(.sandboxes // [])[] | select(.name == $n) | (.workspaces // [])[]' \
        | while read -r w; do row workspace "$w"; done
fi

# Memory is the other thing a mound holds that exists nowhere else, so it gets
# the same treatment as unfetched commits: say whether dr-rm would lose any.
# Skipped entirely under DRAUGR_MEM_SYNC=off, which is what that value is for -
# a section reporting on something you have said you do not use is just noise.
if [ "$DRAUGR_MEM_SYNC" != off ]; then
    heading "memory"
    # The store gained a per-agent level in 0.2.0. Migrating here as well as in
    # dr-mem means the first command you run after upgrading moves it, whichever
    # one that is - rather than reporting an empty store until you happen to run
    # the other.
    dr_mem_store_migrate "$DR_REPO"
    store_dir=$(dr_mem_store_dir "$DR_REPO")
    marker="$store_dir/.draugr-export"
    if [ -d "$store_dir/memory" ]; then
        stored=$(find "$store_dir/memory" -type f 2>/dev/null | wc -l | tr -d ' ')
        if [ -f "$marker" ]; then
            row store "$stored file(s), exported $(sed -n 's/^date:  *//p' "$marker")"
        else
            row store "$stored file(s) in $store_dir/memory"
        fi
    else
        row store "${_DR_DIM}nothing exported yet${_DR_OFF}"
    fi

    # Only when it is already up: dr-mem check runs a command inside the mound,
    # and that would start a stopped one. Stopped is not "no memory", so it says
    # which of the two it is rather than implying there is nothing to lose.
    case "$state" in
    running)
        mcheck=0
        "$_dr_bin/dr-mem" check >/dev/null 2>&1 || mcheck=$?
        case "$mcheck" in
            0) row mound "${_DR_GREEN}nothing unexported${_DR_OFF}" ;;
            1) row mound "${_DR_YELLOW}has memory not in the store${_DR_OFF} - dr-mem export" ;;
            *) row mound "${_DR_DIM}could not be read${_DR_OFF}" ;;
        esac
        ;;
    stopped) row mound "${_DR_DIM}not checked${_DR_OFF} - would have to start the mound" ;;
    esac
fi

# Only the three settings that change what the agent can reach. The rest are a
# dr-config away, and a status screen nobody reads is worse than a short one.
heading "settings"
if dr_is_true "$DRAUGR_CLONE"; then
    row clone "${_DR_GREEN}true${_DR_OFF} - the agent works on its own clone"
else
    row clone "${_DR_RED}false${_DR_OFF} - the agent has your real working tree, read-write"
fi
row kit "${DRAUGR_KIT:-${_DR_DIM}none${_DR_OFF}}"
row remote "$DRAUGR_REMOTE"

printf '\n  %sWhy any of these:  dr-config --changed%s\n' "$_DR_DIM" "$_DR_OFF"
