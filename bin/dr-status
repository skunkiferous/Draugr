#!/usr/bin/env bash
# dr-status: the current facts about this repo.
#
# One screen: the mound, its state, the state of the host tree, the work to
# review, and the decisions of the configuration.
#
# Nothing here starts a stopped mound. A value that needs a question to the
# sandbox comes from local state. Or, if the mound already runs, the code asks
# it. People run this command to decide what to do. Thus the command
# itself must not do something.
#
#   dr-status
set -euo pipefail

DR_PROG=dr-status
# readlink -f comes first. install.sh links this file into ~/.local/bin, and
# through a link BASH_SOURCE is the LINK. Without it, ../lib is ~/.local/lib.
_dr_bin=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$_dr_bin/../lib/common.sh"

case "${1:-}" in
    -h|--help) dr_help "$0"; exit 0 ;;
    ?*) dr_die "unknown option: $1" "dr-status takes no arguments." ;;
esac

dr_context

# A layout in two columns, so that the labels line up and the values are easy to
# read.
row() { printf '  %-14s %s\n' "$1" "$2"; }

# dr-status is a report. All of it is content, so all of it goes to stdout.
# dr_heading writes to stderr. That is correct for questions, but wrong here.
# The two streams have separate buffers, and in a pipe the headings came out in
# the wrong places.
heading() { printf '\n%s%s%s\n' "$_DR_BOLD" "$*" "$_DR_OFF"; }

heading "repository"
row repo "$DR_REPO"
row windows "$DR_REPO_WIN"
row branch "$(dr_repo_branch "$DR_REPO")"

# People act on the dirty-tree line, so it tells the result, and does not only
# count files.
#
# The code counts DRAUGR_DATA files separately. For those, "the clone does not
# have them" is FALSE. They go through rsync, not git, and arrive before the
# agent starts. One count for both told a repo of data that it had sixteen
# problems, and the code already handled each one.
if dr_repo_is_clean "$DR_REPO"; then
    row tree "${_DR_GREEN}clean${_DR_OFF}"
else
    total=$(git -C "$DR_REPO" status --porcelain | wc -l | tr -d ' ')
    blocking=$(dr_data_dirty_blockers "$DR_REPO" | wc -l | tr -d ' ')

    if [ "$blocking" -gt 0 ]; then
        row tree "${_DR_YELLOW}$blocking uncommitted change(s)${_DR_OFF}. The clone does not have them."
    else
        row tree "${_DR_GREEN}clean${_DR_OFF} except data"
    fi

    # Named with its transport. "Why does that not block me?" and "how does it
    # get there?" have the same answer.
    if [ "$((total - blocking))" -gt 0 ]; then
        row data "$((total - blocking)) changed. dr-data push moves them ($DRAUGR_DATA_PUSH), not git."
    fi
fi

# Each state names the command that changes it. Thus the status screen also
# tells you the next command.
heading "mound"
state=$(dr_sandbox_state "$DRAUGR_SANDBOX")
case "$state" in
    running) row state "${_DR_GREEN}running${_DR_OFF}" ;;
    stopped) row state "${_DR_DIM}stopped${_DR_OFF}. dr-go starts it." ;;
    absent)  row state "${_DR_DIM}does not exist${_DR_OFF}. dr-up creates it." ;;
    *)       row state "${_DR_YELLOW}$state${_DR_OFF}" ;;
esac
row name "$DRAUGR_SANDBOX"
row agent "$DRAUGR_AGENT"

# What dr-sync brought back last time. Only from local refs, on purpose. A
# question to the mound starts a stopped one, and a status command must have no
# side effects. Thus this is "at your last dr-sync". If it is empty, it
# says so.
tracking=$(dr_tracking_ref)
if git -C "$DR_REPO" rev-parse --verify --quiet "$tracking" >/dev/null; then
    ahead=$(git -C "$DR_REPO" rev-list --count "HEAD..$tracking")
    behind=$(git -C "$DR_REPO" rev-list --count "$tracking..HEAD")
    if [ "$ahead" -gt 0 ]; then
        row unmerged "${_DR_YELLOW}$ahead commit(s)${_DR_OFF} on $tracking. Use dr-diff, then dr-merge."
    else
        row unmerged "${_DR_GREEN}none${_DR_OFF} at your last dr-sync"
    fi
    # Commits that the agent possibly works without, and the two reasons for it.
    # From the tracking ref alone, the two look the same. dr-send puts them on
    # host/<branch> inside the mound, and does not move the branch of the agent.
    # Thus "not in draugr/main - dr-send" stayed the answer also after delivery,
    # and the advice did nothing.
    if [ "$behind" -gt 0 ]; then
        # With no mound, these commits are not lost, and dr-send cannot help. It
        # delivers INTO a mound, so with no mound it refuses, and the count does
        # not change. A user followed the advice twice, saw the same screen, and
        # so found this. The tracking ref here is from a removed mound. A new
        # mound clones from HEAD. Thus dr-up brings these in from the start, and
        # no send is necessary.
        if [ "$state" = absent ]; then
            row unsent "${_DR_DIM}$behind commit(s) not in $tracking. dr-up clones them into the new mound.${_DR_OFF}"
        elif [ "$(dr_send_state)" = unmerged ]; then
            row unsent "${_DR_DIM}$behind commit(s) delivered, not merged. Use dr-send --merge.${_DR_OFF}"
        else
            row unsent "${_DR_DIM}$behind commit(s) not in $tracking. Use dr-send.${_DR_OFF}"
        fi
    fi
else
    row unmerged "${_DR_DIM}never synced${_DR_OFF}. dr-sync fetches the commits of the agent."
fi

# Branches other than the tracked one. dr-sync fetches each branch, but before,
# this screen reported only the tracked one. Thus an agent on its own branch was
# not visible here, and "unmerged: none" was false. Each line is "<ref>
# <count>", so the code splits both halves before use. A branch name taken from
# the whole line keeps the count in the suggested command, and a paste of that
# command does not work.
mapfile -t other_branches < <(dr_other_branches)
for entry in "${other_branches[@]+"${other_branches[@]}"}"; do
    ob_ref=${entry% *}
    ob_count=${entry##* }
    row "${_DR_YELLOW}untracked${_DR_OFF}" \
        "$ob_count commit(s) on $ob_ref - DRAUGR_BRANCH=${ob_ref#"$DRAUGR_REMOTE"/} dr-diff"
done

# Show the workspaces, because people easily forget an extra read-only mount. It
# is the most usual answer to "why can the agent see that?".
if [ "$state" != absent ]; then
    dr_sbx ls --json 2>/dev/null | jq -r --arg n "$DRAUGR_SANDBOX" \
        '(.sandboxes // [])[] | select(.name == $n) | (.workspaces // [])[]' \
        | while read -r w; do row workspace "$w"; done
fi

# Memory is the other thing that exists only in a mound. Thus it gets the same
# treatment as unfetched commits: say whether dr-rm loses some. With
# DRAUGR_MEM_SYNC=off, the code skips it, because that is the purpose of that
# value. A section about something that you do not use is only noise.
if [ "$DRAUGR_MEM_SYNC" != off ]; then
    heading "memory"
    # In 0.2.0, the store got a level for each agent. The migration is here and
    # in dr-mem. Thus the first command that you run after the upgrade moves it.
    # Otherwise one command reports an empty store until you run the other.
    dr_mem_store_migrate "$DR_REPO"
    store_dir=$(dr_mem_store_dir "$DR_REPO")
    marker="$store_dir/.draugr-export"
    if [ -d "$store_dir/memory" ]; then
        stored=$(find "$store_dir/memory" -type f 2>/dev/null | wc -l | tr -d ' ')
        if [ -f "$marker" ]; then
            row store "$stored file(s), exported $(sed -n 's/^date:  *//p' "$marker")"
        else
            row store "$stored file(s) in $store_dir/memory"
        fi
    else
        row store "${_DR_DIM}nothing exported yet${_DR_OFF}"
    fi

    # Only for a mound that already runs. dr-mem check runs a command inside the
    # mound, and that starts a stopped one. Stopped is not "no memory". Thus it
    # tells which of the two, and does not imply that there is nothing to lose.
    case "$state" in
    running)
        mcheck=0
        "$_dr_bin/dr-mem" check >/dev/null 2>&1 || mcheck=$?
        case "$mcheck" in
            0) row mound "${_DR_GREEN}nothing unexported${_DR_OFF}" ;;
            1) row mound "${_DR_YELLOW}has memory that is not in the store${_DR_OFF}. Use dr-mem export." ;;
            *) row mound "${_DR_DIM}could not be read${_DR_OFF}" ;;
        esac
        ;;
    stopped) row mound "${_DR_DIM}not tested${_DR_OFF}. The test must start the mound." ;;
    esac
fi

# Only the keys that change what the agent can reach. dr-config shows the rest.
# A status screen that nobody reads is worse than a short one.
heading "configuration"
if dr_is_true "$DRAUGR_CLONE"; then
    row clone "${_DR_GREEN}true${_DR_OFF}. The agent works on its own clone."
else
    row clone "${_DR_RED}false${_DR_OFF}. The agent has your real working tree, read-write."
fi
row kit "${DRAUGR_KIT:-${_DR_DIM}none${_DR_OFF}}"
row remote "$DRAUGR_REMOTE"

# A local model changes where each prompt goes, and this section is for that.
# Only a set value shows, so that the screen stays short for all others. It
# shows with its state. A model that does not answer looks the same as one that
# answers, until the first prompt of the agent fails.
if [ -n "${DRAUGR_MODEL:-}" ]; then
    _surl=$(dr_model_url) || _surl=
    case ${_surl:+$(dr_model_probe "$_surl")} in
        proxy|alive) row model "$DRAUGR_MODEL at $_surl" ;;
        bare)        row model "$DRAUGR_MODEL at $_surl ${_DR_YELLOW}(no proxy in front)${_DR_OFF}" ;;
        stalled)     row model "$DRAUGR_MODEL at $_surl ${_DR_RED}(proxy up, model server down)${_DR_OFF}" ;;
        dead)        row model "$DRAUGR_MODEL at $_surl ${_DR_RED}(no answer. dr-go refuses)${_DR_OFF}" ;;
        *)           row model "$DRAUGR_MODEL at ${_surl:-$DRAUGR_MODEL_URL}" ;;
    esac
fi

# What this repo needs, and whether it runs. One row each, because the question
# is always "can I start work?", not "what is the full state of the chain?".
# dr-dep answers that, and tells who else holds what.
if [ -n "${DRAUGR_REQUIRES:-}" ]; then
    while read -r _dep; do
        [ -n "$_dep" ] || continue
        _dname=$(dr_dep_config "$_dep" DRAUGR_SANDBOX)
        if [ -z "$_dname" ]; then
            row requires "${_DR_RED}$_dep (cannot read its configuration)${_DR_OFF}"
        else
            row requires "$_dname ($(dr_sandbox_state "$_dname"))"
        fi
    done < <(dr_dep_requires "$DR_REPO")
fi

# The environment is text with no limit, and this screen is short on purpose.
# Thus only the COUNT gets a row. "Something goes into the agent" is the
# important fact, and dr-config prints the values. A bad value says so, and does
# not report zero, because zero looks like "none set".
if [ -n "${DRAUGR_ENV:-}" ]; then
    if _envs=$(dr_env_pairs 2>/dev/null); then
        row env "$(printf '%s\n' "$_envs" | grep -c .) variable(s). To see them: dr-config"
    else
        row env "${_DR_RED}bad value. dr-go refuses.${_DR_OFF}"
    fi
fi

printf '\n  %sThe reason for each value:  dr-config --changed%s\n' "$_DR_DIM" "$_DR_OFF"
