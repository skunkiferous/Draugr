#!/usr/bin/env bash
# dr-cp: copy files out of the mound (or into it), without git.
#
# It is for things that do not go through git: a log of the agent, a screenshot,
# or a file that is not complete, that you want to see. Use dr-sync for
# committed work. dr-sync keeps the history and the authors.
#
# A path inside the mound is relative to the repo, in the clone of the agent.
# Thus `dr-cp out.log .` means "the out.log in the clone", not one in /.
# The name of a file or directory cannot start with a -
#
#   dr-cp out.log .              mound -> host
#   dr-cp --to notes.md docs/    host  -> mound
#   dr-cp --raw /tmp/x .         mound path as written, not relative to the repo
#   dr-cp -L dist/ .             copy the targets of symlinks, not the links
#   dr-cp --verify out/ .        list both sides afterwards and compare them
#
# shellcheck disable=SC2016
# Single-quoted "$1" appears here on purpose. Those strings are scripts for the
# shell of the MOUND, and the host must not expand them. See dr_mound_sh in
# lib/common.sh for how the arguments get there.
set -euo pipefail

DR_PROG=dr-cp
# readlink -f comes first. install.sh links this file into ~/.local/bin, and
# through a link BASH_SOURCE is the LINK. Without it, ../lib is ~/.local/lib.
_dr_bin=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$_dr_bin/../lib/common.sh"

# The direction is a flag. Draugr does not guess it from the paths. If a host
# file has the same name as a sandbox path, a guess is wrong.
#
# WHAT `sbx cp` DOES WITH A LINK. It is not the same in the two directions, and
# the difference decides everything below. Measured on sbx 0.53.0, in a
# disposable sandbox, with the link first in the walk, last in the walk, and
# inside a subdirectory:
#
#   host -> mound   the link is SKIPPED and every other file arrives, wherever
#                   the link sits, and `sbx cp` exits 0. The only trace is a
#                   line on stderr: `level=error msg="Can't add file …\mlink to
#                   tar: archive/tar: unknown file mode"`. A Windows JUNCTION
#                   behaves the same way. -L changes nothing: the link is still
#                   skipped, not followed.
#
#   mound -> host   extraction FAILS with `symlinkat \etc\hostname …: A required
#                   privilege is not held by the client` and status 1, after
#                   writing PART of the tree, and which part is not
#                   predictable: one tree arrived with all four of its regular
#                   files, one with a single file out of four, one with
#                   nothing. A fifo gives `Object Name not found.`, a name
#                   holding a control character gives `The filename, directory
#                   name, or volume label syntax is incorrect.`, both status 1.
#                   -L on a tree that HOLDS a link answers `500 Internal Server
#                   Error: failed to archive` and copies nothing at all. On a
#                   tree with no link it behaves like a plain copy.
#
#   0.37.1          -L followed links ANYWHERE in the tree, not only the source.
#                   A seed with AGENTS.md as a symlink to CLAUDE.md came out as
#                   2262 real files, with no link left in them.
#
# So one direction is loud and leaves a half-written tree, and the other looks
# like a success. The warnings below say which, and the check after the copy
# compares the two sides by name, because "sbx exited 0" is not "the same files
# are on both sides". That behavior has already changed once between two sbx
# versions, so Draugr does not rest on it: it asks.
to_mound=
raw=
verify=
follow=()
args=()
while [ $# -gt 0 ]; do
    case "$1" in
        --to)      to_mound=1 ;;
        --raw)     raw=1 ;;
        --verify)  verify=1 ;;
        -L|--follow-link) follow=(-L) ;;
        -h|--help) dr_help "$0"; exit 0 ;;
        -*) dr_die "unknown option: $1" "Try: dr-cp --help" ;;
        *) args+=("$1") ;;
    esac
    shift
done

[ ${#args[@]} -eq 2 ] || dr_die \
    "dr-cp takes two paths, no more and no less" \
    "Out of the mound:  dr-cp <path-in-mound> <host-dest>" \
    "Into the mound:    dr-cp --to <host-path> <path-in-mound>"

dr_context

dr_sandbox_exists "$DRAUGR_SANDBOX" || dr_die \
    "$DRAUGR_SANDBOX does not exist" "Create it with:  dr-up"

clone=$(dr_path_mound "$DR_REPO")

# Without --raw, a path in the mound is relative to the clone of the agent.
# An absolute path does not change, because it is already clear.
mound_path() {
    case "$1" in
        /*) printf '%s' "$1" ;;
        *)  if [ -n "$raw" ]; then printf '%s' "$1"; else printf '%s/%s' "$clone" "$1"; fi ;;
    esac
}

# The HOST side of the copy, in the form that sbx wants.
#
# sbx.exe is a Windows binary that WSL runs through interop, and it does not
# translate paths. An absolute WSL path arrives as a Windows path. sbx reads
# /mnt/c/Code/x as \mnt\c\Code\x, and the error names a path that nobody typed
#
#   ERROR: extract to /mnt/c/Code/x: GetFileAttributesEx \mnt\c\Code: The system
#          cannot find the path specified.
#
# Relative paths do NOT change, on purpose. Interop resolves them against the
# Windows working directory. That is why `dr-cp out.log .` always worked. A
# translation breaks the documented form, to fix a form that nobody can use.
host_path() {
    case "$1" in
        /*) dr_path_win "$1" ;;
        *)  printf '%s' "$1" ;;
    esac
}

# sbx cp wants one side as SANDBOX:PATH, and the other as a local path. The two
# directions differ only in which side is which.
if [ -n "$to_mound" ]; then
    src=${args[0]}
    # Test before the translation, so the message names the path as typed.
    [ -e "$src" ] || dr_die "no such file on the host: $src"
    src=$(host_path "$src") || dr_die \
        "not on a Windows drive: ${args[0]}" \
        "sbx.exe cannot reach it. Copy from somewhere under /mnt/<drive>/."
    dst="$DRAUGR_SANDBOX:$(mound_path "${args[1]}")"
else
    src="$DRAUGR_SANDBOX:$(mound_path "${args[0]}")"
    dst=$(host_path "${args[1]}") || dr_die \
        "not on a Windows drive: ${args[1]}" \
        "sbx.exe cannot reach it. Copy to somewhere under /mnt/<drive>/, or use" \
        "a relative path. Interop resolves it against the Windows directory."
fi

# --- what is in the tree, before the copy -----------------------------------
#
# One listing on each side, in one shape: "<type><TAB><path relative to the
# tree>", from `-printf` of find itself. The type comes first so a link that was
# dropped shows up as a missing entry rather than as nothing at all.
#
# ONE EXPRESSION AND NO SHELL LOOP, because the mound side runs under `sh`.
# dr_mound_sh sends its script to `sh -c`, where `read -d ''` does not exist -
# a first version used it and the mound returned an empty listing, which read
# as "nothing arrived". The host side uses the same expression on purpose: a
# comparison is only worth anything if both sides were asked the same question.
#
# The limit of a line-based listing is a name that CONTAINS a newline. Such a
# name arrives as two lines on both sides, so a tree that copied correctly
# still compares equal, and a dropped entry still removes lines. It fails
# closed, and classify_staged in dr-data is where a name is judged rather than
# counted.
_list_expr() {
    find "$1" -mindepth 1 -printf '%y\t%P\n' 2>/dev/null | LC_ALL=C sort
}

list_host() {
    local dir=$1
    [ -e "$dir" ] || return 0
    # A single regular file is one entry with no relative path of its own.
    if [ -f "$dir" ] && [ ! -L "$dir" ]; then printf 'f\t\n'; return 0; fi
    _list_expr "$dir"
}

# The same listing, asked of the mound. It runs with the shell and the
# find of the mound, which is why it is used to DESCRIBE a tree and never to decide whether
# one is safe.
list_mound_tree() {
    # shellcheck disable=SC2016  # $1 is the sh of the mound, not this shell
    dr_mound_sh '
        [ -e "$1" ] || exit 0
        if [ -f "$1" ] && [ ! -L "$1" ]; then printf "f\t\n"; exit 0; fi
        find "$1" -mindepth 1 -printf "%y\t%P\n" 2>/dev/null | LC_ALL=C sort' "$1"
}

# A warning before the copy, because the two directions fail differently and
# the one that fails loudly still leaves files behind. See the measurements in
# the header.
if [ -n "$to_mound" ]; then
    if [ -d "${args[0]}" ] && [ -n "$(find "${args[0]}" -type l 2>/dev/null | head -1)" ]; then
        dr_warn "${args[0]} holds a link, and sbx 0.53 leaves it out of the copy"
        printf '  %sEverything else arrives and sbx exits 0, so the tree in the mound%s\n' \
            "$_DR_DIM" "$_DR_OFF" >&2
        printf '  %sis missing that entry. -L does not help. Copy the target yourself.%s\n' \
            "$_DR_DIM" "$_DR_OFF" >&2
    fi
else
    # The mound side has to be asked. A link there does not make a partial
    # copy, it makes a FAILED copy with part of the tree already on your disk.
    #
    # The answer is a WORD, not "did anything come back". Any output read as
    # "there is a link" turns an unreachable mound, or a find that printed
    # a diagnostic, into a warning about something nobody saw. Only LINK is an
    # answer. Everything else leaves this silent, and a link that is really
    # there then shows as the loud failure below.
    # shellcheck disable=SC2016  # $1 is the sh of the mound, not this shell
    if [ "$(dr_mound_sh \
                'if find "$1" -type l 2>/dev/null | head -1 | grep -q .; then echo LINK; else echo NONE; fi' \
                "$(mound_path "${args[0]}")")" = LINK ]; then
        dr_warn "that path in the mound holds a link, and Windows will not create it"
        printf '  %ssbx stops with "a required privilege is not held", after writing%s\n' \
            "$_DR_DIM" "$_DR_OFF" >&2
        printf '  %sPART of the tree here. -L answers 500 for such a tree. Look first:%s\n' \
            "$_DR_DIM" "$_DR_OFF" >&2
        printf '  %s  dr-shell -- find <path> -type l%s\n' "$_DR_DIM" "$_DR_OFF" >&2
    fi
fi

# --verify only. The listing of the source, taken before the copy, and where
# the copy will land. Measured in both directions: if the destination exists
# and is a directory, sbx appends the basename of the source to it. If it does
# not exist, the destination BECOMES the copy.
before=''
landed=''
if [ -n "$verify" ]; then
    if [ -n "$to_mound" ]; then
        before=$(list_host "${args[0]}")
        # shellcheck disable=SC2016  # $1 is the sh of the mound, not this shell
        if dr_mound_sh 'test -d "$1"' "$(mound_path "${args[1]}")"; then
            landed=$(mound_path "${args[1]}")/$(basename "${args[0]}")
        else
            landed=$(mound_path "${args[1]}")
        fi
    else
        before=$(list_mound_tree "$(mound_path "${args[0]}")")
        if [ -d "${args[1]}" ]; then
            landed=${args[1]}/$(basename "${args[0]}")
        else
            landed=${args[1]}
        fi
    fi
fi

dr_info "$src -> $dst"
# The hint names the two failures with the words that sbx prints. Before, both
# came with "check the path exists on the source side". That was wrong both
# times, because the path existed.
dr_sbx cp ${follow[0]+"${follow[@]}"} "$src" "$dst" || dr_die \
    "copy failed" \
    "\"a required privilege is not held\" means the tree holds a symlink, which" \
    "Windows will not create. PART of the tree is on your disk already, and which" \
    "part is not predictable. -L does not help: on such a tree it answers 500." \
    "Copy the target of the link instead of the link." \
    "\"not found in container\" means that the path in the mound is wrong. Look with:" \
    "  dr-shell -- ls -la"

# On the host, sbx cp writes as the user that ran it. *Into* the mound, it
# writes as root:root, but the agent is uid 1000. The agent can read a copied
# file, but not write it. That fails later, and looks like a broken script.
#
# The chown works because of -u root. By default, `sbx exec` runs as the agent,
# and the agent cannot chown a tree that root owns. Without -u root, this line
# failed each time, and gave the warning below. The line exists to prevent that
# result, and showed it as a rare case. A test with sbx 0.37.1 showed this.
if [ -n "$to_mound" ]; then
    target=$(mound_path "${args[1]}")
    dr_sbx exec -u root "$DRAUGR_SANDBOX" chown -R 1000:1000 "$target" 2>/dev/null \
        || dr_warn "copied, but could not chown $target to the agent (uid 1000)"
fi

# --- --verify: the same entries on both sides -------------------------------
#
# "sbx exited 0" is not "the copy is complete". Measured on 0.53.0: a copy INTO
# the mound leaves a link out, keeps every other file, and exits 0. The only
# trace is a line on stderr that this command does not read. So --verify
# compares the two sides. The comparison belongs to Draugr itself, so it does not
# depend on the copy tool having said anything.
#
# IT IS A FLAG AND NOT THE DEFAULT. Two listings are two more conversations
# with the mound, and the warnings above already name the one condition that
# causes a silent drop. --verify is for the transfer that is worth the cost.
# This is the wording of the review itself, and the shape of every other narrow
# feature here: off unless asked for.
#
# BY NAME AND TYPE, NEVER BY SIZE OR CONTENT. `dr-cp out.log .` on a log the
# agent is still writing is a documented use of this command, and its size
# differs between the two listings by design. What a dropped entry changes is
# the set of names.
verify_copy() {
    local after n_before n_after
    if [ -n "$to_mound" ]; then
        after=$(list_mound_tree "$landed")
    else
        after=$(list_host "$landed")
    fi
    n_before=$(printf '%s\n' "$before" | grep -c . || true)
    if [ "$before" = "$after" ]; then
        dr_ok "verified: $n_before entr(ies) on both sides"
        return 0
    fi

    n_after=$(printf '%s\n' "$after" | grep -c . || true)
    dr_error "what arrived is not what was there: $n_before entr(ies) on the source, $n_after at the destination"
    # comm needs both sides sorted. A missing entry is the failure this exists
    # for. An extra one means the destination already held something, or the
    # source changed while the copy ran.
    comm -23 <(printf '%s\n' "$before" | sort) <(printf '%s\n' "$after" | sort) \
        | head -10 | sed 's/^/    missing  /' >&2
    comm -13 <(printf '%s\n' "$before" | sort) <(printf '%s\n' "$after" | sort) \
        | head -10 | sed 's/^/    extra    /' >&2
    dr_die "the copy is incomplete" \
        "A leading l is a link: sbx leaves those out of a copy into the mound and" \
        "still exits 0. Copy the target of the link instead." \
        "The entries that did arrive ARE at the destination. Nothing was removed." \
        "A file that appeared or vanished while the copy ran also shows up here."
}

[ -z "$verify" ] || verify_copy

dr_ok "copied"
