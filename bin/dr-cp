#!/usr/bin/env bash
# dr-cp - copy files out of the mound (or into it) without going through git.
#
# For the things git is the wrong channel for: a log the agent produced, a
# screenshot, a half-finished file you want to look at. Committed work should
# come out with dr-sync instead - it keeps the history and the authorship.
#
# Paths inside the mound are given repo-relative and resolved against the agent's
# clone, so `dr-cp out.log .` means "the out.log in the clone", not one in /.
# Files and directory cannot start with a -
#
#   dr-cp out.log .              mound -> host
#   dr-cp --to notes.md docs/    host  -> mound
#   dr-cp --raw /tmp/x .         mound path taken literally, not repo-relative
#   dr-cp -L dist/ .             copy what symlinks point at, not the links
set -euo pipefail

DR_PROG=dr-cp
# readlink -f first: install.sh links this into ~/.local/bin by default, and
# through a link BASH_SOURCE is the LINK, so ../lib would be ~/.local/lib.
_dr_bin=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$_dr_bin/../lib/common.sh"

# Direction is a flag rather than being inferred from the paths: "does this look
# like a sandbox path" would guess wrong the moment a host file shares a name.
#
# -L is passed straight through to sbx, and is not the same flag as cp(1)'s: sbx
# follows links found ANYWHERE in the tree, not just one named as the source.
# Measured against sbx 0.37.1 - a seed containing a plugin whose AGENTS.md is a
# symlink to CLAUDE.md copied out whole, 2262 files, with no link left in it.
to_mound=
raw=
follow=()
args=()
while [ $# -gt 0 ]; do
    case "$1" in
        --to)      to_mound=1 ;;
        --raw)     raw=1 ;;
        -L|--follow-link) follow=(-L) ;;
        -h|--help) dr_help "$0"; exit 0 ;;
        -*) dr_die "unknown option: $1" "Try: dr-cp --help" ;;
        *) args+=("$1") ;;
    esac
    shift
done

[ ${#args[@]} -eq 2 ] || dr_die \
    "dr-cp takes exactly two paths" \
    "Out of the mound:  dr-cp <path-in-mound> <host-dest>" \
    "Into the mound:    dr-cp --to <host-path> <path-in-mound>"

dr_context

dr_sandbox_exists "$DRAUGR_SANDBOX" || dr_die \
    "$DRAUGR_SANDBOX does not exist" "Create it with:  dr-up"

clone=$(dr_path_mound "$DR_REPO")

# Resolve a mound-side path against the agent's clone unless --raw was given.
# Absolute paths are left alone either way: they were already unambiguous.
mound_path() {
    case "$1" in
        /*) printf '%s' "$1" ;;
        *)  if [ -n "$raw" ]; then printf '%s' "$1"; else printf '%s/%s' "$clone" "$1"; fi ;;
    esac
}

# The HOST side of the copy, spelled the way sbx wants it.
#
# sbx.exe is a Windows binary that WSL runs over interop, and it does not
# translate paths: an absolute WSL path arrives as a Windows one, so
# /mnt/c/Code/x is read as \mnt\c\Code\x and the error names a path nobody typed
#
#   ERROR: extract to /mnt/c/Code/x: GetFileAttributesEx \mnt\c\Code: The system
#          cannot find the path specified.
#
# Relative paths are deliberately NOT touched. Interop already resolves those
# against the Windows working directory, which is why `dr-cp out.log .` has
# always worked - translating them would break the documented spelling to fix
# one nobody could use.
host_path() {
    case "$1" in
        /*) dr_path_win "$1" ;;
        *)  printf '%s' "$1" ;;
    esac
}

# sbx cp wants one side written as SANDBOX:PATH and the other as a plain local
# path. Which side is which is the only difference between the two directions.
if [ -n "$to_mound" ]; then
    src=${args[0]}
    # Checked before translation, so the message names the path as it was typed.
    [ -e "$src" ] || dr_die "no such file on the host: $src"
    src=$(host_path "$src") || dr_die \
        "not on a Windows drive: ${args[0]}" \
        "sbx.exe cannot reach it. Copy from somewhere under /mnt/<drive>/."
    dst="$DRAUGR_SANDBOX:$(mound_path "${args[1]}")"
else
    src="$DRAUGR_SANDBOX:$(mound_path "${args[0]}")"
    dst=$(host_path "${args[1]}") || dr_die \
        "not on a Windows drive: ${args[1]}" \
        "sbx.exe cannot reach it. Copy to somewhere under /mnt/<drive>/, or use" \
        "a relative path - interop resolves those against the Windows directory."
fi

dr_info "$src -> $dst"
# The hint names the two failures by the words sbx prints, because both of them
# used to arrive under "check the path exists on the source side" - advice that
# was wrong in each case, since the path existed both times.
dr_sbx cp ${follow[0]+"${follow[@]}"} "$src" "$dst" || dr_die \
    "copy failed" \
    "\"a required privilege is not held\" means the tree contains a symlink, and" \
    "Windows will not create one. Copy what it points at instead:  dr-cp -L ..." \
    "\"not found in container\" means the mound-side path is wrong. Look with:" \
    "  dr-shell -- ls -la"

# sbx cp writes to the host as whoever ran it, but *into* the mound as root:root,
# and the agent is uid 1000 - so a file copied in would be readable and not
# writable, which fails later in ways that look like a broken script.
#
# -u root is what makes the chown work. `sbx exec` runs as the agent by default,
# and the agent cannot chown a root-owned tree, so without it this line failed
# every time and degraded to the warning below - the exact outcome it exists to
# prevent, announced as if it were rare. Measured against sbx 0.37.1.
if [ -n "$to_mound" ]; then
    target=$(mound_path "${args[1]}")
    dr_sbx exec -u root "$DRAUGR_SANDBOX" chown -R 1000:1000 "$target" 2>/dev/null \
        || dr_warn "copied, but could not chown $target to the agent (uid 1000)"
fi

dr_ok "copied"
