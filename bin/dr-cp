#!/usr/bin/env bash
# dr-cp: copy files out of the mound (or into it), without git.
#
# It is for things that do not go through git: a log of the agent, a screenshot,
# or a file that is not complete, that you want to see. Use dr-sync for
# committed work. dr-sync keeps the history and the authors.
#
# A path inside the mound is relative to the repo, in the clone of the agent.
# Thus `dr-cp out.log .` means "the out.log in the clone", not one in /.
# The name of a file or directory cannot start with a -
#
#   dr-cp out.log .              mound -> host
#   dr-cp --to notes.md docs/    host  -> mound
#   dr-cp --raw /tmp/x .         mound path as written, not relative to the repo
#   dr-cp -L dist/ .             copy the targets of symlinks, not the links
set -euo pipefail

DR_PROG=dr-cp
# readlink -f comes first. install.sh links this file into ~/.local/bin, and
# through a link BASH_SOURCE is the LINK. Without it, ../lib is ~/.local/lib.
_dr_bin=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$_dr_bin/../lib/common.sh"

# The direction is a flag. Draugr does not guess it from the paths. If a host
# file has the same name as a sandbox path, a guess is wrong.
#
# -L goes to sbx without change, and it is not the -L of cp(1). sbx follows
# links ANYWHERE in the tree, not only the source. A test with sbx 0.37.1 showed
# this. A seed had a plugin with AGENTS.md as a symlink to CLAUDE.md. All 2262
# files came out, with no link in them.
to_mound=
raw=
follow=()
args=()
while [ $# -gt 0 ]; do
    case "$1" in
        --to)      to_mound=1 ;;
        --raw)     raw=1 ;;
        -L|--follow-link) follow=(-L) ;;
        -h|--help) dr_help "$0"; exit 0 ;;
        -*) dr_die "unknown option: $1" "Try: dr-cp --help" ;;
        *) args+=("$1") ;;
    esac
    shift
done

[ ${#args[@]} -eq 2 ] || dr_die \
    "dr-cp takes two paths, no more and no less" \
    "Out of the mound:  dr-cp <path-in-mound> <host-dest>" \
    "Into the mound:    dr-cp --to <host-path> <path-in-mound>"

dr_context

dr_sandbox_exists "$DRAUGR_SANDBOX" || dr_die \
    "$DRAUGR_SANDBOX does not exist" "Create it with:  dr-up"

clone=$(dr_path_mound "$DR_REPO")

# Without --raw, a path in the mound is relative to the clone of the agent.
# An absolute path does not change, because it is already clear.
mound_path() {
    case "$1" in
        /*) printf '%s' "$1" ;;
        *)  if [ -n "$raw" ]; then printf '%s' "$1"; else printf '%s/%s' "$clone" "$1"; fi ;;
    esac
}

# The HOST side of the copy, in the form that sbx wants.
#
# sbx.exe is a Windows binary that WSL runs through interop, and it does not
# translate paths. An absolute WSL path arrives as a Windows path. sbx reads
# /mnt/c/Code/x as \mnt\c\Code\x, and the error names a path that nobody typed
#
#   ERROR: extract to /mnt/c/Code/x: GetFileAttributesEx \mnt\c\Code: The system
#          cannot find the path specified.
#
# Relative paths do NOT change, on purpose. Interop resolves them against the
# Windows working directory. That is why `dr-cp out.log .` always worked. A
# translation breaks the documented form, to fix a form that nobody can use.
host_path() {
    case "$1" in
        /*) dr_path_win "$1" ;;
        *)  printf '%s' "$1" ;;
    esac
}

# sbx cp wants one side as SANDBOX:PATH, and the other as a local path. The two
# directions differ only in which side is which.
if [ -n "$to_mound" ]; then
    src=${args[0]}
    # Test before the translation, so the message names the path as typed.
    [ -e "$src" ] || dr_die "no such file on the host: $src"
    src=$(host_path "$src") || dr_die \
        "not on a Windows drive: ${args[0]}" \
        "sbx.exe cannot reach it. Copy from somewhere under /mnt/<drive>/."
    dst="$DRAUGR_SANDBOX:$(mound_path "${args[1]}")"
else
    src="$DRAUGR_SANDBOX:$(mound_path "${args[0]}")"
    dst=$(host_path "${args[1]}") || dr_die \
        "not on a Windows drive: ${args[1]}" \
        "sbx.exe cannot reach it. Copy to somewhere under /mnt/<drive>/, or use" \
        "a relative path. Interop resolves it against the Windows directory."
fi

dr_info "$src -> $dst"
# The hint names the two failures with the words that sbx prints. Before, both
# came with "check the path exists on the source side". That was wrong both
# times, because the path existed.
dr_sbx cp ${follow[0]+"${follow[@]}"} "$src" "$dst" || dr_die \
    "copy failed" \
    "\"a required privilege is not held\" means that the tree has a symlink, and" \
    "Windows does not create it. Copy the target of the link:  dr-cp -L ..." \
    "\"not found in container\" means that the path in the mound is wrong. Look with:" \
    "  dr-shell -- ls -la"

# On the host, sbx cp writes as the user that ran it. *Into* the mound, it
# writes as root:root, but the agent is uid 1000. The agent can read a copied
# file, but not write it. That fails later, and looks like a broken script.
#
# The chown works because of -u root. By default, `sbx exec` runs as the agent,
# and the agent cannot chown a tree that root owns. Without -u root, this line
# failed each time, and gave the warning below. The line exists to prevent that
# result, and showed it as a rare case. A test with sbx 0.37.1 showed this.
if [ -n "$to_mound" ]; then
    target=$(mound_path "${args[1]}")
    dr_sbx exec -u root "$DRAUGR_SANDBOX" chown -R 1000:1000 "$target" 2>/dev/null \
        || dr_warn "copied, but could not chown $target to the agent (uid 1000)"
fi

dr_ok "copied"
