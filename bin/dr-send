#!/usr/bin/env bash
# dr-send: make your newest host commits available inside the mound.
#
# The obvious way, a push from the host into the clone, does not work. The clone
# has that branch checked out, and git refuses to update a checked-out branch
# from outside. Thus the transfer runs from the *inside*, as a fetch from the
# read-only host mount at /run/sandbox/source. No network, no daemon, no ssh:
# the repository is already there.
#
# It fetches, and does not merge, because the agent can be in the middle of an
# edit in that clone.
#
#   dr-send            fetch your commits into the mound as host/<branch>
#   dr-send --merge    also merge them, if the tree of the agent is clean
set -euo pipefail

DR_PROG=dr-send
# readlink -f comes first. install.sh links this file into ~/.local/bin, and
# through a link BASH_SOURCE is the LINK. Without it, ../lib is ~/.local/lib.
_dr_bin=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$_dr_bin/../lib/common.sh"

# --merge is only on request, because the agent can be in the middle of an edit.
# By default, the commits become available, and the user inside decides the
# time to take them.
merge=
while [ $# -gt 0 ]; do
    case "$1" in
        --merge)   merge=1 ;;
        -h|--help) dr_help "$0"; exit 0 ;;
        *) dr_die "unknown option: $1" "Try: dr-send --help" ;;
    esac
    shift
done

dr_context

dr_sandbox_exists "$DRAUGR_SANDBOX" || dr_die \
    "$DRAUGR_SANDBOX does not exist" "Create it with:  dr-up"

# Only committed work can go. The mount shows your files to the agent, but a
# fetch moves commits. Thus uncommitted work is not in the transfer.
#
# The warning skips DRAUGR_DATA files. They never go this way, and they have
# their own command. If the list named them, it looked as if dr-send lost them.
# In a repo of data, that was the whole message.
if ! dr_repo_is_clean "$DR_REPO"; then
    _blocking=$(dr_data_dirty_blockers "$DR_REPO")
    if [ -n "$_blocking" ]; then
        dr_warn "you have uncommitted changes. Only committed work goes."
        printf '%s\n' "$_blocking" >&2
    fi

    # Say it once, quietly, and not never. Data moves on its own schedule, so
    # "dr-send moved everything" is a wrong belief.
    _data=$(( $(git -C "$DR_REPO" status --porcelain | wc -l) - $(printf '%s' "$_blocking" | grep -c . || true) ))
    if [ "$_data" -gt 0 ]; then
        printf '  %s%s data file(s) go separately:  dr-data push%s\n' \
            "$_DR_DIM" "$_data" "$_DR_OFF" >&2
    fi
fi

branch=$DRAUGR_BRANCH
clone=$(dr_path_mound "$DR_REPO")

# refs/remotes/host/<branch>, not a local branch name. Thus nothing inside the
# clone is overwritten, and the agent sees it as a remote to merge from.
dr_info "sending $branch into $DRAUGR_SANDBOX"
dr_sbx exec "$DRAUGR_SANDBOX" \
    git -C "$clone" fetch /run/sandbox/source "$branch:refs/remotes/host/$branch" \
    || dr_die \
        "could not fetch inside the mound" \
        "Does the mound run, and is $clone the clone of the agent?  dr-status"

# dr-status and dr-sync tell "the mound never saw these" from "delivered, but
# not merged" by refs/draugr/sent/<branch>. Until now the extra fetch refspec of
# dr-sync was the only thing that wrote it, so the mark appeared only if you
# synced AFTER you sent. In the ordinary order - collect the work of the agent,
# then hand it yours - the mark was never made, because at fetch time the mound
# had no refs/remotes/host/* to copy. dr-status then said "Use dr-send" for
# ever, which is the loop this mark exists to break.
#
# After the fetch and not before: a delivery that failed must not claim one.
# $branch and not HEAD, because $branch is what was just sent. The refspec of
# dr-sync stays: it is still the only thing that can CORRECT the mark when the
# host/* ref of the mound is older than what the host believes it sent, as after
# a dr-up --recreate threw the clone away.
git -C "$DR_REPO" update-ref "$(dr_sent_ref)" "$(git -C "$DR_REPO" rev-parse "$branch")" \
    || dr_warn "could not mark $branch as sent, so dr-status may still say dr-send"

dr_ok "your commits are on host/$branch inside the mound"

# A stop here is the normal case. Thus name both ways forward. Do not let the
# reader guess what "available inside the mound" gives.
if [ -z "$merge" ]; then
    printf '  %sThe agent can take them with:  git merge host/%s%s\n' \
        "$_DR_DIM" "$branch" "$_DR_OFF" >&2
    printf '  %sOr do it now with:  dr-send --merge%s\n' "$_DR_DIM" "$_DR_OFF" >&2
    exit 0
fi

# --merge is only on request, and still refuses on a dirty clone. The agent can
# be in the middle of an edit there, and a merge mixes it up.
if ! dr_sbx exec "$DRAUGR_SANDBOX" git -C "$clone" diff --quiet HEAD 2>/dev/null; then
    dr_die \
        "the tree of the agent has uncommitted changes. No merge into it." \
        "Ask the agent to commit, then run again:  dr-send --merge" \
        "Or do nothing. The commits are already there as host/$branch."
fi

# `git merge` applies to what is CHECKED OUT in the clone, and that need not be
# $branch. An agent works on a branch of its own all the time. Nothing here read
# the HEAD of the clone, so the refusal below named host/$branch while the merge
# had in fact been tried on another branch.
#
# A test showed how that reads: the clone was on `simple-english`,
# the own `main` of the clone WAS fast-forwardable, and dr-send said "could not
# fast-forward the mound to host/main" one line after dr-sync said
# "nothing new in the mound - draugr/main matches your branch". Together the two
# lines look like a contradiction, and the real answer - that the merge went to
# a third branch - appeared nowhere.
#
# A detached HEAD makes symbolic-ref fail. An empty answer means "cannot tell",
# and falls through to the merge below. Do not refuse on a question that could
# not be asked.
_head=$(dr_sbx exec "$DRAUGR_SANDBOX" \
            git -C "$clone" symbolic-ref --short HEAD 2>/dev/null) || _head=
_head=${_head%%[[:space:]]*}
if [ -n "$_head" ] && [ "$_head" != "$branch" ]; then
    dr_die \
        "the mound is on $_head, not $branch. No merge into it." \
        "host/$branch is fetched and waiting. To take it, inside the mound:" \
        "  git merge host/$branch            on $_head, a real merge" \
        "Or move the own $branch of the mound forward:" \
        "  git checkout $branch && git merge --ff-only host/$branch"
fi

dr_sbx exec "$DRAUGR_SANDBOX" git -C "$clone" merge --ff-only "host/$branch" \
    || dr_die \
        "could not fast-forward the mound to host/$branch" \
        "The agent has commits of its own, so this needs a real merge." \
        "Fetch its work first with dr-sync, or merge inside the mound:  dr-shell"

dr_ok "the mound is now at your $branch"
