#!/usr/bin/env bash
# dr-kit - check, show and apply this project's sbx kits, and keep a library.
#
# A kit declares what the agent gets INSIDE the mound: network rules, install
# commands, ports, environment. Draugr does not parse it - sbx does, and these
# are thin wrappers so the error text you get is sbx's own.
#
# DRAUGR_KIT is a LIST, because sbx merges kits rather than choosing between
# them, so a project kit and a shared "lua" kit from your library compose:
#
#   DRAUGR_KIT=".draugr/kit lua"
#
# What Draugr adds is noticing when they change. dr-up records every kit at
# creation and reports drift instead of quietly rebuilding your sandbox.
#
# Only one change can be applied to a running mound: kits ADDED to the end of
# the list. sbx refuses to re-add a kit it already has, and cannot remove one,
# so an edited or removed kit needs `dr-up --recreate` - apply says which.
#
#   dr-kit validate    check every kit, with sbx's own diagnostics
#   dr-kit show        what they declare
#   dr-kit drift       have they changed since the mound was built?
#   dr-kit apply       add new kits in place, or say why only a recreate can
#   dr-kit list        the named kits in your library
#   dr-kit save NAME   copy this project's kit into the library as NAME
#   dr-kit adopt       write hosts opened with dr-policy --allow into the kit
set -euo pipefail

DR_PROG=dr-kit
# readlink -f first: install.sh links this into ~/.local/bin by default, and
# through a link BASH_SOURCE is the LINK, so ../lib would be ~/.local/lib.
_dr_bin=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$_dr_bin/../lib/common.sh"

# The action is the first positional, defaulting to the harmless one. `shift ||
# :` because with no arguments at all there is nothing to shift and set -e would
# take that as a failure.
action=${1:-show}
case "$action" in
    -h|--help) dr_help "$0"; exit 0 ;;
    validate|show|drift|apply|list|save|adopt) shift || : ;;
    *) dr_die "unknown action: $action" \
              "One of: validate, show, drift, apply, list, save, adopt" ;;
esac

# -y is read by dr_confirm, which `apply` and `save` both use. The lone
# positional belongs to `save`; anywhere else it is a typo worth naming.
save_name=
while [ $# -gt 0 ]; do
    case "$1" in
        -y|--yes) DR_ASSUME_YES=1 ;;
        -*) dr_die "unknown option: $1" "Try: dr-kit --help" ;;
        *)
            [ -z "$save_name" ] || dr_die "unexpected argument: $1" "Try: dr-kit --help"
            save_name=$1
            ;;
    esac
    shift
done

dr_context

store=$(dr_kit_store)

# --- the library --------------------------------------------------------------
#
# These two are about the store rather than this project's kit list, so they run
# before the checks that insist DRAUGR_KIT resolves to something. Saving a kit
# from a repo whose own kit is fine but whose library entry is misspelled should
# not be blocked by the misspelling.

case "$action" in

list)
    # An absent store is the normal state until you save something, so it is an
    # invitation rather than a warning.
    if [ ! -d "$store" ]; then
        dr_info "no kit library yet at $store"
        printf '  %sSave this project'"'"'s kit as a reusable one:  dr-kit save <name>%s\n' \
            "$_DR_DIM" "$_DR_OFF" >&2
        exit 0
    fi

    # One level only: a kit is a directory of files, so anything nested inside
    # one belongs to that kit rather than being a kit of its own.
    mapfile -t names < <(find "$store" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort)
    if [ ${#names[@]} -eq 0 ]; then
        dr_info "the kit library at $store is empty"
        printf '  %sPut one there with:  dr-kit save <name>%s\n' "$_DR_DIM" "$_DR_OFF" >&2
        exit 0
    fi

    dr_heading "${#names[@]} kit(s) in $store"
    for n in "${names[@]}"; do
        # displayName is the one human-written line in a spec, which makes it
        # worth more in a listing than anything we could compute from the files.
        desc=$(sed -n 's/^displayName:[[:space:]]*//p' "$store/$n/spec.yaml" 2>/dev/null | head -1)
        printf '  %-20s %s%s%s\n' "$n" "$_DR_DIM" "${desc:-no displayName}" "$_DR_OFF" >&2
    done
    printf '\n  %sUse one by adding its name to DRAUGR_KIT - it ADDS to the project'"'"'s kit:%s\n' \
        "$_DR_DIM" "$_DR_OFF" >&2
    printf '  %s  DRAUGR_KIT=".draugr/kit %s"%s\n' "$_DR_DIM" "${names[0]}" "$_DR_OFF" >&2
    exit 0
    ;;

save)
    [ -n "$save_name" ] || dr_die "dr-kit save needs a name" "e.g.  dr-kit save lua"

    # The name becomes a directory AND is what a bare DRAUGR_KIT entry is matched
    # against, so a slash or a leading dot would resolve somewhere unintended.
    case "$save_name" in
        */*|.*|*[!A-Za-z0-9._-]*)
            dr_die "'$save_name' is not a usable kit name" \
                "Letters, digits, dot, dash and underscore. No slashes." ;;
    esac

    # The project's OWN kit, not whatever happens to be first in the list: saving
    # a library kit back into the library under a second name is not what anyone
    # means by "save this project's kit".
    src=$(dr_kit_repo_dir) || dr_die \
        "this project has no kit of its own to save" \
        "DRAUGR_KIT is '$DRAUGR_KIT', and none of it resolves inside $DR_REPO." \
        "Generate a starter one with:  dr-init"

    # Overwriting is the destructive case, and its blast radius is every OTHER
    # repo pointing at this name - which is exactly what the prompt has to say,
    # because the repo you are standing in is not the one that will be surprised.
    dest="$store/$save_name"
    if [ -d "$dest" ]; then
        dr_warn "'$save_name' already exists in the library"
        printf '  %s%s%s\n' "$_DR_DIM" "$dest" "$_DR_OFF" >&2
        printf '  %sEvery repo using it would get the new version at its next dr-up.%s\n' \
            "$_DR_DIM" "$_DR_OFF" >&2
        dr_confirm "Overwrite it?" || dr_die "cancelled"
        rm -rf "$dest"
    fi

    # A copy, not a symlink: symlinks on a Windows drive need privilege, and a
    # library that silently tracked one repo's edits would be a shared mutable
    # dependency nobody asked for.
    mkdir -p "$store"
    cp -r "$src" "$dest" || dr_die "could not copy $src to $dest"
    dr_ok "saved $src as '$save_name'"
    printf '  %sUse it from any repo by adding it to DRAUGR_KIT:%s\n' "$_DR_DIM" "$_DR_OFF" >&2
    printf '  %s  DRAUGR_KIT=".draugr/kit %s"%s\n' "$_DR_DIM" "$save_name" "$_DR_OFF" >&2
    printf '  %sThis is a COPY. Editing one does not change the other, and editing%s\n' \
        "$_DR_DIM" "$_DR_OFF" >&2
    printf '  %sthe library copy makes every repo using it drift until dr-up --recreate.%s\n' \
        "$_DR_DIM" "$_DR_OFF" >&2
    exit 0
    ;;
esac

# --- this project's kit list --------------------------------------------------

[ -n "$DRAUGR_KIT" ] || dr_die \
    "DRAUGR_KIT is empty, so this project has no kit" \
    "Generate a starter one with:  dr-init"

# Resolved through the same helpers dr-up uses, so what these commands check is
# exactly what dr-up would hand to sbx - a wrapper that resolved differently
# would be worse than no wrapper.
mapfile -t refs < <(dr_kit_refs)
mapfile -t missing < <(dr_kit_missing)

# Named, but not fatal on its own: one entry of three failing to resolve still
# leaves two worth checking, and the report is more useful than a refusal.
for m in "${missing[@]+"${missing[@]}"}"; do
    dr_warn "no kit found for '$m'"
    printf '  %sLooked in %s and in the kit store %s%s\n' \
        "$_DR_DIM" "$DR_REPO" "$store" "$_DR_OFF" >&2
done

[ ${#refs[@]} -gt 0 ] || dr_die \
    "none of DRAUGR_KIT resolves to a kit" \
    "DRAUGR_KIT is '$DRAUGR_KIT', from ${DR_ORIGIN[DRAUGR_KIT]}." \
    "Generate a starter one with:  dr-init" \
    "What is already in your library:  dr-kit list"

hash_file=$(dr_kit_stamp)

# sbx.exe needs a Windows path for a directory; a remote reference goes through
# as it stands. Precomputed once so every action below spells them the same way.
kit_args=()
for r in "${refs[@]}"; do
    # dr_path_win_kit rather than dr_path_win, so a library kit on WSL's ext4 -
    # which is where DRAUGR_KIT_STORE points by default - gets its UNC spelling
    # instead of being refused. Kits are read on the host, never bind-mounted.
    if [ -d "$r" ]; then
        kit_args+=("$(dr_path_win_kit "$r")") || dr_die \
            "cannot spell $r in a way sbx.exe can read" \
            "Kits outside /mnt/<drive> need \$WSL_DISTRO_NAME, which WSL sets."
    else
        kit_args+=("$r")
    fi
done

case "$action" in

validate)
    # sbx's own words, deliberately. A wrapper that reworded these would be one
    # more thing to keep in sync with a schema we do not own.
    for k in "${kit_args[@]}"; do
        dr_sbx kit validate "$k" || dr_die \
            "the kit is not valid: $k" \
            "The message above is sbx's own. Schema: https://docs.docker.com/ai/sandboxes/customize/kits/"
    done

    # And then the one thing sbx's validate does NOT check. A kit pinned to
    # another agent is entirely valid; it simply cannot be composed with this
    # one, and finding that out at dr-up is finding it out too late.
    conflicts=0
    while IFS=' ' read -r k want; do
        [ -n "$k" ] || continue
        conflicts=1
        dr_warn "$k requires agent \"$want\", but DRAUGR_AGENT is \"$DRAUGR_AGENT\""
        printf '  %sdr-up will refuse. Drop the "requires: agent:" line, or keep%s\n' \
            "$_DR_DIM" "$_DR_OFF" >&2
        printf '  %sa separate %s.%s/ for this agent.%s\n' \
            "$_DR_DIM" "$k" "$DRAUGR_AGENT" "$_DR_OFF" >&2
    done < <(dr_kit_agent_conflicts)

    # The second compose hazard, and the one this command used to paper over: a
    # kit whose own name is an agent name. sbx refuses the composition, sbx kit
    # validate passes it, and the line below then called it composable.
    while IFS=' ' read -r k nm; do
        [ -n "$k" ] || continue
        conflicts=1
        dr_warn "$k is named \"$nm\", which is also the name of an agent"
        printf '  %sdr-up will refuse: sbx composes the agent kit with this one,%s\n' \
            "$_DR_DIM" "$_DR_OFF" >&2
        printf '  %sand two kits in one composition cannot share a name.%s\n' \
            "$_DR_DIM" "$_DR_OFF" >&2
        printf '  %sRename it in %s/spec.yaml - only name: is constrained,%s\n' \
            "$_DR_DIM" "$k" "$_DR_OFF" >&2
        printf '  %sdisplayName is free text. Try:  name: %s-project%s\n' \
            "$_DR_DIM" "$nm" "$_DR_OFF" >&2
    done < <(dr_kit_name_conflicts)
    [ "$conflicts" -eq 0 ] && dr_ok "valid, and composable with $DRAUGR_AGENT"
    ;;

# inspect prints what each kit asks for. The pointer matters because the kits are
# only half the answer - the machine-wide defaults are the other half.
show)
    for k in "${kit_args[@]}"; do
        dr_heading "$k"
        dr_sbx kit inspect "$k"
    done
    printf '\n  %sThis is what the kits DECLARE, and they are merged rather than%s\n' \
        "$_DR_DIM" "$_DR_OFF" >&2
    printf '  %sranked. For what is actually in force, defaults included:  dr-policy%s\n' \
        "$_DR_DIM" "$_DR_OFF" >&2
    ;;

# Drift matters because a kit change is invisible until something behaves oddly:
# the sandbox keeps whatever it was built with until it is recreated. With a list
# that now includes a library kit somebody else's repo edited.
drift)
    now=$(dr_kit_hash_all)
    if [ ! -f "$hash_file" ]; then
        dr_warn "no record of an applied kit for this repo"
        printf '  %sdr-up records one when it creates the mound.%s\n' "$_DR_DIM" "$_DR_OFF" >&2
        exit 0
    fi
    # The first line is the combined hash; the lines after it name each kit.
    was=$(dr_kit_stamp_hash)
    if [ "$now" = "$was" ]; then
        dr_ok "the kit list matches what the mound was built with"
        # Said out loud rather than implied: a moved OCI tag is drift that no
        # local hash can see, and a clean report should not suggest otherwise.
        for r in "${refs[@]}"; do
            [ -d "$r" ] && continue
            printf '  %s%s is a remote reference - only its NAME is compared.%s\n' \
                "$_DR_DIM" "$r" "$_DR_OFF" >&2
        done
    else
        dr_warn "the kit list has changed since the mound was built"
        printf '  %sThe running sandbox still has the OLD rules and setup.%s\n' "$_DR_DIM" "$_DR_OFF" >&2
        printf '  %sKits added at the end:  dr-kit apply.  Anything else:  dr-up --recreate%s\n' \
            "$_DR_DIM" "$_DR_OFF" >&2
        exit 1
    fi
    ;;

# apply adds kits to a running mound, and that is ALL it can do. Measured on sbx
# 0.37.1 against a throwaway mound, and the reason this is shaped as it is:
#
#  - `sbx kit add SANDBOX REF` REFUSES a kit whose name the sandbox already has:
#    'duplicate kit name "x" - each kit in a composition must have a unique
#    name'. So an edited kit cannot be re-applied this way at all.
#  - Adding a kit with a NEW name recreates the container from every kit's
#    CURRENT source, and writes their rules as a new policy rule WITHOUT
#    deleting the previous one. An edit that narrows a kit therefore does not
#    narrow anything: the old, wider rule stays in force beside the new one.
#  - The clone and the agent's home survived that recreate, where dr-up
#    --recreate destroys both - which is why the in-place path is worth keeping
#    for the one case it handles honestly.
#
# That case is: every kit the mound was built with is unchanged and still first
# in the list, and there are new ones after them. Anything else - a kit edited,
# removed, reordered, or a stamp too old to say which kits it had - is refused
# with the command that does work.
apply)
    dr_sandbox_exists "$DRAUGR_SANDBOX" || dr_die \
        "$DRAUGR_SANDBOX does not exist" "Create it with:  dr-up  (which applies the kits)"

    recreate_hint="Rebuild it with the kits as they are now:  dr-up --recreate"

    # What the mound was built from, kit by kit. A stamp from before per-kit
    # records existed has only the combined hash, which can say "unchanged" but
    # never "only added to" - so it gets the safe answer.
    mapfile -t built < <(dr_kit_stamp_kits)
    if [ ${#built[@]} -eq 0 ]; then
        if [ "$(dr_kit_hash_all)" = "$(dr_kit_stamp_hash)" ]; then
            dr_ok "nothing to apply: the kits match what $DRAUGR_SANDBOX was built with"
            exit 0
        fi
        dr_die "cannot tell which kits $DRAUGR_SANDBOX was built with" \
               "Its record predates per-kit tracking, and sbx cannot list a sandbox's kits." \
               "$recreate_hint"
    fi

    # The built kits must be the start of the current list, each one unchanged.
    # A kit that changed cannot be re-added (sbx refuses the duplicate name), and
    # one that was removed cannot be taken out: add is the only verb sbx has.
    i=0
    for line in "${built[@]}"; do
        IFS=$'\t' read -r b_ref _ b_hash <<< "$line"
        now_ref=${refs[$i]:-}
        if [ "$now_ref" != "$b_ref" ]; then
            dr_die "the kit list no longer starts with what $DRAUGR_SANDBOX was built with" \
                   "Built with $b_ref in position $((i + 1)); DRAUGR_KIT now has ${now_ref:-nothing} there." \
                   "sbx can only ADD a kit to a mound - it cannot remove or reorder one." \
                   "$recreate_hint"
        fi
        if [ -d "$now_ref" ]; then now_hash=$(dr_dir_hash "$now_ref"); else now_hash=$now_ref; fi
        if [ "$now_hash" != "$b_hash" ]; then
            dr_die "$now_ref has changed since $DRAUGR_SANDBOX was built" \
                   "sbx will not re-add a kit the mound already has, and adding another one" \
                   "would apply this edit only where it ADDS something: a rule the edit" \
                   "removed would stay in force (measured). So only a rebuild applies it." \
                   "$recreate_hint"
        fi
        i=$((i + 1))
    done

    # Whatever is left is new, in order.
    new_refs=("${refs[@]:$i}")
    new_args=("${kit_args[@]:$i}")
    if [ ${#new_refs[@]} -eq 0 ]; then
        dr_ok "nothing to apply: the kits match what $DRAUGR_SANDBOX was built with"
        exit 0
    fi

    # A new kit named like one the mound already has would be refused by sbx in
    # its own words, halfway through. Checked here so it is refused before any
    # container is touched, and with the names side by side.
    for r in "${new_refs[@]}"; do
        [ -d "$r" ] || continue
        n=$(dr_kit_spec_name "$r")
        for line in "${built[@]}"; do
            IFS=$'\t' read -r b_ref b_name _ <<< "$line"
            [ -n "$n" ] && [ "$n" = "$b_name" ] && dr_die \
                "$r is named \"$n\", like $b_ref which $DRAUGR_SANDBOX already has" \
                "sbx refuses two kits with one name in the same sandbox." \
                "Rename one in its spec.yaml, or rebuild:  dr-up --recreate"
        done
    done

    # Spell out the cost before asking, not after: "recreates the container" is
    # not something to discover from a prompt you already clicked through.
    dr_warn "adding ${#new_refs[@]} kit(s) recreates the container, in place"
    printf '  %sThe clone and the agent'"'"'s home survive (measured). A running agent is%s\n' \
        "$_DR_DIM" "$_DR_OFF" >&2
    printf '  %sinterrupted, and anything installed by hand outside those may not be.%s\n' \
        "$_DR_DIM" "$_DR_OFF" >&2
    for k in "${new_args[@]}"; do
        printf '    %s\n' "$k" >&2
    done
    dr_confirm "Add ${#new_refs[@]} kit(s) to $DRAUGR_SANDBOX?" || dr_die "cancelled"

    # One at a time, in order, so a failure names the kit that failed. The
    # sandbox comes FIRST: `sbx kit add SANDBOX REFERENCE`. The old code passed
    # the kit first and a --sandbox flag sbx does not have, and no test noticed
    # because the mock accepted any argv - see tests/kits.bats.
    for k in "${new_args[@]}"; do
        dr_sbx kit add "$DRAUGR_SANDBOX" "$k" || dr_die \
            "could not add $k to $DRAUGR_SANDBOX" \
            "sbx refuses on sandboxes created before kits shipped; dr-up --recreate rebuilds one."
    done

    mkdir -p "$DR_REPO/.draugr"
    dr_kit_stamp_write
    dr_ok "added ${#new_refs[@]} kit(s) to $DRAUGR_SANDBOX, and recorded them"
    ;;
# --- adopt --------------------------------------------------------------------
#
# The end of the build-your-own-kit loop. `dr-policy --allow` opens a host on the
# running mound so the build can be retried at once, but that rule is MACHINE
# state scoped to this sandbox - measured, it does not outlive it: after sbx rm,
# looking the rule up by id gives "policy or rule not found". So the set you
# arrived at empirically is destroyed by the very recreate that would apply it.
#
# This writes it down instead. Only rules this repo's kit does not already
# declare, so running it twice is a no-op rather than a duplicate list.
adopt)
    kit=$(dr_kit_repo_dir) || dr_die \
        "this project has no kit of its own" \
        "A host allowed for the mound has nowhere to be written down." \
        "Create one:  dr-init"

    dr_sandbox_exists "$DRAUGR_SANDBOX" || dr_die \
        "$DRAUGR_SANDBOX does not exist" \
        "The rules live with the mound, so there is nothing left to adopt."

    mapfile -t hosts < <(dr_policy_unadopted)
    if [ ${#hosts[@]} -eq 0 ]; then
        dr_ok "nothing to adopt - the kit already declares everything opened by hand"
        exit 0
    fi

    # Shown before the prompt: these become a committed promise about what the
    # project may reach, and every teammate who clones it inherits them.
    dr_warn "${#hosts[@]} host(s) will be written into $kit/spec.yaml"
    printf '  %s\n' "${hosts[@]}" >&2
    printf '  %sThey are in force for this mound now, and would be lost by a recreate.%s\n' \
        "$_DR_DIM" "$_DR_OFF" >&2
    printf '  %sCommitted, they travel with the project - so read them once more.%s\n' \
        "$_DR_DIM" "$_DR_OFF" >&2
    dr_confirm "Write ${#hosts[@]} host(s) into the kit?" || dr_die "cancelled"

    # Written through a temp file and moved into place, so an interrupted run
    # cannot leave a half-edited spec - which sbx would then refuse, in the
    # middle of a session, about a file you did not knowingly touch.
    tmp="$DR_REPO/.draugr/tmp"
    mkdir -p "$tmp"
    out="$tmp/spec.yaml.$$"

    # A targeted edit rather than a YAML rewriter: find `allow:` under
    # `network:`, take its indent, and insert the new entries as list items two
    # spaces deeper. `allow: []` becomes `allow:` on the way past, since the two
    # cannot both be true. Anything it does not recognise is left alone and
    # reported below, because a kit half-written by a guess is worse than one
    # you were asked to edit yourself.
    awk -v add="$(printf '%s\n' "${hosts[@]}")" '
        BEGIN { split(add, want, "\n") }
        !done && /^[[:space:]]*network:[[:space:]]*$/ { innet = 1 }
        !done && innet && /^[[:space:]]*allow:[[:space:]]*(\[\])?[[:space:]]*$/ {
            match($0, /^[[:space:]]*/); ind = substr($0, 1, RLENGTH)
            sub(/allow:.*/, "allow:")
            print
            for (i in want) if (want[i] != "") print ind "  - " want[i]
            done = 1
            next
        }
        { print }
        END { if (!done) exit 3 }
    ' "$kit/spec.yaml" > "$out" || {
        rm -f "$out"
        dr_warn "could not find caps.network.allow in $kit/spec.yaml"
        printf '  %sNothing was changed. Add this block by hand:%s\n' \
            "$_DR_DIM" "$_DR_OFF" >&2
        printf '\n  caps:\n    network:\n      allow:\n' >&2
        printf '        - %s\n' "${hosts[@]}" >&2
        exit 1
    }

    # The move is the commit point: everything above it worked on a copy, so an
    # interrupted run leaves the kit exactly as it was rather than half-edited.
    mv "$out" "$kit/spec.yaml"
    dr_ok "wrote ${#hosts[@]} host(s) into $kit/spec.yaml"
    printf '  %sCheck it, then commit it - it is the record every teammate gets:%s\n' \
        "$_DR_DIM" "$_DR_OFF" >&2
    printf '  %s  dr-kit validate%s\n' "$_DR_DIM" "$_DR_OFF" >&2
    printf '  %sThe mound already has these rules, so no recreate is needed now.%s\n' \
        "$_DR_DIM" "$_DR_OFF" >&2
    ;;

esac
