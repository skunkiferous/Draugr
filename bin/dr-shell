#!/usr/bin/env bash
# dr-shell: a shell inside the mound, next to the work of the agent.
#
# Use it to look at the results of the agent, and not disturb it. You arrive in
# the clone, not in your working tree. Thus nothing that you type here can touch
# the host.
#
# For a shell without a second window, press Ctrl-Z inside the agent. It
# suspends the agent and puts you here, and fg goes back.
#
#   dr-shell                 interactive shell
#   dr-shell -- npm test     run one command and come back (no terminal needed)
#   dr-shell --root          as root, to install something that you forgot
set -euo pipefail

DR_PROG=dr-shell
# readlink -f comes first. install.sh links this file into ~/.local/bin, and
# through a link BASH_SOURCE is the LINK. Without it, ../lib is ~/.local/lib.
_dr_bin=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$_dr_bin/../lib/common.sh"

# All arguments after "--" are the command to run. Thus dr-shell is the
# interactive door into the mound, and also a way to run one command from a
# script.
as_root=
cmd=()
while [ $# -gt 0 ]; do
    case "$1" in
        --root)    as_root=1 ;;
        -h|--help) dr_help "$0"; exit 0 ;;
        --) shift; cmd=("$@"); break ;;
        *) dr_die "unknown option: $1" "A command to run goes after --, for example dr-shell -- ls" ;;
    esac
    shift
done

dr_context
dr_attach_check

# sbx exec starts a stopped sandbox, but it cannot make one that nobody created.
# Also, "no such sandbox" is a worse message than this one.
if ! dr_sandbox_exists "$DRAUGR_SANDBOX"; then
    dr_die "$DRAUGR_SANDBOX does not exist" "Create it with:  dr-up"
fi

if [ "$DRAUGR_ATTACH" = ssh ]; then
    # ssh arrives in the home directory of the mound, but the work is in the
    # clone.
    mound=$(dr_path_mound "$DR_REPO") || dr_die \
        "$DR_REPO is not on a Windows drive, so it has no path inside the mound"

    # sudo, not the -u root of sbx. ssh authenticates as the agent, and the
    # agent is in the sudo group with no password. A test with sbx 0.37.1 showed
    # this.
    prefix=
    [ -n "$as_root" ] && prefix="sudo "

    if [ ${#cmd[@]} -gt 0 ]; then
        # No pty and no -t, so that dr-shell works from a script, and you can
        # pipe its output. The code builds the command line here, and dr_shquote
        # quotes it for the far side. SC2029 asks about that.
        # shellcheck disable=SC2029
        ssh "$(dr_ssh_host)" "cd $(printf '%q' "$mound") && $prefix$(dr_shquote "${cmd[@]}")"
    else
        dr_require_tty dr-shell
        dr_info "opening a shell in $DRAUGR_SANDBOX (to leave: exit or Ctrl-D)"
        if [ -n "$as_root" ]; then
            # -s, not -i. A login shell moves you to /root, but you are root
            # here to fix something in the clone.
            ssh -t "$(dr_ssh_host)" "cd $(printf '%q' "$mound") && exec sudo -s"
        else
            dr_ssh_attach "$mound"
        fi
    fi
else
    exec_args=(exec)
    [ -n "$as_root" ] && exec_args+=(-u root)

    # -i keeps stdin open, and -t gives a terminal. Together they make a shell
    # usable. Both are wrong for a piped command. Thus, with a command, the code
    # stays non-interactive, so that dr-shell works from a script.
    if [ ${#cmd[@]} -gt 0 ]; then
        dr_sbx "${exec_args[@]}" "$DRAUGR_SANDBOX" "${cmd[@]}"
    else
        dr_require_tty dr-shell
        dr_info "opening a shell in $DRAUGR_SANDBOX (to leave: exit or Ctrl-D)"
        dr_sbx "${exec_args[@]}" -it "$DRAUGR_SANDBOX" bash
    fi
fi
