#!/usr/bin/env bash
# dr-setup: the setup of the machine, once: the ssh bridge and the kit library.
#
# People often forget this step. `sbx setup ssh` configures only the WINDOWS ssh
# client. WSL has its own ~/.ssh/config, and Draugr runs in WSL. Without a block
# here, `ssh <name>.sbx` and the ssh:// transport of git do not work. Then
# dr-sync cannot fetch the commits of the agent.
#
# It also creates DRAUGR_KIT_STORE, the library of named kits that your
# repositories share. Both are for the machine. All else in Draugr is for one
# repo.
#
#   dr-setup           write the block if it is missing, and create the library
#   dr-setup --force   write it again, even if something is already there
#   dr-setup --print   print what it writes, and change nothing
#   dr-setup --forge   also write the `Host *.forge` block, for a forge VM
#   dr-setup --forge-gateway <mound>   the same, with the name of the gateway mound
#
# THE FORGE BLOCK IS ONLY ON REQUEST, AND IT STAYS. Only on request, because a
# machine with no forge VM must never have a block about one. It stays, because
# the code below removes the managed blocks before it writes them again. Thus a
# later plain run must mean "keep it", not "delete it".
set -euo pipefail

DR_PROG=dr-setup
# readlink -f comes first. install.sh links this file into ~/.local/bin, and
# through a link BASH_SOURCE is the LINK. Without it, ../lib is ~/.local/lib.
_dr_bin=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$_dr_bin/../lib/common.sh"

# --print is a dry run. It shows the block, and touches nothing.
force=
print=
forge=
forge_gw=
forge_given=
while [ $# -gt 0 ]; do
    case "$1" in
        --force|-f) force=1 ;;
        --print|-n) print=1 ;;
        --forge)    forge=1; forge_given=1 ;;
        --forge-gateway)
            shift
            [ -n "${1:-}" ] || dr_die "--forge-gateway needs the name of the gateway mound" \
                "For example:  dr-setup --forge-gateway draugr-gateway"
            forge=1; forge_given=1; forge_gw=$1 ;;
        -h|--help)  dr_help "$0"; exit 0 ;;
        *) dr_die "unknown option: $1" "Try: dr-setup --help" ;;
    esac
    shift
done

# No repository is part of this, and dr_load_config accepts that. With no repo
# argument, it sets the defaults and applies only the layer of the user home.
# That is the correct order for a command for the machine. It also makes
# DRAUGR_KIT_STORE readable below, also after you moved it.
dr_load_config

# Above --print, so that the dry run can also report the forge block. Here the
# code also finds the existing block, before it writes something.
config="$HOME/.ssh/config"

# Is it already there? Then it stays, also without a request in this run.
forge_had=
if grep -qE '^# >>> draugr forge \(managed\) >>>$' "$config" 2>/dev/null; then
    forge_had=1
    forge=1
fi

# The name of the gateway mound is the one variable thing in that block. The
# code READS it from the block, and does not use the default again. A plain
# second run must not silently point the route to a mound that does not serve
# it.
if [ -z "$forge_gw" ] && [ -n "$forge_had" ]; then
    forge_gw=$(sed -n 's/^[[:space:]]*ProxyCommand ssh .*[[:space:]]\([^[:space:]]*\)\.sbx socat .*/\1/p' \
               "$config" | head -1)
fi
# Draugr generates the gateway, so Draugr names it. The default is the name that
# it uses.
[ -n "$forge_gw" ] || forge_gw=draugr-gateway

forge_key="$HOME/.ssh/draugr_forge_ed25519"
forge_known="$HOME/.ssh/draugr_forge_known_hosts"

sbx_exe=$(dr_find_sbx) || dr_die \
    "cannot find sbx.exe" \
    "Install it first:  winget install Docker.sbx" \
    "Or tell Draugr where it is:  export DRAUGR_SBX=/mnt/c/path/to/sbx.exe"

# sbx keeps its host keys next to its own state. Get the path from the binary,
# and do not guess a user name. sbx.exe is in <root>/bin/sbx.exe.
sbx_home=$(dirname "$(dirname "$sbx_exe")")
known_hosts="$sbx_home/sandboxes/config/ssh/known_hosts"
if [ ! -d "$sbx_home/sandboxes" ]; then
    # WinGet installs a shim in Links/. In that case, use LOCALAPPDATA. An `if`,
    # not `[ -n "$lad" ] && ...`. If cmd.exe answers nothing, that && list
    # returns 1, because it is the last command in this branch. Then `set -e`
    # stops dr-setup silently: exit 1, no message, nothing written. If the
    # working directory is on the WSL file system, cmd.exe answers nothing. That
    # is true for each person who runs this from the home directory.
    if command -v cmd.exe >/dev/null 2>&1; then
        lad=$(cmd.exe /c 'echo %LOCALAPPDATA%' 2>/dev/null | tr -d '\r\n') || lad=
        if [ -n "$lad" ]; then
            sbx_home="$(dr_path_from_win "$lad")/DockerSandboxes"
        fi
        known_hosts="$sbx_home/sandboxes/config/ssh/known_hosts"
    fi
fi

# The ProxyCommand runs on the Windows side, so it needs the Windows path form.
# The ssh of WSL reads UserKnownHostsFile, so that one stays a /mnt path.
snippet=$(sed \
    -e "s|@SBX_EXE@|$sbx_exe|" \
    -e "s|@KNOWN_HOSTS@|$known_hosts|" \
    "$DRAUGR_SHARE/ssh-config.snippet")

# Made also for --print. If nobody asked for the forge, and it is not there,
# it is empty. Thus the block is not in the file, and not in the dry run, on all
# other machines.
forge_snippet=
if [ -n "$forge" ]; then
    forge_snippet=$(sed \
        -e "s|@FORGE_GATEWAY@|$forge_gw|" \
        -e "s|@FORGE_KEY@|$forge_key|" \
        -e "s|@FORGE_KNOWN_HOSTS@|$forge_known|" \
        "$DRAUGR_SHARE/ssh-config-forge.snippet")
fi

# The dry run, before the code creates something: the blocks as the code writes
# them, and only a description of the library. Nothing below runs. That is the
# promise of --print.
if [ -n "$print" ]; then
    printf '%s\n' "$snippet"
    [ -n "$forge_snippet" ] && printf '\n%s\n' "$forge_snippet"
    printf '\n# It also creates the kit library at %s\n' "$(dr_kit_store)"
    exit 0
fi

# The kit library, here because this is the one command that sets up the
# MACHINE, not a repository. An empty directory is also a better first view than
# a text from `dr-kit list` about what a kit store is.
#
# Before the ssh work, so that it also happens at the "already configured" exit
# below. After an upgrade, a person who runs dr-setup again has a working ssh
# block and no library. Otherwise the code skips exactly that case.
store=$(dr_kit_store)
if [ -d "$store" ]; then
    dr_debug "kit library already at $store"
else
    mkdir -p "$store" || dr_die "could not create the kit library at $store"
    dr_ok "created the kit library at $store"
    printf '  %sPut a kit for many repos there, from a repo:  dr-kit save <name>%s\n' \
        "$_DR_DIM" "$_DR_OFF" >&2
fi

mkdir -p "$HOME/.ssh"
chmod 700 "$HOME/.ssh"
touch "$config"
chmod 600 "$config"

# A SEPARATE key, not the admin key of the Windows side, for two reasons. ssh
# refuses a key from /mnt/c, where Windows files look world-readable. You can
# also revoke a second credential and not touch the first. It is made here,
# because the block names it. An alias for a file that does not exist fails at
# connection time, not at write time.
if [ -n "$forge" ]; then
    if [ ! -f "$forge_key" ]; then
        ssh-keygen -t ed25519 -N '' -C 'draugr-forge-wsl' -f "$forge_key" >/dev/null
        dr_ok "made $forge_key"
    fi
    chmod 600 "$forge_key"
fi

existing=
if grep -qE '^[[:space:]]*Host[[:space:]]+\*\.sbx' "$config" 2>/dev/null; then
    existing=1
fi

# Something is already there, and nobody asked to force. Two cases. For a
# working sbx block, do not touch it, and say so. For something else with the
# same Host pattern, refuse, because we do not rewrite ssh configuration that we
# did not write. --forge and --forge-gateway skip this exit, on purpose. Without
# that, a request for the forge block on a machine that is older than the forge
# prints "already configured", and does nothing. A rewrite is safe: it is
# idempotent, and the previous file has a backup.
if [ -n "$existing" ] && [ -z "$force" ] && [ -z "$forge_given" ]; then
    proxy=$(grep -A8 -E '^[[:space:]]*Host[[:space:]]+\*\.sbx' "$config" \
            | grep -i ProxyCommand | head -1 || true)
    if printf '%s' "$proxy" | grep -q sbx; then
        dr_ok "already configured. A Host *.sbx block with an sbx ProxyCommand exists."
        printf '  %s%s%s\n' "$_DR_DIM" "$config" "$_DR_OFF" >&2
        printf '  %sTo write it again anyway: dr-setup --force%s\n' "$_DR_DIM" "$_DR_OFF" >&2
        exit 0
    fi
    dr_die \
        "a Host *.sbx block already exists, but has no sbx ProxyCommand" \
        "Draugr does not silently rewrite ssh configuration that it did not write." \
        "Look at $config, then run:  dr-setup --force"
fi

backup="$config.draugr-backup.$(date +%Y%m%d%H%M%S)"
cp "$config" "$backup"

# Remove each managed block that is already there, so that a second run cannot
# make two of them. An awk program is a list of  PATTERN { ACTION }  pairs, run
# once for each input line. Here, a flag called `skip` records whether we are
# inside a block to discard.
#
# The order of the rules is important. The opening markers set skip=1 BEFORE the
# print rule, so the marker line is removed too. The closing markers clear it
# AFTER, so the closing line is also removed.
tmp=$(mktemp)
awk '
    /^# >>> draugr \(managed\) >>>$/           { skip = 1 }
    /^# >>> draugr forge \(managed\) >>>$/     { skip = 1 }
    /^# >>> docker sandboxes \(managed\) >>>$/ { skip = 1 }
    skip != 1 { print }
    /^# <<< draugr \(managed\) <<<$/           { skip = 0 }
    /^# <<< draugr forge \(managed\) <<<$/     { skip = 0 }
    /^# <<< docker sandboxes \(managed\) <<<$/ { skip = 0 }
' "$config" > "$tmp"

# A "Host *.sbx" that a person wrote has no markers, so the pass above does not
# touch it. We get here only with --force, so the user said to replace it. An
# ssh configuration block continues until the next Host line. Thus start to skip
# at ours, and stop at the next Host. `next` skips the other rules for this
# line, so the Host line is removed too.
if grep -qE '^[[:space:]]*Host[[:space:]]+\*\.sbx' "$tmp"; then
    awk '
        /^[[:space:]]*Host[[:space:]]+\*\.sbx([[:space:]]|$)/ { skip = 1; next }
        skip == 1 && /^[[:space:]]*Host[[:space:]]/           { skip = 0 }
        skip != 1 { print }
    ' "$tmp" > "$tmp.2"
    mv "$tmp.2" "$tmp"
fi

# Commands in { } share one redirect, which captures all of their output.
{
    cat "$tmp"
    printf '\n'
    printf '%s\n' "$snippet"
    [ -n "$forge_snippet" ] && printf '\n%s\n' "$forge_snippet"
} > "$config.new"

# Reduce the groups of blank lines that the deletions above leave, so that many
# --force runs do not slowly make the file longer. NF is the field count of awk,
# so `NF == 0` is "blank line". Count them, and do not print them. Then, at a
# real line, print one blank line before it at most.
awk 'NF == 0 { blank++; next } { while (blank-- > 1) print ""; blank = 0; print }' \
    "$config.new" > "$config"
rm -f "$tmp" "$config.new"
chmod 600 "$config"

if [ -n "$forge_snippet" ]; then
    dr_ok "wrote the *.sbx and *.forge blocks into $config"
else
    dr_ok "wrote the *.sbx block into $config"
fi
printf '  %sbacked up the previous file to %s%s\n' "$_DR_DIM" "$backup" "$_DR_OFF" >&2
printf '  %ssbx.exe:     %s%s\n' "$_DR_DIM" "$sbx_exe" "$_DR_OFF" >&2
printf '  %sknown_hosts: %s%s\n' "$_DR_DIM" "$known_hosts" "$_DR_OFF" >&2
if [ -n "$forge_snippet" ]; then
    printf '  %sforge gateway mound: %s%s\n' "$_DR_DIM" "$forge_gw" "$_DR_OFF" >&2
    printf '  %sforge key:   %s%s\n' "$_DR_DIM" "$forge_key" "$_DR_OFF" >&2
    # The public half, because somebody must authorize it inside the guest
    # before the route carries traffic. Printed, not installed, because this
    # command cannot reach the VM.
    printf '\n  %sAuthorize this in the guest (dr-forge init does, when the VM exists):%s\n' \
        "$_DR_DIM" "$_DR_OFF" >&2
    printf '  %s\n' "$(cat "$forge_key.pub")" >&2
fi

printf '\n  %sMake sure that it works with:  dr-doctor%s\n' "$_DR_DIM" "$_DR_OFF" >&2
