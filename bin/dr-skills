#!/usr/bin/env bash
# dr-skills: watch and seed the one directory that a sandbox can write to.
#
# Each mound mounts the shared skills store READ-WRITE. All mounds share it, and
# it stays after sbx rm. Thus it is the one exception to "the sandbox cannot
# touch the host". Its contents are agent instructions. Thus this command treats
# it as a thing to review, not as a cache. It shows what is there, shows what
# changed, and lets you record your review.
#
# ONE host directory, because sbx does not split it for each agent. But sbx
# mounts it at a path that depends on the agent: ~/.claude/skills in a claude
# mound, ~/.agents/skills in a codex mound. Each agent reads its path. Tests
# showed both: each agent listed its skills on request. This command is for the
# whole machine, and has no repository to ask. Thus it reports the store, not
# the view of one mound.
#
#   dr-skills list       what is in the store, and if you can refuse the mount
#   dr-skills diff       what appeared or changed since your last accept
#   dr-skills accept     record the current contents as reviewed
#   dr-skills import     seed the store from your own host skill directories
#   dr-skills install    put the skills of Draugr into the store
#
# `list` also names the skills of your PLUGINS. Those are a different thing in a
# different directory. They load from the plugin, never from this store, and
# only in a mound where the plugin is installed. See docs/CLAUDE_PLUGINS.md and
# `dr-plugin kit`. They are in the list, because without them this command
# reported one skill on a machine whose plugin library held fifteen.
#
# If something changed, diff exits 1, so you can use it as a test.
set -euo pipefail

DR_PROG=dr-skills
# readlink -f comes first. install.sh links this file into ~/.local/bin, and
# through a link BASH_SOURCE is the LINK. Without it, ../lib is ~/.local/lib.
_dr_bin=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$_dr_bin/../lib/common.sh"

# list is the default, because a look costs nothing. The other actions assume
# that you already know the contents.
action=${1:-list}
case "$action" in
    -h|--help) dr_help "$0"; exit 0 ;;
    list|diff|accept|import|install) shift || : ;;
    *) dr_die "unknown action: $action" "One of: list, diff, accept, import, install" ;;
esac

# -y is ours. It answers the question below. All other arguments go to sbx on
# the import path without change. Thus --dry-run and --force continue to work,
# and this code does not have to know them, or follow new flags of sbx.
passthrough=()
while [ $# -gt 0 ]; do
    case "$1" in
        -y|--yes) DR_ASSUME_YES=1 ;;
        *)        passthrough+=("$1") ;;
    esac
    shift
done

# No dr_context. The store is for the whole machine. Thus this is one of the few
# commands that have nothing to do with the current repository.
#
# But the CONFIGURATION still matters. dr_load_config with no repository loads
# only the layer of the machine, and skips both project layers. Without this
# call, the command ran with only the built-in defaults. DRAUGR_SBX in your
# configuration did nothing here, and DRAUGR_PLUGIN_STORE was always empty. Then
# the plugin section at the end of `list` showed nothing, for any number of
# plugin skills.
dr_load_config

skills_dir=$(dr_skills_dir) || dr_die \
    "cannot find sbx.exe" \
    "The code finds the skills store from its location. Name it in" \
    "your ~/.config/draugr/config, or in the environment:" \
    "  export DRAUGR_SBX=/mnt/c/path/to/sbx.exe"

# What you looked at, as you last said. In the configuration directory of the
# user, not in the repo, because the store does not belong to one project.
seen_file="$DR_CONFIG_USER/skills.seen"

# A report: content goes to stdout, so that it stays in a pipe. See dr-status.
heading() { printf '\n%s%s%s\n' "$_DR_BOLD" "$*" "$_DR_OFF"; }

# "<hash>  <name>" for each skill, one line each. A skill is a directory, so the
# hash covers all of its contents. A changed file in a skill is a changed skill.
#
# dotglob, in a subshell, so that it applies only to this walk. A skill whose
# directory name starts with a dot is still a skill, and Claude still LOADS it.
# A test with Claude Code 2.1.221 showed this. A store entry named .hidden-probe
# is in its list of available skills, the same as a visible one. Claude does not
# read entries one level deeper. It ignores <store>/parent/child/SKILL.md. Thus
# the depth is the limit, not the dot. Without dotglob, the review commands have
# a blind spot exactly where someone hides something.
# The dotglob of bash still excludes . and .., so */ cannot match the store.
current() {
    [ -d "$skills_dir" ] || return 0
    (
        shopt -s dotglob
        local d name
        for d in "$skills_dir"/*/; do
            [ -d "$d" ] || continue      # with no match, the glob stays as is
            name=${d%/}; name=${name##*/}
            printf '%s  %s\n' "$(dr_dir_hash "$d")" "$name"
        done
    )
}

# --- can you refuse the mount? ---------------------------------------------
#
# `sbx skills --help` says "use --no-share-skills to opt out". But a feature
# flag hides that flag, and the feature flag is OFF by default. Thus a default
# install mounts the store into each mound, and no visible flag turns it off.
#
# Tests with sbx 0.37.1 showed all three states. With feature.shareSkills false,
# the mount is always there. With it true, the flag appears AND works, and gives
# a mound with no skills line in /proc/mounts. Thus the message below says "can
# be declined" only for a machine where that is true. The flag works only at
# creation. An existing mound keeps its first state. The code reports it,
# because the help text implies that the flag always exists.
report_optout() {
    local out
    out=$(dr_sbx settings get feature.shareSkills 2>/dev/null) || {
        printf '  %scould not read feature.shareSkills from sbx%s\n' "$_DR_DIM" "$_DR_OFF"
        return 0
    }
    case "$out" in
        *'"enabled":true'*)
            printf '  the mount CAN be declined:  sbx create --no-share-skills\n'
            printf '  %s(only at creation. It does not change an existing mound)%s\n' \
                "$_DR_DIM" "$_DR_OFF"
            ;;
        *)
            printf '  the mount cannot be declined on this machine\n'
            printf '  %s--no-share-skills is hidden until you run:%s\n' "$_DR_DIM" "$_DR_OFF"
            printf '  %s  sbx settings set feature.shareSkills true%s\n' "$_DR_DIM" "$_DR_OFF"
            printf '  %sand it applies only to mounds that you create after that.%s\n' "$_DR_DIM" "$_DR_OFF"
            ;;
    esac
}

case "$action" in

list)
    # Three different states, with different meanings: no store (nothing used
    # skills on this machine), an empty store, and a store with contents that
    # you must recognize.
    heading "shared skills store"
    printf '  %s\n' "$skills_dir"
    if [ ! -d "$skills_dir" ]; then
        printf '  not created yet. sbx makes it when it needs it.\n'
    else
        n=$(current | grep -c . || true)
        if [ "$n" -eq 0 ]; then
            printf '  empty\n'
        else
            # read -r _ name drops the hash and keeps the name, spaces included.
            current | while read -r _ name; do printf '    %s\n' "$name"; done
        fi
    fi

    # One store, two mount paths, and each agent reads its own path. Tests
    # showed this: each agent listed its skills on request, in a claude mound
    # and in a codex mound. Thus each mound on this machine can read a skill
    # here, for each agent.
    heading "reach"
    printf '  each mound mounts it read-write, and all mounds share it\n'
    printf '  claude: ~/.claude/skills    codex: ~/.agents/skills\n'
    printf '  each agent reads its path. One store, each mound\n'
    printf '  stays after dr-rm\n'
    report_optout

    # Also available, but NOT from here. The skills of a plugin load from the
    # plugin, so they never show in the store above. Before, this command said
    # nothing about them. It reported one skill on a machine whose plugin
    # library held fifteen, with no sign of the others.
    #
    # Two guards, and each one hides the heading ALONE. With no library, this
    # test is false, and the walk never runs. For a library with no plugin that
    # has skills, the empty test below catches it. Thus a section with nothing
    # to show is silent. A removal of one guard alone changes no output.
    # Mutation tests showed this for both.
    if [ -n "${DRAUGR_PLUGIN_STORE:-}" ]; then
        plug_rows=$(dr_plugin_skills "$DRAUGR_PLUGIN_STORE")
        if [ -n "$plug_rows" ]; then
            heading "also in plugins that you already have"
            printf '%s\n' "$plug_rows" | while read -r name id _; do
                printf '    %-30s %s\n' "$name" "$id"
            done
            # The condition is the purpose. These are not available as a store
            # entry is. Nothing loads them until the plugin is installed in that
            # mound. Another claim gives the wrong idea in the other direction.
            printf '  %snot in the store above, and not loaded until the plugin is%s\n' \
                "$_DR_DIM" "$_DR_OFF"
            printf '  %sINSTALLED in that mound:  dr-plugin kit%s\n' \
                "$_DR_DIM" "$_DR_OFF"
        fi
    fi
    ;;

# --- diff, against what you last accepted -----------------------------------
diff)
    now=$(current)

    # A missing baseline does not mean "nothing changed". It means that nobody
    # looked yet. That is the more useful answer.
    if [ ! -f "$seen_file" ]; then
        if [ -z "$now" ]; then
            dr_ok "the shared skills store is empty"
            exit 0
        fi
        dr_warn "you never accepted the contents of the skills store"
        printf '%s\n' "$now" | while read -r _ name; do printf '  new: %s\n' "$name"; done
        printf '  %sReview them, then record them with:  dr-skills accept%s\n' \
            "$_DR_DIM" "$_DR_OFF" >&2
        exit 1
    fi

    declare -A was=()
    while read -r hash name; do
        [ -n "$name" ] && was[$name]=$hash
    done < "$seen_file"

    # Compare the current contents with what you accepted, and delete each match
    # from $was. The "gone" set then stays below, with no second pass and no
    # third array.
    changes=0
    while read -r hash name; do
        [ -n "$name" ] || continue
        if [ -z "${was[$name]+set}" ]; then
            printf '  new:     %s\n' "$name"; changes=$((changes + 1))
        elif [ "${was[$name]}" != "$hash" ]; then
            printf '  changed: %s\n' "$name"; changes=$((changes + 1))
        fi
        unset "was[$name]"
    done <<< "$now"

    # The rest of $was is what you accepted once, and that is gone now.
    for name in "${!was[@]}"; do
        printf '  gone:    %s\n' "$name"; changes=$((changes + 1))
    done

    # Exit 1 for each difference, so that this works as a test. The last advice
    # names the command that clears it. A report that you cannot act on only
    # annoys you.
    if [ "$changes" -eq 0 ]; then
        dr_ok "the skills store is the same as at your last accept"
        exit 0
    fi
    printf '  %sSkills are instructions, and each mound reads them. Review, then:%s\n' \
        "$_DR_DIM" "$_DR_OFF" >&2
    printf '  %s  dr-skills accept%s\n' "$_DR_DIM" "$_DR_OFF" >&2
    exit 1
    ;;

# Record hashes, not names. Thus an edit inside an accepted skill still shows as
# a change next time.
accept)
    mkdir -p "$DR_CONFIG_USER"
    current > "$seen_file"
    n=$(grep -c . < "$seen_file" || true)
    dr_ok "recorded $n skill(s) as reviewed"
    ;;

# --- install ------------------------------------------------------------------
#
# Draugr ships its own skills, under share/skills/. `sbx skills import` cannot
# put them there. It scans five fixed host directories (~/.agents/skills and the
# directories of each agent), and takes no path. Thus the only way is a direct
# copy into the store. This verb does that.
#
# Its own verb, and not a silent step of dr-setup, for the reason of the whole
# command. All mounds on the machine share the store, and its contents are
# instructions. If Draugr put instructions within reach of an agent without a
# request, dr-skills diff must catch exactly that.
install)
    src="$DRAUGR_ROOT/share/skills"
    [ -d "$src" ] || dr_die "no skills shipped at $src" \
        "This checkout is missing share/skills/."

    # Named before the question. "From Draugr" is no reason to read them
    # quickly. They are instructions, as all others are, and now is the time to
    # read them.
    mapfile -t _shipped < <(cd "$src" && for d in */; do [ -d "$d" ] && printf '%s\n' "${d%/}"; done)
    [ ${#_shipped[@]} -gt 0 ] || dr_die "no skills to install in $src"

    # Listed with name and path before the question. "From Draugr" is no reason
    # to read them quickly, and now they are easiest to read.
    dr_warn "this puts ${#_shipped[@]} skill(s) into the shared store"
    for _s in "${_shipped[@]}"; do
        printf '    %s  %s%s/%s/SKILL.md%s\n' "$_s" "$_DR_DIM" "$src" "$_s" "$_DR_OFF" >&2
    done
    printf '  %sEach mound on this machine reads them, for each agent.%s\n' \
        "$_DR_DIM" "$_DR_OFF" >&2
    dr_confirm "Install ${#_shipped[@]} Draugr skill(s)?" || dr_die "cancelled"

    mkdir -p "$skills_dir"
    for _s in "${_shipped[@]}"; do
        # Replace all of it, do not merge. Thus a file that a newer version
        # removed cannot stay. sbx uses the same rule on import.
        rm -rf "${skills_dir:?}/$_s"
        cp -a "$src/$_s" "$skills_dir/$_s" || dr_die "could not copy $_s into the store"
    done

    # A new baseline, so that the next dr-skills diff is about the NEXT change,
    # not about the install that you just asked for.
    mkdir -p "$DR_CONFIG_USER"
    current > "$seen_file"
    dr_ok "installed ${#_shipped[@]} skill(s), and recorded the result as reviewed"
    ;;

# --- import -----------------------------------------------------------------
#
# sbx does the copy. This code adds two things. It tells the meaning first.
# After that, it makes a new baseline. Then the next dr-skills diff is about the
# NEXT change, not about the import that you just did on purpose.
import)
    dr_warn "skills are instructions, and each mound reads them"
    printf '  %sThe store is shared. A skill that you import for one project is available to%s\n' \
        "$_DR_DIM" "$_DR_OFF" >&2
    printf '  %seach sandbox on this machine, also to sandboxes that you create later.%s\n' \
        "$_DR_DIM" "$_DR_OFF" >&2
    dr_confirm "Import host skills into the shared store?" || dr_die "cancelled"

    dr_sbx skills import ${passthrough[0]+"${passthrough[@]}"} \
        || dr_die "sbx skills import failed"

    # --dry-run copied nothing. A new baseline then records a state that never
    # existed. A test of the flag is better than a test of the store for
    # changes.
    case " ${passthrough[*]-} " in
        *" --dry-run "*) ;;
        *) mkdir -p "$DR_CONFIG_USER"; current > "$seen_file"
           dr_ok "imported, and recorded the result as reviewed" ;;
    esac
    ;;
esac
