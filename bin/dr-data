#!/usr/bin/env bash
# dr-data: move DRAUGR_DATA files between host and mound, next to git.
#
# Git is good for source code, but not for a 4 GB parquet file in mid-process.
# This is the second channel. rsync uses the same ssh transport as dr-sync. A
# file goes to the SAME path in the repo on both sides. Thus a script that reads
# tmp/raw/2024.parquet works without change on both sides.
#
# Always one direction at a time. A parquet file has no merge algorithm. If both
# sides changed it, a sync in two directions selects one version without a
# message, and destroys the other. Thus each transfer names the side that wins.
#
# Nobody reviews a pull. dr-merge gives you a commit to read. rsync gives you a
# file name and a byte count, and then the bytes are on your disk. Thus
# `dr-data diff` shows what a pull writes. Each pull names the files that come,
# and marks each file that looks like something you run.
#
#   dr-data status   dry run, BOTH directions: what moves, and how much
#   dr-data diff     what a pull CHANGES, as a real diff where possible
#   dr-data push     host -> mound  (the host wins)
#   dr-data pull     mound -> host  (the sandbox wins)
set -euo pipefail

DR_PROG=dr-data
# readlink -f comes first. install.sh links this file into ~/.local/bin, and
# through a link BASH_SOURCE is the LINK. Without it, ../lib is ~/.local/lib.
_dr_bin=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$_dr_bin/../lib/common.sh"

# status is the default, because it is the only action that changes nothing.
# The usual first question is "which direction do I want?"
action=${1:-status}
case "$action" in
    -h|--help) dr_help "$0"; exit 0 ;;
    status|diff|push|pull) shift || : ;;
    *) dr_die "unknown action: $action" "One of: status, diff, push, pull" ;;
esac

# --delete needs the configuration AND a confirmation in this run. Thus a
# clean-up on one side cannot delete the output of the other side without a
# message.
delete=
while [ $# -gt 0 ]; do
    case "$1" in
        -y|--yes)   DR_ASSUME_YES=1 ;;
        --delete)   delete=1 ;;
        *) dr_die "unknown option: $1" "Try: dr-data --help" ;;
    esac
    shift
done

dr_context

[ -n "$DRAUGR_DATA" ] || dr_die \
    "DRAUGR_DATA is empty, so there is nothing to move" \
    "Set it to globs relative to the repo, for example  DRAUGR_DATA=\"tmp/** *.parquet\"" \
    "It came from ${DR_ORIGIN[DRAUGR_DATA]}."

dr_sandbox_exists "$DRAUGR_SANDBOX" || dr_die \
    "$DRAUGR_SANDBOX does not exist" "Create it with:  dr-up"

# The rules are in lib/common.sh next to dr_data_matches, because the two must
# agree. Otherwise a file transfers but still blocks dr-go, or the reverse. That
# bug is hard to find. mapfile reads the rules, one on each line.
mapfile -t filters < <(dr_data_filters)

mound=$(dr_path_mound "$DR_REPO")
# dr_sandbox_ssh_host, not "$DRAUGR_SANDBOX.sbx". The far end can be the forge
# VM, and its host is an ssh_config alias. A copy here disagrees with the URL of
# dr-sync.
remote="$(dr_sandbox_ssh_host):$mound/"
local_dir="$DR_REPO/"

# -a keeps permissions and times. -m removes empty directories. --chmod sets the
# modes on the way in. Under WSL, all of /mnt/c is mode 777, and without --chmod
# that goes into the mound.
common=(-a -m --chmod="$DRAUGR_DATA_CHMOD" "${filters[@]}")

# The summary of rsync is more correct than a number that Draugr calculates. It
# tells what moved on the wire. That number shows that the delta algorithm works
# across the boundary.
run_rsync() {
    local label=$1 src=$2 dst=$3
    shift 3
    dr_info "$label"
    rsync "${common[@]}" "$@" "$src" "$dst" || dr_die \
        "rsync failed" \
        "Is the mound reachable?  dr-status" \
        "Is rsync installed inside it?  dr-shell -- command -v rsync"
}

# --- reviewing what a pull would land ---------------------------------------
#
# A pull writes bytes from the agent into your working directory. The summary of
# rsync, "12 files, 4.1 MB", is a receipt, not a review. A receipt is not enough
# for content that you did not write and cannot see. This section fixes that.

# Bytes that are easy to read. To compare 4823 and 5104 is work, but 4.7 KB and
# 4.9 KB is easy. The exact number is not important in this report.
human() {
    local b=$1
    if   [ "$b" -ge 1073741824 ]; then printf '%d.%d GB' "$((b/1073741824))" "$(((b%1073741824)*10/1073741824))"
    elif [ "$b" -ge 1048576 ];    then printf '%d.%d MB' "$((b/1048576))"    "$(((b%1048576)*10/1048576))"
    elif [ "$b" -ge 1024 ];       then printf '%d.%d KB' "$((b/1024))"       "$(((b%1024)*10/1024))"
    else                               printf '%d B' "$b"
    fi
}

# The names that a pull writes, relative to the repo, one on each line, without
# directories. Only a dry run gives the correct list. It uses the same filter
# rules and delta algorithm as the real transfer, so the two cannot differ.
incoming_names() {
    rsync "${common[@]}" --dry-run --out-format='%n' "$remote" "$local_dir" \
        2>/dev/null | grep -v '/$' || true
}

# Sort a list of incoming files into three groups. It sets arrays and does not
# print, because each caller wants a different group. diff fetches the safe
# names, and pull stops on the executable ones. All callers report the refused
# ones.
DR_IN_SAFE=(); DR_IN_EXEC=(); DR_IN_UNSAFE=()
classify_incoming() {
    local f
    DR_IN_SAFE=(); DR_IN_EXEC=(); DR_IN_UNSAFE=()
    for f in "$@"; do
        # Refuse it, and do not sort it more. Draugr does not write this name,
        # so it does not read its size either.
        if ! dr_data_path_safe "$f"; then
            DR_IN_UNSAFE+=("$f")
            continue
        fi
        DR_IN_SAFE+=("$f")
        if dr_data_exec_shaped "$f"; then DR_IN_EXEC+=("$f"); fi
    done
    return 0
}

# Print the result. It returns 1 for an incoming file that looks executable.
# Thus a caller can change the report into a question.
report_incoming() {
    local f rc=0

    # A refused path is a fact about the sandbox, not a preference. rsync
    # probably cleans it too. But Draugr does not print "the copy tool probably
    # handles it".
    if [ ${#DR_IN_UNSAFE[@]} -gt 0 ]; then
        dr_error "${#DR_IN_UNSAFE[@]} incoming path(s) REFUSED as unsafe:"
        for f in "${DR_IN_UNSAFE[@]}"; do printf '    %q\n' "$f" >&2; done
        printf '  %sAbsolute, with .., or with control characters. Draugr does%s\n' \
            "$_DR_DIM" "$_DR_OFF" >&2
        printf '  %snot write them. Look at the mound before you trust the other files.%s\n' \
            "$_DR_DIM" "$_DR_OFF" >&2
        rc=1
    fi

    # This is the reason for all of this section. The mode tells nothing (see
    # dr_data_exec_shaped), so the name gets the mark, and the mark is clear.
    if [ ${#DR_IN_EXEC[@]} -gt 0 ]; then
        dr_warn "${#DR_IN_EXEC[@]} incoming file(s) look RUNNABLE:"
        for f in "${DR_IN_EXEC[@]}"; do printf '    %s\n' "$f" >&2; done
        printf '  %sThe agent wrote these, and you did not read them. On a Windows drive%s\n' \
            "$_DR_DIM" "$_DR_OFF" >&2
        printf '  %seach file gets mode 0777, whatever DRAUGR_DATA_CHMOD says, so they%s\n' \
            "$_DR_DIM" "$_DR_OFF" >&2
        printf '  %sare executable. Read them first:  dr-data diff%s\n' \
            "$_DR_DIM" "$_DR_OFF" >&2
        rc=1
    fi
    return "$rc"
}

case "$action" in

# Both directions, and neither is applied. Run this command before you select a
# direction.
status)
    dr_heading "host -> mound (what dr-data push transfers)"
    run_rsync "dry run" "$local_dir" "$remote" --dry-run --stats
    dr_heading "mound -> host (what dr-data pull transfers)"
    run_rsync "dry run" "$remote" "$local_dir" --dry-run --stats

    # Only the inbound direction gets a review. What you send to the agent is
    # already yours. What it sends back is the half that you did not read.
    mapfile -t names < <(incoming_names)
    if [ ${#names[@]} -gt 0 ]; then
        classify_incoming "${names[@]}"
        report_incoming || true
    fi
    ;;

# The review step for a pull. It is not part of `pull`, on purpose. To fetch
# each changed file and compare it costs work and bytes. Thus it runs only on
# request, not before each transfer.
diff)
    mapfile -t names < <(incoming_names)
    if [ ${#names[@]} -eq 0 ]; then
        dr_ok "nothing to pull. The data of the mound is the same as yours."
        exit 0
    fi
    classify_incoming "${names[@]}"
    report_incoming || true

    # The copies go in .draugr/tmp, and dr_data_filters removes that from each
    # transfer. Thus a later push cannot take them. --files-from names each
    # file, so the filter rules are not necessary. dr_data_path_safe accepted
    # the names.
    dr_stage
    trap 'rm -rf "$DR_STAGE"' EXIT
    if [ ${#DR_IN_SAFE[@]} -gt 0 ]; then
        printf '%s\n' "${DR_IN_SAFE[@]}" \
            | rsync -a --files-from=- "$remote" "$DR_STAGE/" || dr_die \
                "could not fetch the incoming files to compare them" \
                "Is the mound reachable?  dr-status"
    fi

    dr_heading "${#DR_IN_SAFE[@]} file(s) that a pull writes"
    for f in "${DR_IN_SAFE[@]+"${DR_IN_SAFE[@]}"}"; do
        new="$DR_STAGE/$f"
        # A name in the list can still be missing here. It can be a directory, a
        # symlink, or a file that the agent removed between the two transfers.
        [ -f "$new" ] || continue
        old="$DR_REPO/$f"
        newsize=$(stat -c %s "$new")
        oldsize=0
        [ -f "$old" ] && oldsize=$(stat -c %s "$old")

        # The header shows the sizes, also without a body, because "1.2 GB
        # became 4 B" is a review result.
        if [ -f "$old" ]; then
            printf '\n%s--- %s%s  %s(%s -> %s)%s\n' \
                "$_DR_BOLD" "$f" "$_DR_OFF" "$_DR_DIM" \
                "$(human "$oldsize")" "$(human "$newsize")" "$_DR_OFF" >&2
        else
            printf '\n%s+++ %s%s  %s(new, %s)%s\n' \
                "$_DR_BOLD" "$f" "$_DR_OFF" "$_DR_DIM" "$(human "$newsize")" "$_DR_OFF" >&2
        fi

        # Two different reasons to not show content. You cannot read binary, and
        # a very large file does not help. Say which reason. Then you know the
        # cases where a larger DRAUGR_DATA_DIFF_MAX helps.
        if ! dr_data_is_text "$new"; then
            printf '  %sbinary, content not shown%s\n' "$_DR_DIM" "$_DR_OFF" >&2
            continue
        fi
        if [ "$newsize" -gt "$DRAUGR_DATA_DIFF_MAX" ]; then
            printf '  %s%s is more than DRAUGR_DATA_DIFF_MAX (%s), content not shown%s\n' \
                "$_DR_DIM" "$(human "$newsize")" "$(human "$DRAUGR_DATA_DIFF_MAX")" "$_DR_OFF" >&2
            continue
        fi

        # The diff goes to stdout, and the text around it goes to stderr. Thus
        # `dr-data diff > review.patch` keeps the patch, and the text stays on
        # the screen. --label names the two sides a/ and b/, as git does. The
        # staging directory is not in each header, and `patch -p1` can apply it.
        if [ -f "$old" ]; then
            diff -u --label "a/$f" --label "b/$f" -- "$old" "$new" || true
        else
            diff -u --label /dev/null --label "b/$f" -- /dev/null "$new" || true
        fi
    done
    ;;

push|pull)
    # If the configuration and this run agree, a deletion goes to the other
    # side. If not, it does not. DRAUGR_DATA_DELETE alone is not enough. The
    # dangerous case: you clean one side, and forget that the other side has
    # your only copy.
    del=()
    if [ -n "$delete" ] || dr_is_true "$DRAUGR_DATA_DELETE"; then
        dr_warn "--delete: files that are missing on the source are REMOVED on the destination"
        dr_confirm "Propagate deletions?" || dr_die "cancelled"
        del=(--delete)
    fi

    # The review of a pull is here, or nowhere. The report also prints with
    # --yes, which dr-go gives for an automatic pull. The record of what arrived
    # is important, not only the chance to say no.
    if [ "$action" = pull ]; then
        mapfile -t names < <(incoming_names)
        if [ ${#names[@]} -gt 0 ]; then
            classify_incoming "${names[@]}"

            # An unsafe path stops the whole transfer, with no question. rsync
            # probably makes it safe. But if a mound gives "../..", do not take
            # the other files from it after a yes or no answer.
            if [ ${#DR_IN_UNSAFE[@]} -gt 0 ]; then
                report_incoming || true
                dr_die "refusing to pull" \
                    "The mound gave a path that Draugr does not write to your host." \
                    "Look at the mound before you continue:  dr-shell"
            fi

            # Content that looks executable gets a question, not a refusal.
            # Otherwise a project with scripts in its data cannot pull at all.
            # People turn off a guard that they cannot satisfy.
            if ! report_incoming; then
                dr_confirm "Pull them anyway?" || dr_die "cancelled" \
                    "Read them before you decide:  dr-data diff"
            fi
        fi
    fi

    # The same rsync for both directions. Only the order of the arguments
    # differs. The message names the direction. The wrong direction overwrites
    # the side that you wanted to keep.
    if [ "$action" = push ]; then
        run_rsync "pushing $DRAUGR_DATA -> $DRAUGR_SANDBOX" \
            "$local_dir" "$remote" --stats "${del[@]+"${del[@]}"}"
    else
        run_rsync "pulling $DRAUGR_DATA <- $DRAUGR_SANDBOX" \
            "$remote" "$local_dir" --stats "${del[@]+"${del[@]}"}"
    fi
    dr_ok "$action complete"
    ;;
esac
