#!/usr/bin/env bash
# dr-data: move DRAUGR_DATA files between host and mound, next to git.
#
# Git is good for source code, but not for a 4 GB parquet file in mid-process.
# This is the second channel. rsync uses the same ssh transport as dr-sync. A
# file goes to the SAME path in the repo on both sides. Thus a script that reads
# tmp/raw/2024.parquet works without change on both sides.
#
# Always one direction at a time. A parquet file has no merge algorithm. If both
# sides changed it, a sync in two directions selects one version without a
# message, and destroys the other. Thus each transfer names the side that wins.
#
# Nobody reviews a pull. dr-merge gives you a commit to read. rsync gives you a
# file name and a byte count, and then the bytes are on your disk. Thus
# `dr-data diff` shows what a pull writes. Each pull names the files that come,
# and marks each file that looks like something you run.
#
# A pull lands in a host-owned staging directory first, outside the repository,
# and the review reads THAT tree before anything is published. A dry run
# describes a mound that keeps working afterwards. The staged tree is the files
# themselves. See the `pull` branch at the end of this file.
#
#   dr-data status   dry run, BOTH directions: what moves, and how much
#   dr-data diff     what a pull CHANGES, as a real diff where possible
#   dr-data push     host -> mound  (the host wins)
#   dr-data pull     mound -> host  (the sandbox wins)
set -euo pipefail

DR_PROG=dr-data
# readlink -f comes first. install.sh links this file into ~/.local/bin, and
# through a link BASH_SOURCE is the LINK. Without it, ../lib is ~/.local/lib.
_dr_bin=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$_dr_bin/../lib/common.sh"

# status is the default, because it is the only action that changes nothing.
# The usual first question is "which direction do I want?"
action=${1:-status}
case "$action" in
    -h|--help) dr_help "$0"; exit 0 ;;
    status|diff|push|pull) shift || : ;;
    *) dr_die "unknown action: $action" "One of: status, diff, push, pull" ;;
esac

# --delete needs the configuration AND a confirmation in this run. Thus a
# clean-up on one side cannot delete the output of the other side without a
# message.
delete=
while [ $# -gt 0 ]; do
    case "$1" in
        -y|--yes)   DR_ASSUME_YES=1 ;;
        --delete)   delete=1 ;;
        *) dr_die "unknown option: $1" "Try: dr-data --help" ;;
    esac
    shift
done

dr_context

[ -n "$DRAUGR_DATA" ] || dr_die \
    "DRAUGR_DATA is empty, so there is nothing to move" \
    "Set it to globs relative to the repo, for example  DRAUGR_DATA=\"tmp/** *.parquet\"" \
    "It came from ${DR_ORIGIN[DRAUGR_DATA]}."

dr_sandbox_exists "$DRAUGR_SANDBOX" || dr_die \
    "$DRAUGR_SANDBOX does not exist" "Create it with:  dr-up"

# The rules are in lib/common.sh next to dr_data_matches, because the two must
# agree. Otherwise a file transfers but still blocks dr-go, or the reverse. That
# bug is hard to find. mapfile reads the rules, one on each line.
mapfile -t filters < <(dr_data_filters)

mound=$(dr_path_mound "$DR_REPO")
# dr_sandbox_ssh_host, not "$DRAUGR_SANDBOX.sbx". The far end can be the forge
# VM, and its host is an ssh_config alias. A copy here disagrees with the URL of
# dr-sync.
remote="$(dr_sandbox_ssh_host):$mound/"
local_dir="$DR_REPO/"

# -a keeps permissions and times. -m removes empty directories. --chmod sets the
# modes on the way in. Under WSL, all of /mnt/c is mode 777, and without --chmod
# that goes into the mound.
#
# REGULAR FILES AND DIRECTORIES, NOTHING ELSE. -a is -rlptgoD, and the `l` and
# the `D` are a transfer of names rather than of content: a symlink, a device,
# a fifo, a socket. A symlink is the interesting one. It is a NAME THAT POINTS
# SOMEWHERE, so a sender can put `.draugr/tmp -> /anywhere` in your tree and
# the next host command that writes through it writes there instead. That is
# how two findings of the review chained into one. Draugr transfers data, and
# data is bytes, so the three --no- flags turn the whole class off.
#
# Measured with rsync 3.2.7: a skipped symlink prints `skipping non-regular
# file "x"` and the run still exits 0. The exit code does NOT report it, which
# is why incoming_names below reads that line instead of trusting the status.
common=(-a --no-links --no-devices --no-specials -m "${filters[@]}")

# --chmod belongs to ONE direction, and it used to be in `common`, where it was
# in both.
#
# A push writes into the mound, which is ext4: there a mode is a mode, and
# without --chmod the 0777 that all of /mnt/c reports goes in with the file.
#
# A pull writes onto a Windows drive, where DrvFs reports every file as 0777
# whatever --chmod says. That measurement is already why dr_data_exec_shaped
# judges the name and not the mode. So on a pull --chmod changes nothing on
# disk, but it does change what rsync BELIEVES the destination should be, and
# --link-dest links only a file that matches in full, permissions included.
# Measured here, ext4 sender to a /mnt/c destination with the repo as the
# reference, 128 MB unchanged: 5.9 s with --chmod, 65 ms without it and with
# --no-perms. The staged pull below needs that link, so the pull legs state
# both.
tomound=(--chmod="$DRAUGR_DATA_CHMOD")
tohost=(--no-perms)

# The summary of rsync is more correct than a number that Draugr calculates. It
# tells what moved on the wire. That number shows that the delta algorithm works
# across the boundary.
run_rsync() {
    local label=$1 src=$2 dst=$3 rc=0
    shift 3
    dr_info "$label"

    # The status goes into a variable first. `rsync … || dr_die` cannot tell
    # you WHICH failure it was, and the three that matter here have different
    # answers.
    rsync "${common[@]}" "$@" "$src" "$dst" || rc=$?
    [ "$rc" -eq 0 ] && return 0

    case "$rc" in
        23|24)
            # 23 is "some files could not be transferred", 24 is "some files
            # vanished on the sender". Both mean the transfer is INCOMPLETE,
            # and the old code reported them as "rsync failed. Is the mound
            # reachable?", which sends you to look at the wrong thing.
            dr_die "the transfer is incomplete (rsync status $rc)" \
                "rsync named each file it could not take, above this message." \
                "A permission or a vanished file does that. So does a file that" \
                "is not a regular file: Draugr transfers bytes, not symlinks," \
                "devices or sockets." ;;
        *)
            dr_die "rsync failed (status $rc)" \
                "Is the mound reachable?  dr-status" \
                "Is rsync installed inside it?  dr-shell -- command -v rsync" ;;
    esac
}

# --- reviewing what a pull would land ---------------------------------------
#
# A pull writes bytes from the agent into your working directory. The summary of
# rsync, "12 files, 4.1 MB", is a receipt, not a review. A receipt is not enough
# for content that you did not write and cannot see. This section fixes that.

# Bytes that are easy to read. To compare 4823 and 5104 is work, but 4.7 KB and
# 4.9 KB is easy. The exact number is not important in this report.
human() {
    local b=$1
    if   [ "$b" -ge 1073741824 ]; then printf '%d.%d GB' "$((b/1073741824))" "$(((b%1073741824)*10/1073741824))"
    elif [ "$b" -ge 1048576 ];    then printf '%d.%d MB' "$((b/1048576))"    "$(((b%1048576)*10/1048576))"
    elif [ "$b" -ge 1024 ];       then printf '%d.%d KB' "$((b/1024))"       "$(((b%1024)*10/1024))"
    else                               printf '%d B' "$b"
    fi
}

# A FORECAST of the names that a pull writes, relative to the repo, one on each
# line, without directories. It uses the same filter rules and delta algorithm
# as a real transfer, so it is the best answer available without transferring
# anything, and `status` and `diff` transfer nothing, which is their point.
#
# `pull` does NOT use this. A forecast describes the mound at the moment it was
# asked, and the mound keeps running. classify_staged below reads the files
# that actually arrived. Reading a name out of the report of rsync is also reading
# an encoding of it, which the comment there measures.
#
# THREE THINGS THIS FUNCTION USED TO GET WRONG, and they are one mistake: it
# believed output that it had not checked.
#
#   1. `rsync … 2>/dev/null | grep -v '/$' || true` is the status of GREP, and
#      `|| true` discards even that. A dry run that FAILED, such as an unreachable
#      mound, a refused ssh or a missing rsync in there, arrived as an empty
#      list, which every caller reads as "a pull lands nothing". The pull then
#      ran unreviewed, with the real transfer doing the work. That is F07.
#   2. rsync writes its own remarks to STDOUT, mixed in with the names.
#      Measured on 3.2.7: `skipping non-regular file "alink"` is a stdout
#      line. So a symlink in the tree of the sender turned into an incoming "file"
#      with that sentence for a name. The >> marker below tells the two apart:
#      a name is a line that rsync FORMATTED, not any line it printed.
#   3. A line it cannot read is not a line to drop. If rsync has something to
#      say here, the honest answer is "I cannot tell you what a pull would
#      land", and the caller stops. The skipped symlink of point 2 lands here.
#
# stderr is NOT captured: ssh writes its own notes there (a new host key), and
# those are for the user to read, not for this function to parse.
incoming_names() {
    local out chatter
    out=$(rsync "${common[@]}" "${tohost[@]}" --dry-run --out-format='>>%n' \
            "$remote" "$local_dir") || return 1

    # Anything that is not a formatted name. The status of the pipe is not
    # read, the CONTENT is, so a grep that matches nothing cannot be mistaken
    # for a failure.
    chatter=$(printf '%s\n' "$out" | grep -v '^>>' | grep -v '^$') || true
    if [ -n "$chatter" ]; then
        printf '%s\n' "$chatter" >&2
        return 2
    fi

    # %n ends a directory with a slash. A name that itself starts with ">>"
    # arrives as ">>>>name", and one strip leaves it intact.
    printf '%s\n' "$out" | sed -n 's/^>>//p' | grep -v '/$' || true
}

# names=() from incoming_names, with the status kept.
#
# `mapfile -t names < <(incoming_names)` cannot do this: it reports the status of
# MAPFILE, which is 0 whatever the preview did. That is the defect of point 1
# again, in the shape that the shell makes convenient. It was in all three
# callers.
list_incoming() {
    local out rc=0 line
    out=$(incoming_names) || rc=$?
    case "$rc" in
        0) ;;
        2) dr_die "Draugr cannot tell what a pull would land" \
               "rsync printed the line above where a file name belongs. A symlink" \
               "or another non-regular file in the mound does that: Draugr does" \
               "not transfer those, so the preview cannot account for one." \
               "Look at the mound before you pull:  dr-shell" ;;
        *) dr_die "could not preview what a pull would land" \
               "The dry run failed, so the review would be empty, and an empty" \
               "review is not the same answer as 'nothing to pull'." \
               "Is the mound reachable?  dr-status" ;;
    esac

    names=()
    [ -n "$out" ] || return 0
    while IFS= read -r line; do names+=("$line"); done <<< "$out"
}

# Sort a list of incoming files into three groups. It sets arrays and does not
# print, because each caller wants a different group. diff fetches the safe
# names, and pull stops on the executable ones. All callers report the refused
# ones.
DR_IN_SAFE=(); DR_IN_EXEC=(); DR_IN_UNSAFE=(); DR_IN_ODD=()

# The verdict on one name. Both classifiers below call this one, so the order
# of the two questions cannot drift between the forecast that `status` prints
# and the decision that `pull` makes.
_classify_one() {
    local f=$1
    # Refuse it, and do not sort it more. Draugr does not write this name,
    # so it does not read its size either.
    if ! dr_data_path_safe "$f"; then
        DR_IN_UNSAFE+=("$f")
        return 0
    fi
    DR_IN_SAFE+=("$f")
    if dr_data_exec_shaped "$f"; then DR_IN_EXEC+=("$f"); fi
}

# The three groups, from a list of names. `status` and `diff` use this, and
# DR_IN_ODD stays empty here: a name on its own says nothing about the type of
# the thing it names.
classify_incoming() {
    local f
    DR_IN_SAFE=(); DR_IN_EXEC=(); DR_IN_UNSAFE=(); DR_IN_ODD=()
    for f in "$@"; do _classify_one "$f"; done
    return 0
}

# The same three groups, read from a staged tree on this disk instead of from
# the report of rsync on one. `pull` uses this and nothing else.
#
# WHY THE NAMES COME FROM THE FILESYSTEM. `%n` is the presentation output of rsync,
# and a name is not always what it prints as. Measured with rsync 3.2.7: a
# newline in a name arrives as the four characters `\#012`, a `\001` as
# `\#001`, and a backslash is itself escaped to `\#134` when the result would
# otherwise be ambiguous, so a review of that text reviews an encoding, and
# `--files-from` fed that text back finds no such file (status 23, measured).
# A raw tab, by contrast, is passed through unescaped. Here the names come
# from find -print0, where the only separator is the one byte a name cannot
# contain, so each name arrives exactly as it is on disk.
#
# WHY THE TYPE COMES FROM A TEST AND NOT FROM A SENTENCE. The three --no-
# flags should stop a symlink, a device and a socket at the sender, and a
# skipped one is announced in prose on stdout with a zero exit status. This
# asks the file instead. -L comes first, because -d and -f follow a link.
classify_staged() {
    local e path
    DR_IN_SAFE=(); DR_IN_EXEC=(); DR_IN_UNSAFE=(); DR_IN_ODD=()
    while IFS= read -r -d '' e; do
        path=${e#"$DR_STAGE/"}
        if [ -L "$e" ] || { [ ! -d "$e" ] && [ ! -f "$e" ]; }; then
            DR_IN_ODD+=("$path")
        elif [ -d "$e" ]; then
            # A directory lands no bytes, and the name of one that holds a
            # file is already judged as a component of that file's path. An
            # EMPTY one is the case this line exists for: -m should prune it,
            # and a guarantee does not rest on an rsync flag.
            dr_data_path_safe "$path" || DR_IN_UNSAFE+=("$path")
        else
            _classify_one "$path"
        fi
    done < <(find "$DR_STAGE" -mindepth 1 -print0)
    return 0
}

# Print the result. It returns 1 for an incoming file that looks executable.
# Thus a caller can change the report into a question.
report_incoming() {
    local f rc=0

    # A refused path is a fact about the sandbox, not a preference. rsync
    # probably cleans it too. But Draugr does not print "the copy tool probably
    # handles it".
    if [ ${#DR_IN_UNSAFE[@]} -gt 0 ]; then
        dr_error "${#DR_IN_UNSAFE[@]} incoming path(s) REFUSED as unsafe:"
        for f in "${DR_IN_UNSAFE[@]}"; do printf '    %q\n' "$f" >&2; done
        printf '  %sAbsolute, with .., with control characters, or a name that your%s\n' \
            "$_DR_DIM" "$_DR_OFF" >&2
        printf '  %sdrive resolves to something else: .GIT and GIT~1 are both .git%s\n' \
            "$_DR_DIM" "$_DR_OFF" >&2
        printf '  %sthere, and .git/config decides what git runs. Draugr does%s\n' \
            "$_DR_DIM" "$_DR_OFF" >&2
        printf '  %snot write them. Look at the mound before you trust the other files.%s\n' \
            "$_DR_DIM" "$_DR_OFF" >&2
        rc=1
    fi

    # Only a staged pull can report this, because only a staged pull has the
    # entry on a disk to test. A symlink is the one that matters: it is a name
    # that points somewhere, and the next host command that writes through it
    # writes there. --no-links should mean there is never one to report.
    if [ ${#DR_IN_ODD[@]} -gt 0 ]; then
        dr_error "${#DR_IN_ODD[@]} incoming entr(ies) are NOT regular files:"
        for f in "${DR_IN_ODD[@]}"; do printf '    %q\n' "$f" >&2; done
        printf '  %sDraugr transfers bytes. A symlink, a device or a socket arrived%s\n' \
            "$_DR_DIM" "$_DR_OFF" >&2
        printf '  %sanyway, which means --no-links did not hold. Nothing is published.%s\n' \
            "$_DR_DIM" "$_DR_OFF" >&2
        rc=1
    fi

    # This is the reason for all of this section. The mode tells nothing (see
    # dr_data_exec_shaped), so the name gets the mark, and the mark is clear.
    if [ ${#DR_IN_EXEC[@]} -gt 0 ]; then
        dr_warn "${#DR_IN_EXEC[@]} incoming file(s) look RUNNABLE:"
        for f in "${DR_IN_EXEC[@]}"; do printf '    %s\n' "$f" >&2; done
        printf '  %sThe agent wrote these, and you did not read them. On a Windows drive%s\n' \
            "$_DR_DIM" "$_DR_OFF" >&2
        printf '  %seach file gets mode 0777, whatever DRAUGR_DATA_CHMOD says, so they%s\n' \
            "$_DR_DIM" "$_DR_OFF" >&2
        printf '  %sare executable. Read them first:  dr-data diff%s\n' \
            "$_DR_DIM" "$_DR_OFF" >&2
        rc=1
    fi
    return "$rc"
}

case "$action" in

# Both directions, and neither is applied. Run this command before you select a
# direction.
status)
    dr_heading "host -> mound (what dr-data push transfers)"
    run_rsync "dry run" "$local_dir" "$remote" --dry-run --stats "${tomound[@]}"
    dr_heading "mound -> host (what dr-data pull transfers)"
    run_rsync "dry run" "$remote" "$local_dir" --dry-run --stats "${tohost[@]}"

    # Only the inbound direction gets a review. What you send to the agent is
    # already yours. What it sends back is the half that you did not read.
    list_incoming
    if [ ${#names[@]} -gt 0 ]; then
        classify_incoming "${names[@]}"
        report_incoming || true

        # Say what this list is. It comes from a dry run, so it describes the
        # mound as it was a moment ago, and the mound keeps working. `pull`
        # does not decide from a list like this one - it decides from the files
        # it received. The two can differ, and only the second one is a gate.
        printf '  %sA forecast, from a dry run. dr-data pull decides on the files it%s\n' \
            "$_DR_DIM" "$_DR_OFF" >&2
        printf '  %sactually receives, which is not always this list.%s\n' \
            "$_DR_DIM" "$_DR_OFF" >&2
    fi
    ;;

# The review step for a pull. It is not part of `pull`, on purpose. To fetch
# each changed file and compare it costs work and bytes. Thus it runs only on
# request, not before each transfer.
diff)
    list_incoming
    if [ ${#names[@]} -eq 0 ]; then
        dr_ok "nothing to pull. The data of the mound is the same as yours."
        exit 0
    fi
    classify_incoming "${names[@]}"
    report_incoming || true

    # The copies go in a host-owned staging directory OUTSIDE the repo (see
    # dr_stage), so a later push cannot take them and nothing in the tree can
    # redirect them. --files-from names each
    # file, so the filter rules are not necessary. dr_data_path_safe accepted
    # the names.
    dr_stage
    trap 'rm -rf "$DR_STAGE"' EXIT
    if [ ${#DR_IN_SAFE[@]} -gt 0 ]; then
        printf '%s\n' "${DR_IN_SAFE[@]}" \
            | rsync -a --files-from=- "$remote" "$DR_STAGE/" || dr_die \
                "could not fetch the incoming files to compare them" \
                "Is the mound reachable?  dr-status"
    fi

    dr_heading "${#DR_IN_SAFE[@]} file(s) that a pull writes"
    for f in "${DR_IN_SAFE[@]+"${DR_IN_SAFE[@]}"}"; do
        new="$DR_STAGE/$f"
        # A name in the list can still be missing here. It can be a directory, a
        # symlink, or a file that the agent removed between the two transfers.
        [ -f "$new" ] || continue
        old="$DR_REPO/$f"
        newsize=$(stat -c %s "$new")
        oldsize=0
        [ -f "$old" ] && oldsize=$(stat -c %s "$old")

        # The header shows the sizes, also without a body, because "1.2 GB
        # became 4 B" is a review result.
        if [ -f "$old" ]; then
            printf '\n%s--- %s%s  %s(%s -> %s)%s\n' \
                "$_DR_BOLD" "$f" "$_DR_OFF" "$_DR_DIM" \
                "$(human "$oldsize")" "$(human "$newsize")" "$_DR_OFF" >&2
        else
            printf '\n%s+++ %s%s  %s(new, %s)%s\n' \
                "$_DR_BOLD" "$f" "$_DR_OFF" "$_DR_DIM" "$(human "$newsize")" "$_DR_OFF" >&2
        fi

        # Two different reasons to not show content. You cannot read binary, and
        # a very large file does not help. Say which reason. Then you know the
        # cases where a larger DRAUGR_DATA_DIFF_MAX helps.
        if ! dr_data_is_text "$new"; then
            printf '  %sbinary, content not shown%s\n' "$_DR_DIM" "$_DR_OFF" >&2
            continue
        fi
        if [ "$newsize" -gt "$DRAUGR_DATA_DIFF_MAX" ]; then
            printf '  %s%s is more than DRAUGR_DATA_DIFF_MAX (%s), content not shown%s\n' \
                "$_DR_DIM" "$(human "$newsize")" "$(human "$DRAUGR_DATA_DIFF_MAX")" "$_DR_OFF" >&2
            continue
        fi

        # The diff goes to stdout, and the text around it goes to stderr. Thus
        # `dr-data diff > review.patch` keeps the patch, and the text stays on
        # the screen. --label names the two sides a/ and b/, as git does. The
        # staging directory is not in each header, and `patch -p1` can apply it.
        if [ -f "$old" ]; then
            diff -u --label "a/$f" --label "b/$f" -- "$old" "$new" || true
        else
            diff -u --label /dev/null --label "b/$f" -- /dev/null "$new" || true
        fi
    done
    ;;

push|pull)
    # If the configuration and this run agree, a deletion goes to the other
    # side. If not, it does not. DRAUGR_DATA_DELETE alone is not enough. The
    # dangerous case: you clean one side, and forget that the other side has
    # your only copy.
    del=()
    if [ -n "$delete" ] || dr_is_true "$DRAUGR_DATA_DELETE"; then
        dr_warn "--delete: files that are missing on the source are REMOVED on the destination"
        dr_confirm "Propagate deletions?" || dr_die "cancelled"
        del=(--delete)
    fi

    # A push needs no review. What you send to the agent is already yours.
    if [ "$action" = push ]; then
        run_rsync "pushing $DRAUGR_DATA -> $DRAUGR_SANDBOX" \
            "$local_dir" "$remote" --stats "${tomound[@]}" "${del[@]+"${del[@]}"}"
        dr_ok "push complete"
        exit 0
    fi

    # --- a pull lands in staging first, and is reviewed from there -----------
    #
    # A PULL USED TO BE TWO CONVERSATIONS WITH THE SENDER. One dry run decided
    # what to refuse and what to ask about, and a second, separate rsync did
    # the transfer. Between them the mound keeps running, so the list that was
    # judged and the files that landed were never the same observation. That is
    # U01, and it is not academic: dr_data_path_safe is the ONLY thing that
    # stops a name like `.git.`, which a Windows drive resolves to `.git` and
    # which the filter rules (exact patterns) do not match. A sender that
    # shows a tidy tree to the dry run and writes that name afterwards got it
    # past the one check that would have refused it.
    #
    # So the transfer happens FIRST, into a host-owned directory outside the
    # repository, and the review reads that tree. One conversation with the
    # sender, and the thing that was judged is the thing that is published.
    #
    # IT COSTS ALMOST NOTHING, measured on this host rather than assumed, with
    # an ext4 sender and a /mnt/c repository:
    #
    #   --link-dest=repo on the way in    an unchanged file becomes a hard
    #                                     link, not a copy: 128 MB in 65 ms
    #   --link-dest=stage on the way out  a published file is a hard link to
    #                                     the staged one: 128 MB in 70 ms
    #
    # 128 MB of changed data: 1130 ms staged against 1104 ms straight into the
    # repository. Removing the staging tree afterwards leaves the published
    # file whole. A hard link is the file, not a reference to it.
    #
    # Both links need the staging root and the repository on ONE volume, which
    # %LOCALAPPDATA% and a checkout on C: normally are. On two, rsync copies
    # instead of linking: slower, and the same result.
    dr_stage
    trap 'rm -rf "$DR_STAGE"' EXIT

    run_rsync "pulling $DRAUGR_DATA <- $DRAUGR_SANDBOX" \
        "$remote" "$DR_STAGE/" --stats "${tohost[@]}" --link-dest="$local_dir"

    classify_staged

    # Nothing arrived. With deletions confirmed that is still an instruction
    # (the mound removed its data and this run is told to follow), so the
    # publication below has to run. Without them there is nothing left to do.
    if [ ${#DR_IN_SAFE[@]} -eq 0 ] && [ ${#DR_IN_UNSAFE[@]} -eq 0 ] \
       && [ ${#DR_IN_ODD[@]} -eq 0 ] && [ ${#del[@]} -eq 0 ]; then
        dr_ok "nothing to pull. The data of the mound is the same as yours."
        exit 0
    fi

    # An unsafe path stops the whole pull, with no question. If a mound sends
    # `../..`, do not take the other files from it after a yes or no answer.
    # Nothing is in the repository yet, so the refusal costs the bytes and
    # nothing else.
    if [ ${#DR_IN_UNSAFE[@]} -gt 0 ] || [ ${#DR_IN_ODD[@]} -gt 0 ]; then
        report_incoming || true
        dr_die "refusing to pull" \
            "The mound sent something that Draugr does not write to your host." \
            "NOTHING WAS PUBLISHED. The files are in the staging directory," \
            "which this command removes as it exits." \
            "Look at the mound before you continue:  dr-shell"
    fi

    # HOW MUCH OF IT THERE MAY BE, asked before the question below rather than
    # after it: a limit that fires after you have agreed to a pull has made you
    # read a report for nothing.
    #
    # This is the one of the three shared receive steps that the data channel
    # uses as it stands (lib/common.sh, "the shared receive path"). It does not
    # call dr_incoming_validate_tree, because classify_staged above is the
    # version of that walk that belongs to this command, and a better one here: it REPORTS
    # every entry it refuses instead of dying at the first, which is what makes
    # the review above worth reading. And it does not call
    # dr_incoming_dest_ok, because this channel publishes by merging into the
    # repository rather than by replacing a directory - the repository IS the
    # root, so there is no strict descendant to confine, and the per-name test
    # is dr_data_path_safe.
    #
    # What a destination test would have caught here, the default of rsync already
    # does, measured with rsync 3.2.7 (tmp/h1-rsync-dest.log): a staged
    # `data/out.txt` published onto a repository where `data` is a symlink out
    # of the tree REPLACES the link with a real directory and leaves the
    # outside file untouched, and the same holds for a symlinked file. One flag
    # reverses that - --keep-dirlinks writes straight through the link - and
    # tests/data.bats keeps it out of this file.
    dr_incoming_within_limits "$DR_STAGE" || dr_die \
        "refusing to pull" \
        "The mound sent more than this host accepts. The line above names the" \
        "limit and the key that raises it." \
        "NOTHING WAS PUBLISHED. The files are in the staging directory," \
        "which this command removes as it exits."

    # Content that looks executable gets a question, not a refusal. Otherwise
    # a project with scripts in its data cannot pull at all. People turn off a
    # guard that they cannot satisfy.
    #
    # The report also prints with --yes, which dr-go gives for an automatic
    # pull. The record of what arrived is important, not only the chance to
    # say no.
    if ! report_incoming; then
        dr_confirm "Pull them anyway?" || dr_die "cancelled" \
            "Read them before you decide:  dr-data diff"
    fi

    # Publication. The filters come with `common`, and they are what makes
    # --delete safe here: without them it would mean "remove everything in the
    # repository that is not data", which is the whole source tree. Measured:
    # a data file absent from the staged tree is deleted, a source file absent
    # from it is kept.
    #
    # --link-dest is the staging tree itself, which reads oddly and is exactly
    # right: for every file rsync has to write, the reference holds a perfect
    # match, so it links instead of copying. The repository and the staging
    # tree then share one inode until the trap above removes the staging name.
    run_rsync "publishing into $DR_REPO" \
        "$DR_STAGE/" "$local_dir" "${tohost[@]}" --link-dest="$DR_STAGE/" \
        "${del[@]+"${del[@]}"}"

    dr_ok "pull complete"
    ;;
esac
