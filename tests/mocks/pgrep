#!/usr/bin/env bash
# A stand-in for pgrep, so that dr_agent_mem_quiesce has a fixed answer.
#
# The real pgrep reads the process table of the HOST, and the mock sbx runs the
# quiesce probe on the host, not in a mound. Thus each process named `codex` on
# the machine changed the result of a test. MEASURED: a copy of /bin/sleep named
# `codex` changed "codex check: unexported session history is not nothing to
# lose" from ok to not ok, at tests/mem.bats:553. When the copy stopped, the
# test was ok again. Under `bats -j 8`, that looked like a random failure, and
# like a real defect in dr-mem.
#
#   DR_MOCK_AGENT_RUNNING   the names of the running processes, separated by
#                           spaces. Unset means none, which is the quiet answer.
#   DR_MOCK_PGREP_BROKEN    exit 2, as the real pgrep does for its own errors.
#                           Thus a test can cover "could not tell".
set -euo pipefail

[ -n "${DR_MOCK_PGREP_BROKEN:-}" ] && exit 2

# Only the last word that is not a flag is the pattern. -x and -f change what
# the real pgrep compares. This mock always compares the whole name, because
# each caller in Draugr passes -x.
want=
for arg in "$@"; do
    case "$arg" in
        -*) ;;
        *)  want=$arg ;;
    esac
done

for name in ${DR_MOCK_AGENT_RUNNING:-}; do
    if [ "$name" = "$want" ]; then
        # A realistic pid, because pgrep prints one for each match, and a
        # caller can read it. No code in Draugr reads it yet.
        printf '4242\n'
        exit 0
    fi
done
exit 1
