#!/usr/bin/env bash
# A stand-in for the `ip` of iproute2, so that dr_host_ip has a fixed answer.
#
# The real tool reports an address that WSL gets at each boot. That is the full
# reason for dr_host_ip. Thus a test that depends on it tests the current lease
# of the developer.
#
#   DR_MOCK_HOST_IP   the address to report. Unset means a probable default.
#                     EMPTY means a route with no `src`. That exercises "this is
#                     not WSL".
set -euo pipefail

case "$*" in
    *"route get"*)
        ip=${DR_MOCK_HOST_IP-172.19.192.26}
        if [ -z "$ip" ]; then
            # A real answer for an interface with no source address. The route
            # resolves, but there is no source.
            printf '1.1.1.1 dev eth0 \n    cache \n'
            exit 0
        fi
        printf '1.1.1.1 via 172.19.192.1 dev eth0 src %s uid 1000 \n    cache \n' "$ip"
        ;;
    *)
        printf 'mock ip: unhandled: %s\n' "$*" >&2
        exit 1
        ;;
esac
