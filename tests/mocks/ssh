#!/usr/bin/env bash
# A stand-in for the ssh client. Records its argv, so that tests can assert on
# the remote command that Draugr built. It returns, and contacts nothing.
#
#   DR_MOCK_LOG      file to append the argv to, with the prefix "ssh ", so that
#                    the calls() helper can find it beside the sbx lines
#   DR_MOCK_FAIL     with "ssh" in it, each connection fails
#   DR_MOCK_SSH_RC   the exit code in other cases. It acts as the status of the
#                    far side. For dr-go, that is the status of the agent
#
# It does not interpret the remote command. The string that Draugr builds must
# be the string that reaches the shell of the mound. The tests decode it
# themselves.
set -euo pipefail

if [ -n "${DR_MOCK_LOG:-}" ]; then
    printf 'ssh %s\n' "$*" >> "$DR_MOCK_LOG"
fi

case " ${DR_MOCK_FAIL:-} " in
    *" ssh "*) printf 'mock ssh: connection failed\n' >&2; exit 255 ;;
esac

# `ssh -G <host>` prints the configuration that ssh uses, and connects to
# nothing. dr-forge asks it whether the alias of the forge is defined. Thus the
# mock must answer it, and not exit silently. A silent exit reads as "no alias"
# in each test.
#
#   DR_MOCK_SSH_ALIAS=<host>:<port>   a DEFINED alias, with a proxy through the mound
#   unset                             the bare defaults that ssh prints when no Host block
#                                     matches: the name as hostname, port 22, no proxy.
#                                     That is exactly how "undefined" looks.
case " $* " in
    *" -G "*)
        if [ -n "${DR_MOCK_SSH_ALIAS:-}" ]; then
            printf 'hostname %s\n' "${DR_MOCK_SSH_ALIAS%%:*}"
            printf 'port %s\n' "${DR_MOCK_SSH_ALIAS##*:}"
            printf 'user forge\n'
            printf 'proxycommand ssh mock-mound.sbx socat - PROXY:gateway.docker.internal:%%h:%%p,proxyport=3128\n'
        else
            printf 'hostname %s\n' "${*##* }"
            printf 'port 22\n'
            printf 'user nobody\n'
        fi
        exit 0 ;;
esac

# The liveness probe that dr-forge runs over that alias. It can answer only if
# an alias exists. Thus the two stay consistent: no alias, no chain.
#
#   DR_MOCK_SSH_CHAIN=no   a DEFINED alias whose chain still does not carry. A test showed
#                          this. The forward of the supervisor was bound, but the guest
#                          refused each channel over it. sshd binds the permitopen of the
#                          tunnel key at authentication time, and the list became wider after
#                          that. Links 6 and 7 passed all the time. Thus this state must be
#                          separate from "no alias". If not, nobody can test the advice.
case " $* " in
    *DRAUGR_WSL_OK*)
        if [ "${DR_MOCK_SSH_CHAIN:-}" = no ]; then
            printf 'mock ssh: channel 1: open failed: administratively prohibited\n' >&2
            exit 255
        fi
        if [ -n "${DR_MOCK_SSH_ALIAS:-}" ]; then printf 'DRAUGR_WSL_OK\n'; exit 0; fi
        printf 'mock ssh: no alias, so nothing to connect to\n' >&2
        exit 255 ;;
esac

exit "${DR_MOCK_SSH_RC:-0}"
