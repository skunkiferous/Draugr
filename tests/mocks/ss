#!/usr/bin/env bash
# A stand-in for `ss`, so that the loopback test of dr-hostport has a fixed
# answer, not the listeners of the machine that runs the tests.
#
#   DR_MOCK_LISTEN   the local address to report, for example "127.0.0.1:11434"
#                    or "*:11434". Unset means that nothing listens on that port.
#                    That is not an error. You can start it soon.
set -euo pipefail

[ -n "${DR_MOCK_LISTEN:-}" ] || exit 0
printf 'LISTEN 0      4096   %s %s\n' "$DR_MOCK_LISTEN" '*:*'
