#!/usr/bin/env bash
# A stand-in for sbx.exe. Records its argv so tests can assert on the command
# line Draugr built, and replays canned output. Never touches a hypervisor.
#
#   DR_MOCK_LOG    file to append the argv to (one invocation per line)
#   DR_MOCK_STATE  what 'ls --json' should report: absent|stopped|running
#   DR_MOCK_FAIL   exit non-zero for any subcommand named here
#   DR_MOCK_MOUND  a directory standing in for the mound's filesystem. When set,
#                  'exec' and 'cp' stop pretending and really run, against that
#                  tree - so dr-mem's project keys, listings and cp arguments are
#                  exercised for real rather than asserted about. Same reasoning
#                  as dr_fake_mound doing an honest git fetch.
set -euo pipefail

if [ -n "${DR_MOCK_LOG:-}" ]; then
    printf '%s\n' "$*" >> "$DR_MOCK_LOG"
fi

sub=${1:-}

# When DR_MOCK_DAEMON_ERR is set, a create writes it into a daemon.log at exactly
# the path dr_sbx_daemon_log computes from this binary's own location. That is
# how the real sandboxd records the cause of a failure sbx itself reports as a
# bare 500, so the reading of it can be exercised end to end.
if [ -n "${DR_MOCK_DAEMON_ERR:-}" ] && [ "$sub" = create ]; then
    _root=$(dirname "$(dirname "$0")")
    mkdir -p "$_root/sandboxes/state/sandboxd"
    # shellcheck disable=SC2016  # $e is jq's variable, not the shell's
    _filter='{time:"t",level:"ERROR",msg:"create sandbox failed",stage:"run_container",error:$e}'
    jq -cn --arg e "$DR_MOCK_DAEMON_ERR" "$_filter" >> "$_root/sandboxes/state/sandboxd/daemon.log"
fi

case " ${DR_MOCK_FAIL:-} " in
    *" $sub "*) printf 'mock sbx: %s failed\n' "$sub" >&2; exit 1 ;;
esac

case "$sub" in
# A version string new enough to satisfy dr-doctor's >= 0.37 check.
version)
    printf 'Docker Sandboxes version 0.37.1\n'
    ;;

# The only output any test actually parses. DR_MOCK_STATE=absent yields an empty
# list; anything else yields one sandbox per name in that state.
#
# DR_MOCK_NAMES (space separated) stands in for a machine running several at
# once, which is what dr-stop --all is about and what a single-sandbox mock
# could not express.
ls)
    state=${DR_MOCK_STATE:-stopped}
    if [ "$state" = absent ]; then
        printf '{\n  "sandboxes": []\n}\n'
    else
        read -ra _names <<< "${DR_MOCK_NAMES:-${DR_MOCK_NAME:-draugr-testrepo}}"
        printf '{\n  "sandboxes": [\n'
        _sep=
        for _n in "${_names[@]}"; do
            printf '%s' "$_sep"
            cat <<EOF
    {
      "name": "$_n",
      "id": "00000000-0000-0000-0000-000000000000",
      "agent": "claude",
      "status": "$state",
      "workspaces": [
        "C:\\\\Code\\\\testrepo"
      ]
    }
EOF
            _sep=','
        done
        printf '  ]\n}\n'
    fi
    ;;
# With DR_MOCK_MOUND set, run the command for real against that tree. Absolute
# arguments are rewritten into it, which is how "/home/agent/.claude/..." becomes
# a directory this process may actually create. The script itself is passed
# through untouched: it is meant for the mound's shell, and rewriting inside it
# would be guessing at its syntax.
exec)
    if [ -z "${DR_MOCK_MOUND:-}" ]; then
        printf 'mock sbx: %s\n' "$*"
        exit 0
    fi
    shift                              # "exec"
    # Flags come before the sandbox name, exactly as they do for real sbx. -u
    # root is the one Draugr passes; the rest are listed so that where this mock
    # thinks the sandbox name starts cannot drift from where sbx thinks it does.
    while [ $# -gt 0 ]; do
        case "$1" in
            -u|--user|-e|--env|--env-file|-w|--workdir|--detach-keys) shift 2 ;;
            -*) shift ;;
            *)  break ;;
        esac
    done
    shift                              # the sandbox name
    if [ "${1:-}" = -- ]; then shift; fi   # the optional separator

    # Only absolute arguments are rewritten. A script body, a flag or a relative
    # word is passed through as typed - the mound's paths are the things that
    # have to land inside the stand-in tree, and nothing else is ours to touch.
    argv=()
    for a in "$@"; do
        case "$a" in
            /*) argv+=("$DR_MOCK_MOUND$a") ;;
            *)  argv+=("$a") ;;
        esac
    done
    "${argv[@]}"
    ;;

# sbx cp semantics, both directions. "cp SRC DEST" with DEST an existing
# directory places SRC *inside* it, which is plain cp -a's behaviour too.
cp)
    if [ -z "${DR_MOCK_MOUND:-}" ]; then
        printf 'mock sbx: %s\n' "$*"
        exit 0
    fi
    shift

    # Three kinds of argument, and the first two both contain a colon:
    #   C:\Code\x        a Windows path - exactly one letter before the colon
    #   name:/some/path  inside the sandbox
    #   /some/path       an ordinary host path
    #
    # The Windows case is un-translated here rather than by sourcing common.sh:
    # the mock reversing it independently is the point, because then a wrong
    # dr_path_win produces a path this cannot find, instead of two matching bugs.
    translate() {
        # In single quotes '\\' below is two characters, which tr reads as one
        # escaped backslash - not bash escaping, hence the disable, which has to
        # sit in front of the whole case rather than one of its branches.
        # shellcheck disable=SC1003
        case "$1" in
            [A-Za-z]:*)
                printf '/mnt/%s%s' \
                    "$(printf '%s' "${1:0:1}" | tr '[:upper:]' '[:lower:]')" \
                    "$(printf '%s' "${1:2}" | tr '\\' '/')"
                ;;
            *:*) printf '%s%s' "$DR_MOCK_MOUND" "${1#*:}" ;;
            *)   printf '%s' "$1" ;;
        esac
    }

    src=$(translate "$1")
    dst=$(translate "$2")
    [ -e "$src" ] || { printf 'mock sbx: path %s not found\n' "$1" >&2; exit 1; }
    cp -a "$src" "$dst"
    ;;

# The two policy reads Draugr parses rather than just prints. Everything else
# about `policy` still falls through to the recorder below.
#
#   DR_MOCK_DENIED   space-separated hosts to report as blocked
#   DR_MOCK_ADHOC    space-separated hosts allowed for this sandbox by hand
#   DR_MOCK_MULTI    one editable rule holding SEVERAL resources, which nothing
#                    that prunes by resource may touch
#   DR_MOCK_KITHOST  one host allowed by the sandbox's KIT, which must never be
#                    mistaken for an ad-hoc rule - editable:false is what tells
#                    them apart, and that distinction is the whole of dr-kit adopt
policy)
    case "${2:-}" in
    log)
        printf 'mock sbx: %s
' "$*" >> "${DR_MOCK_LOG:-/dev/null}"
        printf '{"blocked_hosts":['
        sep=
        for h in ${DR_MOCK_DENIED:-}; do
            printf '%s{"host":"%s:443","vm_name":"%s","count_since":1}'                 "$sep" "$h" "${DR_MOCK_NAME:-mock}"
            sep=,
        done
        printf ']}
'
        exit 0
        ;;
    ls)
        case " $* " in *" --json "*) ;; *) printf 'mock sbx: %s
' "$*"; exit 0 ;; esac
        printf 'mock sbx: %s
' "$*" >> "${DR_MOCK_LOG:-/dev/null}"
        printf '{"rules":['
        sep=
        n=0
        for h in ${DR_MOCK_ADHOC:-}; do
            printf '%s{"id":"rule-%s","applies_to":"sandbox:%s","decision":"allow","resource_type":"network","editable":true,"resources":["%s"]}' "$sep" "$n" "${DR_MOCK_NAME:-mock}" "$h"
            sep=,
            n=$((n + 1))
        done
        if [ -n "${DR_MOCK_KITHOST:-}" ]; then
            printf '%s{"id":"kit-rule","applies_to":"sandbox:%s","decision":"allow","resource_type":"network","editable":false,"resources":["%s"]}' "$sep" "${DR_MOCK_NAME:-mock}" "$DR_MOCK_KITHOST"
            sep=,
        fi
        if [ -n "${DR_MOCK_MULTI:-}" ]; then
            printf '%s{"id":"multi-rule","applies_to":"sandbox:%s","decision":"allow","resource_type":"network","editable":true,"resources":[' "$sep" "${DR_MOCK_NAME:-mock}"
            msep=
            for h in $DR_MOCK_MULTI; do printf '%s"%s"' "$msep" "$h"; msep=,; done
            printf ']}'
            sep=,
        fi
        printf ']}
'
        exit 0
        ;;
    esac
    printf 'mock sbx: %s
' "$*"
    ;;

# create makes the stand-in filesystem exist, when there is one. dr-plugin builds
# in the mound's own rootfs and copies the result back onto the workspace, so a
# create that left DR_MOCK_MOUND absent would fail at the first exec rather than
# at anything a test meant to check.
create)
    printf 'mock sbx: %s\n' "$*"
    # An `if`, not `[ ] &&`: under set -e a false test as the last command in
    # this branch would exit 1 and fail every test that creates a sandbox.
    if [ -n "${DR_MOCK_MOUND:-}" ]; then
        mkdir -p "$DR_MOCK_MOUND/home/agent"
    fi
    ;;

# Everything else only ever needs to have its argv recorded: the tests assert on
# the command line Draugr built, which is the part worth checking.
run|stop|rm|ports|kit|skills)
    printf 'mock sbx: %s\n' "$*"
    ;;
# Loudly, and with sbx's own exit code for an unknown command - a mock that
# silently succeeds on a subcommand it does not model is worse than no mock.
*)
    printf 'mock sbx: unhandled subcommand: %s\n' "$sub" >&2
    exit 127
    ;;
esac
