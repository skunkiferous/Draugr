#!/usr/bin/env bash
# A stand-in for sbx.exe. Records its argv, so that tests can assert on the
# command line that Draugr built. Replays fixed output. Never uses a hypervisor.
#
#   DR_MOCK_LOG    file to append the argv to (one invocation per line)
#   DR_MOCK_STATE  what 'ls --json' reports: absent|stopped|running
#   DR_MOCK_STATES overrides for it by name: "gw=running app=stopped"
#   DR_MOCK_FAIL   exit non-zero for each subcommand named here
#   DR_MOCK_MOUND  a directory that acts as the filesystem of the mound. When
#                  set, 'exec' and 'cp' really run, against that tree. Thus the
#                  project keys, listings and cp arguments of dr-mem really run.
#                  The reason is the same as for the real git fetch of
#                  dr_fake_mound.
set -euo pipefail

if [ -n "${DR_MOCK_LOG:-}" ]; then
    printf '%s\n' "$*" >> "$DR_MOCK_LOG"
fi

sub=${1:-}

# When DR_MOCK_DAEMON_ERR is set, a create writes it into a daemon.log, at the
# path that dr_sbx_daemon_log gets from the location of this binary. The real
# sandboxd records there the cause of a failure that sbx reports as a bare 500.
# Thus a test can exercise the full read of it.
if [ -n "${DR_MOCK_DAEMON_ERR:-}" ] && [ "$sub" = create ]; then
    _root=$(dirname "$(dirname "$0")")
    mkdir -p "$_root/sandboxes/state/sandboxd"
    # shellcheck disable=SC2016  # $e is jq's variable, not the shell's
    _filter='{time:"t",level:"ERROR",msg:"create sandbox failed",stage:"run_container",error:$e}'
    jq -cn --arg e "$DR_MOCK_DAEMON_ERR" "$_filter" >> "$_root/sandboxes/state/sandboxd/daemon.log"
fi

case " ${DR_MOCK_FAIL:-} " in
    *" $sub "*) printf 'mock sbx: %s failed\n' "$sub" >&2; exit 1 ;;
esac

case "$sub" in
# A version string that passes the >= 0.37 test of dr-doctor.
version)
    printf 'Docker Sandboxes version 0.37.1\n'
    ;;

# The only output that a test parses. DR_MOCK_STATE=absent gives an empty list.
# Other values give one sandbox for each name, in that state.
#
# DR_MOCK_NAMES (space separated) acts as a machine that runs several at once.
# dr-stop --all is about that case, and a mock with one sandbox cannot show it.
ls)
    state=${DR_MOCK_STATE:-stopped}
    if [ "$state" = absent ]; then
        printf '{\n  "sandboxes": []\n}\n'
    else
        read -ra _names <<< "${DR_MOCK_NAMES:-${DR_MOCK_NAME:-draugr-testrepo}}"
        printf '{\n  "sandboxes": [\n'
        _sep=
        for _n in "${_names[@]}"; do
            # DR_MOCK_STATES overrides DR_MOCK_STATE by name, as
            # "name=running other=stopped". One state for the full machine
            # cannot show a dependency that runs while its consumer does not.
            # That is the full subject of dr-dep.
            # Padded in the expansion and in the test. Without the leading
            # space, "${DR_MOCK_STATES##*" name="}" does not match the FIRST
            # entry, and gives back the full string. That string then reads as
            # a status. A real failure showed this. It made a test pass for the
            # wrong reason, and later made one fail.
            _s=$state
            _pad=" ${DR_MOCK_STATES:-} "
            case "$_pad" in
                *" $_n="*) _s=${_pad##*" $_n="}; _s=${_s%% *} ;;
            esac
            printf '%s' "$_sep"
            cat <<EOF
    {
      "name": "$_n",
      "id": "00000000-0000-0000-0000-000000000000",
      "agent": "claude",
      "status": "$_s",
      "workspaces": [
        "C:\\\\Code\\\\testrepo"
      ]
    }
EOF
            _sep=','
        done
        printf '  ]\n}\n'
    fi
    ;;
# With DR_MOCK_MOUND set, run the command for real against that tree. Absolute
# arguments move into it. Thus "/home/agent/.claude/..." becomes a directory
# that this process can create. The script itself goes through unchanged. It is
# for the shell of the mound, and a rewrite inside it guesses at its syntax.
exec)
    if [ -z "${DR_MOCK_MOUND:-}" ]; then
        printf 'mock sbx: %s\n' "$*"
        exit 0
    fi
    shift                              # "exec"
    # Flags come before the sandbox name, as for the real sbx. Draugr passes -u
    # root. The others are listed, so that this mock and sbx always agree on
    # where the sandbox name starts.
    while [ $# -gt 0 ]; do
        case "$1" in
            -u|--user|-e|--env|--env-file|-w|--workdir|--detach-keys) shift 2 ;;
            -*) shift ;;
            *)  break ;;
        esac
    done
    shift                              # the sandbox name
    if [ "${1:-}" = -- ]; then shift; fi   # the optional separator

    # Only absolute arguments change. A script body, a flag or a relative word
    # goes through as typed. Only the paths of the mound must go into the
    # stand-in tree. Nothing else is ours to change.
    argv=()
    for a in "$@"; do
        case "$a" in
            /*) argv+=("$DR_MOCK_MOUND$a") ;;
            *)  argv+=("$a") ;;
        esac
    done
    "${argv[@]}"
    ;;

# The behavior of sbx cp, in both directions. If DEST is an existing directory,
# "cp SRC DEST" puts SRC *inside* it. Plain cp -a does the same.
cp)
    if [ -z "${DR_MOCK_MOUND:-}" ]; then
        printf 'mock sbx: %s\n' "$*"
        exit 0
    fi
    shift

    # Three kinds of argument, and the first two both contain a colon:
    #   C:\Code\x        a Windows path, with exactly one letter before the colon
    #   name:/some/path  inside the sandbox
    #   /some/path       an ordinary host path
    #
    # The Windows case is translated back here, not by sourcing common.sh. The
    # mock reverses it on its own, on purpose. Then a wrong dr_path_win gives a
    # path that this cannot find, and not two matching bugs.
    translate() {
        # In single quotes, '\\' below is two characters. tr reads them as one
        # escaped backslash. That is not bash escaping, thus the disable. It
        # must come before the full case, not one of its branches.
        # shellcheck disable=SC1003
        case "$1" in
            [A-Za-z]:*)
                printf '/mnt/%s%s' \
                    "$(printf '%s' "${1:0:1}" | tr '[:upper:]' '[:lower:]')" \
                    "$(printf '%s' "${1:2}" | tr '\\' '/')"
                ;;
            *:*) printf '%s%s' "$DR_MOCK_MOUND" "${1#*:}" ;;
            *)   printf '%s' "$1" ;;
        esac
    }

    src=$(translate "$1")
    dst=$(translate "$2")
    [ -e "$src" ] || { printf 'mock sbx: path %s not found\n' "$1" >&2; exit 1; }
    cp -a "$src" "$dst"
    ;;

# The two policy reads that Draugr parses, and does not only print. All other
# `policy` calls go to the recorder below.
#
#   DR_MOCK_DENIED   space-separated hosts to report as blocked
#   DR_MOCK_ADHOC    space-separated hosts allowed for this sandbox by hand
#   DR_MOCK_MULTI    one editable rule with SEVERAL resources. A prune by
#                    resource must never touch it
#   DR_MOCK_KITHOST  one host allowed by the KIT of the sandbox. It is never an
#                    ad-hoc rule. editable:false tells them apart, and that
#                    difference is all of dr-kit adopt
policy)
    case "${2:-}" in
    log)
        printf 'mock sbx: %s
' "$*" >> "${DR_MOCK_LOG:-/dev/null}"
        printf '{"blocked_hosts":['
        sep=
        for h in ${DR_MOCK_DENIED:-}; do
            printf '%s{"host":"%s:443","vm_name":"%s","count_since":1}'                 "$sep" "$h" "${DR_MOCK_NAME:-mock}"
            sep=,
        done
        printf ']}
'
        exit 0
        ;;
    ls)
        case " $* " in *" --json "*) ;; *) printf 'mock sbx: %s
' "$*"; exit 0 ;; esac
        printf 'mock sbx: %s
' "$*" >> "${DR_MOCK_LOG:-/dev/null}"
        printf '{"rules":['
        sep=
        n=0
        for h in ${DR_MOCK_ADHOC:-}; do
            printf '%s{"id":"rule-%s","applies_to":"sandbox:%s","decision":"allow","resource_type":"network","editable":true,"resources":["%s"]}' "$sep" "$n" "${DR_MOCK_NAME:-mock}" "$h"
            sep=,
            n=$((n + 1))
        done
        if [ -n "${DR_MOCK_KITHOST:-}" ]; then
            printf '%s{"id":"kit-rule","applies_to":"sandbox:%s","decision":"allow","resource_type":"network","editable":false,"resources":["%s"]}' "$sep" "${DR_MOCK_NAME:-mock}" "$DR_MOCK_KITHOST"
            sep=,
        fi
        if [ -n "${DR_MOCK_MULTI:-}" ]; then
            printf '%s{"id":"multi-rule","applies_to":"sandbox:%s","decision":"allow","resource_type":"network","editable":true,"resources":[' "$sep" "${DR_MOCK_NAME:-mock}"
            msep=
            for h in $DR_MOCK_MULTI; do printf '%s"%s"' "$msep" "$h"; msep=,; done
            printf ']}'
            sep=,
        fi
        printf ']}
'
        exit 0
        ;;
    esac
    printf 'mock sbx: %s
' "$*"
    ;;

# create makes the stand-in filesystem, when there is one. dr-plugin builds in
# the rootfs of the mound, and copies the result back to the workspace. Without
# DR_MOCK_MOUND after create, the first exec fails, not the step under test.
create)
    printf 'mock sbx: %s\n' "$*"
    # An `if`, not `[ ] &&`. Under set -e, a false test as the last command in
    # this branch exits 1, and fails each test that creates a sandbox.
    if [ -n "${DR_MOCK_MOUND:-}" ]; then
        mkdir -p "$DR_MOCK_MOUND/home/agent"
    fi
    ;;

# For all other commands, the mock only records the argv. The tests assert on
# the command line that Draugr built, and that is the important part.
run|stop|rm|ports|kit|skills)
    printf 'mock sbx: %s\n' "$*"
    ;;
# Loudly, and with the exit code of sbx for an unknown command. A mock that
# silently passes a subcommand that it does not model is worse than no mock.
*)
    printf 'mock sbx: unhandled subcommand: %s\n' "$sub" >&2
    exit 127
    ;;
esac
