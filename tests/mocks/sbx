#!/usr/bin/env bash
# A stand-in for sbx.exe. Records its argv, so that tests can assert on the
# command line that Draugr built. Replays fixed output. Never uses a hypervisor.
#
#   DR_MOCK_LOG    file to append the argv to (one invocation per line)
#   DR_MOCK_STATE  what 'ls --json' reports: absent|stopped|running
#   DR_MOCK_STATES overrides for it by name: "gw=running app=stopped"
#   DR_MOCK_FAIL   exit non-zero for each subcommand named here
#   DR_MOCK_FAIL_AT exit non-zero when the FULL argv holds this text. DR_MOCK_FAIL
#                  matches the subcommand only, so it cannot fail `policy rm` and
#                  leave `policy ls` working. A test of a failed revocation needs
#                  exactly that: the listing has to succeed for the removal to be
#                  reached at all.
#   DR_MOCK_MOUND  a directory that acts as the filesystem of the mound. When
#                  set, 'exec' and 'cp' really run, against that tree. Thus the
#                  project keys, listings and cp arguments of dr-mem really run.
#                  The reason is the same as for the real git fetch of
#                  dr_fake_mound.
#   DR_MOCK_LS_BARRIER  a path. Before answering `ls`, the mock appends its pid
#                  to "<path>.arrived" and waits for "<path>.go". A test holds
#                  several processes at one point that way and releases them
#                  together, which is how a race is reproduced on purpose
#                  rather than hoped for. It gives up after 10 s, so a test
#                  that never opens the gate fails instead of hanging.
#   DR_MOCK_CP_TRUNCATE  a name that a 'cp' removes from the destination after
#                  copying: a copy that exits 0 and is not complete.
#   DR_MOCK_CP_PLANT  a name that a 'cp' ADDS to the destination as a symlink,
#                  which the source never had and no listing of it mentions.
set -euo pipefail

if [ -n "${DR_MOCK_LOG:-}" ]; then
    printf '%s\n' "$*" >> "$DR_MOCK_LOG"
fi

sub=${1:-}

# The barrier is the first thing an `ls` meets, before any state is read, so
# every caller stops at the same place.
if [ -n "${DR_MOCK_LS_BARRIER:-}" ] && [ "$sub" = ls ]; then
    printf '%s\n' "$$" >> "$DR_MOCK_LS_BARRIER.arrived"
    _wait=0
    while [ ! -e "$DR_MOCK_LS_BARRIER.go" ] && [ "$_wait" -lt 200 ]; do
        _wait=$((_wait + 1))
        sleep 0.05
    done
fi

# Version-sensitive generated kits can be tested without changing old fixtures.
if [ "$sub" = --version ]; then
    [ -z "${DR_MOCK_VERSION:-}" ] || printf 'sbx version %s\n' "$DR_MOCK_VERSION"
    exit 0
fi

# Replay a captured native envelope independently of the legacy renderer.
if [ "$sub" = ls ] && [ -n "${DR_MOCK_JSON:-}" ]; then
    printf '%s\n' "$DR_MOCK_JSON"
    exit 0
fi

# When DR_MOCK_DAEMON_ERR is set, a create writes it into a daemon.log, at the
# path that dr_sbx_daemon_log gets from the location of this binary. The real
# sandboxd records there the cause of a failure that sbx reports as a bare 500.
# Thus a test can exercise the full read of it.
if [ -n "${DR_MOCK_DAEMON_ERR:-}" ] && [ "$sub" = create ]; then
    _root=$(dirname "$(dirname "$0")")
    mkdir -p "$_root/sandboxes/state/sandboxd"
    # shellcheck disable=SC2016  # $e is jq's variable, not the shell's
    _filter='{time:"t",level:"ERROR",msg:"create sandbox failed",stage:"run_container",error:$e}'
    jq -cn --arg e "$DR_MOCK_DAEMON_ERR" "$_filter" >> "$_root/sandboxes/state/sandboxd/daemon.log"
fi

# The same for a refused START, which has a different shape in the log. The VM
# supervisor of sbx (`sailor`) writes JSON INSIDE JSON. Its own level and error
# are in an escaped string in .msg, but the OUTER level of that entry is INFO. A
# stand-in that writes a plain ERROR entry does not test that read.
#
# The second line is the trap. In the real log window of a failed start, the
# only outer ERROR said `endpoint not connected`. That is a RESULT of the VM
# that did not start. Code that reads that line reports the wrong cause.
if [ -n "${DR_MOCK_DAEMON_NESTED_ERR:-}" ] && [ "$sub" = exec ]; then
    _root=$(dirname "$(dirname "$0")")
    mkdir -p "$_root/sandboxes/state/sandboxd"
    _inner=$(jq -cn --arg e "$DR_MOCK_DAEMON_NESTED_ERR" \
        '{time:"t",level:"error",component:"sailor",msg:"failed to create vm",error:$e}')
    jq -cn --arg m "$_inner" '{time:"t",level:"INFO",msg:$m}' \
        >> "$_root/sandboxes/state/sandboxd/daemon.log"
    jq -cn '{time:"t",level:"ERROR",error:"endpoint not connected"}' \
        >> "$_root/sandboxes/state/sandboxd/daemon.log"
fi

case " ${DR_MOCK_FAIL:-} " in
    *" $sub "*) printf 'mock sbx: %s failed\n' "$sub" >&2; exit 1 ;;
esac

# The guard matters: with DR_MOCK_FAIL_AT unset, the pattern is *""* and
# every call fails.
if [ -n "${DR_MOCK_FAIL_AT:-}" ]; then
    case "$*" in
        *"$DR_MOCK_FAIL_AT"*)
            printf 'mock sbx: refused "%s"\n' "$DR_MOCK_FAIL_AT" >&2; exit 1 ;;
    esac
fi

case "$sub" in
# A version string that passes the >= 0.37 test of dr-doctor.
version)
    printf 'Docker Sandboxes version 0.37.1\n'
    ;;

# The only output that a test parses. DR_MOCK_STATE=absent gives an empty list.
# Other values give one sandbox for each name, in that state.
#
# DR_MOCK_NAMES (space separated) acts as a machine that runs several at once.
# dr-stop --all is about that case, and a mock with one sandbox cannot show it.
ls)
    state=${DR_MOCK_STATE:-stopped}
    if [ "$state" = absent ]; then
        printf '{\n  "sandboxes": []\n}\n'
    else
        read -ra _names <<< "${DR_MOCK_NAMES:-${DR_MOCK_NAME:-draugr-testrepo}}"
        printf '{\n  "sandboxes": [\n'
        _sep=
        for _n in "${_names[@]}"; do
            # DR_MOCK_STATES overrides DR_MOCK_STATE by name, as
            # "name=running other=stopped". One state for the full machine
            # cannot show a dependency that runs while its consumer does not.
            # That is the full subject of dr-dep.
            # Padded in the expansion and in the test. Without the leading
            # space, "${DR_MOCK_STATES##*" name="}" does not match the FIRST
            # entry, and gives back the full string. That string then reads as
            # a status. A real failure showed this. It made a test pass for the
            # wrong reason, and later made one fail.
            _s=$state
            _pad=" ${DR_MOCK_STATES:-} "
            case "$_pad" in
                *" $_n="*) _s=${_pad##*" $_n="}; _s=${_s%% *} ;;
            esac
            # DR_MOCK_AGENT is the agent that sbx reports for the sandbox. Set
            # and EMPTY leaves the field out, as an older sbx did, so that "sbx
            # does not say" is testable and not only imaginable.
            _agent_line=
            if [ -n "${DR_MOCK_AGENT-${DRAUGR_AGENT:-claude}}" ]; then
                _agent_line=$(printf '      "agent": "%s",' "${DR_MOCK_AGENT-${DRAUGR_AGENT:-claude}}")
            fi
            printf '%s' "$_sep"
            cat <<EOF
    {
      "name": "$_n",
      "id": "00000000-0000-0000-0000-000000000000",
$_agent_line
      "status": "$_s",
      "workspaces": [
        "C:\\\\Code\\\\testrepo"
      ]
    }
EOF
            _sep=','
        done
        printf '  ]\n}\n'
    fi
    ;;
# With DR_MOCK_MOUND set, run the command for real against that tree. Absolute
# arguments move into it. Thus "/home/agent/.claude/..." becomes a directory
# that this process can create. The script itself goes through unchanged. It is
# for the shell of the mound, and a rewrite inside it guesses at its syntax.
exec)
    if [ -z "${DR_MOCK_MOUND:-}" ]; then
        printf 'mock sbx: %s\n' "$*"
        # The two steps of dr_mound_ensure_rsync. The DEFAULT is a mound that
        # already has rsync, so a test about something else sees no install.
        # DR_MOCK_NO_RSYNC=1 is the real base image of sbx, which has none, and
        # takes the install. =stuck also fails the install itself, which is the
        # warning path: no network, no mirror, or no apt-get at all.
        case "$*" in
            *'command -v rsync'*)
                [ -n "${DR_MOCK_NO_RSYNC:-}" ] && exit 1
                ;;
            *'install -y rsync'*)
                [ "${DR_MOCK_NO_RSYNC:-}" = stuck ] && exit 1
                ;;
        esac
        exit 0
    fi
    shift                              # "exec"
    # Flags come before the sandbox name, as for the real sbx. Draugr passes -u
    # root. The others are listed, so that this mock and sbx always agree on
    # where the sandbox name starts.
    while [ $# -gt 0 ]; do
        case "$1" in
            -u|--user|-e|--env|--env-file|-w|--workdir|--detach-keys) shift 2 ;;
            -*) shift ;;
            *)  break ;;
        esac
    done
    shift                              # the sandbox name
    if [ "${1:-}" = -- ]; then shift; fi   # the optional separator

    # Only absolute arguments change. A script body, a flag or a relative word
    # goes through as typed. Only the paths of the mound must go into the
    # stand-in tree. Nothing else is ours to change.
    argv=()
    for a in "$@"; do
        case "$a" in
            /*) argv+=("$DR_MOCK_MOUND$a") ;;
            *)  argv+=("$a") ;;
        esac
    done
    "${argv[@]}"
    ;;

# The behavior of sbx cp, in both directions. If DEST is an existing directory,
# "cp SRC DEST" puts SRC *inside* it. Plain cp -a does the same.
cp)
    if [ -z "${DR_MOCK_MOUND:-}" ]; then
        printf 'mock sbx: %s\n' "$*"
        exit 0
    fi
    shift

    # Three kinds of argument, and the first two both contain a colon:
    #   C:\Code\x        a Windows path, with exactly one letter before the colon
    #   name:/some/path  inside the sandbox
    #   /some/path       an ordinary host path
    #
    # The Windows case is translated back here, not by sourcing common.sh. The
    # mock reverses it on its own, on purpose. Then a wrong dr_path_win gives a
    # path that this cannot find, and not two matching bugs.
    translate() {
        # In single quotes, '\\' below is two characters. tr reads them as one
        # escaped backslash. That is not bash escaping, thus the disable. It
        # must come before the full case, not one of its branches.
        # shellcheck disable=SC1003
        case "$1" in
            [A-Za-z]:*)
                printf '/mnt/%s%s' \
                    "$(printf '%s' "${1:0:1}" | tr '[:upper:]' '[:lower:]')" \
                    "$(printf '%s' "${1:2}" | tr '\\' '/')"
                ;;
            *:*) printf '%s%s' "$DR_MOCK_MOUND" "${1#*:}" ;;
            *)   printf '%s' "$1" ;;
        esac
    }

    src=$(translate "$1")
    dst=$(translate "$2")
    [ -e "$src" ] || { printf 'mock sbx: path %s not found\n' "$1" >&2; exit 1; }
    # A boundary assertion must see what was uploaded, not only what survived import.
    if [ -n "${DR_MOCK_CP_CAPTURE:-}" ]; then
        mkdir -p "$DR_MOCK_CP_CAPTURE"
        cp -a "$src" "$DR_MOCK_CP_CAPTURE/"
    fi
    cp -a "$src" "$dst"
    # A copy that exits 0 and is not complete. sbx 0.53 does that: a cp of a
    # tree with a link STOPS at the link, drops the rest, and reports success.
    # The mock copies a link without trouble, so the check in dr-mem does not
    # test that path. This knob removes one named entry after the copy.
    if [ -n "${DR_MOCK_CP_TRUNCATE:-}" ]; then
        # :? on each part, because this is an rm -rf. An empty $dst makes
        # it "/", and shellcheck is right to insist (SC2115).
        rm -rf "${dst:?}/$(basename "${src:?}")/${DR_MOCK_CP_TRUNCATE:?}" \
               "${dst:?}/${DR_MOCK_CP_TRUNCATE:?}" 2>/dev/null || :
    fi
    # The opposite: an entry at the DESTINATION that the source never had, and
    # that no listing of the source mentions. That is the shape a sender gets
    # when the check it had to pass ran on its own side: the agent module
    # refuses a link in the mound, with the find that is in the mound, and this knob
    # stands in for a mound where that refusal did not happen.
    #
    # A symlink by default, because it is the entry that a list of `-type f`
    # cannot see. DR_MOCK_CP_PLANT=<name> plants <name> -> /etc/hostname.
    if [ -n "${DR_MOCK_CP_PLANT:-}" ]; then
        _plant_dir="$dst/$(basename "$src")"
        [ -d "$_plant_dir" ] || _plant_dir=$dst
        ln -sfn /etc/hostname "$_plant_dir/$DR_MOCK_CP_PLANT" 2>/dev/null || :
    fi
    ;;

# The two policy reads that Draugr parses, and does not only print. All other
# `policy` calls go to the recorder below.
#
#   DR_MOCK_DENIED   space-separated hosts to report as blocked
#   DR_MOCK_ADHOC    space-separated hosts allowed for this sandbox by hand
#   DR_MOCK_MULTI    one editable rule with SEVERAL resources. A prune by
#                    resource must never touch it
#   DR_MOCK_KITHOST  one host allowed by the KIT of the sandbox. It is never an
#                    ad-hoc rule. editable:false tells them apart, and that
#                    difference is all of dr-kit adopt
policy)
    case "${2:-}" in
    log)
        printf 'mock sbx: %s
' "$*" >> "${DR_MOCK_LOG:-/dev/null}"
        printf '{"blocked_hosts":['
        sep=
        for h in ${DR_MOCK_DENIED:-}; do
            printf '%s{"host":"%s:443","vm_name":"%s","count_since":1}'                 "$sep" "$h" "${DR_MOCK_NAME:-mock}"
            sep=,
        done
        printf ']}
'
        exit 0
        ;;
    ls)
        case " $* " in *" --json "*) ;; *) printf 'mock sbx: %s
' "$*"; exit 0 ;; esac
        printf 'mock sbx: %s
' "$*" >> "${DR_MOCK_LOG:-/dev/null}"
        printf '{"rules":['
        sep=
        n=0
        for h in ${DR_MOCK_ADHOC:-}; do
            printf '%s{"id":"rule-%s","applies_to":"sandbox:%s","decision":"allow","resource_type":"network","editable":true,"resources":["%s"]}' "$sep" "$n" "${DR_MOCK_NAME:-mock}" "$h"
            sep=,
            n=$((n + 1))
        done
        if [ -n "${DR_MOCK_KITHOST:-}" ]; then
            printf '%s{"id":"kit-rule","applies_to":"sandbox:%s","decision":"allow","resource_type":"network","editable":false,"resources":["%s"]}' "$sep" "${DR_MOCK_NAME:-mock}" "$DR_MOCK_KITHOST"
            sep=,
        fi
        if [ -n "${DR_MOCK_MULTI:-}" ]; then
            printf '%s{"id":"multi-rule","applies_to":"sandbox:%s","decision":"allow","resource_type":"network","editable":true,"resources":[' "$sep" "${DR_MOCK_NAME:-mock}"
            msep=
            for h in $DR_MOCK_MULTI; do printf '%s"%s"' "$msep" "$h"; msep=,; done
            printf ']}'
            sep=,
        fi
        printf ']}
'
        exit 0
        ;;
    esac
    printf 'mock sbx: %s
' "$*"
    ;;

# inspect: the shape of `sbx inspect <name> --json`, measured on sbx 0.53, with
# only the fields that Draugr reads. This is the one source that can say
# whether a mound has the host tree READ-WRITE, and it is the one a mound
# cannot edit, unlike .draugr.conf and .draugr/create.applied, which live in
# the repository that a bind-mounted agent can write.
#
#   DR_MOCK_TREE=clone      this repo mounted READ-ONLY at /run/sandbox/source,
#                           which is what --clone produces (the default here)
#   DR_MOCK_TREE=writable   this repo bind-mounted read-write
#   DR_MOCK_TREE=other      an answer that names no mount for this repo
#   DR_MOCK_TREE=fail       a non-zero exit, as from a daemon that cannot answer
#   DR_MOCK_WS_WIN          the Windows spelling of the repo. The default is
#                           the CURRENT DIRECTORY, because that is the repo
#                           whenever a dr-* command asks this question, and a
#                           fixture repo is never at a fixed path. Draugr
#                           compares by path, so a fixed default answers
#                           "I know nothing about your repo" to every test
#                           that merely runs dr-go.
inspect)
    # /mnt/<d>/x -> <D>:\x, reversed here rather than by sourcing common.sh.
    # The mock does its own translations on purpose (see translate() under cp):
    # then a wrong dr_path_win gives a mismatch, and not two matching bugs.
    _ws_default=$PWD
    case "$_ws_default" in
        /mnt/[A-Za-z]/*|/mnt/[A-Za-z])
            _d=$(printf '%s' "${_ws_default:5:1}" | tr '[:lower:]' '[:upper:]')
            # shellcheck disable=SC1003  # '\\' is the two characters that tr reads as one backslash
            _ws_default="$_d:\\$(printf '%s' "${_ws_default:7}" | tr '/' '\\')" ;;
        *) _ws_default='C:\Code\testrepo' ;;
    esac
    case "${DR_MOCK_TREE:-clone}" in
        fail)
            printf 'mock sbx: cannot inspect %s\n' "${2:-}" >&2
            exit 1 ;;
        other)    _ro=true;  _hp=${DR_MOCK_OTHER_WIN:-'C:\Code\another-repo'} ;;
        writable) _ro=false; _hp=${DR_MOCK_WS_WIN:-$_ws_default} ;;
        *)        _ro=true;  _hp=${DR_MOCK_WS_WIN:-$_ws_default} ;;
    esac
    # A backslash is an escape inside a JSON string, so each one is doubled
    # here. Without this, jq reads C:\Temp as C: followed by a tab.
    _hp_json=${_hp//\\/\\\\}
    cat <<EOF
{
  "name": "${2:-draugr-testrepo}",
  "agent": "${DR_MOCK_AGENT-${DRAUGR_AGENT:-claude}}",
  "state": "${DR_MOCK_STATE:-stopped}",
  "workspace": "$_hp_json",
  "source_repo_dir": "$(if [ "$_ro" = true ]; then printf '%s' "$_hp_json"; fi)",
  "host_mounts": [
    {
      "container_target": "$(if [ "$_ro" = true ]; then printf '/run/sandbox/source'; else printf '/c/Code/testrepo'; fi)",
      "host_path": "$_hp_json",
      "read_only": $_ro
    }
  ]
}
EOF
    ;;

# create makes the stand-in filesystem, when there is one. dr-plugin builds in
# the rootfs of the mound, and copies the result back to the workspace. Without
# DR_MOCK_MOUND after create, the first exec fails, not the step under test.
create)
    printf 'mock sbx: %s\n' "$*"
    # An `if`, not `[ ] &&`. Under set -e, a false test as the last command in
    # this branch exits 1, and fails each test that creates a sandbox.
    if [ -n "${DR_MOCK_MOUND:-}" ]; then
        mkdir -p "$DR_MOCK_MOUND/home/agent"
    fi
    ;;

# For all other commands, the mock only records the argv. The tests assert on
# the command line that Draugr built, and that is the important part.
run|stop|rm|ports|kit|skills)
    printf 'mock sbx: %s\n' "$*"
    ;;
# Loudly, and with the exit code of sbx for an unknown command. A mock that
# silently passes a subcommand that it does not model is worse than no mock.
*)
    printf 'mock sbx: unhandled subcommand: %s\n' "$sub" >&2
    exit 127
    ;;
esac
