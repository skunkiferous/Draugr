#!/usr/bin/env bash
# post-up: keep the gateway alive, run tinyproxy and the SMB server of the
# vault, and prove that the path answers.
#
# `dr-forge gateway` GENERATED it from share/gateway.example/hooks/post-up of
# Draugr. It must be executable. If not, dr_hook silently skips it: no keeper,
# no proxy, no share, and no message. Generation sets the bit. share/ cannot
# carry it.
#
# Tests on sbx 0.37.1 showed why this hook does four jobs:
#  - sbx stops a sandbox 30 s after its last session disconnects, and traffic
#    through a published port is not a session. One held
#    `sbx exec <name> sleep infinity` keeps it up. It dies with a reboot.
#  - After a restart of sandboxd, the commands.startup of a kit never runs
#    again. Each Windows reboot restarts it. Thus tinyproxy starts here.
#  - A process started with setsid from an exec stays after that exec, while
#    the keeper holds the mound.
set -euo pipefail

name=${DRAUGR_SANDBOX:?post-up runs from dr-up, which exports DRAUGR_SANDBOX}
proxy=http://127.0.0.1:18888
probe=${GATEWAY_PROBE_URL:-https://www.unrealengine.com/}

# The MOUND-side paths of the two directories from DRAUGR_MOUNTS. A mount goes
# to the mirrored path, so /mnt/d/VaultHolder on the host is /d/VaultHolder in
# here. Generation writes them. An empty vault_path means that this gateway
# serves no vault. It is still a working gateway. Step 3 is skipped, and the
# proxy works.
vault_path=@VAULT_MOUND@
scratch_path=@SCRATCH_MOUND@

pwsh() { powershell.exe -NoProfile -NonInteractive -Command "$1" | tr -d '\r'; }

# 1. The keeper first, so that the mound cannot auto-stop between the steps
# below.
keepers=$(pwsh "@(Get-CimInstance Win32_Process -Filter 'Name=''sbx.exe''' | Where-Object { \$_.CommandLine -match 'exec +$name +sleep +infinity' }).Count")
if [ "${keepers:-0}" = 0 ]; then
    pwsh "Start-Process -WindowStyle Hidden -FilePath (Get-Command sbx.exe).Source -ArgumentList 'exec','$name','sleep','infinity'" >/dev/null
    echo "post-up: started a keeper session for $name"
fi

# 2. tinyproxy, with NO destination filter and NO Allow lines, on purpose. The
#    allowlist is the sbx policy (dr-policy). Each client arrives from the sbx
#    forwarder, 172.17.0.10, so Allow cannot tell them apart.
#    Base64, because the script crosses bash -> powershell.exe -> sbx.exe -> sh.
ensure=$(cat <<'SH'
conf=/tmp/tinyproxy-gateway.conf
printf '%s\n' 'Port 8888' 'Listen 0.0.0.0' 'Timeout 600' 'MaxClients 200' \
    'LogFile "/tmp/tinyproxy.log"' 'LogLevel Connect' > "$conf"
pgrep -x tinyproxy >/dev/null || setsid tinyproxy -d -c "$conf" </dev/null >/tmp/tinyproxy.out 2>&1 &
sleep 1
pgrep -x tinyproxy >/dev/null
SH
)
b64=$(printf '%s' "$ensure" | base64 -w0)
pwsh "sbx.exe exec $name bash -c 'echo $b64 | base64 -d | bash'" >/dev/null \
    || { echo "post-up: could not start tinyproxy in $name" >&2; exit 1; }

# 3. The vault: SMB for the forge VM. It shares what DRAUGR_MOUNTS gave this
#    mound. The mount makes it read-only, not this configuration. The vault is
#    bind mounted ro, so the kernel refuses writes, whatever the configuration
#    of Samba. "read only = yes" below says the same thing again, on purpose.
#
#    SMB, not sftp, because the guest needs no install to use it. Also, it tells
#    the truth. A test showed that sshfs/WinFsp reported a refused delete to the
#    guest as a SUCCESS. SMB refuses it.
#
#    The password comes from the host, so that it stays after a recreate. If
#    not, each rebuild makes the copy in the guest wrong. Draugr never writes or
#    reads that file. It is the one record of a password that the guest also
#    keeps.
smb_pass_file=$(wslpath -u "$(pwsh '$env:USERPROFILE')")/.ssh/draugr_vault_smb.pass
if [ -z "$vault_path" ]; then
    echo "post-up: no vault directory configured, so no vault share"
elif [ ! -f "$smb_pass_file" ]; then
    echo "post-up: no vault password, so no vault share. To serve one:" >&2
    echo "  put a random string in '$smb_pass_file', then give the user of the mound access to it" >&2
else
    vault=$(cat <<SH
set -e
cat > /etc/samba/smb.conf <<'EOF'
[global]
   workgroup = WORKGROUP
   server string = draugr gateway
   security = user
   map to guest = never
   server min protocol = SMB3
   smb ports = 445
   disable netbios = yes
   log level = 1

[vault]
   path = $vault_path
   read only = yes
   browseable = yes
   valid users = agent

[scratch]
   path = $scratch_path
   read only = no
   browseable = yes
   valid users = agent
EOF
pass=\$(echo $(base64 -w0 "$smb_pass_file") | base64 -d)
printf '%s\n%s\n' "\$pass" "\$pass" | smbpasswd -a -s agent >/dev/null
smbpasswd -e agent >/dev/null
pgrep -x smbd >/dev/null || smbd -D
sleep 2
pgrep -x smbd >/dev/null
SH
)
    b64=$(printf '%s' "$vault" | base64 -w0)
    pwsh "sbx.exe exec -u root $name bash -c 'echo $b64 | base64 -d | bash'" >/dev/null \
        || { echo "post-up: could not start the vault SMB share in $name" >&2; exit 1; }
    echo "post-up: vault SMB answers on 127.0.0.1:18445"
fi

# 4. Prove the path. curl.exe, not the curl of WSL. WSL cannot reach Windows
#    loopback. 000 = nothing answered. 500 = tinyproxy says that sbx refused the
#    host. All else, also a 403 from the site itself, means that the path works.
code=000
for _ in $(seq 1 15); do
    code=$(curl.exe -s -m 10 -o NUL -w '%{http_code}' -x "$proxy" "$probe" | tr -d '\r') || code=000
    case "$code" in
        000|500) sleep 2 ;;
        *) echo "post-up: gateway answers ($probe -> $code)"; exit 0 ;;
    esac
done
echo "post-up: $proxy does not reach $probe (last status $code)" >&2
echo "  does tinyproxy run?  sbx.exe exec $name pgrep -a tinyproxy" >&2
echo "  is the probe allowed? dr-policy --check $probe" >&2
exit 1
