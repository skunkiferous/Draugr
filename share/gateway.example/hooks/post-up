#!/usr/bin/env bash
# post-up - keep the gateway alive, run tinyproxy and the vault's SMB server,
# prove the path answers.
#
# GENERATED by `dr-forge gateway` from Draugr's share/gateway.example/hooks/post-up.
# It must be executable or dr_hook skips it in silence - no keeper, no proxy, no
# share, and no message either. Generation sets the bit; share/ cannot carry it.
#
# Measured on sbx 0.37.1, and the reason this hook does four jobs:
#  - sbx stops a sandbox 30 s after its last session disconnects, and traffic
#    through a published port is not a session. One held
#    `sbx exec <name> sleep infinity` keeps it up. It dies with a reboot.
#  - A kit's commands.startup stops running for good once sandboxd restarts,
#    which every Windows reboot does. So tinyproxy is started here.
#  - A process started with setsid from an exec outlives that exec while the
#    keeper holds the mound.
set -euo pipefail

name=${DRAUGR_SANDBOX:?post-up runs from dr-up, which exports DRAUGR_SANDBOX}
proxy=http://127.0.0.1:18888
probe=${GATEWAY_PROBE_URL:-https://www.unrealengine.com/}

# The MOUND-side paths of the two directories DRAUGR_MOUNTS brings in. A mount lands
# at the mirrored path, so /mnt/d/VaultHolder on the host is /d/VaultHolder in here.
# Written by generation; an empty vault_path means this gateway serves no vault, which
# is still a working gateway - step 3 is then skipped and the proxy is unaffected.
vault_path=@VAULT_MOUND@
scratch_path=@SCRATCH_MOUND@

pwsh() { powershell.exe -NoProfile -NonInteractive -Command "$1" | tr -d '\r'; }

# 1. The keeper first, so the mound cannot auto-stop between the steps below.
keepers=$(pwsh "@(Get-CimInstance Win32_Process -Filter 'Name=''sbx.exe''' | Where-Object { \$_.CommandLine -match 'exec +$name +sleep +infinity' }).Count")
if [ "${keepers:-0}" = 0 ]; then
    pwsh "Start-Process -WindowStyle Hidden -FilePath (Get-Command sbx.exe).Source -ArgumentList 'exec','$name','sleep','infinity'" >/dev/null
    echo "post-up: started a keeper session for $name"
fi

# 2. tinyproxy, with NO destination filtering and NO Allow lines, on purpose:
#    the allowlist is the sbx policy (dr-policy), and every client arrives from
#    the sbx forwarder, 172.17.0.10, so Allow could not tell them apart anyway.
#    Base64 because the script crosses bash -> powershell.exe -> sbx.exe -> sh.
ensure=$(cat <<'SH'
conf=/tmp/tinyproxy-gateway.conf
printf '%s\n' 'Port 8888' 'Listen 0.0.0.0' 'Timeout 600' 'MaxClients 200' \
    'LogFile "/tmp/tinyproxy.log"' 'LogLevel Connect' > "$conf"
pgrep -x tinyproxy >/dev/null || setsid tinyproxy -d -c "$conf" </dev/null >/tmp/tinyproxy.out 2>&1 &
sleep 1
pgrep -x tinyproxy >/dev/null
SH
)
b64=$(printf '%s' "$ensure" | base64 -w0)
pwsh "sbx.exe exec $name bash -c 'echo $b64 | base64 -d | bash'" >/dev/null \
    || { echo "post-up: could not start tinyproxy in $name" >&2; exit 1; }

# 3. The vault: SMB for the forge VM, sharing what DRAUGR_MOUNTS gave this mound.
#    Read-only is the mount's job, not this config's - the vault is bind mounted
#    ro, so the kernel refuses writes however Samba is configured. "read only =
#    yes" below says the same thing twice on purpose.
#
#    SMB rather than sftp because the guest needs nothing installed to use it and
#    because it tells the truth: measured, a refused delete over
#    sshfs/WinFsp was reported to the guest as a SUCCESS, while SMB refuses it.
#
#    The password comes from the host so it survives a recreate - otherwise every
#    rebuild would invalidate what the guest stored. Draugr never writes or reads
#    that file: it is the one record of a password the guest also stores.
smb_pass_file=$(wslpath -u "$(pwsh '$env:USERPROFILE')")/.ssh/draugr_vault_smb.pass
if [ -z "$vault_path" ]; then
    echo "post-up: no vault directory configured, so no vault share"
elif [ ! -f "$smb_pass_file" ]; then
    echo "post-up: no vault password, so no vault share. To serve one:" >&2
    echo "  a random string in '$smb_pass_file', then grant the mound's user access to it" >&2
else
    vault=$(cat <<SH
set -e
cat > /etc/samba/smb.conf <<'EOF'
[global]
   workgroup = WORKGROUP
   server string = draugr gateway
   security = user
   map to guest = never
   server min protocol = SMB3
   smb ports = 445
   disable netbios = yes
   log level = 1

[vault]
   path = $vault_path
   read only = yes
   browseable = yes
   valid users = agent

[scratch]
   path = $scratch_path
   read only = no
   browseable = yes
   valid users = agent
EOF
pass=\$(echo $(base64 -w0 "$smb_pass_file") | base64 -d)
printf '%s\n%s\n' "\$pass" "\$pass" | smbpasswd -a -s agent >/dev/null
smbpasswd -e agent >/dev/null
pgrep -x smbd >/dev/null || smbd -D
sleep 2
pgrep -x smbd >/dev/null
SH
)
    b64=$(printf '%s' "$vault" | base64 -w0)
    pwsh "sbx.exe exec -u root $name bash -c 'echo $b64 | base64 -d | bash'" >/dev/null \
        || { echo "post-up: could not start the vault SMB share in $name" >&2; exit 1; }
    echo "post-up: vault SMB answers on 127.0.0.1:18445"
fi

# 4. Prove the path. curl.exe, not WSL's curl: WSL cannot reach Windows loopback.
#    000 = nothing answered; 500 = tinyproxy saying sbx refused the host.
#    Anything else, including a 403 from the site itself, means the path works.
code=000
for _ in $(seq 1 15); do
    code=$(curl.exe -s -m 10 -o NUL -w '%{http_code}' -x "$proxy" "$probe" | tr -d '\r') || code=000
    case "$code" in
        000|500) sleep 2 ;;
        *) echo "post-up: gateway answers ($probe -> $code)"; exit 0 ;;
    esac
done
echo "post-up: $proxy does not reach $probe (last status $code)" >&2
echo "  tinyproxy running?   sbx.exe exec $name pgrep -a tinyproxy" >&2
echo "  probe allowed?       dr-policy --check $probe" >&2
exit 1
