# >>> draugr (managed) >>>
# WSL has its own ~/.ssh/config. `sbx setup ssh` configures the Windows client
# only, so without this block neither `ssh <name>.sbx` nor git's ssh:// transport
# works from WSL - which is where Draugr runs. dr-setup writes it.
#
# ProxyCommand shells out to sbx.exe exactly the way an interactive login does,
# so there is no TCP port involved, nothing to elevate, and a stopped sandbox is
# started automatically.
Host *.sbx
    User _default_user_
    ProxyCommand "@SBX_EXE@" ssh proxy %n
    IdentityAgent none
    IdentityFile /dev/null
    IdentitiesOnly yes
    ControlMaster no
    ControlPath none
    UserKnownHostsFile "@KNOWN_HOSTS@"
    StrictHostKeyChecking accept-new
    # An allowlist, never "SendEnv *". Measured against sbx 0.37.1: the proxy
    # honours no AcceptEnv at all, so nothing crosses today - not even LANG.
    # That made the wildcard pure downside. It forwarded nothing, while standing
    # ready to forward every variable in the WSL environment - AWS_SECRET_ACCESS_KEY
    # and friends included - the day a future sbx starts accepting them. Locale is
    # the only thing worth sending to a sandbox, and it cannot grow into a leak.
    SendEnv LANG LC_*
# <<< draugr (managed) <<<
