# .draugr.conf: the Draugr configuration of this project. Commit this file.
#
# It is shell, and Draugr sources it, so Draugr runs it. Thus Draugr records its
# hash when you first accept it, and refuses to source a version that it did not
# see before. After an edit, run:  dr-trust
#
# Put personal values in .draugr.local.conf (gitignored, and sourced after this
# file, so it wins).

# The agent that this project expects. To change it later, run dr-up --recreate.
# sbx freezes the agent into the sandbox spec when it builds the mound.
#DRAUGR_AGENT=claude

# Arguments for the agent, in the spelling of the agent: "--continue" for Claude
# Code, "resume --last" for Codex. Set this here only if the PROJECT needs them.
# A habit such as a resume by default belongs to you, not to the repo. Thus it
# goes in ~/.config/draugr/config (or .draugr.local.conf), not a committed file.
#DRAUGR_AGENT_ARGS=

# Network rules and setup commands are in the kit, not here:
#   .draugr/kit/spec.yaml
# See https://docs.docker.com/ai/sandboxes/customize/kits/
#DRAUGR_KIT=.draugr/kit

# Ports for the dev server of this project.
#DRAUGR_PORTS="5173:5173"

# A service on your own machine that the agent can call, for example a local
# Ollama. Bare port numbers. Draugr finds the address at each dr-up.
#DRAUGR_HOST_PORTS="11434"

# Run the AGENT itself on a model that you host, not on the cloud of its vendor.
# Commit this only if the PROJECT requires it. Code that must stay in the
# building belongs to the repository. But the model NAME belongs to the machine
# that runs it. A teammate who did not pull that model gets a failure at the
# first prompt. A preference, not a requirement, goes in .draugr.local.conf.
#DRAUGR_MODEL="qwen3.8:27b"

# Where that model is served. A bare port must ALSO be in DRAUGR_HOST_PORTS
# above. If not, dr-go refuses to start. This is 11435, not the 11434 of the
# example above. 11435 is the query-only proxy in share/ollama-proxy. 11434
# serves DELETE /api/delete, and also inference.
#DRAUGR_MODEL_URL="11435"

# Extra environment for the agent, as space-separated NAME=value pairs. Commit
# this only for something that the PROJECT needs. A limit that depends on your
# GPU, not on the repository, goes in .draugr.local.conf.
#DRAUGR_ENV="CLAUDE_CODE_DISABLE_1M_CONTEXT=1"

# Reference material that the agent can read, but never change.
#DRAUGR_MOUNTS="/mnt/c/Docs/api:ro"

# Data files in work, not committed until they are valid.
# The clean-tree test does not apply to them.
#DRAUGR_DATA="tmp/** *.parquet"
#DRAUGR_DATA_PUSH=auto
#DRAUGR_DATA_PULL=manual
