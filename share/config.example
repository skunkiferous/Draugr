# ~/.config/draugr/config - Draugr's user-home configuration.
#
# Plain shell. KEY=value, comments with #, sourced by every dr-* command. Because
# it is sourced you can compute values:  DRAUGR_PORTS="$(cat ~/.ports)"
#
# Precedence, lowest to highest:
#   built-in defaults -> THIS FILE -> <repo>/.draugr.conf -> <repo>/.draugr.local.conf
#     -> DRAUGR_* in the environment -> command-line flags
#
# Everything below is commented out and shows the built-in default. Uncomment
# only what you want to change; `dr-config` will tell you where each value came
# from once you have.

# --- Which agent, and how big a mound ---------------------------------------

# claude | codex | copilot | cursor | docker-agent | droid | gemini | kiro |
# opencode | shell
#
# Everything but MEMORY works the same for all of them. Draugr knows where two
# of them keep theirs - see lib/agents/ - and dr-mem declines for the rest
# rather than copying into a directory the agent will never read.
#DRAUGR_AGENT=claude

# Arguments passed to the agent on every dr-go, as if you had typed
#   dr-go -- <these>
# Empty is today's behaviour: the agent starts with nothing extra. The common
# reason to set it is to resume by default rather than starting fresh each time:
#
#   DRAUGR_AGENT_ARGS="--continue"        # Claude Code
#   DRAUGR_AGENT_ARGS="resume --last"     # Codex
#
# These are the AGENT's flags, not Draugr's, so they depend on DRAUGR_AGENT and
# neither of those means anything to `shell`. Draugr does not interpret them;
# whatever is here is split on spaces and handed over.
#
# Codex on a ChatGPT plan usually needs a model named here. sbx sets the provider
# in the mound's config.toml but no model, so codex falls back to its own default
# - and on a ChatGPT account that default is often one you are not entitled to,
# which fails EVERY prompt with "... is not supported when using Codex with a
# ChatGPT account". It looks like a login problem and is not. See docs/CONFIG.md.
#DRAUGR_AGENT_ARGS="--model gpt-5.6-terra"
#
# To override for one run:  dr-go -- <other args>   (replaces, does not add to)
# To pass nothing for one run:  dr-go --bare
#DRAUGR_AGENT_ARGS=

# ssh | sbx - how dr-go and dr-shell get a terminal inside the mound.
#
# ssh is the only one where Ctrl-Z works. It suspends the agent and hands you a
# shell INSIDE the mound; fg goes back, with the session as you left it. Through
# sbx.exe - a Windows binary WSL runs over interop - Ctrl-Z suspends the relay
# instead, and the session dies with "inspect exec: context deadline exceeded".
#
# Set sbx only if a future sbx breaks its ssh proxy, or to compare the two.
#DRAUGR_ATTACH=ssh

# Sandbox name. Empty derives draugr-<repo-folder-name>, which is what you want
# unless two projects share a folder name.
#DRAUGR_SANDBOX=

# Empty means sbx's own defaults: 50% of host RAM capped at 32 GiB, and all CPUs.
#DRAUGR_MEMORY=8g
#DRAUGR_CPUS=4

# Container image. Empty means the agent's stock image.
#DRAUGR_TEMPLATE=

# false bind-mounts your working tree READ-WRITE instead of giving the agent a
# private clone. That is the setting that undoes the entire point of Draugr, so
# it prompts for confirmation every single time. No config key silences that.
#DRAUGR_CLONE=true

# --- What the agent is allowed to reach -------------------------------------
#
# Network rules and setup commands are NOT Draugr settings: they live in an sbx
# kit, which is a first-party declarative format that already does this job and
# travels with the repo. dr-init writes a starter one.
#
#   https://docs.docker.com/ai/sandboxes/customize/kits/
#
# Path to the kit, relative to the repo root, or an absolute path, git ref or OCI
# reference. Empty disables kit loading entirely.
#DRAUGR_KIT=.draugr/kit

# A LIST: sbx merges kits rather than choosing between them, so a shared kit
# ADDS to the project's. Each entry is looked for as an absolute path, then in
# the repo, then in the kit store below, then treated as an OCI/git reference.
#DRAUGR_KIT=".draugr/kit lua"

# Your library of named kits, shared across repositories. Put one there with
# `dr-kit save lua` from the repo whose kit you want to reuse, and see what is
# already there with `dr-kit list`.
#DRAUGR_KIT_STORE=~/.config/draugr/kits

# --- Ports and extra material -----------------------------------------------

# Published to Windows loopback. Applied at creation; use dr-ports mid-session.
#DRAUGR_PORTS="5173:5173 8080:8080"

# The other direction: ports on THIS machine the mound is allowed to reach, as
# bare port numbers. Re-applied on every dr-up, because the address they belong
# to is handed out per boot and cannot be pinned. See dr-hostport.
#DRAUGR_HOST_PORTS="11434"

# Extra workspaces. Append :ro for read-only, which is almost always what you
# want - a read-only mount is strictly safer than copying data in.
#DRAUGR_MOUNTS="/mnt/c/Docs/api:ro"

# --- Data files that are not ready to commit --------------------------------
#
# Repo-relative globs, synced with rsync alongside git rather than through it.
# Paths matching these are exempt from the DRAUGR_REQUIRE_CLEAN check.
#DRAUGR_DATA="tmp/** *.parquet scratch/raw/"

# auto | manual | off.  push is host -> sandbox before the agent starts;
# pull is sandbox -> host when you detach. Never both at once: there is no merge
# algorithm for a parquet file, so each transfer declares a winner.
#DRAUGR_DATA_PUSH=auto
#DRAUGR_DATA_PULL=manual

# Propagate deletions (rsync --delete). Off by default, because a push after you
# tidied a directory would otherwise delete the agent's generated output.
#DRAUGR_DATA_DELETE=false

# /mnt/c is mode 777 under WSL; normalise on the way in. Note that this cannot
# work on the way OUT: DrvFs ignores chmod, so a pulled file is executable on a
# Windows drive whatever you put here. dr-data flags runnable-looking names
# instead - see docs/SECURITY.md.
#DRAUGR_DATA_CHMOD=D755,F644

# Per-file ceiling for `dr-data diff`, in bytes. Bigger text files are reported
# by name and size instead of content; binaries always are. Raise it when you
# have a large generated file you genuinely need to read before accepting it.
#DRAUGR_DATA_DIFF_MAX=262144

# --- Git behaviour ----------------------------------------------------------

# Empty tracks whichever branch you have checked out.
#DRAUGR_BRANCH=

# Name of the git remote pointing at the sandbox. Draugr never touches origin.
#DRAUGR_REMOTE=draugr

# The clone contains committed history only, so uncommitted work is simply not
# there and the agent would quietly build on stale code. This catches that.
#DRAUGR_REQUIRE_CLEAN=true

# Run dr-sync automatically when you detach. This is the mechanism that makes
# the mound safe to lose, not a convenience - leave it on unless you intend to
# run dr-sync yourself.
#DRAUGR_AUTO_SYNC=true

# Stop the mound when you leave the agent, after the sync has run. Off because a
# running mound is what people expect, and because stopping kills anything the
# kit serves through publishedPorts or startup commands. An idle mound holds
# around 1.4 GB; restarting one costs about four seconds. Turn it on for projects
# that serve nothing.
#DRAUGR_STOP_ON_EXIT=false

# What to do when you point Draugr at a directory that is not a git repository.
# Clone mode needs one, and clone mode is what keeps your files read-only to the
# agent - so the default is to refuse rather than quietly do something weaker.
#
#   fail              refuse, and name these alternatives
#   create-add-all    commit what is there; an ordinary repo from then on
#   create-data-only  track nothing (.gitignore of "*"); files travel by
#                     DRAUGR_DATA instead. For folders of documents or data.
#
# Only dr-init and dr-up ever create one.
#DRAUGR_ON_MISSING_REPO=fail

# --- Memory -----------------------------------------------------------------

# auto | manual | off
#DRAUGR_MEM_SYNC=auto

# The store is <project key>/<agent>/ under this, because two agents' memories
# of one project are different things in different shapes.
#DRAUGR_MEM_STORE="$HOME/.local/share/draugr/memory"

# --- Safety rails -----------------------------------------------------------
#
# .gitignore hides files from git, not from the filesystem: an untracked .env is
# absent from the agent's clone but fully readable through the read-only mount.
# This finds those before the agent can.
#DRAUGR_SCAN=true
#DRAUGR_SCAN_PATTERNS=".env *.pem *.key id_rsa id_ed25519 credentials.json secrets.*"

# warn | block
#DRAUGR_SCAN_FAIL=block
