# A query-only front door for Ollama. ./ollama-proxy renders it, and fills in the
# at-delimited values below at start time.
#
# Each path to something shared is defined again relative to the prefix: the pid
# file, both logs, and all five temp paths. That makes this instance independent
# of each other nginx on the machine, and lets it run as a normal user. The
# built-in defaults of nginx point to /var/run and /var/lib/nginx, and a non-root
# process cannot write there. If one temp path is missing, the instance starts,
# but fails at the first response that needs a buffer.

pid          pid;
error_log    logs/error.log warn;

events {
    worker_connections 256;
}

http {
    access_log            logs/access.log;
    client_body_temp_path tmp/client;
    proxy_temp_path       tmp/proxy;
    fastcgi_temp_path     tmp/fastcgi;
    uwsgi_temp_path       tmp/uwsgi;
    scgi_temp_path        tmp/scgi;

    # Generation is slow and streamed. Without proxy_buffering off, the tokens
    # arrive all together at the end, which looks like a hung application. Without
    # the long read timeout, nginx cuts a slow answer at its 60s default, in the
    # middle of a sentence. client_max_body_size covers long prompts and vision
    # images.
    proxy_http_version    1.1;
    proxy_buffering       off;
    proxy_read_timeout    1h;
    proxy_send_timeout    1h;
    client_max_body_size  100m;

    # Ollama reads the Host header. If it does not look like a local address,
    # Ollama answers 403. That is a defense against DNS rebinding. For a named
    # upstream, the nginx default is the upstream NAME (here, "ollama"), which
    # fails that test. Thus the Host is the address of the real connection.
    #
    # A test showed this. It fails only after the bind of Ollama to loopback.
    # While it listened on 0.0.0.0, the same proxied request was allowed. Thus
    # the hardening that makes this proxy useful also exposes the missing
    # header. That is a bad order in which to find things.
    proxy_set_header Host @UPSTREAM@;

    upstream ollama {
        server @UPSTREAM@;
    }

    server {
        listen @LISTEN@:@PORT@;

        # DEFAULT DENY. The safety of this file depends on this line. Ollama
        # gets new endpoints between releases. Thus a denylist of /api/pull and
        # /api/delete silently lets in the next new endpoint. All below is an
        # exception to this, and nginx refuses all that is not named.
        location / { return 403; }

        # nginx answers this itself, with no upstream. Thus it stays a true test
        # of "is the proxy up", also when Ollama is down. The start command waits
        # for it, and does not return before the port is open.
        location = /healthz { return 200 "ollama-proxy ok\n"; }

        # --- inference -------------------------------------------------------
        # Tested on Ollama 0.32.14: a request for a model that is not installed
        # returns {"error":"model '...' not found"}, and does NOT pull it. Thus
        # these allows do not let a download in.
        location = /api/chat      { limit_except POST { deny all; } proxy_pass http://ollama; }
        location = /api/generate  { limit_except POST { deny all; } proxy_pass http://ollama; }
        location = /api/embed     { limit_except POST { deny all; } proxy_pass http://ollama; }
        location = /api/embeddings { limit_except POST { deny all; } proxy_pass http://ollama; }

        # --- read-only introspection ----------------------------------------
        # /api/show is a POST that only describes a model. That is why it is
        # here, not above. The method says "write", but the endpoint does not.
        location = /api/show      { limit_except POST { deny all; } proxy_pass http://ollama; }
        location = /api/tags      { limit_except GET  { deny all; } proxy_pass http://ollama; }
        location = /api/ps        { limit_except GET  { deny all; } proxy_pass http://ollama; }
        location = /api/version   { limit_except GET  { deny all; } proxy_pass http://ollama; }

        # --- the /v1/ surface: OpenAI AND Anthropic --------------------------
        # A test showed that this prefix has no management verbs. /v1/models
        # answers. chat/completions, completions, and embeddings exist as POST.
        # /v1/files is a 404, because Ollama does not implement the file or
        # fine-tune half of the OpenAI API. Thus the whole prefix can pass
        # through, unlike /api/, where the two types of endpoint are mixed.
        #
        # If your application uses the OpenAI protocol, delete the /api/ block
        # above, and keep this one. A smaller allowlist is easier to keep
        # correct, and it is one line, not eight.
        #
        # It now also has a second protocol. That is the reason to run this.
        # Since Ollama 0.14, /v1/messages is the Messages API of ANTHROPIC.
        # Thus the line below, and no other, serves a coding agent that points
        # here with ANTHROPIC_BASE_URL. It needed no new rule. The prefix
        # already passed through whole, and a new protocol arrived in it.
        #
        # That is the limit of the reasoning above. "Has no management verbs" is
        # a claim about a surface that changes. A test showed that it is true on
        # 0.32.14. Test it again, and do not only trust it.
        location /v1/ { proxy_pass http://ollama; }

        # Never proxied. Listed so that you can see that the omission is on
        # purpose, not a mistake:
        #
        #   /api/pull, /api/push     get and publish models over your network
        #   /api/create              builds a model, and can read local files
        #   /api/copy, /api/delete   change and destroy what you installed
        #   /api/blobs/<digest>      upload of any blob
        #
        # `location /` above refuses these. No line denies them by name, on
        # purpose. A denial name by name decays over time.
    }
}
