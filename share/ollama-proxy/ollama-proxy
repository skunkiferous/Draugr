#!/usr/bin/env bash
# ollama-proxy: a query-only front door for a local Ollama.
#
#   ollama-proxy start     start it, and wait until it really answers
#   ollama-proxy stop      stop it
#   ollama-proxy status    is it up, on what address, and is Ollama behind it
#   ollama-proxy config    print the configuration that it uses, and validate it
#
# Ollama has no authentication and no read-only mode. Thus each client that can
# reach it can also pull, create, and delete models. /api/create can also read
# local files. This puts nginx in front, with a default-deny allowlist. Thus an
# application gets inference, and nothing else.
#
# It goes with DRAUGR_HOST_PORTS of Draugr, but needs nothing from Draugr, and
# you can use it alone. The layout is:
#
#   Ollama          127.0.0.1:11434   loopback only, no access from outside
#   this proxy      0.0.0.0:11435     the only way in, query-only
#   the sandbox     DRAUGR_HOST_PORTS="11435"
#
# That exposes LESS than an Ollama bound to 0.0.0.0. Nothing off the host can
# reach a listener for the management API.
#
# --- it does not disturb another nginx ---------------------------------------
#
# This runs a private instance as a normal user, with its own prefix,
# configuration, pid file, logs, and temp paths. It touches nothing under
# /etc/nginx. Tests on nginx 1.28.3 showed this. `nginx -T` on this
# configuration finds zero references to /etc/nginx. A system instance and this
# one serve at the same time. `-s quit` here stops only this one. Only a site in
# /etc/nginx/sites-enabled can couple them, and this never installs one.
#
# `apt install nginx` itself starts a system nginx on port 80 under systemd. The
# distribution does that, not this script. If you do not want it, disable it
# with `sudo systemctl disable --now nginx`.
set -euo pipefail

PROG=${0##*/}

# You can override each value. The defaults are the layout above. UPSTREAM is
# loopback, because Ollama must not listen in another place.
LISTEN=${OLLAMA_PROXY_LISTEN:-0.0.0.0}
PORT=${OLLAMA_PROXY_PORT:-11435}
UPSTREAM=${OLLAMA_PROXY_UPSTREAM:-127.0.0.1:11434}

# Machine state, not repo state. Thus it goes in the XDG state directory, not
# next to a project. The same reason keeps sandbox policy rules out of the kit.
STATE=${OLLAMA_PROXY_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/ollama-proxy}

# The template is beside this script. Thus a copied directory continues to work,
# and its location needs no configuration. First, this follows BASH_SOURCE to
# its target. The obvious way to put this on a PATH is
#
#   ln -s .../share/ollama-proxy/ollama-proxy ~/.local/bin/ollama-proxy
#
# Through a symlink, BASH_SOURCE is the LINK. Then dirname is ~/.local/bin, and
# the search for the template is next to the link, not next to the script. A
# test showed that `ollama-proxy start` then fails with "template not found:
# /home/you/.local/bin/nginx.conf.template", a path that nobody chose.
#
# readlink -f follows a chain of links, and prints a real file with no change.
# Thus a copied directory costs nothing. Guarded, because an absent or non-GNU
# readlink must keep the old behavior, not give an empty path.
_self=${BASH_SOURCE[0]}
_target=$(readlink -f "$_self" 2>/dev/null) && [ -n "$_target" ] && _self=$_target
HERE=$(cd "$(dirname "$_self")" && pwd)
TEMPLATE=${OLLAMA_PROXY_TEMPLATE:-$HERE/nginx.conf.template}

die() { printf '%s: %s\n' "$PROG" "$1" >&2; shift; for l in "$@"; do printf '  %s\n' "$l" >&2; done; exit 1; }
say() { printf '%s: %s\n' "$PROG" "$1"; }

# nginx is the only hard dependency. curl does the readiness wait and the status
# probe. This tests both here, so that a missing one gives a clear message, not
# a confusing failure three steps later.
need() {
    command -v "$1" >/dev/null 2>&1 \
        || die "$1 is not installed" "Install it with:  sudo apt install $2"
}

# Render the template into the prefix. A shell parameter expansion does the
# substitution, not sed. Thus a value with a slash (an IPv6 address, a path)
# cannot break the delimiter.
render() {
    [ -f "$TEMPLATE" ] || die "template not found: $TEMPLATE"
    local conf
    conf=$(cat "$TEMPLATE")
    conf=${conf//@LISTEN@/$LISTEN}
    conf=${conf//@PORT@/$PORT}
    conf=${conf//@UPSTREAM@/$UPSTREAM}
    printf '%s\n' "$conf"
}

# The prefix must exist before nginx tests the configuration. -t opens the log
# files. Thus a missing logs/ directory fails the validation, for a reason that
# is not a wrong configuration.
prepare() {
    mkdir -p "$STATE/logs" "$STATE/tmp"
    render > "$STATE/nginx.conf"
}

# The pid file alone proves nothing. It stays after a kill -9 and a reboot. Thus
# its process must still exist AND still be an nginx. That stops this from the
# use of a different process that gets that pid later.
running() {
    local pid
    [ -f "$STATE/pid" ] || return 1
    pid=$(cat "$STATE/pid" 2>/dev/null) || return 1
    [ -n "$pid" ] || return 1
    [ -r "/proc/$pid/cmdline" ] || return 1
    tr -d '\0' < "/proc/$pid/cmdline" | grep -q nginx
}

# Wait until the port really answers, then return. Some callers start the proxy
# and then immediately send a request (for example, a dr-up hook). Without this,
# such a caller races the listener, and gets a wrong "connection refused".
#
# /healthz is served by nginx itself, so this tests the proxy and not Ollama.
wait_ready() {
    for _ in $(seq 1 50); do
        if curl -fsS -o /dev/null --max-time 1 "http://127.0.0.1:$PORT/healthz" 2>/dev/null; then
            return 0
        fi
        sleep 0.1
    done
    return 1
}

case "${1:-status}" in

start)
    need nginx nginx
    need curl curl
    prepare

    # Idempotent (safe to run twice), so that a hook can call it at each sandbox
    # start. A proxy that already runs is a success, not an error.
    if running; then
        say "already running on $LISTEN:$PORT (pid $(cat "$STATE/pid"))"
        exit 0
    fi

    # Validated before the start. Thus a broken template gives one clear nginx
    # error, not a process that dies immediately and leaves an old pid file.
    nginx -p "$STATE/" -c nginx.conf -t >/dev/null 2>&1 \
        || { nginx -p "$STATE/" -c nginx.conf -t; die "the rendered config is not valid" \
             "See it with:  $PROG config"; }

    nginx -p "$STATE/" -c nginx.conf \
        || die "nginx did not start" "Look at:  $STATE/logs/error.log"

    wait_ready || die "started, but $LISTEN:$PORT never answered" \
                      "Look at:  $STATE/logs/error.log"
    say "listening on $LISTEN:$PORT, forwarding queries to $UPSTREAM"
    ;;

stop)
    # Not an error if it is already down. A teardown script cannot use a stop
    # command that fails on a stopped service.
    if ! running; then
        say "not running"
        exit 0
    fi
    nginx -p "$STATE/" -c nginx.conf -s quit || die "could not stop it"
    say "stopped"
    ;;

status)
    # Exit 1 if it is down, so that a script can use this as a test.
    # `ollama-proxy status || ollama-proxy start` then does the obvious thing.
    if ! running; then
        say "not running"
        printf '  Start it with:  %s start\n' "$PROG"
        exit 1
    fi
    say "running on $LISTEN:$PORT (pid $(cat "$STATE/pid"))"

    # Two separate questions. A mix of them costs an afternoon on the wrong
    # process: is the PROXY up, and is OLLAMA up behind it.
    if curl -fsS -o /dev/null --max-time 2 "http://127.0.0.1:$PORT/healthz" 2>/dev/null; then
        printf '  proxy   answering\n'
    else
        printf '  proxy   NOT answering. See %s/logs/error.log\n' "$STATE"
    fi

    if curl -fsS -o /dev/null --max-time 2 "http://127.0.0.1:$PORT/api/version" 2>/dev/null; then
        printf '  ollama  reachable at %s\n' "$UPSTREAM"
    else
        printf '  ollama  NOT reachable at %s\n' "$UPSTREAM"
    fi

    # The refusal is the feature, so show that it works, and do not only assume
    # it. A 403 here means that the allowlist does its job.
    code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 2 \
                -X POST "http://127.0.0.1:$PORT/api/pull" 2>/dev/null) || code=000
    printf '  /api/pull returns %s (403 is correct: management is refused)\n' "$code"
    ;;

config)
    # Printed AND tested. A configuration that you can read is not the same as
    # one that nginx accepts. Also, you use this command after a failed start.
    prepare
    render
    printf '\n' >&2
    nginx -p "$STATE/" -c nginx.conf -t
    ;;

-h|--help|help)
    sed -n '2,/^set -euo/p' "$0" | sed 's/^# \{0,1\}//; $d'
    ;;

*)
    die "unknown command: $1" "Try:  $PROG start|stop|status|config"
    ;;
esac
